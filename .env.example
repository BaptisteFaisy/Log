# Base PostgreSQL Aiven (pg-memoire / historique)
PGHOST=pg-memoire-xxxxx.i.aivencloud.com
PGPORT=21492
PGDATABASE=historique
PGUSER=logsite
PGPASSWORD=
PGSSLMODE=require

# Rôle administrateur, uniquement pour `npm run db:schema`
PGADMIN_USER=avnadmin
PGADMIN_PASSWORD=

# Kafka Aiven (site)
KAFKA_BROKERS=
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_TOPIC=otel.logs
KAFKA_REPORTS_TOPIC=otel-reports
