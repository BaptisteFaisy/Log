# =====================================================================
# BaptisteFaisy/Log — journaux du poste
# ---------------------------------------------------------------------
# Deny-list de securite : aucun secret ne doit jamais etre versionne.
# Regle : "un log qui contiendrait un token est un incident, pas un push".
# =====================================================================

# jetons et mots de passe
.aiven_token
*.aiven_token
token
*.token
remote-password*.txt
*.pem
*.key
id_ed25519*
id_rsa*
known_hosts

# configuration contenant des secrets
.env
.env.*
!.env.example
creds.env
secrets/

# journal du sync lui-meme (ecrit par bin/sync-logs.sh -> ~/logs/)
log-sync.log

# divers
*.pyc
__pycache__/
.DS_Store
