{"type":"tool_use","timestamp":1792673588114,"sessionID":"ses_e9c56088afferRmTdLiI5wSk3K","part":{"partID":"prt_163ac236e001YLxXU8s627pBw7","sessionID":"ses_e9c56088afferRmTdLiI5wSk3K","messageID":"msg_163ac0d7a001cGL6xRQRn7FM5F","type":"tool","id":"call_00_Nm0Aw2nMahZpcHDFStNz1273","tool":"shell","state":{"status":"completed","input":{"command":"cd /home/baptistefaisy/aiven-kafka-demo && sed -n '150,330p' tools/emit_sql_error.py","timeout":60000},"output":"            from urllib.parse import urlsplit\n            parts = urlsplit(url)\n            host = parts.hostname or host\n            port = str(parts.port or port)\n            user = parts.username or user\n            password = parts.password or \"\"\n        sslmode = \"require\"\n\n    if not password:\n        raise kafkalib.ConfigError(\n            f\"mot de passe PostgreSQL introuvable (attendu dans {CREDS_ENV} \"\n            f\"ou --db-url)\")\n\n    return {\n        \"PGHOST\": host,\n        \"PGPORT\": str(port),\n        \"PGUSER\": user,\n        \"PGPASSWORD\": password,\n        \"PGDATABASE\": db,\n        \"PGSSLMODE\": sslmode,\n        \"PGCONNECT_TIMEOUT\": \"15\",\n        \"PGAPPNAME\": \"emit_sql_error\",\n    }\n\n\n# ---------------------------------------------------------------------------\n# execution psql\n# ---------------------------------------------------------------------------\ndef psql(pg_env: Dict[str, str], sql: str, timeout: int = 45,\n         extra_env: Optional[Dict[str, str]] = None,\n         database: Optional[str] = None) -> subprocess.CompletedProcess:\n    env = os.environ.copy()\n    env.update(pg_env)\n    if database:\n        env[\"PGDATABASE\"] = database\n    if extra_env:\n        env.update(extra_env)\n    return subprocess.run(\n        [\"psql\", \"-X\", \"-q\", \"-v\", \"VERBOSITY=verbose\", \"-f\", \"-\"],\n        input=sql, env=env, capture_output=True, text=True, timeout=timeout)\n\n\ndef parse_errors(stderr: str) -> List[Dict[str, str]]:\n    \"\"\"Erreurs PostgreSQL remontees par psql (severite, sqlstate, message).\"\"\"\n    errors = []\n    for severity, sqlstate, message in ERROR_RE.findall(stderr or \"\"):\n        errors.append({\n            \"severity\": severity,\n            \"sqlstate\": sqlstate or \"\",\n            \"message\": message.strip(),\n        })\n    return errors\n\n\ndef pick_error(errors: List[Dict[str, str]],\n               expected: str) -> Optional[Dict[str, str]]:\n    \"\"\"L'erreur qui porte le sqlstate attendu, sinon la derniere.\"\"\"\n    for err in errors:\n        if expected and err[\"sqlstate\"] == expected:\n            return err\n    return errors[-1] if errors else None\n\n\n# ---------------------------------------------------------------------------\n# sondes : chacune PROVOQUE une erreur SQL reelle\n# ---------------------------------------------------------------------------\nPROBES: List[Dict[str, Any]] = [\n    {\n        \"id\": \"sql_undefined_table\",\n        \"label\": \"relation inexistante (42P01)\",\n        \"error_type\": \"db_undefined_table\",\n        \"sqlstate\": \"42P01\",\n        \"operation\": \"SELECT\",\n        \"sql\": \"SELECT * FROM historique_index_absent;\",\n    },\n    {\n        \"id\": \"sql_undefined_function\",\n        \"label\": \"fonction inexistante (42883)\",\n        \"error_type\": \"db_undefined_function\",\n        \"sqlstate\": \"42883\",\n        \"operation\": \"historique_get\",\n        \"sql\": \"SELECT historique_get();\",\n    },\n    {\n        \"id\": \"sql_syntax_error\",\n        \"label\": \"erreur de syntaxe (42601)\",\n        \"error_type\": \"db_syntax_error\",\n        \"sqlstate\": \"42601\",\n        \"operation\": \"SELECT\",\n        \"sql\": \"SELECT nom === FROM historique;\",\n    },\n    {\n        \"id\": \"sql_undefined_column\",\n        \"label\": \"colonne inexistante (42703)\",\n        \"error_type\": \"db_undefined_column\",\n        \"sqlstate\": \"42703\",\n        \"operation\": \"SELECT\",\n        \"sql\": \"SELECT resolution_privee FROM historique;\",\n    },\n    {\n        \"id\": \"sql_division_by_zero\",\n        \"label\": \"division par zero (22012)\",\n        \"error_type\": \"db_data_exception\",\n        \"sqlstate\": \"22012\",\n        \"operation\": \"SELECT\",\n        \"sql\": \"SELECT 1/0;\",\n    },\n    {\n        \"id\": \"sql_invalid_input\",\n        \"label\": \"conversion de type invalide (22P02)\",\n        \"error_type\": \"db_data_exception\",\n        \"sqlstate\": \"22P02\",\n        \"operation\": \"SELECT\",\n        \"sql\": \"SELECT 'abc'::integer;\",\n    },\n    {\n        \"id\": \"sql_in_failed_transaction\",\n        \"label\": \"transaction abortee (25P02)\",\n        \"error_type\": \"db_in_failed_transaction\",\n        \"sqlstate\": \"25P02\",\n        \"operation\": \"SELECT\",\n        \"sql\": (\"BEGIN;\\n\"\n                \"SELECT 1/0;\\n\"\n                \"SELECT count(*) FROM historique;\\n\"\n                \"ROLLBACK;\\n\"),\n    },\n    {\n        \"id\": \"sql_application_guard\",\n        \"label\": \"garde-fou applicatif historique_set (P0001)\",\n        \"error_type\": \"db_application_exception\",\n        \"sqlstate\": \"P0001\",\n        \"operation\": \"historique_set\",\n        # la fonction leve AVANT l'INSERT : aucune ecriture\n        \"sql\": \"SELECT historique_set('   ', 'sonde');\",\n    },\n    {\n        \"id\": \"sql_duplicate_key\",\n        \"label\": \"nom deja present (P0001)\",\n        \"error_type\": \"db_application_exception\",\n        \"sqlstate\": \"P0001\",\n        \"operation\": \"historique_set\",\n        # nom deja present -> ON CONFLICT ... WHERE p_ecraser ne modifie rien\n        \"sql\": (\"SELECT historique_set(\"\n                \"  (SELECT nom::text FROM historique ORDER BY id LIMIT 1),\"\n                \"  'sonde');\"),\n    },\n    {\n        \"id\": \"sql_lock_timeout\",\n        \"label\": \"verrou pose expire (55P03)\",\n        \"error_type\": \"db_lock_timeout\",\n        \"sqlstate\": \"55P03\",\n        \"operation\": \"SELECT FOR UPDATE\",\n        \"sql\": (\"SET lock_timeout = '750ms';\\n\"\n                \"BEGIN;\\n\"\n                \"SELECT id FROM historique ORDER BY id LIMIT 1 FOR UPDATE;\\n\"\n                \"ROLLBACK;\\n\"),\n        \"hold\": {\n            \"sql\": (\"BEGIN;\\n\"\n                    \"SELECT id FROM historique ORDER BY id LIMIT 1 FOR UPDATE;\\n\"\n                    \"SELECT pg_sleep(6);\\n\"\n                    \"ROLLBACK;\\n\"),\n            \"delay\": 1.5,\n        },\n    },\n]\n\n\ndef read_row_count(pg_env: Dict[str, str]) -> Optional[int]:\n    \"\"\"Nombre de lignes de `historique` (garde-fou anti-ecriture).\"\"\"\n    try:\n        proc = psql(pg_env, \"SELECT count(*) FROM historique;\", timeout=30)\n    except (subprocess.TimeoutExpired, OSError):\n        return None\n    out = (proc.stdout or \"\").strip().splitlines()\n    for line in out:\n        if line.strip().isdigit():\n            return int(line.strip())\n    return None\n\n\ndef read_pool_counters(pg_env: Dict[str, str]) -> Dict[str, str]:\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"            from urllib.parse import urlsplit\n            parts = urlsplit(url)\n            host = parts.hostname or host\n            port = str(parts.port or port)\n            user = parts.username or user\n            password = parts.password or \"\"\n        sslmode = \"require\"\n\n    if not password:\n        raise kafkalib.ConfigError(\n            f\"mot de passe PostgreSQL introuvable (attendu dans {CREDS_ENV} \"\n            f\"ou --db-url)\")\n\n    return {\n        \"PGHOST\": host,\n        \"PGPORT\": str(port),\n        \"PGUSER\": user,\n        \"PGPASSWORD\": password,\n        \"PGDATABASE\": db,\n        \"PGSSLMODE\": sslmode,\n        \"PGCONNECT_TIMEOUT\": \"15\",\n        \"PGAPPNAME\": \"emit_sql_error\",\n    }\n\n\n# ---------------------------------------------------------------------------\n# execution psql\n# ---------------------------------------------------------------------------\ndef psql(pg_env: Dict[str, str], sql: str, timeout: int = 45,\n         extra_env: Optional[Dict[str, str]] = None,\n         database: Optional[str] = None) -> subprocess.CompletedProcess:\n    env = os.environ.copy()\n    env.update(pg_env)\n    if database:\n        env[\"PGDATABASE\"] = database\n    if extra_env:\n        env.update(extra_env)\n    return subprocess.run(\n        [\"psql\", \"-X\", \"-q\", \"-v\", \"VERBOSITY=verbose\", \"-f\", \"-\"],\n        input=sql, env=env, capture_output=True, text=True, timeout=timeout)\n\n\ndef parse_errors(stderr: str) -> List[Dict[str, str]]:\n    \"\"\"Erreurs PostgreSQL remontees par psql (severite, sqlstate, message).\"\"\"\n    errors = []\n    for severity, sqlstate, message in ERROR_RE.findall(stderr or \"\"):\n        errors.append({\n            \"severity\": severity,\n            \"sqlstate\": sqlstate or \"\",\n            \"message\": message.strip(),\n        })\n    return errors\n\n\ndef pick_error(errors: List[Dict[str, str]],\n               expected: str) -> Optional[Dict[str, str]]:\n    \"\"\"L'erreur qui porte le sqlstate attendu, sinon la derniere.\"\"\"\n    for err in errors:\n        if expected and err[\"sqlstate\"] == expected:\n            return err\n    return errors[-1] if errors else None\n\n\n# ---------------------------------------------------------------------------\n# sondes : chacune PROVOQUE une erreur SQL reelle\n# ---------------------------------------------------------------------------\nPROBES: List[Dict[str, Any]] = [\n    {\n        \"id\": \"sql_undefined_table\",\n        \"label\": \"relation inexistante (42P01)\",\n        \"error_type\": \"db_undefined_table\",\n        \"sqlstate\": \"42P01\",\n        \"operation\": \"SELECT\",\n        \"sql\": \"SELECT * FROM historique_index_absent;\",\n    },\n    {\n        \"id\": \"sql_undefined_function\",\n        \"label\": \"fonction inexistante (42883)\",\n        \"error_type\": \"db_undefined_function\",\n        \"sqlstate\": \"42883\",\n        \"operation\": \"historique_get\",\n        \"sql\": \"SELECT historique_get();\",\n    },\n    {\n        \"id\": \"sql_syntax_error\",\n        \"label\": \"erreur de syntaxe (42601)\",\n        \"error_type\": \"db_syntax_error\",\n        \"sqlstate\": \"42601\",\n        \"operation\": \"SELECT\",\n        \"sql\": \"SELECT nom === FROM historique;\",\n    },\n    {\n        \"id\": \"sql_undefined_column\",\n        \"label\": \"colonne inexistante (42703)\",\n        \"error_type\": \"db_undefined_column\",\n        \"sqlstate\": \"42703\",\n        \"operation\": \"SELECT\",\n        \"sql\": \"SELECT resolution_privee FROM historique;\",\n    },\n    {\n        \"id\": \"sql_division_by_zero\",\n        \"label\": \"division par zero (22012)\",\n        \"error_type\": \"db_data_exception\",\n        \"sqlstate\": \"22012\",\n        \"operation\": \"SELECT\",\n        \"sql\": \"SELECT 1/0;\",\n    },\n    {\n        \"id\": \"sql_invalid_input\",\n        \"label\": \"conversion de type invalide (22P02)\",\n        \"error_type\": \"db_data_exception\",\n        \"sqlstate\": \"22P02\",\n        \"operation\": \"SELECT\",\n        \"sql\": \"SELECT 'abc'::integer;\",\n    },\n    {\n        \"id\": \"sql_in_failed_transaction\",\n        \"label\": \"transaction abortee (25P02)\",\n        \"error_type\": \"db_in_failed_transaction\",\n        \"sqlstate\": \"25P02\",\n        \"operation\": \"SELECT\",\n        \"sql\": (\"BEGIN;\\n\"\n                \"SELECT 1/0;\\n\"\n                \"SELECT count(*) FROM historique;\\n\"\n                \"ROLLBACK;\\n\"),\n    },\n    {\n        \"id\": \"sql_application_guard\",\n        \"label\": \"garde-fou applicatif historique_set (P0001)\",\n        \"error_type\": \"db_application_exception\",\n        \"sqlstate\": \"P0001\",\n        \"operation\": \"historique_set\",\n        # la fonction leve AVANT l'INSERT : aucune ecriture\n        \"sql\": \"SELECT historique_set('   ', 'sonde');\",\n    },\n    {\n        \"id\": \"sql_duplicate_key\",\n        \"label\": \"nom deja present (P0001)\",\n        \"error_type\": \"db_application_exception\",\n        \"sqlstate\": \"P0001\",\n        \"operation\": \"historique_set\",\n        # nom deja present -> ON CONFLICT ... WHERE p_ecraser ne modifie rien\n        \"sql\": (\"SELECT historique_set(\"\n                \"  (SELECT nom::text FROM historique ORDER BY id LIMIT 1),\"\n                \"  'sonde');\"),\n    },\n    {\n        \"id\": \"sql_lock_timeout\",\n        \"label\": \"verrou pose expire (55P03)\",\n        \"error_type\": \"db_lock_timeout\",\n        \"sqlstate\": \"55P03\",\n        \"operation\": \"SELECT FOR UPDATE\",\n        \"sql\": (\"SET lock_timeout = '750ms';\\n\"\n                \"BEGIN;\\n\"\n                \"SELECT id FROM historique ORDER BY id LIMIT 1 FOR UPDATE;\\n\"\n                \"ROLLBACK;\\n\"),\n        \"hold\": {\n            \"sql\": (\"BEGIN;\\n\"\n                    \"SELECT id FROM historique ORDER BY id LIMIT 1 FOR UPDATE;\\n\"\n                    \"SELECT pg_sleep(6);\\n\"\n                    \"ROLLBACK;\\n\"),\n            \"delay\": 1.5,\n        },\n    },\n]\n\n\ndef read_row_count(pg_env: Dict[str, str]) -> Optional[int]:\n    \"\"\"Nombre de lignes de `historique` (garde-fou anti-ecriture).\"\"\"\n    try:\n        proc = psql(pg_env, \"SELECT count(*) FROM historique;\", timeout=30)\n    except (subprocess.TimeoutExpired, OSError):\n        return None\n    out = (proc.stdout or \"\").strip().splitlines()\n    for line in out:\n        if line.strip().isdigit():\n            return int(line.strip())\n    return None\n\n\ndef read_pool_counters(pg_env: Dict[str, str]) -> Dict[str, str]:\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /home/baptistefaisy/aiven-kafka-demo && sed -n '150,330p' tools/emit_sql_error.py\", \"timeout\": 60000}"},"time":{"start":1792673588078,"end":1792673588114}}}}
