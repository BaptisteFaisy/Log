ttrs: Dict[str, str] = {\n        \"db.system\": \"postgresql\",\n        \"db.namespace\": pg_env.get(\"PGDATABASE\", DEFAULT_DB),\n        \"db.operation.name\": probe.get(\"operation\", \"SELECT\"),\n        \"db.sqlstate\": sqlstate,\n        \"db.error.severity\": err.get(\"severity\", \"ERROR\"),\n        \"db.statement\": probe[\"sql\"].strip().splitlines()[0][:200],\n        \"db.connection_pool.name\": \"historique-app\",\n        \"exception.type\": f\"postgresql.{condition}\",\n        \"exception.message\": message[:400],\n        \"net.peer.name\": pg_env.get(\"PGHOST\", DEFAULT_HOST),\n        \"net.peer.port\": pg_env.get(\"PGPORT\", str(DEFAULT_PORT)),\n    }\n    attrs.update(counters)\n\n    return {\n        \"id\": probe[\"id\"],\n        \"error_type\": error_type,\n        \"profile\": \"infra\",\n        \"agent_result\": json.dumps({\n            \"success\": False, \"booking_confirmed\": False,\n            \"tool_confirmed\": False, \"tool_calls\": 1}),\n        \"spans\": [{\n            \"name\": \"agent.run\", \"offset_ms\": 0, \"duration_ms\": 45,\n            \"status\": \"Error\", \"attributes\": dict(attrs),\n        }],\n        \"logs\": [{\n            \"severity\": \"ERROR\", \"severity_number\": 17, \"span\": \"agent.run\",\n            \"offset_ms\": 30, \"body\": message[:400], \"attributes\": dict(attrs),\n        }],\n        \"metrics\": [{\n            \"name\": \"db.client.connection.pool.active\", \"unit\": \"{connection}\",\n            \"offset_ms\": 30, \"value\": int(counters.get(\"db.connection_pool.active\", 0) or 0),\n            \"attributes\": {\"db.system\": \"postgresql\",\n                           \"db.namespace\": pg_env.get(\"PGDATABASE\", DEFAULT_DB)},\n        }],\n    }\n\n\ndef publish(scenario: Dict[str, Any], prefix: Optional[str]) -> Tuple[str, Dict[str, int]]:\n    catalog = contract.load_catalog()\n    trace_id = contract.new_trace_id()\n    messages = contract.build_messages(\n        catalog, scenario, trace_id=trace_id,\n        base_timestamp=contract.format_ts(datetime_now()))\n    publisher = kafkalib.Publisher(prefix=prefix)\n    counts: Dict[str, int] = {}\n    for suffix, key, payload in contract.iter_messages(messages):\n        publisher.send(suffix, key, contract.dumps(payload))\n        counts[suffix] = counts.get(suffix, 0) + 1\n    publisher.flush()\n    return trace_id, counts\n\n\ndef datetime_now():\n    from datetime import datetime, timezone\n    return datetime.now(timezone.utc)\n\n\n# ---------------------------------------------------------------------------\ndef main(argv=None):\n    parser = argparse.ArgumentParser(\n        prog=\"emit_sql_error.py\",\n        description=\"provoque une VRAIE erreur SQL PostgreSQL et la publie dans Kafka\")\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /home/baptistefaisy/aiven-kafka-demo && sed -n '330,470p' tools/emit_sql_error.py\", \"timeout\": 60000}"},"time":{"start":1792673950259,"end":1792673951557}}}}
