{"type":"tool_use","timestamp":1792673582277,"sessionID":"ses_e9c56088afferRmTdLiI5wSk3K","part":{"partID":"prt_163ac0c19002nY1xBoznb1lp5R","sessionID":"ses_e9c56088afferRmTdLiI5wSk3K","messageID":"msg_163abff49001jibkyDtJCuCjZQ","type":"tool","id":"call_00_hM8wFadCnspO6CSYQgOt0913","tool":"shell","state":{"status":"completed","input":{"command":"cd /home/baptistefaisy/aiven-kafka-demo && sed -n '1,80p' tools/emit_sql_error.py","timeout":60000},"output":"#!/usr/bin/env python3\n\"\"\"tools/emit_sql_error — publie une VRAIE erreur SQL PostgreSQL dans Kafka.\n\nComme `tools/emit_incident.py`, mais au lieu de rejouer un scenario\nsynthetique du catalogue, ce script PROVOQUE une erreur SQL reelle sur la\nbase PostgreSQL, capture le message et le `sqlstate` du serveur, et publie le\nresultat dans Kafka selon le contrat §3 (`tools/contract.py`).\n\nRegle « zero code » : `tools/kafka-incident-watch` n'est JAMAIS modifie.\nCe producteur ne touche qu'a deux choses hors de lui-meme :\n  - `routes.yaml` : une ligne par `error.type` nouveau ;\n  - rien d'autre. Le catalogue n'est pas modifie (il ne doit contenir que\n    les 5 pannes de plateforme + le run nominal, cf. `seed --self-check`).\n\nSecurite : aucune sonde n'ecrit dans la base. Les sondes qui appellent une\nfonction ecrivante (`historique_set`) echouent AVANT tout INSERT, et toutes\nles transactions sont annulees. Le nombre de lignes de `historique` est\nrelu avant et apres chaque sonde : s'il change, l'outil s'arrete en erreur.\n\nUsage :\n  ./tools/emit_sql_error.py --list\n  ./tools/emit_sql_error.py --probe sql_undefined_table\n  ./tools/emit_sql_error.py --all [--prefix P] [--dry-run] [--json]\n\nCodes de sortie : 0 ok / 1 usage / 2 configuration manquante /\n3 Kafka injoignable / 4 aucune erreur declenchee / 5 la base a change\n/ 7 generateurs d'erreurs coupes (./tools/generator on).\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport os\nimport re\nimport subprocess\nimport sys\nfrom pathlib import Path\nfrom typing import Any, Dict, List, Optional, Tuple\n\nHERE = Path(__file__).resolve().parent\nPROJECT_ROOT = HERE.parent\nsys.path.insert(0, str(HERE))\n\nimport contract  # noqa: E402\nimport generator_switch  # noqa: E402\nimport kafkalib  # noqa: E402\n\nEXIT_OK = kafkalib.EXIT_OK\nEXIT_USAGE = kafkalib.EXIT_USAGE\nEXIT_CONFIG = kafkalib.EXIT_CONFIG\nEXIT_KAFKA = kafkalib.EXIT_KAFKA\nEXIT_NO_ERROR = 4\nEXIT_DATA_CHANGED = 5\n\n# --- connexion PostgreSQL -------------------------------------------------\nCREDS_ENV = Path(\"/home/baptistefaisy/hackathon-memory/.secrets/creds.env\")\nMEMORY_ENV = Path(\"/home/baptistefaisy/hackathon-memory/.env\")\nDEFAULT_HOST = \"pg-memoire-baptiste-c04f.i.aivencloud.com\"\nDEFAULT_PORT = 21492\nDEFAULT_DB = \"historique\"\nDEFAULT_USER = \"app\"\n\n# --- sqlstate -> nom de condition PostgreSQL (CONSEQUENT CONDITIONS) -------\nCONDITIONS = {\n    \"42P01\": \"undefined_table\",\n    \"42883\": \"undefined_function\",\n    \"42601\": \"syntax_error\",\n    \"42703\": \"undefined_column\",\n    \"22012\": \"division_by_zero\",\n    \"22P02\": \"invalid_text_representation\",\n    \"22023\": \"invalid_parameter_value\",\n    \"25P02\": \"in_failed_sql_transaction\",\n    \"40P01\": \"deadlock_detected\",\n    \"55P03\": \"lock_not_available\",\n    \"28P01\": \"invalid_password\",\n    \"28000\": \"invalid_authorization_specification\",\n    \"P0001\": \"raise_exception\",\n    \"53300\": \"too_many_connections\",\n    \"57014\": \"query_canceled\",\n    \"08006\": \"connection_failure\",\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"#!/usr/bin/env python3\n\"\"\"tools/emit_sql_error — publie une VRAIE erreur SQL PostgreSQL dans Kafka.\n\nComme `tools/emit_incident.py`, mais au lieu de rejouer un scenario\nsynthetique du catalogue, ce script PROVOQUE une erreur SQL reelle sur la\nbase PostgreSQL, capture le message et le `sqlstate` du serveur, et publie le\nresultat dans Kafka selon le contrat §3 (`tools/contract.py`).\n\nRegle « zero code » : `tools/kafka-incident-watch` n'est JAMAIS modifie.\nCe producteur ne touche qu'a deux choses hors de lui-meme :\n  - `routes.yaml` : une ligne par `error.type` nouveau ;\n  - rien d'autre. Le catalogue n'est pas modifie (il ne doit contenir que\n    les 5 pannes de plateforme + le run nominal, cf. `seed --self-check`).\n\nSecurite : aucune sonde n'ecrit dans la base. Les sondes qui appellent une\nfonction ecrivante (`historique_set`) echouent AVANT tout INSERT, et toutes\nles transactions sont annulees. Le nombre de lignes de `historique` est\nrelu avant et apres chaque sonde : s'il change, l'outil s'arrete en erreur.\n\nUsage :\n  ./tools/emit_sql_error.py --list\n  ./tools/emit_sql_error.py --probe sql_undefined_table\n  ./tools/emit_sql_error.py --all [--prefix P] [--dry-run] [--json]\n\nCodes de sortie : 0 ok / 1 usage / 2 configuration manquante /\n3 Kafka injoignable / 4 aucune erreur declenchee / 5 la base a change\n/ 7 generateurs d'erreurs coupes (./tools/generator on).\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport os\nimport re\nimport subprocess\nimport sys\nfrom pathlib import Path\nfrom typing import Any, Dict, List, Optional, Tuple\n\nHERE = Path(__file__).resolve().parent\nPROJECT_ROOT = HERE.parent\nsys.path.insert(0, str(HERE))\n\nimport contract  # noqa: E402\nimport generator_switch  # noqa: E402\nimport kafkalib  # noqa: E402\n\nEXIT_OK = kafkalib.EXIT_OK\nEXIT_USAGE = kafkalib.EXIT_USAGE\nEXIT_CONFIG = kafkalib.EXIT_CONFIG\nEXIT_KAFKA = kafkalib.EXIT_KAFKA\nEXIT_NO_ERROR = 4\nEXIT_DATA_CHANGED = 5\n\n# --- connexion PostgreSQL -------------------------------------------------\nCREDS_ENV = Path(\"/home/baptistefaisy/hackathon-memory/.secrets/creds.env\")\nMEMORY_ENV = Path(\"/home/baptistefaisy/hackathon-memory/.env\")\nDEFAULT_HOST = \"pg-memoire-baptiste-c04f.i.aivencloud.com\"\nDEFAULT_PORT = 21492\nDEFAULT_DB = \"historique\"\nDEFAULT_USER = \"app\"\n\n# --- sqlstate -> nom de condition PostgreSQL (CONSEQUENT CONDITIONS) -------\nCONDITIONS = {\n    \"42P01\": \"undefined_table\",\n    \"42883\": \"undefined_function\",\n    \"42601\": \"syntax_error\",\n    \"42703\": \"undefined_column\",\n    \"22012\": \"division_by_zero\",\n    \"22P02\": \"invalid_text_representation\",\n    \"22023\": \"invalid_parameter_value\",\n    \"25P02\": \"in_failed_sql_transaction\",\n    \"40P01\": \"deadlock_detected\",\n    \"55P03\": \"lock_not_available\",\n    \"28P01\": \"invalid_password\",\n    \"28000\": \"invalid_authorization_specification\",\n    \"P0001\": \"raise_exception\",\n    \"53300\": \"too_many_connections\",\n    \"57014\": \"query_canceled\",\n    \"08006\": \"connection_failure\",\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /home/baptistefaisy/aiven-kafka-demo && sed -n '1,80p' tools/emit_sql_error.py\", \"timeout\": 60000}"},"time":{"start":1792673582105,"end":1792673582277}}}}
