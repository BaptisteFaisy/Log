{"type":"tool_use","timestamp":1792673951557,"sessionID":"ses_e9c56088afferRmTdLiI5wSk3K","part":{"partID":"prt_163b1aa33001rPaciDoiPEsQrx","sessionID":"ses_e9c56088afferRmTdLiI5wSk3K","messageID":"msg_163acb61e001vip4ReBeKDKwmK","type":"tool","id":"call_00_TpaBTiAeU4Mzv2OTYAyQ6707","tool":"shell","state":{"status":"completed","input":{"command":"cd /home/baptistefaisy/aiven-kafka-demo && sed -n '330,470p' tools/emit_sql_error.py","timeout":60000},"output":"def read_pool_counters(pg_env: Dict[str, str]) -> Dict[str, str]:\n    \"\"\"Compteurs REELS de sessions, lus sur la base (db-diagnose les utilise).\"\"\"\n    counters = {\"db.connection_pool.active\": \"0\",\n                \"db.connection_pool.idle\": \"0\",\n                \"db.connection_pool.max\": \"0\"}\n    sql = (\"SELECT (SELECT count(*) FROM pg_stat_activity),\"\n           \"       (SELECT count(*) FROM pg_stat_activity WHERE state = 'idle'),\"\n           \"       current_setting('max_connections');\\n\")\n    try:\n        proc = psql(pg_env, sql, timeout=30)\n    except (subprocess.TimeoutExpired, OSError):\n        return counters\n    for line in (proc.stdout or \"\").splitlines():\n        parts = line.split(\"|\")\n        if len(parts) == 3 and all(p.strip().isdigit() for p in parts):\n            counters[\"db.connection_pool.active\"] = parts[0].strip()\n            counters[\"db.connection_pool.idle\"] = parts[1].strip()\n            counters[\"db.connection_pool.max\"] = parts[2].strip()\n            break\n    return counters\n\n\ndef run_probe(probe: Dict[str, Any], pg_env: Dict[str, str]) -> Dict[str, Any]:\n    \"\"\"Declenche l'erreur et rend le detail reel du serveur.\"\"\"\n    holder = None\n    if probe.get(\"hold\"):\n        hold = probe[\"hold\"]\n        try:\n            holder = subprocess.Popen(\n                [\"psql\", \"-X\", \"-q\", \"-v\", \"VERBOSITY=verbose\", \"-f\", \"-\"],\n                stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,\n                stderr=subprocess.DEVNULL, text=True,\n                env={**os.environ, **pg_env})\n            holder.stdin.write(hold[\"sql\"])\n            holder.stdin.close()\n        except OSError:\n            holder = None\n        import time\n        time.sleep(hold.get(\"delay\", 1.0))\n\n    try:\n        proc = psql(pg_env, probe[\"sql\"], timeout=45)\n        stderr, stdout = proc.stderr or \"\", proc.stdout or \"\"\n    except subprocess.TimeoutExpired:\n        stderr, stdout = \"ERROR: 57014: terminating connection due to administrator command\\n\", \"\"\n    finally:\n        if holder is not None:\n            try:\n                holder.wait(timeout=15)\n            except subprocess.TimeoutExpired:\n                holder.kill()\n\n    errors = parse_errors(stderr)\n    chosen = pick_error(errors, probe[\"sqlstate\"])\n    return {\n        \"probe\": probe[\"id\"],\n        \"label\": probe[\"label\"],\n        \"expected_sqlstate\": probe[\"sqlstate\"],\n        \"error\": chosen,\n        \"all_errors\": errors,\n        \"stdout\": stdout.strip()[:400],\n    }\n\n\n# ---------------------------------------------------------------------------\n# publication\n# ---------------------------------------------------------------------------\ndef build_scenario(probe: Dict[str, Any], outcome: Dict[str, Any],\n                   pg_env: Dict[str, str],\n                   counters: Dict[str, str]) -> Dict[str, Any]:\n    err = outcome.get(\"error\") or {}\n    sqlstate = err.get(\"sqlstate\") or probe[\"sqlstate\"]\n    message = err.get(\"message\") or probe[\"label\"]\n    condition = CONDITIONS.get(sqlstate, \"sql_error\")\n    error_type = probe.get(\"error_type\") or SQLSTATE_TO_ERROR_TYPE.get(\n        sqlstate, \"db_sql_error\")\n\n    attrs: Dict[str, str] = {\n        \"db.system\": \"postgresql\",\n        \"db.namespace\": pg_env.get(\"PGDATABASE\", DEFAULT_DB),\n        \"db.operation.name\": probe.get(\"operation\", \"SELECT\"),\n        \"db.sqlstate\": sqlstate,\n        \"db.error.severity\": err.get(\"severity\", \"ERROR\"),\n        \"db.statement\": probe[\"sql\"].strip().splitlines()[0][:200],\n        \"db.connection_pool.name\": \"historique-app\",\n        \"exception.type\": f\"postgresql.{condition}\",\n        \"exception.message\": message[:400],\n        \"net.peer.name\": pg_env.get(\"PGHOST\", DEFAULT_HOST),\n        \"net.peer.port\": pg_env.get(\"PGPORT\", str(DEFAULT_PORT)),\n    }\n    attrs.update(counters)\n\n    return {\n        \"id\": probe[\"id\"],\n        \"error_type\": error_type,\n        \"profile\": \"infra\",\n        \"agent_result\": json.dumps({\n            \"success\": False, \"booking_confirmed\": False,\n            \"tool_confirmed\": False, \"tool_calls\": 1}),\n        \"spans\": [{\n            \"name\": \"agent.run\", \"offset_ms\": 0, \"duration_ms\": 45,\n            \"status\": \"Error\", \"attributes\": dict(attrs),\n        }],\n        \"logs\": [{\n            \"severity\": \"ERROR\", \"severity_number\": 17, \"span\": \"agent.run\",\n            \"offset_ms\": 30, \"body\": message[:400], \"attributes\": dict(attrs),\n        }],\n        \"metrics\": [{\n            \"name\": \"db.client.connection.pool.active\", \"unit\": \"{connection}\",\n            \"offset_ms\": 30, \"value\": int(counters.get(\"db.connection_pool.active\", 0) or 0),\n            \"attributes\": {\"db.system\": \"postgresql\",\n                           \"db.namespace\": pg_env.get(\"PGDATABASE\", DEFAULT_DB)},\n        }],\n    }\n\n\ndef publish(scenario: Dict[str, Any], prefix: Optional[str]) -> Tuple[str, Dict[str, int]]:\n    catalog = contract.load_catalog()\n    trace_id = contract.new_trace_id()\n    messages = contract.build_messages(\n        catalog, scenario, trace_id=trace_id,\n        base_timestamp=contract.format_ts(datetime_now()))\n    publisher = kafkalib.Publisher(prefix=prefix)\n    counts: Dict[str, int] = {}\n    for suffix, key, payload in contract.iter_messages(messages):\n        publisher.send(suffix, key, contract.dumps(payload))\n        counts[suffix] = counts.get(suffix, 0) + 1\n    publisher.flush()\n    return trace_id, counts\n\n\ndef datetime_now():\n    from datetime import datetime, timezone\n    return datetime.now(timezone.utc)\n\n\n# ---------------------------------------------------------------------------\ndef main(argv=None):\n    parser = argparse.ArgumentParser(\n        prog=\"emit_sql_error.py\",\n        description=\"provoque une VRAIE erreur SQL PostgreSQL et la publie dans Kafka\")\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"def read_pool_counters(pg_env: Dict[str, str]) -> Dict[str, str]:\n    \"\"\"Compteurs REELS de sessions, lus sur la base (db-diagnose les utilise).\"\"\"\n    counters = {\"db.connection_pool.active\": \"0\",\n                \"db.connection_pool.idle\": \"0\",\n                \"db.connection_pool.max\": \"0\"}\n    sql = (\"SELECT (SELECT count(*) FROM pg_stat_activity),\"\n           \"       (SELECT count(*) FROM pg_stat_activity WHERE state = 'idle'),\"\n           \"       current_setting('max_connections');\\n\")\n    try:\n        proc = psql(pg_env, sql, timeout=30)\n    except (subprocess.TimeoutExpired, OSError):\n        return counters\n    for line in (proc.stdout or \"\").splitlines():\n        parts = line.split(\"|\")\n        if len(parts) == 3 and all(p.strip().isdigit() for p in parts):\n            counters[\"db.connection_pool.active\"] = parts[0].strip()\n            counters[\"db.connection_pool.idle\"] = parts[1].strip()\n            counters[\"db.connection_pool.max\"] = parts[2].strip()\n            break\n    return counters\n\n\ndef run_probe(probe: Dict[str, Any], pg_env: Dict[str, str]) -> Dict[str, Any]:\n    \"\"\"Declenche l'erreur et rend le detail reel du serveur.\"\"\"\n    holder = None\n    if probe.get(\"hold\"):\n        hold = probe[\"hold\"]\n      