{"type":"tool_use","timestamp":1792669218055,"sessionID":"ses_e9c987e62ffe2fETmZjIetQze7","part":{"partID":"prt_1636974db002dDjtxhIrb1zxm4","sessionID":"ses_e9c987e62ffe2fETmZjIetQze7","messageID":"msg_163695d44001uV1l1l35DJMWp2","type":"tool","id":"call_00_yLiBOu4oKtVMXJPB3MrH0699","tool":"shell","state":{"status":"completed","input":{"command":"cd /home/baptistefaisy/aiven-kafka-demo && sed -n '1,70p' tools/pg-diag"},"output":"#!/usr/bin/env python3\n\"\"\"tools/pg-diag — diagnostic PostgreSQL en LECTURE SEULE, sans secret.\n\nSert aux agents (db-diagnose) quand ils doivent aller voir la base reelle\npour conclure, sans qu'un mot de passe apparaisse ni dans la commande ni\ndans le rapport (le rapport est republie dans Kafka, puis dans un depot\npublic).\n\nUsage :\n  ./tools/pg-diag \"SELECT state, count(*) FROM pg_stat_activity GROUP BY 1\"\n  ./tools/pg-diag --db-url <url> \"<requete>\"\n\nSecurite :\n  - la session est ouverte en `default_transaction_read_only = on` :\n    PostgreSQL refuse toute ecriture, meme si la requete est malveillante ;\n  - seules les requetes de lecture sont acceptees (SELECT / SHOW / EXPLAIN /\n    WITH / VALUES / TABLE) ;\n  - le mot de passe vient de `.secrets/creds.env` et n'est jamais affiche.\n\nCodes de sortie : 0 ok / 1 usage / 2 configuration manquante / 3 requete refusee.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport os\nimport re\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nHERE = Path(__file__).resolve().parent\nsys.path.insert(0, str(HERE))\n\nimport kafkalib  # noqa: E402\nfrom emit_sql_error import build_pg_env  # noqa: E402\n\nEXIT_OK = kafkalib.EXIT_OK\nEXIT_USAGE = kafkalib.EXIT_USAGE\nEXIT_CONFIG = kafkalib.EXIT_CONFIG\nEXIT_REFUSED = 3\n\nREAD_ONLY_RE = re.compile(\n    r\"^\\s*(SELECT|SHOW|EXPLAIN|WITH|VALUES|TABLE)\\b\", re.IGNORECASE)\n\nFORBIDDEN = re.compile(\n    r\"\\b(INSERT|UPDATE|DELETE|DROP|CREATE|ALTER|TRUNCATE|GRANT|REVOKE|\"\n    r\"COPY|CALL|DO|SET|VACUUM|REINDEX|CLUSTER|LOCK|REFRESH)\\b\",\n    re.IGNORECASE)\n\n\ndef main(argv=None):\n    parser = argparse.ArgumentParser(\n        prog=\"pg-diag\",\n        description=\"execute une requete SQL en lecture seule (aucun secret expose)\")\n    parser.add_argument(\"sql\", help=\"requete SQL de lecture\")\n    parser.add_argument(\"--db-url\", help=\"URL PostgreSQL (defaut : service Aiven 'historique')\")\n    parser.add_argument(\"--timeout\", type=int, default=30, help=\"timeout en secondes\")\n    args = parser.parse_args(argv)\n\n    if not args.sql.strip():\n        parser.print_usage(sys.stderr)\n        print(\"ERREUR : une requete SQL est obligatoire\", file=sys.stderr)\n        return EXIT_USAGE\n    if not READ_ONLY_RE.match(args.sql) or FORBIDDEN.search(args.sql):\n        print(\"ERREUR : seules les requetes de lecture sont acceptees \"\n              \"(SELECT / SHOW / EXPLAIN / WITH / VALUES)\", file=sys.stderr)\n        return EXIT_REFUSED\n\n    try:\n        pg_env = build_pg_env(args.db_url)\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"#!/usr/bin/env python3\n\"\"\"tools/pg-diag — diagnostic PostgreSQL en LECTURE SEULE, sans secret.\n\nSert aux agents (db-diagnose) quand ils doivent aller voir la base reelle\npour conclure, sans qu'un mot de passe apparaisse ni dans la commande ni\ndans le rapport (le rapport est republie dans Kafka, puis dans un depot\npublic).\n\nUsage :\n  ./tools/pg-diag \"SELECT state, count(*) FROM pg_stat_activity GROUP BY 1\"\n  ./tools/pg-diag --db-url <url> \"<requete>\"\n\nSecurite :\n  - la session est ouverte en `default_transaction_read_only = on` :\n    PostgreSQL refuse toute ecriture, meme si la requete est malveillante ;\n  - seules les requetes de lecture sont acceptees (SELECT / SHOW / EXPLAIN /\n    WITH / VALUES / TABLE) ;\n  - le mot de passe vient de `.secrets/creds.env` et n'est jamais affiche.\n\nCodes de sortie : 0 ok / 1 usage / 2 configuration manquante / 3 requete refusee.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport os\nimport re\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nHERE = Path(__file__).resolve().parent\nsys.path.insert(0, str(HERE))\n\nimport kafkalib  # noqa: E402\nfrom emit_sql_error import build_pg_env  # noqa: E402\n\nEXIT_OK = kafkalib.EXIT_OK\nEXIT_USAGE = kafkalib.EXIT_USAGE\nEXIT_CONFIG = kafkalib.EXIT_CONFIG\nEXIT_REFUSED = 3\n\nREAD_ONLY_RE = re.compile(\n    r\"^\\s*(SELECT|SHOW|EXPLAIN|WITH|VALUES|TABLE)\\b\", re.IGNORECASE)\n\nFORBIDDEN = re.compile(\n    r\"\\b(INSERT|UPDATE|DELETE|DROP|CREATE|ALTER|TRUNCATE|GRANT|REVOKE|\"\n    r\"COPY|CALL|DO|SET|VACUUM|REINDEX|CLUSTER|LOCK|REFRESH)\\b\",\n    re.IGNORECASE)\n\n\ndef main(argv=None):\n    parser = argparse.ArgumentParser(\n        prog=\"pg-diag\",\n        description=\"execute une requete SQL en lecture seule (aucun secret expose)\")\n    parser.add_argument(\"sql\", help=\"requete SQL de lecture\")\n    parser.add_argument(\"--db-url\", help=\"URL PostgreSQL (defaut : service Aiven 'historique')\")\n    parser.add_argument(\"--timeout\", type=int, default=30, help=\"timeout en secondes\")\n    args = parser.parse_args(argv)\n\n    if not args.sql.strip():\n        parser.print_usage(sys.stderr)\n        print(\"ERREUR : une requete SQL est obligatoire\", file=sys.stderr)\n        return EXIT_USAGE\n    if not READ_ONLY_RE.match(args.sql) or FORBIDDEN.search(args.sql):\n        print(\"ERREUR : seules les requetes de lecture sont acceptees \"\n              \"(SELECT / SHOW / EXPLAIN / WITH / VALUES)\", file=sys.stderr)\n        return EXIT_REFUSED\n\n    try:\n        pg_env = build_pg_env(args.db_url)\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /home/baptistefaisy/aiven-kafka-demo && sed -n '1,70p' tools/pg-diag\"}"},"time":{"start":1792669218011,"end":1792669218055}}}}
