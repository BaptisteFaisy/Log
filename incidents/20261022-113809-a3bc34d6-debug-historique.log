{\\\"db.connection_pool.active\\\": \\\"0\\\",\\n333:                \\\"db.connection_pool.idle\\\": \\\"0\\\",\\n334:                \\\"db.connection_pool.max\\\": \\\"0\\\"}\\n336:           \\\"       (SELECT count(*) FROM pg_stat_activity WHERE state = 'idle'),\\\"\\n345:            counters[\\\"db.connection_pool.active\\\"] = parts[0].strip()\\n346:            counters[\\\"db.connection_pool.idle\\\"] = parts[1].strip()\\n347:            counters[\\\"db.connection_pool.max\\\"] = parts[2].strip()\\n414:        \\\"db.connection_pool.name\\\": \\\"historique-app\\\",\\n438:            \\\"name\\\": \\\"db.client.connection.pool.active\\\", \\\"unit\\\": \\\"{connection}\\\",\\n439:            \\\"offset_ms\\\": 30, \\\"value\\\": int(counters.get(\\\"db.connection_pool.active\\\", 0) or 0),\\n\"}],\"providerCall\":{\"executed\":false},\"providerResult\":{\"executed\":false},\"rawInput\":\"{\\\"command\\\": \\\"cd /home/baptistefaisy/aiven-kafka-demo && grep -n \\\\\\\"connection_pool\\\\\\\\|active\\\\\\\\|idle\\\\\\\\|max\\\\\\\\b\\\\\\\" tools/emit_sql_error.py | head -20\\\"}\"},\"time\":{\"start\":1792665010642,\"end\":1792665010976}}}}\n{\"type\":\"tool_use\",\"timestamp\":1792665011014,\"sessionID\":\"ses_e9ce51effffe4mN3wYE3w3Fzub\",\"part\":{\"partID\":\"prt_1632941d8001ugnHczOTdjfiQJ\",\"sessionID\":\"ses_e9ce51effffe4mN3wYE3w3Fzub\",\"messageID\":\"msg_163292a830016wcCVCEjcUAajO\",\"type\":\"tool\",\"id\":\"call_01_h30ssbq1mlYCVEAVF3OG1151\",\"tool\":\"shell\",\"state\":{\"status\":\"completed\",\"input\":{\"command\":\"cd /home/baptistefaisy/hackathon-memory && echo \\\"=== index declares ===\\\"; grep -in \\\"create index\\\\|index \\\" scripts/historique_schema.sql | head -20; echo \\\"=== noms de tables/fonctions ===\\\"; grep -in \\\"create table\\\\|create or replace function\\\" scripts/historique_schema.sql | head -20\"},\"output\":\"=== index declares ===\\n59:-- 2 index : trigram sur le nom (reformulation) + tri du listing\\n60:CREATE INDE