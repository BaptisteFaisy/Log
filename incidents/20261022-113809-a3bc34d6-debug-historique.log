status\":\"completed\",\"truncated\":false,\"exit\":0},\"content\":[{\"type\":\"text\",\"text\":\"      app       |   st   | n |   duree_etat    \\n----------------+--------+---+-----------------\\n emit_sql_error | active | 2 | 00:00:00.000524\\n(1 row)\\n\\n\"}],\"providerCall\":{\"executed\":false},\"providerResult\":{\"executed\":false},\"rawInput\":\"{\\\"command\\\": \\\"cd /home/baptistefaisy/aiven-kafka-demo && ./tools/pg-diag \\\\\\\"select coalesce(application_name,'-') app, coalesce(state,'-') st, count(*) n, max(now()-state_change) as duree_etat from pg_stat_activity where datname=current_database() group by 1,2 order by 3 desc\\\\\\\" 2>&1 | head -20\\\", \\\"timeout\\\": 180000}\"},\"time\":{\"start\":1792665016255,\"end\":1792665019685}}}}\n{\"type\":\"tool_use\",\"timestamp\":1792665019688,\"sessionID\":\"ses_e9ce51effffe4mN3wYE3w3Fzub\",\"part\":{\"partID\":\"prt_163295799001aPp31oPUFsXLWE\",\"sessionID\":\"ses_e9ce51effffe4mN3wYE3w3Fzub\",\"messageID\":\"msg_1632943540016Yrf0n8Ilbpmnk\",\"type\":\"tool\",\"id\":\"call_00_Ry1oTmrhzT3VD3dUBKga8931\",\"tool\":\"shell\",\"state\":{\"status\":\"completed\",\"input\":{\"command\":\"cd /home/baptistefaisy/aiven-kafka-demo && ./tools/pg-diag \\\"select (select count(*) from pg_stat_activity) as total, (select count(*) from pg_stat_activity where state='active') as active, (select count(*) from pg_stat_activity where state='idle') as idle, (select count(*) from pg_stat_activity where state like 'idle in transaction%') as idle_in_tx, current_setting('max_connections') as maxconn\\\" 2>&1 | head -10\",\"timeout\":180000},\"output\":\" total | active | idle | idle_in_tx | maxconn \\n-------+--------+------+------------+---------\\n    15 |      1 |    1 |          0 | 25\\n(1 row)\\n\\n\",\"title\":\"shell\",\"metadata\":{\"metadata\":{\"status\":\"completed\",\"truncated\":false,\"exit\":0},\"content\":[{\"type\":\"text\",\"text\":\" total | active | idle | idle_in_tx | maxconn \\n-------+--------+------+----