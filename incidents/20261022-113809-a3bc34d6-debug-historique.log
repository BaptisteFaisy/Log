{"type":"tool_use","timestamp":1792669194679,"sessionID":"ses_e9c987e62ffe2fETmZjIetQze7","part":{"partID":"prt_163691970001OEO9PjwmRP3FAI","sessionID":"ses_e9c987e62ffe2fETmZjIetQze7","messageID":"msg_163690461001xCeTYW9OCQYJli","type":"tool","id":"call_01_sJZeCWe3PfgDyjuw84gg3304","tool":"shell","state":{"status":"completed","input":{"command":"cd /home/baptistefaisy/aiven-kafka-demo && sed -n '1,80p' tools/generator_switch.py 2>&1"},"output":"\"\"\"tools/generator_switch.py — l'interrupteur commun des generateurs d'erreurs.\n\nUn seul etat, partage par TOUS les producteurs d'erreurs (seed,\nemit_incident.py, emit_sql_error.py, emit_db_errors.py, db_fault_probe.py) et\npar le watcher :\n\n    ~/.local/state/aiven-kafka-demo/generators.json\n    {\"enabled\": false, \"at\": 1792660000.0, \"by\": \"kafka-incident-watch\",\n     \"reason\": \"incident 03ee1959 error.type=db_pool_exhausted\"}\n\n- le watcher le COUPE des qu'une erreur arrive dans Kafka ;\n- `./tools/generator on` le RALLUME (aucun generateur n'est supprime) ;\n- fichier absent ou illisible = generateurs COUPES : ils sont coupes par\n  defaut, il faut `./tools/generator on` (ou `run`) pour publier.\n\nUn generateur appelle `require_enabled(\"<nom>\")` AVANT de publier : s'ils sont\ncoupes, il explique pourquoi et comment les relancer, puis sort en code 7\n(EXIT_DISABLED). Les modes hors publication (--list, --dry-run, --self-check...)\nn'ont pas a l'appeler.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\nimport sys\nimport time\nfrom datetime import datetime\nfrom pathlib import Path\nfrom typing import Any, Dict\n\nSTATE_FILE = Path(os.environ.get(\n    \"GENERATORS_STATE_FILE\",\n    str(Path.home() / \".local\" / \"state\" / \"aiven-kafka-demo\" / \"generators.json\")))\n\n# 0 ok / 1 usage / 2 config / 3 Kafka / 4 deja lance : 7 = generateurs coupes\nEXIT_DISABLED = 7\n\n# etat sans fichier (ou fichier illisible) : COUPES par defaut, a la demande\n# de Baptiste. On ne publie une erreur qu'apres un `./tools/generator on`.\nDEFAULT_STATE: Dict[str, Any] = {\"enabled\": False, \"by\": \"defaut\",\n                                 \"reason\": \"aucun etat enregistre\"}\n\n\ndef status() -> Dict[str, Any]:\n    \"\"\"Etat courant : {\"enabled\": bool, \"at\": float, \"by\": str, \"reason\": str}.\"\"\"\n    try:\n        data = json.loads(STATE_FILE.read_text(encoding=\"utf-8\"))\n    except (OSError, ValueError):\n        return dict(DEFAULT_STATE)\n    if not isinstance(data, dict):\n        return dict(DEFAULT_STATE)\n    data[\"enabled\"] = bool(data.get(\"enabled\", False))\n    return data\n\n\ndef is_enabled() -> bool:\n    return status()[\"enabled\"]\n\n\ndef set_enabled(enabled: bool, by: str, reason: str = \"\") -> Dict[str, Any]:\n    \"\"\"Ecrit l'etat (ecriture atomique : fichier temporaire puis rename).\"\"\"\n    data = {\"enabled\": bool(enabled), \"at\": time.time(), \"by\": by, \"reason\": reason}\n    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)\n    tmp = STATE_FILE.with_name(f\"{STATE_FILE.name}.{os.getpid()}.tmp\")\n    tmp.write_text(json.dumps(data, ensure_ascii=False), encoding=\"utf-8\")\n    tmp.replace(STATE_FILE)\n    return data\n\n\ndef disable(by: str, reason: str = \"\") -> bool:\n    \"\"\"Coupe les generateurs. Retourne True si l'etat a change.\"\"\"\n    if not is_enabled():\n        return False\n    set_enabled(False, by, reason)\n    return True\n\n\ndef enable(by: str = \"manuel\", reason: str = \"\") -> bool:\n    \"\"\"Rallume les generateurs. Retourne True si l'etat a change.\"\"\"\n    if is_enabled():\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"\"\"\"tools/generator_switch.py — l'interrupteur commun des generateurs d'erreurs.\n\nUn seul etat, partage par TOUS les producteurs d'erreurs (seed,\nemit_incident.py, emit_sql_error.py, emit_db_errors.py, db_fault_probe.py) et\npar le watcher :\n\n    ~/.local/state/aiven-kafka-demo/generators.json\n    {\"enabled\": false, \"at\": 1792660000.0, \"by\": \"kafka-incident-watch\",\n     \"reason\": \"incident 03ee1959 error.type=db_pool_exhausted\"}\n\n- le watcher le COUPE des qu'une erreur arrive dans Kafka ;\n- `./tools/generator on` le RALLUME (aucun generateur n'est supprime) ;\n- fichier absent ou illisible = generateurs COUPES : ils sont coupes par\n  defaut, il faut `./tools/generator on` (ou `run`) pour publier.\n\nUn generateur appelle `require_enabled(\"<nom>\")` AVANT de publier : s'ils sont\ncoupes, il explique pourquoi et comment les relancer, puis sort en code 7\n(EXIT_DISABLED). Les modes hors publication (--list, --dry-run, --self-check...)\nn'ont pas a l'appeler.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\nimport sys\nimport time\nfrom datetime import datetime\nfrom pathlib import Path\nfrom typing import Any, Dict\n\nSTATE_FILE = Path(os.environ.get(\n    \"GENERATORS_STATE_FILE\",\n    str(Path.home() / \".local\" / \"state\" / \"aiven-kafka-demo\" / \"generators.json\")))\n\n# 0 ok / 1 usage / 2 config / 3 Kafka / 4 deja lance : 7 = generateurs coupes\nEXIT_DISABLED = 7\n\n# etat sans fichier (ou fichier illisible) : COUPES par defaut, a la demande\n# de Baptiste. On ne publie une erreur qu'apres un `./tools/generator on`.\nDEFAULT_STATE: Dict[str, Any] = {\"enabled\": False, \"by\": \"defaut\",\n                                 \"reason\": \"aucun etat enregistre\"}\n\n\ndef status() -> Dict[str, Any]:\n    \"\"\"Etat courant : {\"enabled\": bool, \"at\": float, \"by\": str, \"reason\": str}.\"\"\"\n    try:\n        data = json.loads(STATE_FILE.read_text(encoding=\"utf-8\"))\n    except (OSError, ValueError):\n        return dict(DEFAULT_STATE)\n    if not isinstance(data, dict):\n        return dict(DEFAULT_STATE)\n    data[\"enabled\"] = bool(data.get(\"enabled\", False))\n    return data\n\n\ndef is_enabled() -> bool:\n    return status()[\"enabled\"]\n\n\ndef set_enabled(enabled: bool, by: str, reason: str = \"\") -> Dict[str, Any]:\n    \"\"\"Ecrit l'etat (ecriture atomique : fichier temporaire puis rename).\"\"\"\n    data = {\"enabled\": bool(enabled), \"at\": time.time(), \"by\": by, \"reason\": reason}\n    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)\n    tmp = STATE_FILE.with_name(f\"{STATE_FILE.name}.{os.getpid()}.tmp\")\n    tmp.write_text(json.dumps(data, ensure_ascii=False), encoding=\"utf-8\")\n    tmp.replace(STATE_FILE)\n    return data\n\n\ndef disable(by: str, reason: str = \"\") -> bool:\n    \"\"\"Coupe les generateurs. Retourne True si l'etat a change.\"\"\"\n    if not is_enabled():\n        return False\n    set_enabled(False, by, reason)\n    return True\n\n\ndef enable(by: str = \"manuel\", reason: str = \"\") -> bool:\n    \"\"\"Rallume les generateurs. Retourne True si l'etat a change.\"\"\"\n    if is_enabled():\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /home/baptistefaisy/aiven-kafka-demo && sed -n '1,80p' tools/generator_switch.py 2>&1\"}"},"time":{"start":1792669194608,"end":1792669194679}}}}
