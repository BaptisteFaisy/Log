{"type":"tool_use","timestamp":1792669189175,"sessionID":"ses_e9c987e62ffe2fETmZjIetQze7","part":{"partID":"prt_1636904070025hw34UjtPhUlcR","sessionID":"ses_e9c987e62ffe2fETmZjIetQze7","messageID":"msg_16368e3bf001o9HlLWzhFZOQVi","type":"tool","id":"call_00_oXVelpVFluZT6rKuyWBL2769","tool":"read","state":{"status":"completed","input":{"path":"/home/baptistefaisy/hackathon-memory/app.py"},"output":"Read file /home/baptistefaisy/hackathon-memory/app.py, lines 1-208\n1: \"\"\"Product : un assistant qui retient.\n2: \n3: POST /chat  -> repond en s'appuyant sur les souvenirs (PostgreSQL) et le court terme (Valkey).\n4: \"\"\"\n5: \n6: import json\n7: import os\n8: \n9: from fastapi import FastAPI\n10: from fastapi.responses import FileResponse\n11: from fastapi.staticfiles import StaticFiles\n12: from pydantic import BaseModel\n13: \n14: import llm\n15: import schema\n16: from schema import USER_ID\n17: \n18: app = FastAPI(title=\"Memoire - assistant qui retient\")\n19: STATIC = os.path.join(os.path.dirname(__file__), \"static\")\n20: \n21: HAS_VECTOR = False\n22: \n23: \n24: @app.on_event(\"startup\")\n25: def startup() -> None:\n26:     global HAS_VECTOR\n27:     # probe_embeddings : dit si l'API embeddings repond (et avec quelle dim).\n28:     # apply_schema : prepare les colonnes vecteur (pgvector), quel que soit l'embeur.\n29:     api_ok, dim = llm.probe_embeddings()\n30:     HAS_VECTOR = schema.apply_schema(dim)\n31:     llm.USE_VECTORS = api_ok\n32:     print(f\"[startup] pgvector={'oui' if HAS_VECTOR else 'non'} dim={llm.EMBED_DIM} \"\n33:           f\"api_embeddings={'oui' if api_ok else 'non (embedder hash)'}\")\n34:     print(\"[startup] DATABASE_URL:\", \"configuree\" if schema.DATABASE_URL else \"ABSENTE\")\n35:     print(\"[startup] VALKEY_URL:\", \"configuree\" if schema.VALKEY_URL else \"ABSENTE\")\n36: \n37: \n38: class ChatIn(BaseModel):\n39:     user_id: str = USER_ID\n40:     message: str\n41: \n42: \n43: class SessionIn(BaseModel):\n44:     user_id: str = USER_ID\n45: \n46: \n47: MEMORY_SYSTEM = \"\"\"Tu es un extracteur de memoires durables. Tu reponds UNIQUEMENT par un JSON, sans texte autour.\n48: \n49: Schema :\n50: {\"memories\":[{\"kind\":\"fact|preference|commitment|event\",\"content\":\"...\",\"importance\":0.0-1.0,\"ttl_days\":null|int}]}\n51: \n52: Regles :\n53: - Ne garde que ce qui reste vrai et utile dans plusieurs jours (identite, habitudes, projets, rendez-vous, preferences).\n54: - Ignore : salutations, small talk, questions, opinions passageres, demandes ponctuelles.\n55: - kind=commitment pour une promesse/une tache a faire (avec ttl_days si echeance connue).\n56: - importance entre 0 et 1 (0.9 pour une information critique ou une echeance, 0.2 pour un detail).\n57: - Si rien n'est a retenir, renvoie exactement {\"memories\":[]}.\"\"\"\n58: \n59: \n60: def extract_memories(user_id: str, message: str) -> list[dict]:\n61:     try:\n62:         raw = llm.chat_json(\n63:             [\n64:                 {\"role\": \"system\", \"content\": MEMORY_SYSTEM},\n65:                 {\"role\": \"user\", \"content\": message},\n66:             ],\n67:             timeout=15.0,\n68:         )\n69:     except Exception as exc:\n70:         print(f\"[memory] extraction KO: {exc}\")\n71:         return []\n72:     items = raw.get(\"memories\") or []\n73:     out = []\n74:     for item in items:\n75:         if not isinstance(item, dict):\n76:             continue\n77:         content = str(item.get(\"content\", \"\")).strip()\n78:         kind = str(item.get(\"kind\", \"fact\")).strip().lower()\n79:         if kind not in {\"fact\", \"preference\", \"commitment\", \"event\"}:\n80:             kind = \"fact\"\n81:         if not content:\n82:             continue\n83:         try:\n84:             importance = max(0.0, min(1.0, float(item.get(\"importance\", 0.5))))\n85:         except (TypeError, ValueError):\n86:             importance = 0.5\n87:         ttl = item.get(\"ttl_days\")\n88:         try:\n89:             ttl = int(ttl) if ttl is not None else None\n90:         except (TypeError, ValueError):\n91:             ttl = None\n92:         out.append({\"kind\": kind, \"content\": content, \"importance\": importance, \"ttl_days\": ttl})\n93:     return out\n94: \n95: \n96: def build_answer(memories: list[dict], question: str) -> str:\n97:     if not memories:\n98:         return \"Je n'ai encore rien retien sur toi.\"\n99:     lines = [f\"- ({m['kind']}) {m['content']}\" for m in memories]\n100:     return \"D'apres ma memoire :\\n\" + \"\\n\".join(lines)\n101: \n102: \n103: @app.get(\"/\")\n104: def index():\n105:     return FileResponse(os.path.join(STATIC, \"index.html\"))\n106: \n107: \n108: @app.get(\"/healthz\")\n109: def healthz():\n110:     return {\n111:         \"ok\": True,\n112:         \"pgvector\": HAS_VECTOR,\n113:         \"embed_dim\": llm.EMBED_DIM,\n114:         \"database\": bool(schema.DATABASE_URL),\n115:         \"valkey\": bool(schema.VALKEY_URL),\n116:     }\n117: \n118: \n119: @app.post(\"/chat\")\n120: def chat_endpoint(body: ChatIn):\n121:     user_id = body.user_id or USER_ID\n122:     message = (body.message or \"\").strip()\n123:     if not message:\n124:         return {\"error\": \"message vide\"}\n125: \n126:     query_emb = llm.embed([message])[0]\n127:     memories = schema.recall(user_id, message, query_emb, has_vector=HAS_VECTOR)\n128:     turns = schema.wm_get(user_id)\n129: \n130:     mem_block = \"\\n\".join(f\"- ({m['kind']}) {m['content']}\" for m in memories) or \"- (aucun souvenir pertinent)\"\n131:     recent_block = \"\\n\".join(f\"{t['role']}: {t['content']}\" for t in turns) or \"- (aucune conversation en cours)\"\n132: \n133:     system = (\n134:         \"Tu es un assistant personnel qui a une memoire durable. \"\n135:         \"Reponds en francais, de facon concrete et courte.\\n\"\n136:         \"<souvenirs>\\n\" + mem_block + \"\\n</souvenirs>\\n\"\n137:         \"<conversation_courante>\\n\" + recent_block + \"\\n</conversation_courante>\\n\"\n138:         \"Regles : utilise uniquement les souvenirs pertinents pour la question. \"\n139:         \"Si un souvenir est utilise, commence ta reponse par 'D'apres ma memoire :'. \"\n140:         \"Si tu ne sais pas, dis-le, n'invente rien.\"\n141:     )\n142: \n143:     messages = [{\"role\": \"system\", \"content\": system}]\n144:     messages += [{\"role\": t[\"role\"], \"content\": t[\"content\"]} for t in turns]\n145:     messages.append({\"role\": \"user\", \"content\": message})\n146: \n147:     answer = \"\"\n148:     degraded = False\n149:     try:\n150:         answer = llm.chat(messages, timeout=30.0)\n151:     except Exception as exc:\n152:         print(f\"[llm] chat KO: {exc}\")\n153:         degraded = True\n154:         answer = build_answer(memories, message)\n155: \n156:     created = []\n157:     try:\n158:         for item in extract_memories(user_id, message):\n159:             result = schema.remember(\n160:                 user_id,\n161:                 item[\"kind\"],\n162:                 item[\"content\"],\n163:                 item[\"importance\"],\n164:                 embedding=llm.embed([item[\"content\"]])[0],\n165:                 ttl_days=item[\"ttl_days\"],\n166:                 has_vector=HAS_VECTOR,\n167:             )\n168:             created.append({\"action\": result[\"status\"], **item})\n169:     except Exception as exc:\n170:         print(f\"[memory] ecriture KO: {exc}\")\n171: \n172:     schema.add_message(user_id, \"user\", message)\n173:     schema.add_message(user_id, \"assistant\", answer)\n174:     schema.wm_push(user_id, \"user\", message)\n175:     schema.wm_push(user_id, \"assistant\", answer)\n176: \n177:     return {\n178:         \"answer\": answer,\n179:         \"degraded\": degraded,\n180:         \"used_memories\": [\n181:             {\"id\": str(m[\"id\"]), \"kind\": m[\"kind\"], \"content\": m[\"content\"], \"score\": m[\"score\"]}\n182:             for m in memories\n183:         ],\n184:         \"created_memories\": created,\n185:         \"working_memory\": schema.wm_stats(user_id),\n186:     }\n187: \n188: \n189: @app.get(\"/memories\")\n190: def memories(user_id: str = USER_ID):\n191:     return {\n192:         \"memories\": schema.list_memories(user_id),\n193:         \"working_memory\": schema.wm_stats(user_id),\n194:     }\n195: \n196: \n197: @app.post(\"/session/reset\")\n198: def session_reset(body: SessionIn):\n199:     schema.wm_reset(body.user_id or USER_ID)\n200:     return {\"ok\": True, \"note\": \"memoire de travail effacee, memoire durable conservee\"}\n201: \n202: \n203: @app.post(\"/seed\")\n204: def seed(user_id: str = USER_ID):\n205:     import seed as seed_mod\n206: \n207:     count = seed_mod.seed_demo_user(user_id)\n208:     return {\"ok\": True, \"memories\": count}","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /home/baptistefaisy/hackathon-memory/app.py, lines 1-208\n1: \"\"\"Product : un assistant qui retient.\n2: \n3: POST /chat  -> repond en s'appuyant sur les souvenirs (PostgreSQL) et le court terme (Valkey).\n4: \"\"\"\n5: \n6: import json\n7: import os\n8: \n9: from fastapi import FastAPI\n10: from fastapi.responses import FileResponse\n11: from fastapi.staticfiles import StaticFiles\n12: from pydantic import BaseModel\n13: \n14: import llm\n15: import schema\n16: from schema import USER_ID\n17: \n18: app = FastAPI(title=\"Memoire - assistant qui retient\")\n19: STATIC = os.path.join(os.path.dirname(__file__), \"static\")\n20: \n21: HAS_VECTOR = False\n22: \n23: \n24: @app.on_event(\"startup\")\n25: def startup() -> None:\n26:     global HAS_VECTOR\n27:     # probe_embeddings : dit si l'API embeddings repond (et avec quelle dim).\n28:     # apply_schema : prepare les colonnes vecteur (pgvector), quel que soit l'embeur.\n29:     api_ok, dim = llm.probe_embeddings()\n30:     HAS_VECTOR = schema.apply_schema(dim)\n31:     llm.USE_VECTORS = api_ok\n32:     print(f\"[startup] pgvector={'oui' if HAS_VECTOR else 'non'} dim={llm.EMBED_DIM} \"\n33:           f\"api_embeddings={'oui' if api_ok else 'non (embedder hash)'}\")\n34:     print(\"[startup] DATABASE_URL:\", \"configuree\" if schema.DATABASE_URL else \"ABSENTE\")\n35:     print(\"[startup] VALKEY_URL:\", \"configuree\" if schema.VALKEY_URL else \"ABSENTE\")\n36: \n37: \n38: class ChatIn(BaseModel):\n39:     user_id: str = USER_ID\n40:     message: str\n41: \n42: \n43: class SessionIn(BaseModel):\n44:     user_id: str = USER_ID\n45: \n46: \n47: MEMORY_SYSTEM = \"\"\"Tu es un extracteur de memoires durables. Tu reponds UNIQUEMENT par un JSON, sans texte autour.\n48: \n49: Schema :\n50: {\"memories\":[{\"kind\":\"fact|preference|commitment|event\",\"content\":\"...\",\"importance\":0.0-1.0,\"ttl_days\":null|int}]}\n51: \n52: Regles :\n53: - Ne garde que ce qui reste vrai et utile dans plusieurs jours (identite, habitudes, projets, rendez-vous, preferences).\n54: - Ignore : salutations, small talk, questions, opinions passageres, demandes ponctuelles.\n55: - kind=commitment pour une promesse/une tache a faire (avec ttl_days si echeance connue).\n56: - importance entre 0 et 1 (0.9 pour une information critique ou une echeance, 0.2 pour un detail).\n57: - Si rien n'est a retenir, renvoie exactement {\"memories\":[]}.\"\"\"\n58: \n59: \n60: def extract_memories(user_id: str, message: str) -> list[dict]:\n61:     try:\n62:         raw = llm.chat_json(\n63:             [\n64:                 {\"role\": \"system\", \"content\": MEMORY_SYSTEM},\n65:                 {\"role\": \"user\", \"content\": message},\n66:             ],\n67:             timeout=15.0,\n68:         )\n69:     except Exception as exc:\n70:         print(f\"[memory] extraction KO: {exc}\")\n71:         return []\n72:     items = raw.get(\"memories\") or []\n73:     out = []\n74:     for item in items:\n75:         if not isinstance(item, dict):\n76:             continue\n77:         content = str(item.get(\"content\", \"\")).strip()\n78:         kind = str(item.get(\"kind\", \"fact\")).strip().lower()\n79:         if kind not in {\"fact\", \"preference\", \"commitment\", \"event\"}:\n80:             kind = \"fact\"\n81:         if not content:\n82:             continue\n83:         try:\n84:             importance = max(0.0, min(1.0, float(item.get(\"importance\", 0.5))))\n85:         except (TypeError, ValueError):\n86:             importance = 0.5\n87:         ttl = item.get(\"ttl_days\")\n88:         try:\n89:             ttl = int(ttl) if ttl is not None else None\n90:         except (TypeError, ValueError):\n91:             ttl = None\n92:         out.append({\"kind\": kind, \"content\": content, \"importance\": importance, \"ttl_days\": ttl})\n93:     return out\n94: \n95: \n96: def build_answer(memories: list[dict], question: str) -> str:\n97:     if not memories:\n98:         return \"Je n'ai encore rien retien sur toi.\"\n99:     lines = [f\"- ({m['kind']}) {m['content']}\" for m in memories]\n100:     return \"D'apres ma memoire :\\n\" + \"\\n\".join(lines)\n101: \n102: \n103: @app.get(\"/\")\n104: def index():\n105:     return FileResponse(os.path.join(STATIC, \"index.html\"))\n106: \n107: \n108: @app.get(\"/healthz\")\n109: def healthz():\n110:     return {\n111:         \"ok\": True,\n112:         \"pgvector\": HAS_VECTOR,\n113:         \"embed_dim\": llm.EMBED_DIM,\n114:         \"database\": bool(schema.DATABASE_URL),\n115:         \"valkey\": bool(schema.VALKEY_URL),\n116:     }\n117: \n118: \n119: @app.post(\"/chat\")\n120: def chat_endpoint(body: ChatIn):\n121:     user_id = body.user_id or USER_ID\n122:     message = (body.message or \"\").strip()\n123:     if not message:\n124:         return {\"error\": \"message vide\"}\n125: \n126:     query_emb = llm.embed([message])[0]\n127:     memories = schema.recall(user_id, message, query_emb, has_vector=HAS_VECTOR)\n128:     turns = schema.wm_get(user_id)\n129: \n130:     mem_block = \"\\n\".join(f\"- ({m['kind']}) {m['content']}\" for m in memories) or \"- (aucun souvenir pertinent)\"\n131:     recent_block = \"\\n\".join(f\"{t['role']}: {t['content']}\" for t in turns) or \"- (aucune conversation en cours)\"\n132: \n133:     system = (\n134:         \"Tu es un assistant personnel qui a une memoire durable. \"\n135:         \"Reponds en francais, de facon concrete et courte.\\n\"\n136:         \"<souvenirs>\\n\" + mem_block + \"\\n</souvenirs>\\n\"\n137:         \"<conversation_courante>\\n\" + recent_block + \"\\n</conversation_courante>\\n\"\n138:         \"Regles : utilise uniquement les souvenirs pertinents pour la question. \"\n139:         \"Si un souvenir est utilise, commence ta reponse par 'D'apres ma memoire :'. \"\n140:         \"Si tu ne sais pas, dis-le, n'invente rien.\"\n141:     )\n142: \n143:     messages = [{\"role\": \"system\", \"content\": system}]\n144:     messages += [{\"role\": t[\"role\"], \"content\": t[\"content\"]} for t in turns]\n145:     messages.append({\"role\": \"user\", \"content\": message})\n146: \n147:     answer = \"\"\n148:     degraded = False\n149:     try:\n150:         answer = llm.chat(messages, timeout=30.0)\n151:     except Exception as exc:\n152:         print(f\"[llm] chat KO: {exc}\")\n153:         degraded = True\n154:         answer = build_answer(memories, message)\n155: \n156:     created = []\n157:     try:\n158:         for item in extract_memories(user_id, message):\n159:             result = schema.remember(\n160:                 user_id,\n161:                 item[\"kind\"],\n162:                 item[\"content\"],\n163:                 item[\"importance\"],\n164:                 embedding=llm.embed([item[\"content\"]])[0],\n165:                 ttl_days=item[\"ttl_days\"],\n166:                 has_vector=HAS_VECTOR,\n167:             )\n168:             created.append({\"action\": result[\"status\"], **item})\n169:     except Exception as exc:\n170:         print(f\"[memory] ecriture KO: {exc}\")\n171: \n172:     schema.add_message(user_id, \"user\", message)\n173:     schema.add_message(user_id, \"assistant\", answer)\n174:     schema.wm_push(user_id, \"user\", message)\n175:     schema.wm_push(user_id, \"assistant\", answer)\n176: \n177:     return {\n178:         \"answer\": answer,\n179:         \"degraded\": degraded,\n180:         \"used_memories\": [\n181:             {\"id\": str(m[\"id\"]), \"kind\": m[\"kind\"], \"content\": m[\"content\"], \"score\": m[\"score\"]}\n182:             for m in memories\n183:         ],\n184:         \"created_memories\": created,\n185:         \"working_memory\": schema.wm_stats(user_id),\n186:     }\n187: \n188: \n189: @app.get(\"/memories\")\n190: def memories(user_id: str = USER_ID):\n191:     return {\n192:         \"memories\": schema.list_memories(user_id),\n193:         \"working_memory\": schema.wm_stats(user_id),\n194:     }\n195: \n196: \n197: @app.post(\"/session/reset\")\n198: def session_reset(body: SessionIn):\n199:     schema.wm_reset(body.user_id or USER_ID)\n200:     return {\"ok\": True, \"note\": \"memoire de travail effacee, memoire durable conservee\"}\n201: \n202: \n203: @app.post(\"/seed\")\n204: def seed(user_id: str = USER_ID):\n205:     import seed as seed_mod\n206: \n207:     count = seed_mod.seed_demo_user(user_id)\n208:     return {\"ok\": True, \"memories\": count}"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/home/baptistefaisy/hackathon-memory/app.py\"}"},"time":{"start":1792669189128,"end":1792669189175}}}}
