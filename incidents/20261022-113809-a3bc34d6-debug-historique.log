{"type":"tool_use","timestamp":1792670160257,"sessionID":"ses_e9c987e62ffe2fETmZjIetQze7","part":{"partID":"prt_16377d17c001SxKtcwkjPUX9eL","sessionID":"ses_e9c987e62ffe2fETmZjIetQze7","messageID":"msg_163775447001n6R6T5fnfrB1Kd","type":"tool","id":"call_00_sRiOvlI7cyzfo8MSwymV1243","tool":"write","state":{"status":"completed","input":{"content":"\"\"\"Lecture seule : attributs de ressource des messages d'une trace (service.name...).\"\"\"\nimport json\nimport sys\nimport uuid\n\nsys.path.insert(0, \"/home/baptistefaisy/aiven-kafka-demo/tools\")\nimport kafkalib  # noqa: E402\n\nTRACE = \"a3bc34d64f0745976b3907d1df09a2c6\"\nck = kafkalib.import_kafka()\nfrom confluent_kafka import OFFSET_BEGINNING, TopicPartition  # noqa: E402\n\nfor attempt in range(4):\n    consumer = ck.Consumer(kafkalib.kafka_config({\n        \"group.id\": f\"scan-{uuid.uuid4().hex[:8]}\",\n        \"enable.auto.commit\": \"false\",\n    }))\n    topics = [kafkalib.topic(s) for s in (\"traces\", \"logs\", \"metrics\")]\n    try:\n        meta = consumer.list_topics(timeout=20)\n    except Exception as exc:  # noqa: BLE001\n        print(\"metadonnees indisponibles:\", exc)\n        consumer.close()\n        continue\n    parts = []\n    for t in topics:\n        tm = meta.topics.get(t)\n        if not tm:\n            continue\n        parts += [TopicPartition(t, pid, OFFSET_BEGINNING) for pid in tm.partitions]\n    consumer.assign(parts)\n    seen = 0\n    idle = 0\n    while idle < 8:\n        msg = consumer.poll(1.0)\n        if msg is None:\n            idle += 1\n            continue\n        if msg.error():\n            continue\n        idle = 0\n        try:\n            p = json.loads(msg.value().decode())\n        except Exception:\n            continue\n        if p.get(\"TraceId\") != TRACE:\n            continue\n        seen += 1\n        if seen <= 2:\n            print(msg.topic(), json.dumps(p.get(\"ResourceAttributes\"), ensure_ascii=False),\n                  \"| service:\", p.get(\"ServiceName\"))\n    consumer.close()\n    print(\"messages de la trace:\", seen)\n    if seen:\n        break\n","path":"/tmp/opencode/scan_resource.py"},"output":"Created file successfully: /tmp/opencode/scan_resource.py","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: /tmp/opencode/scan_resource.py"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"content\": \"\\\"\\\"\\\"Lecture seule : attributs de ressource des messages d'une trace (service.name...).\\\"\\\"\\\"\\nimport json\\nimport sys\\nimport uuid\\n\\nsys.path.insert(0, \\\"/home/baptistefaisy/aiven-kafka-demo/tools\\\")\\nimport kafkalib  # noqa: E402\\n\\nTRACE = \\\"a3bc34d64f0745976b3907d1df09a2c6\\\"\\nck = kafkalib.import_kafka()\\nfrom confluent_kafka import OFFSET_BEGINNING, TopicPartition  # noqa: E402\\n\\nfor attempt in range(4):\\n    consumer = ck.Consumer(kafkalib.kafka_config({\\n        \\\"group.id\\\": f\\\"scan-{uuid.uuid4().hex[:8]}\\\",\\n        \\\"enable.auto.commit\\\": \\\"false\\\",\\n    }))\\n    topics = [kafkalib.topic(s) for s in (\\\"traces\\\", \\\"logs\\\", \\\"metrics\\\")]\\n    try:\\n        meta = consumer.list_topics(timeout=20)\\n    except Exception as exc:  # noqa: BLE001\\n        print(\\\"metadonnees indisponibles:\\\", exc)\\n        consumer.close()\\n        continue\\n    parts = []\\n    for t in topics:\\n        tm = meta.topics.get(t)\\n        if not tm:\\n            continue\\n        parts += [TopicPartition(t, pid, OFFSET_BEGINNING) for pid in tm.partitions]\\n    consumer.assign(parts)\\n    seen = 0\\n    idle = 0\\n    while idle < 8:\\n        msg = consumer.poll(1.0)\\n        if msg is None:\\n            idle += 1\\n            continue\\n        if msg.error():\\n            continue\\n        idle = 0\\n        try:\\n            p = json.loads(msg.value().decode())\\n        except Exception:\\n            continue\\n        if p.get(\\\"TraceId\\\") != TRACE:\\n            continue\\n        seen += 1\\n        if seen <= 2:\\n            print(msg.topic(), json.dumps(p.get(\\\"ResourceAttributes\\\"), ensure_ascii=False),\\n                  \\\"| service:\\\", p.get(\\\"ServiceName\\\"))\\n    consumer.close()\\n    print(\\\"messages de la trace:\\\", seen)\\n    if seen:\\n        break\\n\", \"path\": \"/tmp/opencode/scan_resource.py\"}"},"time":{"start":1792670159228,"end":1792670160257}}}}
