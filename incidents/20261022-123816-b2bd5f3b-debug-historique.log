ELECT / SHOW / EXPLAIN / WITH / VALUES)\", file=sys.stderr)\n        return EXIT_REFUSED\n\n    try:\n        pg_env = build_pg_env(args.db_url)\n    except kafkalib.ConfigError as exc:\n        print(f\"ERREUR : {exc}\", file=sys.stderr)\n        return EXIT_CONFIG\n\n    env = os.environ.copy()\n    env.update(pg_env)\n    script = \"SET default_transaction_read_only = on;\\n\" + args.sql.strip() + \"\\n\"\n    try:\n        proc = subprocess.run(\n            [\"psql\", \"-X\", \"-q\", \"-v\", \"VERBOSITY=verbose\", \"-f\", \"-\"],\n            input=script, env=env, capture_output=True, text=True,\n            timeout=args.timeout)\n    except subprocess.TimeoutExpired:\n        print(f\"ERREUR : la requete depasse {args.timeout}s\", file=sys.stderr)\n        return EXIT_REFUSED\n\n    if proc.stdout:\n        sys.stdout.write(proc.stdout)\n    if proc.stderr:\n        sys.stderr.write(proc.stderr)\n    return EXIT_OK if proc.returncode in (0, 1, 3) else EXIT_REFUSED\n\n\nif __name__ == \"__main__\":\n    try:\n        sys.exit(main())\n    except KeyboardInterrupt:\n        print(\"interrompu\", file=sys.stderr)\n        sys.exit(1)\n=== build_pg_env (emit_sql_error) ===\n130:def build_pg_env(db_url: Optional[str] = None) -> Dict[str, str]:\n131-    \"\"\"PGHOST/PGPORT/... pour `psql`. Le mot de passe ne sort JAMAIS.\"\"\"\n132-    host, port, user, password, db = DEFAULT_HOST, str(DEFAULT_PORT), DEFAULT_USER, \"\", DEFAULT_DB\n133-\n134-    if db_url:\n135-        from urllib.parse import parse_qsl, urlsplit\n136-        parts = urlsplit(db_url)\n137-        host = parts.hostname or host\n138-        port = str(parts.port or port)\n139-        user = parts.username or user\n140-        password = parts.password or password\n141-        db = (parts.path or \"\").lstrip(\"/\") or db\n142-        query = dict(parse_qsl(parts.query))\n143-        sslmode = query.get(\"sslmode\", \"require\")\n144-    else:\n145-        creds = read_env_file(CREDS_ENV)\n146-       