{"type":"tool_use","timestamp":1792673032082,"sessionID":"ses_e9c617452ffeBMGv5PMfXmC0vx","part":{"partID":"prt_163a3a763001G8EdFzKuZtYCMZ","sessionID":"ses_e9c617452ffeBMGv5PMfXmC0vx","messageID":"msg_163a38028001sHA6C5ilDx0jgM","type":"tool","id":"call_00_qWZIGnTaGjxjAQ9lspOn9358","tool":"shell","state":{"status":"completed","input":{"command":"cd /home/baptistefaisy/aiven-kafka-demo; sed -n 40,135p tools/dbprobe.py"},"output":"EXIT_CONFIG = 2\nEXIT_DB = 3\nEXIT_DRIFT = 5\n\n# Bases connues : nom court -> (fichier d'env, lecture seule ?)\n#   « erreurs »    : la base de travail, ou vivent erreurs.* et scratch.* ;\n#                    c'est aussi le bac a sable de validation des patchs.\n#   « historique » : la base de production du service pg-memoire, ouverte a\n#                    l'utilisateur `app` en default_transaction_read_only.\nDATABASES = {\n    \"erreurs\": (PROJECT_ROOT / \".secrets\" / \"pg-erreurs.env\", False),\n    \"historique\": (None, True),  # via emit_sql_error.build_pg_env()\n}\n\nDEFAULT_DB = \"erreurs\"\nDEFAULT_SCHEMAS = {\n    \"erreurs\": [\"erreurs\", \"scratch\"],\n    \"historique\": [\"public\"],\n}\n\nSAFE_IDENT = re.compile(r\"^[a-z_][a-z0-9_]*$\")\n\n\nclass ProbeError(Exception):\n    \"\"\"Connexion impossible, psql absent, configuration incomplete.\"\"\"\n\n\n# ---------------------------------------------------------------------------\n# connexion\n# ---------------------------------------------------------------------------\ndef _read_env_file(path: Path) -> Dict[str, str]:\n    out: Dict[str, str] = {}\n    try:\n        text = path.read_text(encoding=\"utf-8\")\n    except OSError:\n        return out\n    for raw in text.splitlines():\n        line = raw.strip()\n        if not line or line.startswith(\"#\") or \"=\" not in line:\n            continue\n        if line.startswith(\"export \"):\n            line = line[len(\"export \"):]\n        key, _, val = line.partition(\"=\")\n        key = key.strip()\n        if key:\n            out[key] = val.strip().strip('\"').strip(\"'\")\n    return out\n\n\ndef load_env(db: str = DEFAULT_DB) -> Dict[str, str]:\n    \"\"\"Variables PG* pour la base demandee. Le mot de passe ne sort JAMAIS.\"\"\"\n    if db not in DATABASES:\n        raise ProbeError(\n            f\"base inconnue : {db} -> choisir parmi {', '.join(sorted(DATABASES))}\")\n\n    env_file, _read_only = DATABASES[db]\n    if env_file is None:\n        from emit_sql_error import build_pg_env  # import tardif : evite un cycle\n        try:\n            values = build_pg_env(None)\n        except Exception as exc:  # noqa: BLE001 - jamais de traceback\n            raise ProbeError(f\"connexion « {db} » indisponible : {exc}\") from exc\n    else:\n        values = _read_env_file(Path(os.environ.get(\"PG_ENV_FILE\") or env_file))\n        missing = [k for k in (\"PGHOST\", \"PGPORT\", \"PGUSER\", \"PGPASSWORD\") if not values.get(k)]\n        if missing:\n            raise ProbeError(\n                \"configuration PostgreSQL incomplete pour « \" + db + \" » : \"\n                + \", \".join(missing) + f\" -> cree {env_file} en mode 600\")\n\n    for key in (\"PGHOST\", \"PGPORT\", \"PGUSER\", \"PGPASSWORD\", \"PGDATABASE\", \"PGSSLMODE\"):\n        if os.environ.get(key):\n            values[key] = os.environ[key]\n    values.setdefault(\"PGDATABASE\", \"defaultdb\")\n    values.setdefault(\"PGSSLMODE\", \"require\")\n    values.setdefault(\"PGCONNECT_TIMEOUT\", \"15\")\n    return {k: v for k, v in values.items() if k.startswith(\"PG\")}\n\n\ndef run_sql(pg_env: Dict[str, str], sql: str, timeout: int = 45,\n            read_only: bool = True) -> Tuple[int, str, str]:\n    \"\"\"Execute du SQL. Rend (code, stdout, stderr). Ne leve pas sur erreur SQL.\"\"\"\n    script = sql\n    if read_only:\n        script = \"SET default_transaction_read_only = on;\\n\" + sql\n    env = os.environ.copy()\n    env.update(pg_env)\n    env[\"PGCLIENTENCODING\"] = \"UTF8\"\n    try:\n        proc = subprocess.run(\n            [\"psql\", \"-X\", \"-q\", \"-t\", \"-A\", \"-v\", \"VERBOSITY=verbose\", \"-f\", \"-\"],\n            input=script, capture_output=True, text=True, timeout=timeout, env=env)\n    except FileNotFoundError as exc:\n        raise ProbeError(\"psql introuvable -> installe postgresql-client\") from exc\n    except subprocess.TimeoutExpired as exc:\n        raise ProbeError(f\"la requete depasse {timeout}s\") from exc\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"EXIT_CONFIG = 2\nEXIT_DB = 3\nEXIT_DRIFT = 5\n\n# Bases connues : nom court -> (fichier d'env, lecture seule ?)\n#   « erreurs »    : la base de travail, ou vivent erreurs.* et scratch.* ;\n#                    c'est aussi le bac a sable de validation des patchs.\n#   « historique » : la base de production du service pg-memoire, ouverte a\n#                    l'utilisateur `app` en default_transaction_read_only.\nDATABASES = {\n    \"erreurs\": (PROJECT_ROOT / \".secrets\" / \"pg-erreurs.env\", False),\n    \"historique\": (None, True),  # via emit_sql_error.build_pg_env()\n}\n\nDEFAULT_DB = \"erreurs\"\nDEFAULT_SCHEMAS = {\n    \"erreurs\": [\"erreurs\", \"scratch\"],\n    \"historique\": [\"public\"],\n}\n\nSAFE_IDENT = re.compile(r\"^[a-z_][a-z0-9_]*$\")\n\n\nclass ProbeError(Exception):\n    \"\"\"Connexion impossible, psql absent, configuration incomplete.\"\"\"\n\n\n# ---------------------------------------------------------------------------\n# connexion\n# ---------------------------------------------------------------------------\ndef _read_env_file(path: Path) -> Dict[str, str]:\n    out: Dict[str, str] = {}\n    try:\n        text = path.read_text(encoding=\"utf-8\")\n    except OSError:\n        return out\n    for raw in text.splitlines():\n        line = raw.strip()\n        if not line or line.startswith(\"#\") or \"=\" not in line:\n            continue\n        if line.startswith(\"export \"):\n            line = line[len(\"export \"):]\n        key, _, val = line.partition(\"=\")\n        key = key.strip()\n        if key:\n            out[key] = val.strip().strip('\"').strip(\"'\")\n    return out\n\n\ndef load_env(db: str = DEFAULT_DB) -> Dict[str, str]:\n    \"\"\"Variables PG* pour la base demandee. Le mot de passe ne sort JAMAIS.\"\"\"\n    if db not in DATABASES:\n        raise ProbeError(\n            f\"base inconnue : {db} -> choisir parmi {', '.join(sorted(DATABASES))}\")\n\n    env_file, _read_only = DATABASES[db]\n    if env_file is None:\n        from emit_sql_error import build_pg_env  # import tardif : evite un cycle\n        try:\n            values = build_pg_env(None)\n        except Exception as exc:  # noqa: BLE001 - jamais de traceback\n            raise ProbeError(f\"connexion « {db} » indisponible : {exc}\") from exc\n    else:\n        values = _read_env_file(Path(os.environ.get(\"PG_ENV_FILE\") or env_file))\n        missing = [k for k in (\"PGHOST\", \"PGPORT\", \"PGUSER\", \"PGPASSWORD\") if not values.get(k)]\n        if missing:\n            raise ProbeError(\n                \"configuration PostgreSQL incomplete pour « \" + db + \" » : \"\n                + \", \".join(missing) + f\" -> cree {env_file} en mode 600\")\n\n    for key in (\"PGHOST\", \"PGPORT\", \"PGUSER\", \"PGPASSWORD\", \"PGDATABASE\", \"PGSSLMODE\"):\n        if os.environ.get(key):\n            values[key] = os.environ[key]\n    values.setdefault(\"PGDATABASE\", \"defaultdb\")\n    values.setdefault(\"PGSSLMODE\", \"require\")\n    values.setdefault(\"PGCONNECT_TIMEOUT\", \"15\")\n    return {k: v for k, v in values.items() if k.startswith(\"PG\")}\n\n\ndef run_sql(pg_env: Dict[str, str], sql: str, timeout: int = 45,\n            read_only: bool = True) -> Tuple[int, str, str]:\n    \"\"\"Execute du SQL. Rend (code, stdout, stderr). Ne leve pas sur erreur SQL.\"\"\"\n    script = sql\n    if read_only:\n        script = \"SET default_transaction_read_only = on;\\n\" + sql\n    env = os.environ.copy()\n    env.update(pg_env)\n    env[\"PGCLIENTENCODING\"] = \"UTF8\"\n    try:\n        proc = subprocess.run(\n            [\"psql\", \"-X\", \"-q\", \"-t\", \"-A\", \"-v\", \"VERBOSITY=verbose\", \"-f\", \"-\"],\n            input=script, capture_output=True, text=True, timeout=timeout, env=env)\n    except FileNotFoundError as exc:\n        raise ProbeError(\"psql introuvable -> installe postgresql-client\") from exc\n    except subprocess.TimeoutExpired as exc:\n        raise ProbeError(f\"la requete depasse {timeout}s\") from exc\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /home/baptistefaisy/aiven-kafka-demo; sed -n 40,135p tools/dbprobe.py\"}"},"time":{"start":1792673032035,"end":1792673032082}}}}
