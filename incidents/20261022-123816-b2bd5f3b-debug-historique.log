{"type":"tool_use","timestamp":1792672865321,"sessionID":"ses_e9c617452ffeBMGv5PMfXmC0vx","part":{"partID":"prt_163a11bbd001DR4yDImWukOjUm","sessionID":"ses_e9c617452ffeBMGv5PMfXmC0vx","messageID":"msg_163a1042a001Qs75jybsNF5dP5","type":"tool","id":"call_01_msmrArHQL0SOSbpmXNVE3130","tool":"shell","state":{"status":"completed","input":{"command":"cd /home/baptistefaisy/aiven-kafka-demo; echo \"=== emit_db_errors.py ===\"; cat tools/emit_db_errors.py | head -120"},"output":"=== emit_db_errors.py ===\n#!/usr/bin/env python3\n\"\"\"tools/emit_db_errors.py — remonte dans Kafka les erreurs de la base « erreurs ».\n\nMotif « transactional outbox » :\n  1. l'application ecrit une erreur dans `erreurs.app_errors` (status='new') ;\n  2. ce producteur lit les lignes `new`, fabrique les messages OTel du contrat\n     (§3) et les publie dans `<prefix>.traces`, `<prefix>.logs`,\n     `<prefix>.metrics` ;\n  3. chaque ligne publiee passe en `published` (ou `failed` + last_error).\n\nLe watcher `tools/kafka-incident-watch` n'est PAS modifie : il consomme les\nmemes topics et route sur `error.type` via `routes.yaml`. Une erreur dont\nl'`error_type` n'est pas dans `routes.yaml` tombe sur `default_agent`.\n\nSecurite :\n  - identifiants lus dans un fichier mode 600 (`.secrets/pg-erreurs.env`),\n    jamais affiches ni journalises ;\n  - `--dry-run` n'ecrit rien dans Kafka ni dans la base ;\n  - une ligne deja `published` n'est jamais republiee.\n\nUsage :\n  ./tools/emit_db_errors.py --list                 # lignes en attente\n  ./tools/emit_db_errors.py --stats                # compteurs par error_type\n  ./tools/emit_db_errors.py --dry-run              # apercu des messages\n  ./tools/emit_db_errors.py                        # publie tout le retard\n  ./tools/emit_db_errors.py --limit 3 --json       # 3 lignes, sortie JSON\n  ./tools/emit_db_errors.py --watch 15             # boucle toutes les 15 s\n  ./tools/emit_db_errors.py --emit db_pool_exhausted \"pool 20/20\"  # insere\n\nCodes de sortie : 0 ok / 1 usage / 2 configuration / 3 Kafka injoignable\n                  / 4 base de donnees injoignable / 5 publication partielle\n                  / 7 generateurs d'erreurs coupes (./tools/generator on).\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport os\nimport shlex\nimport subprocess\nimport sys\nimport time\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any, Dict, List, Optional\n\nHERE = Path(__file__).resolve().parent\nPROJECT_ROOT = HERE.parent\nsys.path.insert(0, str(HERE))\n\nimport contract  # noqa: E402\nimport generator_switch  # noqa: E402\nimport kafkalib  # noqa: E402\n\nEXIT_OK = kafkalib.EXIT_OK\nEXIT_USAGE = kafkalib.EXIT_USAGE\nEXIT_CONFIG = kafkalib.EXIT_CONFIG\nEXIT_KAFKA = kafkalib.EXIT_KAFKA\nEXIT_DB = 4\nEXIT_PARTIAL = 5\n\nDEFAULT_PG_ENV = PROJECT_ROOT / \".secrets\" / \"pg-erreurs.env\"\nDEFAULT_SERVICE = \"agent-demo\"\nDEFAULT_PROFILE = \"prod\"\nREQUIRED_PG = (\"PGHOST\", \"PGPORT\", \"PGUSER\", \"PGPASSWORD\")\n\n# colonnes lues dans la base (ordre stable, sert a construire le SELECT)\nCOLUMNS = (\n    \"id\", \"trace_id\", \"occurred_at\", \"service_name\", \"environment\",\n    \"severity\", \"severity_number\", \"error_type\", \"message\", \"sqlstate\",\n    \"sql_detail\", \"origin\", \"span_name\",\n    \"http_method\", \"http_route\", \"http_status\", \"host\", \"db_system\",\n    \"db_namespace\", \"db_operation\", \"pool_active\", \"pool_idle\", \"pool_max\",\n    \"duration_ms\", \"attributes\", \"status\", \"attempts\",\n)\n\n\nclass DbUnreachable(Exception):\n    \"\"\"psql absent, identifiants refuses, service en construction...\"\"\"\n\n\n# --------------------------------------------------------------- connexion\ndef load_pg_env() -> Dict[str, str]:\n    \"\"\"Charge .secrets/pg-erreurs.env (KEY=VALUE) sans l'executer.\"\"\"\n    path = Path(os.environ.get(\"PG_ENV_FILE\") or DEFAULT_PG_ENV)\n    values: Dict[str, str] = {}\n    if path.exists():\n        for raw in path.read_text(encoding=\"utf-8\").splitlines():\n            line = raw.strip()\n            if not line or line.startswith(\"#\") or \"=\" not in line:\n                continue\n            if line.startswith(\"export \"):\n                line = line[len(\"export \"):]\n            key, _, val = line.partition(\"=\")\n            key = key.strip()\n            if key:\n                values[key] = val.strip().strip('\"').strip(\"'\")\n    # Les variables deja exportees dans le shell priment sur le fichier.\n    for key in REQUIRED_PG + (\"PGDATABASE\", \"PGSSLMODE\"):\n        if os.environ.get(key):\n            values[key] = os.environ[key]\n    missing = [k for k in REQUIRED_PG if not values.get(k)]\n    if missing:\n        raise kafkalib.ConfigError(\n            \"configuration PostgreSQL incomplete : variable(s) manquante(s) \"\n            + \", \".join(missing)\n            + f\" -> cree {path} en mode 600 (PGHOST, PGPORT, PGDATABASE, \"\n              \"PGUSER, PGPASSWORD, PGSSLMODE=require)\"\n        )\n    values.setdefault(\"PGDATABASE\", \"defaultdb\")\n    values.setdefault(\"PGSSLMODE\", \"require\")\n    values.setdefault(\"PGCONNECT_TIMEOUT\", \"15\")\n    return values\n\n\ndef psql(pg_env: Dict[str, str], sql: str, timeout: int = 45) -> str:\n    \"\"\"Execute une requete et rend la sortie brute (format non aligne).\"\"\"\n    env = dict(os.environ)\n    env.update(pg_env)\n    env[\"PGCLIENTENCODING\"] = \"UTF8\"\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"=== emit_db_errors.py ===\n#!/usr/bin/env python3\n\"\"\"tools/emit_db_errors.py — remonte dans Kafka les erreurs de la base « erreurs ».\n\nMotif « transactional outbox » :\n  1. l'application ecrit une erreur dans `erreurs.app_errors` (status='new') ;\n  2. ce producteur lit les lignes `new`, fabrique les messages OTel du contrat\n     (§3) et les publie dans `<prefix>.traces`, `<prefix>.logs`,\n     `<prefix>.metrics` ;\n  3. chaque ligne publiee passe en `published` (ou `failed` + last_error).\n\nLe watcher `tools/kafka-incident-watch` n'est PAS modifie : il consomme les\nmemes topics et route sur `error.type` via `routes.yaml`. Une erreur dont\nl'`error_type` n'est pas dans `routes.yaml` tombe sur `default_agent`.\n\nSecurite :\n  - identifiants lus dans un fichier mode 600 (`.secrets/pg-erreurs.env`),\n    jamais affiches ni journalises ;\n  - `--dry-run` n'ecrit rien dans Kafka ni dans la base ;\n  - une ligne deja `published` n'est jamais republiee.\n\nUsage :\n  ./tools/emit_db_errors.py --list                 # lignes en attente\n  ./tools/emit_db_errors.py --stats                # compteurs par error_type\n  ./tools/emit_db_errors.py --dry-run              # apercu des messages\n  ./tools/emit_db_errors.py                        # publie tout le retard\n  ./tools/emit_db_errors.py --limit 3 --json       # 3 lignes, sortie JSON\n  ./tools/emit_db_errors.py --watch 15             # boucle toutes les 15 s\n  ./tools/emit_db_errors.py --emit db_pool_exhausted \"pool 20/20\"  # insere\n\nCodes de sortie : 0 ok / 1 usage / 2 configuration / 3 Kafka injoignable\n                  / 4 base de donnees injoignable / 5 publication partielle\n                  / 7 generateurs d'erreurs coupes (./tools/generator on).\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport os\nimport shlex\nimport subprocess\nimport sys\nimport time\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any, Dict, List, Optional\n\nHERE = Path(__file__).resolve().parent\nPROJECT_ROOT = HERE.parent\nsys.path.insert(0, str(HERE))\n\nimport contract  # noqa: E402\nimport generator_switch  # noqa: E402\nimport kafkalib  # noqa: E402\n\nEXIT_OK = kafkalib.EXIT_OK\nEXIT_USAGE = kafkalib.EXIT_USAGE\nEXIT_CONFIG = kafkalib.EXIT_CONFIG\nEXIT_KAFKA = kafkalib.EXIT_KAFKA\nEXIT_DB = 4\nEXIT_PARTIAL = 5\n\nDEFAULT_PG_ENV = PROJECT_ROOT / \".secrets\" / \"pg-erreurs.env\"\nDEFAULT_SERVICE = \"agent-demo\"\nDEFAULT_PROFILE = \"prod\"\nREQUIRED_PG = (\"PGHOST\", \"PGPORT\", \"PGUSER\", \"PGPASSWORD\")\n\n# colonnes lues dans la base (ordre stable, sert a construire le SELECT)\nCOLUMNS = (\n    \"id\", \"trace_id\", \"occurred_at\", \"service_name\", \"environment\",\n    \"severity\", \"severity_number\", \"error_type\", \"message\", \"sqlstate\",\n    \"sql_detail\", \"origin\", \"span_name\",\n    \"http_method\", \"http_route\", \"http_status\", \"host\", \"db_system\",\n    \"db_namespace\", \"db_operation\", \"pool_active\", \"pool_idle\", \"pool_max\",\n    \"duration_ms\", \"attributes\", \"status\", \"attempts\",\n)\n\n\nclass DbUnreachable(Exception):\n    \"\"\"psql absent, identifiants refuses, service en construction...\"\"\"\n\n\n# --------------------------------------------------------------- connexion\ndef load_pg_env() -> Dict[str, str]:\n    \"\"\"Charge .secrets/pg-erreurs.env (KEY=VALUE) sans l'executer.\"\"\"\n    path = Path(os.environ.get(\"PG_ENV_FILE\") or DEFAULT_PG_ENV)\n    values: Dict[str, str] = {}\n    if path.exists():\n        for raw in path.read_text(encoding=\"utf-8\").splitlines():\n            line = raw.strip()\n            if not line or line.startswith(\"#\") or \"=\" not in line:\n                continue\n            if line.startswith(\"export \"):\n                line = line[len(\"export \"):]\n            key, _, val = line.partition(\"=\")\n            key = key.strip()\n            if key:\n                values[key] = val.strip().strip('\"').strip(\"'\")\n    # Les variables deja exportees dans le shell priment sur le fichier.\n    for key in REQUIRED_PG + (\"PGDATABASE\", \"PGSSLMODE\"):\n        if os.environ.get(key):\n            values[key] = os.environ[key]\n    missing = [k for k in REQUIRED_PG if not values.get(k)]\n    if missing:\n        raise kafkalib.ConfigError(\n            \"configuration PostgreSQL incomplete : variable(s) manquante(s) \"\n            + \", \".join(missing)\n            + f\" -> cree {path} en mode 600 (PGHOST, PGPORT, PGDATABASE, \"\n              \"PGUSER, PGPASSWORD, PGSSLMODE=require)\"\n        )\n    values.setdefault(\"PGDATABASE\", \"defaultdb\")\n    values.setdefault(\"PGSSLMODE\", \"require\")\n    values.setdefault(\"PGCONNECT_TIMEOUT\", \"15\")\n    return values\n\n\ndef psql(pg_env: Dict[str, str], sql: str, timeout: int = 45) -> str:\n    \"\"\"Execute une requete et rend la sortie brute (format non aligne).\"\"\"\n    env = dict(os.environ)\n    env.update(pg_env)\n    env[\"PGCLIENTENCODING\"] = \"UTF8\"\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /home/baptistefaisy/aiven-kafka-demo; echo \\\"=== emit_db_errors.py ===\\\"; cat tools/emit_db_errors.py | head -120\"}"},"time":{"start":1792672865213,"end":1792672865321}}}}
