du / 1 usage / 2 configuration /\n                  3 trace introuvable ou Kafka injoignable.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport subprocess\nimport sys\nfrom pathlib import Path\nfrom typing import Any, Dict, List, Optional, Tuple\n\nHERE = Path(__file__).resolve().parent\nPROJECT_ROOT = HERE.parent\nsys.path.insert(0, str(HERE))\n\nimport dbprobe  # noqa: E402\n\nEXIT_OK = dbprobe.EXIT_OK\nEXIT_USAGE = dbprobe.EXIT_USAGE\nEXIT_CONFIG = dbprobe.EXIT_CONFIG\nEXIT_KAFKA = dbprobe.EXIT_DB\n\nPLAYBOOK = PROJECT_ROOT / \"debug\" / \"playbook.json\"\nROUTES = PROJECT_ROOT / \"routes.yaml\"\n\n# sqlstates qui designent un probleme de schema -> on lance schema-check\nSCHEMA_SQLSTATE_PREFIXES = (\"42\", \"3F\")\nSCHEMA_SQLSTATES = {\"42883\", \"42703\", \"42601\", \"42P01\"}\n\n\n# ---------------------------------------------------------------------------\n# lecture des sources\n# ---------------------------------------------------------------------------\ndef load_playbook() -> Dict[str, Any]:\n    try:\n        return json.loads(PLAYBOOK.read_text(encoding=\"utf-8\"))\n    except (OSError, ValueError) as exc:\n=== grep prefix ===\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /home/baptistefaisy/aiven-kafka-demo && sed -n 1,60p tools/debug-bundle; echo \\\"=== grep prefix ===\\\"; grep -n \\\"prefix\\\\|read_messages\\\\|otel\\\" tools/debug-bundle | head -30\", \"timeout\": 60000}"},"time":{"start":1792673842124,"end":1792673843115}}}}
