\": \"code\", \"\n=== ENTRY ===\n\"disk_full\"\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"aliases: {\"_doc\": \"Variantes de nommage acceptees par routes.yaml. Une alias n'a pas besoin de sa propre fiche : elle pointe vers la fiche canonique.\", \"broker_unreachable\": \"kafka_broker_unreachable\", \"connection_timeout\": \"db_connection_timeout\", \"timeout\": \"kafka_broker_unreachable\"}\nfamilies: {\"schema\": {\"label\": \"Schéma (DDL)\", \"artefact\": \"migration\", \"regle\": \"Le schéma est observable et comparable : on ne devine jamais, on diffe (tools/schema-check).\"}, \"data\": {\"label\": \"Données / contraintes\", \"artefact\": \"code\", \"regle\": \"La base a raison : la contrainte refuse une donnée que l'application aurait dû valider. Le correctif est en amont de l'INSERT.\"}, \"concurrency\": {\"label\": \"Concurrence et verrous\", \"artefact\": \"code\", \"regle\": \"Aucune migration ne corrige un deadlock : c'est un ordre d'accès ou une transaction trop longue.\"}, \"config\": {\"label\": \"Configuration et dimensionnement\", \"artefact\": \"config\", \"regle\": \"La base va bien ; c'est le nombre de connexions ou la limite qui est mal réglé.\"}, \"applicatif\": {\"label\": \"Applicatif (la base va bien)\", \"artefact\": \"code\", \"\n=== ENTRY ===\n\"disk_full\"\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /home/baptistefaisy/aiven-kafka-demo && python3 - <<'PY'\\nimport json\\nd=json.load(open('debug/playbook.json'))\\nprint(\\\"aliases:\\\", json.dumps(d['aliases'],ensure_ascii=False)[:800])\\nprint(\\\"families:\\\", json.dumps(d['families'],ensure_ascii=False)[:800])\\nfor e in d['entries']:\\n    j=json.dumps(e,ensure_ascii=False)\\n    if 'disk' in j.lower():\\n        print(\\\"=== ENTRY ===\\\")\\n        print(json.dumps(e,indent=2,ensure_ascii=False)[:3000])\\nPY\", \"timeout\": 60000}"},"time":