add_argument(\"--detectors\", action=\"store_true\", help=\"verdict des 3 detecteurs\")\n    parser.add_argument(\"--list\", action=\"store_true\", help=\"liste les traces\")\n    parser.add_argument(\"--json\", action=\"store_true\", help=\"sortie JSON\")\n    parser.add_argument(\"--prefix\", help=\"prefixe de topics\")\n    args = parser.parse_args(argv)\n\n    # Re-execution dans le venv dedie avant toute sortie (§0.6)\n    kafkalib.ensure_kafka_interpreter()\n\n    try:\n        kafkalib.ensure_config()\n    except Exception:  # noqa: BLE001\n        pass\n\n    try:\n        if args.list:\n            return list_traces(args.prefix, args.json)\n        if not args.trace_id:\n            parser.print_usage(sys.stderr)\n            print(\"ERREUR : il faut un trace_id ou --list\", file=sys.stderr)\n            return EXIT_USAGE\n        return dump_trace(args.trace_id, args.prefix, args.json, args.detectors)\n    except kafkalib.ConfigError as exc:\n        print(f\"ERREUR : {exc}\", file=sys.stderr)\n        return EXIT_CONFIG\n    except kafkalib.KafkaUnreachable as exc:\n        print(f\"ERREUR : {exc}\", file=sys.stderr)\n        return EXIT_KAFKA\n\n\nif __name__ == \"__main__\":\n    try:\n        sys.exit(main())\n    except KeyboardInterrupt:\n        print(\"interrompu\", file=sys.stderr)\n        sys.exit(1)\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /home/baptistefaisy/aiven-kafka-demo && sed -n 80,260p trace-dump\", \"timeout\": 60000}"},"time":{"start":1792673902220,"end":1792673905616}}}}
{"type":"tool_use","timestamp":1792673905626,"sessionID":"ses_e9c53f1c9ffeggZKH1aSDAs7f8","part":{"partID":"prt_163b0f532001rb0RBS9jlZPTYc","sessionID":"ses_e9c53f1c9ffeggZKH1aSDAs7f8","messageID":"msg_163b0d3ab001gdKD4n4lrbmHN2","type":"tool","id":"call_01_gxM2rzBS19it3eCx02DU8833","tool":"shell","state":{"status":"completed","input":{"command":"cd /home/baptistefaisy/aiven-kafka-demo && ls tools/ && echo \"=== kafkalib ===\" && sed -n 1,140p tools/kafkalib.py","timeout":60000},"output":"__pycache__\ncheck.sh\ncontract-check\ncontract.py\ndb_fault_probe.py\ndbprobe.py\ndebug-bundle\ndebug-selftest\ndedup-selftest\ndetectors.py\nemit_db_errors.py\nemit_incident.py\nemit_sql_error.py\ngenerator\ngenerator_switch.py\nkafka-incident-watch\nkafka-incident-watch.service\nkafka-migrate\nkafkalib.py\npatch-new\npatch-validate\npg-diag\npreflight\nprobe_bootstrap.py\nschema-check\nsite-server.py\nsync-log-site-group.sh\nsync-site-catalog.sh\nsync-site-group.sh\nvenv.sh\n=== kafkalib ===\n#!/usr/bin/env python3\n\"\"\"Boite a outils Kafka partagee (config, producteur, consommateur).\n\nRegles de securite :\n  - aucun secret n'est jamais affiche ni journalise ;\n  - chaque appel reseau a un timeout ;\n  - les erreurs sont transformees en messages lisibles\n    (\"quoi / pourquoi / quoi faire maintenant\"), jamais en traceback.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\nimport re\nimport sys\nimport time\nfrom pathlib import Path\nfrom typing import Any, Dict, List, Optional, Tuple\n\nHERE = Path(__file__).resolve().parent\nPROJECT_ROOT = HERE.parent\n\nEXIT_OK = 0\nEXIT_USAGE = 1\nEXIT_CONFIG = 2\nEXIT_KAFKA = 3\nEXIT_RUNNING = 4\n\nREQUIRED_ENV = [\n    \"KAFKA_BOOTSTRAP\",\n    \"KAFKA_USERNAME\",\n    \"KAFKA_PASSWORD\",\n    \"KAFKA_CA_FILE\",\n    \"KAFKA_TOPIC_PREFIX\",\n]\n\n\nclass ConfigError(Exception):\n    \"\"\"Configuration incomplete (variables manquantes, fichier illisible...).\"\"\"\n\n\nclass KafkaUnreachable(Exception):\n    \"\"\"Le broker ne repond pas (reseau, TLS, ACL, service en construction...).\"\"\"\n\n\ndef load_env_file(path: Optional[str] = None) -> Dict[str, str]:\n    \"\"\"Charge un env-<service>.sh sans l'executer (parsing KEY=VALUE).\"\"\"\n    p = Path(path or PROJECT_ROOT / \"env-kafka-1687d005.sh\")\n    values: Dict[str, str] = {}\n    if not p.exists():\n        return values\n    for raw in p.read_text(encoding=\"utf-8\").splitlines():\n        line = raw.strip()\n        if not line or line.startswith(\"#\") or \"=\" not in line:\n            continue\n        if line.startswith(\"export \"):\n            line = line[len(\"export \"):]\n        key, _, val = line.partition(\"=\")\n        key = key.strip()\n        val = val.strip().strip('\"').strip(\"'\")\n        if key and re.fullmatch(r\"[A-Za-z_][A-Za-z0-9_]*\", key):\n            values[key] = val\n    return values\n\n\ndef ensure_config() -> None:\n    \"\"\"Remplit les variables KAFKA_* manquantes depuis le fichier d'env.\n\n    Le fichier est au format systemd (KEY=\"valeur\", sans `export`) : il est\n    lisible par `EnvironmentFile=` ET par bash. En bash, on le charge avec\n    `set -a; . env-kafka-1687d005.sh; set +a` pour l'exporter.\n    \"\"\"\n    if all(os.environ.get(k) for k in REQUIRED_ENV):\n        return\n    env_file = os.environ.get(\"KAFKA_ENV_FILE\")\n    for key, val in load_env_file(env_file).items():\n        os.environ.setdefault(key, val)\n\n\ndef config() -> Dict[str, str]:\n    ensure_config()\n    missing = [k for k in REQUIRED_ENV if not os.environ.get(k)]\n    if missing:\n        raise ConfigError(\n            \"configuration incomplete : variable(s) manquante(s) \"\n            + \", \".join(missing)\n            + \" -> source env-kafka-1687d005.sh (mode 600) puis reessaye\"\n        )\n    return {k: os.environ[k] for k in REQUIRED_ENV}\n\n\n# --------------------------------------------------------------------------\n# selection du cluster\n# --------------------------------------------------------------------------\n# Un seul cluster desormais : kafka-1687d005 (l'ancien service de repli\n# agent-kafka a ete supprime apres migration des donnees). L'infrastructure de\n# profils est conservee pour ne pas casser les appelants : un profil de repli\n# n'est ajoute QUE si KAFKA_FALLBACK_ENV_FILE designe un fichier existant.\nFALLBACK_ENV_FILE = os.environ.get(\"KAFKA_FALLBACK_ENV_FILE\", \"\")\nPROFILE_STATE = Path(os.environ.get(\n    \"KAFKA_PROFILE_STATE\",\n    str(Path.home() / \".local\" / \"state\" / \"aiven-kafka-demo\" / \"active.json\")))\nHEALTH_TTL_S = float(os.environ.get(\"KAFKA_HEALTH_TTL_S\", \"20\"))\n\n\ndef _profile_env(values: Dict[str, str]) -> Dict[str, str]:\n    env = dict(values)\n    env.setdefault(\"KAFKA_SECURITY_PROTOCOL\", \"SASL_SSL\")\n    env.setdefault(\"KAFKA_SASL_MECHANISM\", \"SCRAM-SHA-256\")\n    return env\n\n\ndef profiles() -> List[Tuple[str, Dict[str, str]]]:\n    \"\"\"Les profils disponibles : (nom, variables KAFKA_*).\"\"\"\n    ensure_config()\n    out: List[Tuple[str, Dict[str, str]]] = []\n    primary = {k: os.environ.get(k) for k in REQUIRED_ENV}\n    if all(primary.get(k) for k in REQUIRED_ENV):\n        out.append((\"primary\", _profile_env(primary)))\n    fallback = load_env_file(FALLBACK_ENV_FILE) if FALLBACK_ENV_FILE else {}\n    if all(fallback.get(k) for k in REQUIRED_ENV):\n        if fallback.get(\"KAFKA_BOOTSTRAP\") != primary.get(\"KAFKA_BOOTSTRAP\"):\n            out.append((\"fallback\", _profile_env(fallback)))\n    return out\n\n\ndef _read_state() -> Dict[str, Any]:\n    try:\n        return json.loads(PROFILE_STATE.read_text(encoding=\"utf-8\"))\n    except (OSError, ValueError):\n        return {}\n\n\ndef _write_state(name: str) -> None:\n    try:\n        PROFILE_STATE.parent.mkdir(parents=True, exist_ok=True)\n        PROFILE_STATE.write_text(\n            json.dumps({\"active\": name, \"at\": time.time()}), encoding=\"utf-8\")\n    except OSError:\n        pass\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"__pycache__\ncheck.sh\ncontract-check\ncontract.py\ndb_fault_probe.py\ndbprobe.py\ndebug-bundle\ndebug-selftest\ndedup-selftest\ndetectors.py\nemit_db_errors.py\nemit_incident.py\nemit_sql_error.py\ngenerator\ngenerator_switch.py\nkafka-incident-watch\nkafka-incident-watch.service\nkafka-migrate\nkafkalib.py\npatch-new\npatch-validate\npg-diag\npreflight\nprobe_bootstrap.py\nschema-check\nsite-server.py\nsync-log-site-group.sh\nsync-site-catalog.sh\nsync-site-group.sh\nvenv.sh\n=== kafkalib ===\n#!/usr/bin/env python3\n\"\"\"Boite a outils Kafka partagee (config, producteur, consommateur).\n\nRegles de securite :\n  - aucun secret n'est jamais affiche ni journalise ;\n  - chaque appel reseau a un timeout ;\n  - les erreurs sont transformees en messages lisibles\n    (\"quoi / pourquoi / quoi faire maintenant\"), jamais en traceback.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\nimport re\nimport sys\nimport time\nfrom pathlib import Path\nfrom typing import Any, Dict, List, Optional, Tuple\n\nHERE = Path(__file__).resolve().parent\nPROJECT_ROOT = HERE.parent\n\nEXIT_OK = 0\nEXIT_USAGE = 1\nEXIT_CONFIG = 2\nEXIT_KAFKA = 3\nEXIT_RUNNING = 4\n\nREQUIRED_ENV = [\n    \"KAFKA_BOOTSTRAP\",\n    \"KAFKA_USERNAME\",\n    \"KAFKA_PASSWORD\",\n    \"KAFKA_CA_FILE\",\n    \"KAFKA_TOPIC_PREFIX\",\n]\n\n\nclass ConfigError(Exception):\n    \"\"\"Configuration incomplete (variables manquantes, fichier illisible...).\"\"\"\n\n\nclass KafkaUnreachable(Exception):\n    \"\"\"Le broker ne repond pas (reseau, TLS, ACL, service en construction...).\"\"\"\n\n\ndef load_env_file(path: Optional[str] = None) -> Dict[str, str]:\n    \"\"\"Charge un env-<service>.sh sans l'executer (parsing KEY=VALUE).\"\"\"\n    p = Path(path or PROJECT_ROOT / \"env-kafka-1687d005.sh\")\n    values: Dict[str, str] = {}\n    if not p.exists():\n        return values\n    for raw in p.read_text(encoding=\"utf-8\").splitlines():\n        line = raw.strip()\n        if not line or line.startswith(\"#\") or \"=\" not in line:\n            continue\n        if line.startswith(\"export \"):\n            line = line[len(\"export \"):]\n        key, _, val = line.partition(\"=\")\n        key = key.strip()\n        val = val.strip().strip('\"').strip(\"'\")\n        if key and re.fullmatch(r\"[A-Za-z_][A-Za-z0-9_]*\", key):\n            values[key] = val\n    return values\n\n\ndef ensure_config() -> None:\n    \"\"\"Remplit les variables KAFKA_* manquantes depuis le fichier d'env.\n\n    Le fichier est au format systemd (KEY=\"valeur\", sans `export`) : il est\n    lisible par `EnvironmentFile=` ET par bash. En bash, on le charge avec\n    `set -a; . env-kafka-1687d005.sh; set +a` pour l'exporter.\n    \"\"\"\n    if all(os.environ.get(k) for k in REQUIRED_ENV):\n        return\n    env_file = os.environ.get(\"KAFKA_ENV_FILE\")\n    for key, val in load_env_file(env_file).items():\n        os.environ.setdefault(key, val)\n\n\ndef config() -> Dict[str, str]:\n    ensure_config()\n    missing = [k for k in REQUIRED_ENV if not os.environ.get(k)]\n    if missing:\n        raise ConfigError(\n            \"configuration incomplete : variable(s) manquante(s) \"\n            + \", \".join(missing)\n            + \" -> source env-kafka-1687d005.sh (mode 600) puis reessaye\"\n        )\n    return {k: os.environ[k] for k in REQUIRED_ENV}\n\n\n# --------------------------------------------------------------------------\n# selection du cluster\n# --------------------------------------------------------------------------\n# Un seul cluster desormais : kafka-1687d005 (l'ancien service de repli\n# agent-kafka a ete supprime apres migration des donnees). L'infrastructure de\n# profils est conservee pour ne pas casser les appelants : un profil de repli\n# n'est ajoute QUE si KAFKA_FALLBACK_ENV_FILE designe un fichier existant.\nFALLBACK_ENV_FILE = os.environ.get(\"KAFKA_FALLBACK_ENV_FILE\", \"\")\nPROFILE_STATE = Path(os.environ.get(\n    \"KAFKA_PROFILE_STATE\",\n    str(Path.home() / \".local\" / \"state\" / \"aiven-kafka-demo\" / \"active.json\")))\nHEALTH_TTL_S = float(os.environ.get(\"KAFKA_HEALTH_TTL_S\", \"20\"))\n\n\ndef _profile_env(values: Dict[str, str]) -> Dict[str, str]:\n    env = dict(values)\n    env.setdefault(\"KAFKA_SECURITY_PROTOCOL\", \"SASL_SSL\")\n    env.setdefault(\"KAFKA_SASL_MECHANISM\", \"SCRAM-SHA-256\")\n    return env\n\n\ndef profiles() -> List[Tuple[str, Dict[str, str]]]:\n    \"\"\"Les profils disponibles : (nom, variables KAFKA_*).\"\"\"\n    ensure_config()\n    out: List[Tuple[str, Dict[str, str]]] = []\n    primary = {k: os.environ.get(k) for k in REQUIRED_ENV}\n    if all(primary.get(k) for k in REQUIRED_ENV):\n        out.append((\"primary\", _profile_env(primary)))\n    fallback = load_env_file(FALLBACK_ENV_FILE) if FALLBACK_ENV_FILE else {}\n    if all(fallback.get(k) for k in REQUIRED_ENV):\n        if fallback.get(\"KAFKA_BOOTSTRAP\") != primary.get(\"KAFKA_BOOTSTRAP\"):\n            out.append((\"fallback\", _profile_env(fallback)))\n    return out\n\n\ndef _read_state() -> Dict[str, Any]:\n    try:\n        return json.loads(PROFILE_STATE.read_text(encoding=\"utf-8\"))\n    except (OSError, ValueError):\n        return {}\n\n\ndef _write_state(name: str) -> None:\n    try:\n        PROFILE_STATE.parent.mkdir(parents=True, exist_ok=True)\n        PROFILE_STATE.write_text(\n            json.dumps({\"active\": name, \"at\": time.time()}), encoding=\"utf-8\")\n    except OSError:\n        pass\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /home/baptistefaisy/aiven-kafka-demo && ls tools/ && echo \\\"=== kafkalib ===\\\" && sed -n 1,140p tools/kafkalib.py\", \"timeout\": 60000}"},"time":{"start":1792673903922,"end":1792673905626}}}}
{"type":"step_finish","timestamp":1792673905630,"sessionID":"ses_e9c53f1c9ffeggZKH1aSDAs7f8","part":{"id":"prt_163b0fbde001pyLFO7jkMdYL1A","sessionID":"ses_e9c53f1c9ffeggZKH1aSDAs7f8","messageID":"msg_163b0d3ab001gdKD4n4lrbmHN2","type":"step-finish","reason":"tool-calls","cost":0,"tokens":{"input":771,"output":167,"reasoning":202,"cache":{"read":32512,"write":0}}}}
{"type":"step_start","timestamp":1792673930331,"sessionID":"ses_e9c53f1c9ffeggZKH1aSDAs7f8","part":{"id":"prt_163b15c5b001flUPyhVSxIxgsW","sessionID":"ses_e9c53f1c9ffeggZKH1aSDAs7f8","messageID":"msg_163b0fbee001iWlAm4lwiihlo5","type":"step-start"}}
{"type":"tool_use","timestamp":1792673930387,"sessionID":"ses_e9c53f1c9ffeggZKH1aSDAs7f8","part":{"partID":"prt_163b15c650017w0hrOg5eyXFTp","sessionID":"ses_e9c53f1c9ffeggZKH1aSDAs7f8","messageID":"msg_163b0fbee001iWlAm4lwiihlo5","type":"tool","id":"call_00_inT79JjMKIertAUJkNfR2792","tool":"shell","state":{"status":"completed","input":{"command":"cd /home/baptistefaisy/aiven-kafka-demo && sed -n 140,400p tools/kafkalib.py","timeout":60000},"output":"        pass\n\n\ndef invalidate_profile_cache() -> None:\n    \"\"\"Force un nouveau sondage (le watcher l'appelle apres une erreur).\"\"\"\n    state = _read_state()\n    state[\"at\"] = 0\n    try:\n        PROFILE_STATE.parent.mkdir(parents=True, exist_ok=True)\n        PROFILE_STATE.write_text(json.dumps(state), encoding=\"utf-8\")\n    except OSError:\n        pass\n\n\ndef _config_for(env: Dict[str, str], extra: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:\n    \"\"\"Configuration librdkafka a partir d'un jeu de variables explicite.\"\"\"\n    cfg: Dict[str, Any] = {\n        \"bootstrap.servers\": env[\"KAFKA_BOOTSTRAP\"],\n        \"security.protocol\": env.get(\"KAFKA_SECURITY_PROTOCOL\", \"SASL_SSL\"),\n        \"sasl.mechanism\": env.get(\"KAFKA_SASL_MECHANISM\", \"SCRAM-SHA-256\"),\n        \"sasl.username\": env[\"KAFKA_USERNAME\"],\n        \"sasl.password\": env[\"KAFKA_PASSWORD\"],\n        \"ssl.ca.location\": env[\"KAFKA_CA_FILE\"],\n        # le certificat Aiven porte le nom du SERVICE, pas celui du broker\n        \"ssl.endpoint.identification.algorithm\": \"none\",\n        # le DNS Aiven resout d'abord en IPv6 NAT64 : on force IPv4\n        \"broker.address.family\": os.environ.get(\"KAFKA_ADDRESS_FAMILY\", \"v4\"),\n        \"socket.timeout.ms\": int(os.environ.get(\"KAFKA_SOCKET_TIMEOUT_MS\", \"10000\")),\n        \"request.timeout.ms\": int(os.environ.get(\"KAFKA_REQUEST_TIMEOUT_MS\", \"15000\")),\n    }\n    if extra:\n        cfg.update(extra)\n    return cfg\n\n\ndef _probe_profile(env: Dict[str, str]) -> bool:\n    \"\"\"Le cluster du profil repond-il ? (metadata, timeout court)\"\"\"\n    try:\n        from confluent_kafka.admin import AdminClient  # type: ignore\n\n        admin = AdminClient(_config_for(env, {\"socket.timeout.ms\": 6000,\n                                               \"request.timeout.ms\": 8000,\n                                               \"log_level\": 3}))\n        admin.list_topics(timeout=8)\n        return True\n    except Exception:  # noqa: BLE001\n        return False\n\n\ndef active_profile(force: bool = False) -> Tuple[str, Dict[str, str]]:\n    \"\"\"Retourne (nom, variables) du cluster a utiliser.\n\n    - un seul cluster en service (kafka-1687d005) : le profil « primary » ;\n    - KAFKA_PROFILE=primary|fallback force un profil (fallback n'existe que si\n      KAFKA_FALLBACK_ENV_FILE est defini) ;\n    - le choix reste partage via un fichier d'etat commun a tous les outils.\n    \"\"\"\n    available = profiles()\n    if not available:\n        raise ConfigError(\n            \"configuration incomplete : aucun profil Kafka exploitable \"\n            \"(variables KAFKA_* absentes : lance ./provision.sh)\"\n        )\n    forced = os.environ.get(\"KAFKA_PROFILE\")\n    if forced:\n        for name, env in available:\n            if name == forced:\n                return name, env\n    state = _read_state()\n    now = time.time()\n    if not force and state.get(\"active\") and now - float(state.get(\"at\", 0)) < HEALTH_TTL_S:\n        for name, env in available:\n            if name == state[\"active\"]:\n                return name, env\n    for name, env in available:\n        if _probe_profile(env):\n            if state.get(\"active\") != name:\n                eprint(f\"cluster Kafka actif : {name} ({env['KAFKA_BOOTSTRAP']})\")\n            _write_state(name)\n            return name, env\n    # aucun cluster joignable : on garde le premier (l'erreur sera explicite)\n    name, env = available[0]\n    _write_state(name)\n    return name, env\n\n\ndef kafka_config(extra: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:\n    \"\"\"Configuration librdkafka (§8 : sasl.mechanism au singulier, endpoint none).\n\n    Elle part du profil ACTIF : basculement automatique vers le repli.\n    \"\"\"\n    _name, env = active_profile()\n    return _config_for(env, extra)\n\n\ndef topic(name: str, prefix: Optional[str] = None) -> str:\n    \"\"\"Nom du topic.\n\n    Le suffixe \"reports\" est special : les rapports d'agents vivent dans\n    <prefix>-reports, HORS de l'espace otel.* qui ne contient que la\n    telemetrie (criteres §9.2).\n    \"\"\"\n    p = prefix or os.environ.get(\"KAFKA_TOPIC_PREFIX\", \"otel\")\n    if name == \"reports\":\n        return f\"{p}-reports\"\n    return f\"{p}.{name}\"\n\n\ndef ensure_kafka_interpreter() -> None:\n    \"\"\"Re-execute le script avec le python du venv dedie (§0.6).\n\n    Permet d'appeler ./seed, ./trace-dump ou ./tools/preflight directement,\n    sans avoir a passer par tools/venv.sh.\n    \"\"\"\n    try:\n        import confluent_kafka  # type: ignore  # noqa: F401\n        return\n    except ImportError:\n        pass\n    if os.environ.get(\"KAFKA_VENV_REEXEC\") == \"1\":\n        return\n    venv = os.environ.get(\"KAFKA_VENV\") or os.path.expanduser(\"~/.venvs/aiven-kafka\")\n    py = os.path.join(venv, \"bin\", \"python\")\n    if os.path.exists(py):\n        os.environ[\"KAFKA_VENV_REEXEC\"] = \"1\"\n        os.execv(py, [py, os.path.abspath(sys.argv[0])] + sys.argv[1:])\n\n\ndef import_kafka():\n    \"\"\"Importe confluent_kafka depuis le venv dedie (§0.6).\"\"\"\n    ensure_kafka_interpreter()\n    try:\n        import confluent_kafka  # type: ignore\n        return confluent_kafka\n    except ImportError as exc:\n        raise ConfigError(\n            \"confluent-kafka absent du Python systeme -> utilise le venv dedie : \"\n            \"./tools/venv.sh exec <commande>  (ou ./tools/venv.sh install)\"\n        ) from exc\n\n\ndef suffix_for_topic(topic_name: str, prefix: Optional[str] = None) -> str:\n    \"\"\"« otel.traces » -> « traces », « otel-reports » -> « reports ».\"\"\"\n    p = prefix or os.environ.get(\"KAFKA_TOPIC_PREFIX\", \"otel\")\n    for sep in (\".\", \"-\"):\n        if topic_name.startswith(p + sep):\n            return topic_name[len(p) + 1:]\n    return topic_name.rsplit(\".\", 1)[-1]\n\n\ndef admin_client(client_id: str = \"aiven-kafka-demo\"):\n    \"\"\"Client d'administration (AdminClient vit dans confluent_kafka.admin).\"\"\"\n    import_kafka()\n    from confluent_kafka.admin import AdminClient  # type: ignore\n\n    return AdminClient(kafka_config({\"client.id\": client_id}))\n\n\n# --------------------------------------------------------------------------\n# producteur\n# --------------------------------------------------------------------------\nclass Publisher:\n    \"\"\"Producteur avec collecte des erreurs de livraison (§8 piege 8).\n\n    producer.flush() seul ne dit rien : sans rappel de livraison, une ACL\n    refusee passe inapercue. Ici chaque livraison est verifiee.\n    \"\"\"\n\n    def __init__(self, prefix: Optional[str] = None) -> None:\n        self.ck = import_kafka()\n        name, env = active_profile()\n        self.profile = name\n        self.prefix = prefix or env.get(\"KAFKA_TOPIC_PREFIX\") or \"otel\"\n        self.errors: List[str] = []\n        self.delivered = 0\n        self._lock = __import__(\"threading\").Lock()\n        self._producer = self.ck.Producer(kafka_config({\n            \"client.id\": \"aiven-kafka-demo-seed\",\n            \"linger.ms\": 5,\n            \"acks\": \"all\",\n        }))\n\n    def _on_delivery(self, err, _msg) -> None:\n        with self._lock:\n            if err is not None:\n                self.errors.append(str(err))\n            else:\n                self.delivered += 1\n\n    def send(self, topic_suffix: str, key: str, payload: str) -> None:\n        self.send_to(topic(topic_suffix, self.prefix), key, payload)\n\n    def send_to(self, topic_name: str, key: str, payload: str) -> None:\n        try:\n            self._producer.produce(\n                topic_name,\n                key=key.encode(\"utf-8\"),\n                value=payload.encode(\"utf-8\"),\n                on_delivery=self._on_delivery,\n            )\n            self._producer.poll(0)\n        except Exception as exc:  # noqa: BLE001 - message utilisateur, pas de traceback\n            raise KafkaUnreachable(\n                f\"publication impossible sur {topic_name} : {exc}\"\n            ) from exc\n\n    def flush(self, timeout: float = 30.0) -> None:\n        remaining = self._producer.flush(timeout)\n        if remaining:\n            raise KafkaUnreachable(\n                f\"{remaining} message(s) non livres en {timeout:.0f}s -> \"\n                \"verifie le reseau et les ACL Write\"\n            )\n        if self.errors:\n            raise KafkaUnreachable(\n                \"livraison refusee par le broker : \" + \"; \".join(sorted(set(self.errors))[:3])\n            )\n\n\n# --------------------------------------------------------------------------\n# consommateur\n# --------------------------------------------------------------------------\ndef read_messages(prefix: Optional[str] = None,\n                  suffixes: Optional[List[str]] = None,\n                  trace_id: Optional[str] = None,\n                  group_id: Optional[str] = None,\n                  idle_seconds: float = 6.0,\n                  timeout_seconds: float = 45.0,\n                  max_messages: int = 20000,\n                  attempts: int = 3) -> Dict[str, List[dict]]:\n    \"\"\"Lit les topics depuis le debut et renvoie les messages par suffixe.\n\n    trace_id : ne garder que les messages de cette trace (None = tout).\n    Ne leve jamais : un topic absent ou un broker injoignable donne une\n    liste vide et un diagnostic dans stderr.\n\n    Le broker Aiven peut refuser la premiere negociation SASL (les identifiants\n    SCRAM ne sont pas encore propages sur l'autre noeud du cluster) : on\n    reessaie avec un nouveau consommateur plutot que de renvoyer une liste\n    vide qui ferait croire a une trace absente.\n    \"\"\"\n    result: Dict[str, List[dict]] = {}\n    for attempt in range(max(1, attempts)):\n        result = _read_once(prefix, suffixes, trace_id, group_id, idle_seconds,\n                             timeout_seconds, max_messages)\n        if any(result.values()):\n            return result\n        if attempt < attempts - 1:\n            time.sleep(2)\n    return result\n\n\ndef _read_once(prefix: Optional[str] = None,\n               suffixes: Optional[List[str]] = None,\n               trace_id: Optional[str] = None,\n               group_id: Optional[str] = None,\n               idle_seconds: float = 6.0,\n               timeout_seconds: float = 45.0,\n               max_messages: int = 20000) -> Dict[str, List[dict]]:\n    \"\"\"Une passe de lecture (voir read_messages pour la politique de retry).\"\"\"\n    import time\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"        pass\n\n\ndef invalidate_profile_cache() -> None:\n    \"\"\"Force un nouveau sondage (le watcher l'appelle apres une erreur).\"\"\"\n    state = _read_state()\n    state[\"at\"] = 0\n    try:\n        PROFILE_STATE.parent.mkdir(parents=True, exist_ok=True)\n        PROFILE_STATE.write_text(json.dumps(state), encoding=\"utf-8\")\n    except OSError:\n        pass\n\n\ndef _config_for(env: Dict[str, str], extra: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:\n    \"\"\"Configuration librdkafka a partir d'un jeu de variables explicite.\"\"\"\n    cfg: Dict[str, Any] = {\n        \"bootstrap.servers\": env[\"KAFKA_BOOTSTRAP\"],\n        \"security.protocol\": env.get(\"KAFKA_SECURITY_PROTOCOL\", \"SASL_SSL\"),\n        \"sasl.mechanism\": env.get(\"KAFKA_SASL_MECHANISM\", \"SCRAM-SHA-256\"),\n        \"sasl.username\": env[\"KAFKA_USERNAME\"],\n        \"sasl.password\": env[\"KAFKA_PASSWORD\"],\n        \"ssl.ca.location\": env[\"KAFKA_CA_FILE\"],\n        # le certificat Aiven porte le nom du SERVICE, pas celui du broker\n        \"ssl.endpoint.identification.algorithm\": \"none\",\n        # le DNS Aiven resout d'abord en IPv6 NAT64 : on force IPv4\n        \"broker.address.family\": os.environ.get(\"KAFKA_ADDRESS_FAMILY\", \"v4\"),\n        \"socket.timeout.ms\": int(os.environ.get(\"KAFKA_SOCKET_TIMEOUT_MS\", \"10000\")),\n        \"request.timeout.ms\": int(os.environ.get(\"KAFKA_REQUEST_TIMEOUT_MS\", \"15000\")),\n    }\n    if extra:\n        cfg.update(extra)\n    return cfg\n\n\ndef _probe_profile(env: Dict[str, str]) -> bool:\n    \"\"\"Le cluster du profil repond-il ? (metadata, timeout court)\"\"\"\n    try:\n        from confluent_kafka.admin import AdminClient  # type: ignore\n\n        admin = AdminClient(_config_for(env, {\"socket.timeout.ms\": 6000,\n                                               \"request.timeout.ms\": 8000,\n                                               \"log_level\": 3}))\n        admin.list_topics(timeout=8)\n        return True\n    except Exception:  # noqa: BLE001\n        return False\n\n\ndef active_profile(force: bool = False) -> Tuple[str, Dict[str, str]]:\n    \"\"\"Retourne (nom, variables) du cluster a utiliser.\n\n    - un seul cluster en service (kafka-1687d005) : le profil « primary » ;\n    - KAFKA_PROFILE=primary|fallback force un profil (fallback n'existe que si\n      KAFKA_FALLBACK_ENV_FILE est defini) ;\n    - le choix reste partage via un fichier d'etat commun a tous les outils.\n    \"\"\"\n    available = profiles()\n    if not available:\n        raise ConfigError(\n            \"configuration incomplete : aucun profil Kafka exploitable \"\n            \"(variables KAFKA_* absentes : lance ./provision.sh)\"\n        )\n    forced = os.environ.get(\"KAFKA_PROFILE\")\n    if forced:\n        for name, env in available:\n            if name == forced:\n                return name, env\n    state = _read_state()\n    now = time.time()\n    if not force and state.get(\"active\") and now - float(state.get(\"at\", 0)) < HEALTH_TTL_S:\n        for name, env in available:\n            if name == state[\"active\"]:\n                return name, env\n    for name, env in available:\n        if _probe_profile(env):\n            if state.get(\"active\") != name:\n                eprint(f\"cluster Kafka actif : {name} ({env['KAFKA_BOOTSTRAP']})\")\n            _write_state(name)\n            return name, env\n    # aucun cluster joignable : on garde le premier (l'erreur sera explicite)\n    name, env = available[0]\n    _write_state(name)\n    return name, env\n\n\ndef kafka_config(extra: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:\n    \"\"\"Configuration librdkafka (§8 : sasl.mechanism au singulier, endpoint none).\n\n    Elle part du profil ACTIF : basculement automatique vers le repli.\n    \"\"\"\n    _name, env = active_profile()\n    return _config_for(env, extra)\n\n\ndef topic(name: str, prefix: Optional[str] = None) -> str:\n    \"\"\"Nom du topic.\n\n    Le suffixe \"reports\" est special : les rapports d'agents vivent dans\n    <prefix>-reports, HORS de l'espace otel.* qui ne contient que la\n    telemetrie (criteres §9.2).\n    \"\"\"\n    p = prefix or os.environ.get(\"KAFKA_TOPIC_PREFIX\", \"otel\")\n    if name == \"reports\":\n        return f\"{p}-reports\"\n    return f\"{p}.{name}\"\n\n\ndef ensure_kafka_interpreter() -> None:\n    \"\"\"Re-execute le script avec le python du venv dedie (§0.6).\n\n    Permet d'appeler ./seed, ./trace-dump ou ./tools/preflight directement,\n    sans avoir a passer par tools/venv.sh.\n    \"\"\"\n    try:\n        import confluent_kafka  # type: ignore  # noqa: F401\n        return\n    except ImportError:\n        pass\n    if os.environ.get(\"KAFKA_VENV_REEXEC\") == \"1\":\n        return\n    venv = os.environ.get(\"KAFKA_VENV\") or os.path.expanduser(\"~/.venvs/aiven-kafka\")\n    py = os.path.join(venv, \"bin\", \"python\")\n    if os.path.exists(py):\n        os.environ[\"KAFKA_VENV_REEXEC\"] = \"1\"\n        os.execv(py, [py, os.path.abspath(sys.argv[0])] + sys.argv[1:])\n\n\ndef import_kafka():\n    \"\"\"Importe confluent_kafka depuis le venv dedie (§0.6).\"\"\"\n    ensure_kafka_interpreter()\n    try:\n        import confluent_kafka  # type: ignore\n        return confluent_kafka\n    except ImportError as exc:\n        raise ConfigError(\n            \"confluent-kafka absent du Python systeme -> utilise le venv dedie : \"\n            \"./tools/venv.sh exec <commande>  (ou ./tools/venv.sh install)\"\n        ) from exc\n\n\ndef suffix_for_topic(topic_name: str, prefix: Optional[str] = None) -> str:\n    \"\"\"« otel.traces » -> « traces », « otel-reports » -> « reports ».\"\"\"\n    p = prefix or os.environ.get(\"KAFKA_TOPIC_PREFIX\", \"otel\")\n    for sep in (\".\", \"-\"):\n        if topic_name.startswith(p + sep):\n            return topic_name[len(p) + 1:]\n    return topic_name.rsplit(\".\", 1)[-1]\n\n\ndef admin_client(client_id: str = \"aiven-kafka-demo\"):\n    \"\"\"Client d'administration (AdminClient vit dans confluent_kafka.admin).\"\"\"\n    import_kafka()\n    from confluent_kafka.admin import AdminClient  # type: ignore\n\n    return AdminClient(kafka_config({\"client.id\": client_id}))\n\n\n# --------------------------------------------------------------------------\n# producteur\n# --------------------------------------------------------------------------\nclass Publisher:\n    \"\"\"Producteur avec collecte des erreurs de livraison (§8 piege 8).\n\n    producer.flush() seul ne dit rien : sans rappel de livraison, une ACL\n    refusee passe inapercue. Ici chaque livraison est verifiee.\n    \"\"\"\n\n    def __init__(self, prefix: Optional[str] = None) -> None:\n        self.ck = import_kafka()\n        name, env = active_profile()\n        self.profile = name\n        self.prefix = prefix or env.get(\"KAFKA_TOPIC_PREFIX\") or \"otel\"\n        self.errors: List[str] = []\n        self.delivered = 0\n        self._lock = __import__(\"threading\").Lock()\n        self._producer = self.ck.Producer(kafka_config({\n            \"client.id\": \"aiven-kafka-demo-seed\",\n            \"linger.ms\": 5,\n            \"acks\": \"all\",\n        }))\n\n    def _on_delivery(self, err, _msg) -> None:\n        with self._lock:\n            if err is not None:\n                self.errors.append(str(err))\n            else:\n                self.delivered += 1\n\n    def send(self, topic_suffix: str, key: str, payload: str) -> None:\n        self.send_to(topic(topic_suffix, self.prefix), key, payload)\n\n    def send_to(self, topic_name: str, key: str, payload: str) -> None:\n        try:\n            self._producer.produce(\n                topic_name,\n                key=key.encode(\"utf-8\"),\n                value=payload.encode(\"utf-8\"),\n                on_delivery=self._on_delivery,\n            )\n            self._producer.poll(0)\n        except Exception as exc:  # noqa: BLE001 - message utilisateur, pas de traceback\n            raise KafkaUnreachable(\n                f\"publication impossible sur {topic_name} : {exc}\"\n            ) from exc\n\n    def flush(self, timeout: float = 30.0) -> None:\n        remaining = self._producer.flush(timeout)\n        if remaining:\n            raise KafkaUnreachable(\n                f\"{remaining} message(s) non livres en {timeout:.0f}s -> \"\n                \"verifie le reseau et les ACL Write\"\n            )\n        if self.errors:\n            raise KafkaUnreachable(\n                \"livraison refusee par le broker : \" + \"; \".join(sorted(set(self.errors))[:3])\n            )\n\n\n# --------------------------------------------------------------------------\n# consommateur\n# --------------------------------------------------------------------------\ndef read_messages(prefix: Optional[str] = None,\n                  suffixes: Optional[List[str]] = None,\n                  trace_id: Optional[str] = None,\n                  group_id: Optional[str] = None,\n                  idle_seconds: float = 6.0,\n                  timeout_seconds: float = 45.0,\n                  max_messages: int = 20000,\n                  attempts: int = 3) -> Dict[str, List[dict]]:\n    \"\"\"Lit les topics depuis le debut et renvoie les messages par suffixe.\n\n    trace_id : ne garder que les messages de cette trace (None = tout).\n    Ne leve jamais : un topic absent ou un broker injoignable donne une\n    liste vide et un diagnostic dans stderr.\n\n    Le broker Aiven peut refuser la premiere negociation SASL (les identifiants\n    SCRAM ne sont pas encore propages sur l'autre noeud du cluster) : on\n    reessaie avec un nouveau consommateur plutot que de renvoyer une liste\n    vide qui ferait croire a une trace absente.\n    \"\"\"\n    result: Dict[str, List[dict]] = {}\n    for attempt in range(max(1, attempts)):\n        result = _read_once(prefix, suffixes, trace_id, group_id, idle_seconds,\n                             timeout_seconds, max_messages)\n        if any(result.values()):\n            return result\n        if attempt < attempts - 1:\n            time.sleep(2)\n    return result\n\n\ndef _read_once(prefix: Optional[str] = None,\n               suffixes: Optional[List[str]] = None,\n               trace_id: Optional[str] = None,\n               group_id: Optional[str] = None,\n               idle_seconds: float = 6.0,\n               timeout_seconds: float = 45.0,\n               max_messages: int = 20000) -> Dict[str, List[dict]]:\n    \"\"\"Une passe de lecture (voir read_messages pour la politique de retry).\"\"\"\n    import time\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /home/baptistefaisy/aiven-kafka-demo && sed -n 140,400p 