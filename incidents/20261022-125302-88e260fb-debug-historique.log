\\\",\\\"db.source.table\\\":\\\"erreurs.app_errors\\\"},\\\"ScopeName\\\":\\\"erreurs\\\",\\\"ScopeVersion\\\":\\\"1.0\\\",\\\"ResourceAttributes\\\":{\\\"service.name\\\":\\\"agent-demo\\\",\\\"deployment.environment\\\":\\\"prod\\\",\\\"service.version\\\":\\\"erreurs-db-1.0\\\"},\\\"ServiceName\\\":\\\"agent-demo\\\"}\", \"h\": \"cb4eae6af61599351781f8937891c65d5c9a79156f9492edf4656139b349e24d\"}\n./migration-backup/agent-kafka-20261022/otel.logs.jsonl:46:{\"topic\": \"otel.logs\", \"partition\": 0, \"offset\": 45, \"key\": \"d41130474324c5ace9e4146a0d83e0c9\", \"value\": \"{\\\"Timestamp\\\":\\\"2026-10-21 18:02:19.599\\\",\\\"TraceId\\\":\\\"d41130474324c5ace9e4146a0d83e0c9\\\",\\\"SpanId\\\":\\\"4f74afc9590acdac\\\",\\\"ParentSpanId\\\":\\\"\\\",\\\"TraceFlags\\\":\\\"01\\\",\\\"SeverityText\\\":\\\"ERROR\\\",\\\"SeverityNumber\\\":17,\\\"Body\\\":\\\"No space left on device: write /var/lib/app/telemetry-buffer failed\\\",\\\"LogAttributes\\\":{\\\"agent.scenario\\\":\\\"platform_disk_full\\\",\\\"agent.profile\\\":\\\"infra\\\",\\\"error.type\\\":\\\"disk_full\\\",\\\"exception.message\\\":\\\"java.io.IOException: No space left on device: write /var/lib/app/telemetry-buffer failed\\\",\\\"file.path\\\":\\\"/var/lib/app/telemetry-buffer\\\",\\\"filesystem.type\\\":\\\"ext4\\\",\\\"system.disk.usage\\\":\\\"100\\\",\\\"system.disk.free\\\":\\\"0\\\",\\\"system.disk.size\\\":\\\"53687091200\\\"},\\\"SpanAttributes\\\":{\\\"agent.scenario\\\":\\\"platform_disk_full\\\",\\\"agent.profile\\\":\\\"infra\\\",\\\"error.type\\\":\\\"disk_full\\\",\\\"exception.message\\\":\\\"java.io.IOException: No space left on device: write /var/lib/app/telemetry-buffer failed\\\",\\\"file.path\\\":\\\"/var/lib/app/telemetry-buffer\\\",\\\"filesystem.type\\\":\\\"ext4\\\",\\\"system.disk.usage\\\":\\\"100\\\",\\\"system.disk.free\\\":\\\"0\\\",\\\"system.disk.size\\\":\\\"53687091200\\\"},\\\"ScopeName\\\":\\\"agent\\\",\\\"ScopeVersion\\\":\\\"1.0\\\",\\\"ResourceAttributes\\\":{\\\"service.name\\\":\\\"agent-demo\\\",\\\"deployment.environment\\\":\\\"demo\\\"},\\\"ServiceName\\\":\\\"agent-demo\\\"}\", \"h\": \"07d01d54d8060d435c7d56b51b90f210898946e00c1617d1b7096f673cef1923\"}\n./migration-backup/agent-kafka-20261022/otel.metrics.jsonl:11:{\"topic\": \"otel.metrics\", \"partition\": 0, \"offset\": 10, \"key\": \"a03c79be3db4451b939eca343ee69502\", \"value\": \"{\\\"MetricName\\\":\\\"system.disk.usage\\\",\\\"MetricUnit\\\":\\\"%\\\",\\\"Attributes\\\":{\\\"agent.scenario\\\":\\\"platform_disk_full\\\",\\\"agent.profile\\\":\\\"infra\\\",\\\"error.type\\\":\\\"disk_full\\\",\\\"file.path\\\":\\\"/var/lib/app/telemetry-buffer\\\",\\\"filesystem.type\\\":\\\"ext4\\\"},\\\"TimeUnix\\\":1792605739599000000,\\\"Value\\\":100,\\\"HistogramBucketCounts\\\":[],\\\"HistogramExplicitBounds\\\":[],\\\"HistogramExemplars\\\":[],\\\"HistogramCounts\\\":[]}\", \"h\": \"6d07dbc2eef44b26158854b4bfe24da12d26874955636d93e13357a7400c454d\"}\n./migration-backup/agent-kafka-20261022/otel.metrics.jsonl:12:{\"topic\": \"otel.metrics\", \"partition\": 0, \"offset\": 11, \"key\": \"a03c79be3db4451b939eca343ee69502\", \"value\": \"{\\\"MetricName\\\":\\\"system.disk.free\\\",\\\"MetricUnit\\\":\\\"By\\\",\\\"Attributes\\\":{\\\"agent.scenario\\\":\\\"platform_disk_full\\\",\\\"agent.profile\\\":\\\"infra\\\",\\\"error.type\\\":\\\"disk_full\\\",\\\"file.path\\\":\\\"/var/lib/app/telemetry-buffer\\\",\\\"filesystem.type\\\":\\\"ext4\\\"},\\\"TimeUnix\\\":1792605739599000000,\\\"Value\\\":0,\\\"HistogramBucketCounts\\\":[],\\\"HistogramExplicitBounds\\\":[],\\\"HistogramExemplars\\\":[],\\\"HistogramCounts\\\":[]}\", \"h\": \"3e746411e9f2bce940df10ce2606dd4d7a19a9fe7cfc5d5e9d466f0cae1c4ab3\"}\n=== /var/lib/app refs ===\n./scenarios/catalog.json\n./site/scenarios/catalog.json\n./db/erreurs_seed.sql\n./migration-backup/agent-kafka-20261022/otel-reports.jsonl\n./migration-backup/agent-kafka-20261022/otel.logs.jsonl\n./migration-backup/agent-kafka-20261022/otel.metrics.jsonl\n./migration-backup/agent-kafka-20261022/otel.traces.jsonl\n./README.md\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"./site/scenarios/catalog.json:440:      \"log_body\": \"No space left on device: write /var/lib/app/telemetry-buffer failed\",\n./site/scenarios/catalog.json:441:      \"exception_message\": \"java.io.IOException: No space left on device: write /var/lib/app/telemetry-buffer failed\",\n./site/scenarios/catalog.json:453:            \"exception.message\": \"java.io.IOException: No space left on device: write /var/lib/app/telemetry-buffer failed\",\n./site/scenarios/catalog.json:454:            \"file.path\": \"/var/lib/app/telemetry-buffer\",\n./site/scenarios/catalog.json:469:            \"file.path\": \"/var/lib/app/telemetry-buffer\",\n./site/scenarios/catalog.json:483:          \"body\": \"No space left on device: write /var/lib/app/telemetry-buffer failed\",\n./site/scenarios/catalog.json:486:            \"exception.message\": \"java.io.IOException: No space left on device: write /var/lib/app/telemetry-buffer failed\",\n./site/scenarios/catalog.json:487:            \"file.path\": \"/var/lib/app/telemetry-buffer\",\n./site/scenarios/catalog.json:502:            \"file.path\": \"/var/lib/app/telemetry-buffer\",\n./site/scenarios/catalog.json:512:            \"file.path\": \"/var/lib/app/telemetry-buffer\",\n./site/scenarios/catalog.json:522:            \"file.path\": \"/var/lib/app/telemetry-buffer\",\n./db/erreurs_seed.sql:60: 'java.io.IOException: No space left on device: write /var/lib/app/telemetry-buffer failed',\n./db/erreurs_seed.sql:63: '{\"file.path\":\"/var/lib/app/telemetry-buffer\",\"filesystem.type\":\"ext4\",\"system.disk.usage\":\"100\",\"system.disk.free\":\"0\",\"system.disk.size\":\"53687091200\"}'::jsonb,\n./migration-backup/agent-kafka-20261022/otel-reports.jsonl:4:{\"topic\": \"otel-reports\", \"partition\": 0, \"offset\": 3, \"key\": \"a03c79be3db4451b939eca343ee69502\", \"value\": \"{\\\"Timestamp\\\": \\\"2026-10-22 08:00:44.009\\\", \\\"TraceId\\\": \\\"a03c79be3db4451b939eca343ee69502\\\", \\\"agent\\\": \\\"runtime-diagnose\\\", \\\"error_type\\\": \\\"disk_full\\\", \\\"scenario\\\": \\\"platform_disk_full\\\", \\\"title\\\": \\\"[disk_full] a03c79be\\\", \\\"exit_code\\\": 0, \\\"report\\\": \\\"## PANNIE\\\\n\\\\n**Ressource saturée : volume disque à 100 %, 0 octet libre.** Ce n'est pas le heap.\\\\n\\\\n- `system.disk.usage` = **100 %**, `system.disk.free` = **0 B**, `system.disk.size` = **53 687 091 200 B (50 GiB)** → les 50 GiB sont consommés.\\\\n- Le symptôme observable est l'échec d'écriture : `file.write` (700 ms) puis `agent.run` (900 ms) en `Error`, `java.io.IOException: No space left on device`.\\\\n- Conséquence métier réelle : `agent.result` = `{\\\\\\\"success\\\\\\\":false,\\\\\\\"booking_confirmed\\\\\\\":false,\\\\\\\"tool_confirmed\\\\\\\":false,\\\\\\\"tool_calls\\\\\\\":1}` → **l'action n'a pas abouti**, ce n'est pas un échec silencieux (détecteur `silent_failure` = `ok`).\\\\n\\\\nAucune métrique `jvm.*` dans cette trace → **l'hypothèse OOM / heap saturé est écartée faute de preuve**, pas confirmée. Rien à conclure côté GC.\\\\n\\\\n## CAUSE\\\\n\\\\n**Cause racine = le volume qui porte `/var/lib/app/telemetry-buffer` est plein (tampon de télémétrie qui grossit, sans purge/rotation efficace).**\\\\n**Symptôme = l'agent qui échoue au moment d'écrire dedans.**\\\\n\\\\nDistinction explicite :\\\\n- `system.disk.free` = **0** exactement et `filesystem.type` = `ext4` → l'ENOSPC est bien un manque de place, **pas** un échec d'écriture (I/O, permissions, FS read-only, inode) : un FS en erreur laisserait de la place libre.\\\\n- `file.path` désigne **quel volume** : le buffer de télémétrie applicatif, pas le disque système ni les logs Kafka. C'est donc le producteur de télémétrie qui remplit son propre tampon.\\\\n- Les 700 ms passées dans `file.write` avant l'échec sont cohérentes avec une tentative de flush/vidage du buffer sur un volume déjà à zéro.\\\\n\\\\nRéserve de méthode : la trace ne contient qu'un **instantané** de métrique, pas de série temporelle → je ne peux pas prouver « croissance progressive » vs « pic soudain ». Ce qui est prouvé, c'est l'état saturé et le volume responsable ; la nature exacte de la croissance (rétention absente, segments jamais purgés, backlog de télémétrie) reste à confirmer par la taille des fichiers sur l'hôte.\\\\n\\\\n## PREUVES\\\\n\\\\n| Preuve | Valeur | Source |\\\\n|---|---|---|\\\\n| `system.disk.usage` | 100 % | métrique trace |\\\\n| `system.disk.free` | 0 B | métrique trace |\\\\n| `system.disk.size` | 53 687 091 200 B = 50 GiB | métrique trace |\\\\n| `file.path` | `/var/lib/app/telemetry-buffer` | attribut span + métrique |\\\\n| `filesystem.type` | ext4 | attribut |\\\\n| Erreur | `IOException: No space left on device: write … failed` | span `file.write` + log ERROR sev 17 @ 18:02:19.599 |\\\\n| Spans en erreur | 2/2 (`file.write` 700 ms, `agent.run` 900 ms) | spans |\\\\n| `retry_spiral` / `silent_failure` / `stale_source` | `ok` / `ok` / `ok` | détecteurs |\\\\n\\\\nContre-vérification locale (poste de travail, **pas** l'hôte de l'agent) : `/` sur `/dev/vdb` à **14 % (79 G libres)**, et `/var/lib/app/telemetry-buffer` **n'existe pas** ici → le poste n'est pas la machine en cause, je reste donc sur les métriques de la trace. Mémoire locale : 6 546 Mo total, 1 279 Mo disponibles, swap 0 (sans lien avec cet incident).\\\\n\\\\nNote annexe, non conclusive : `trace-dump` a rencontré un `_TIMED_OUT` sur la récupération des métadonnées Kafka (côté lecture de mon outil). Sans rapport avec `disk_full`, et je n'appelle pas `kafka-health` : ce type d'erreur est un problème de ressource hôte, pas un échec broker.\\\\n\\\\n## ACTION\\\\n\\\\n1. **Identifier le montage exact** (confirmer que c'est bien le volume du buffer) :\\\\n   `findmnt -T /var/lib/app/telemetry-buffer && df -h /var/lib/app/telemetry-buffer`\\\\n2. **Localiser le gros consommateur** avant toute suppression :\\\\n   `du -sh /var/lib/app/telemetry-buffer/* | sort -h | tail -20`\\\\n   `ls -lhS /var/lib/app/telemetry-buffer | head`\\\\n3. **Purger le buffer** — tronquer ou supprimer les **segments les plus anciens**, jamais le fichier actif de l'agent :\\\\n   `find /var/lib/app/telemetry-buffer -type f -name '*.buf*' -mtime +1 -delete`\\\\n   (ou `truncate -s 0` sur les archives déjà livrées)\\\\n4. **Redimensionner le volume** si la rétention doit être conservée (ext4, donc grow online) :\\\\n   agrandir le volume côté plateforme → `growpart /dev/<dev> <n>` → `resize2fs /dev/<dev><n>`\\\\n   Cible : repasser au-dessus du seuil d'alerte, garder **≥ 20 % libres** sur 50 GiB.\\\\n5. **Corriger la cause racine** : poser une **rétention/quota** sur `telemetry-buffer` (taille max + purge planifiée), sinon le disque se remplira de nouveau à l'identique. Vérifier que l'agent ne passe pas en boucle de réécriture quand l'écriture échoue (`retry_spiral` est `ok` ici, à surveiller après correctif).\\\\n6. **Valider** : `df` avec `Avail > 0`, puis rejouer le scénario et vérifier `agent.result.success = true` et `booking_confirmed = true`.\\\"}\", \"h\": \"c6d34de54c0c207e70bd044677d5eb5820bca90643ba98dd221a9a2d9ab1685c\"}\n./migration-backup/agent-kafka-20261022/otel-reports.jsonl:14:{\"topic\": \"otel-reports\", \"partition\": 0, \"offset\": 13, \"key\": \"e5a9b1c3d7f06a4b1c2d3e4f5a6b7c8d\", \"value\": \"{\\\"Timestamp\\\": \\\"2026-10-22 08:29:08.865\\\", \\\"TraceId\\\": \\\"e5a9b1c3d7f06a4b1c2d3e4f5a6b7c8d\\\", \\\"agent\\\": \\\"runtime-diagnose\\\", \\\"error_type\\\": \\\"disk_full\\\", \\\"scenario\\\": \\\"db/disk_full\\\", \\\"title\\\": \\\"[disk_full] e5a9b1c3\\\", \\\"exit_code\\\": 0, \\\"report\\\": \\\"## ÉTAT — ressource saturée : OUI, disque (pas le heap)\\\\n\\\\n| Ressource | Mesure | Verdict |\\\\n|---|---|---|\\\\n| Disque `/var/lib/app/telemetry-buffer` | `system.disk.usage = 100 %`, `system.disk.free = 0 B`, `size = 53 687 091 200 B` (**50 GiB**) | **saturé** |\\\\n| Heap JVM | aucun attribut `jvm.memory.used` / `jvm.memory.limit` dans la trace | **non impliqué** — pas d'OOM |\\\\n| GC | aucun `jvm.gc.pause` émis | pas de pression mémoire avant crash |\\\\n| Poste local | `/dev/vdb 91 G, 14 % utilisé, 79 G libres ; RAM 6,5 G dont 1,1 G dispo` | **hors sujet** : l'incident est sur `app-3.prod.internal`, pas sur cette machine |\\\\n\\\\n## CAUSE\\\\n\\\\n- **Cause racine** : le volume ext4 qui porte `/var/lib/app/telemetry-buffer` sur `app-3.prod.internal` est plein à 100 % (0 octet libre sur 50 GiB). Le tampon de télémétrie a grossi jusqu'à consommer tout le volume — aucun mécanisme de purge/rotation ne l'a contenu.\\\\n- **Symptôme** : l'écriture de l'agent échoue (`IOException: No space left on device`, span `file.write` en 42 ms → échec immédiat, pas un timeout), remonté en HTTP 500 et journalisé dans `erreurs.app_errors`.\\\\n- **Ni fuite mémoire ni GC mal réglé** : `error.type = disk_full`, aucun compteur heap dans la trace. Ne pas aller régler la JVM.\\\\n- **Ni quota applicatif** : `db.error.origin = application`, 0 octet libre au niveau filesystem → c'est bien le volume qui est plein, pas une limite logique.\\\\n\\\\n## PREUVES\\\\n\\\\n```\\\\ntrace e5a9b1c3d7f06a4b1c2d3e4f5a6b7c8d  scenario=db/disk_full  profile=prod\\\\nspan  07:44:50.196  file.write  42.0ms  Error\\\\n      file.path=/var/lib/app/telemetry-buffer   filesystem.type=ext4\\\\n      system.disk.size=53687091200 (50 GiB)  system.disk.free=0  system.disk.usage=100\\\\n      exception=java.io.IOException: No space left on device\\\\n      http.response.status_code=500   server.address=app-3.prod.internal\\\\n      error.source=postgresql://pg-erreurs/erreurs.app_errors  db.error.id=5\\\\nmetric app.errors = 1 {error.type=disk_full, error.severity=ERROR}\\\\ndetecteurs : retry_spiral ok | silent_failure ok | stale_source ok\\\\n             (aucune spirale de retry → l'agent échoue net, il ne martèle pas le disque)\\\\njvm.* : ABSENTS de la trace (used/limit/gc.pause) → hypothèse OOM écartée faute de preuve\\\\n```\\\\n\\\\n## ACTION\\\\n\\\\n1. **Débloquer (urgence prod)** — purger le tampon sur l'hôte fautif, pas sur le broker :\\\\n   ```sh\\\\n   ssh app-3.prod.internal 'df -h /var/lib/app/telemetry-buffer; du -sh /var/lib/app/telemetry-buffer'\\\\n   ssh app-3.prod.internal 'find /var/lib/app/telemetry-buffer -type f -mtime +1 -delete'\\\\n   ```\\\\n   Vérifier ensuite `df -h` : `system.disk.free` doit repasser au-dessus du seuil d'alerte (≥ 15 %).\\\\n2. **Traiter la cause** — borner le tampon au lieu de le laisser grossir : rotation + rétention (ex. `size-based` 5 GiB, `max 5 fichiers`) sur le writer de télémétrie, et **backpressure** (drop/rejet explicite quand le seuil haut est atteint) plutôt qu'une écriture illimitée.\\\\n3. **Redimensionner si le volume est structurellement trop petit** — 50 GiB partagés avec le reste de `/var` : étendre le LV ou dédier un volume séparé au buffer (`/var/lib/app/telemetry-buffer` sur son propre FS).\\\\n4. **Surveiller** — alerte à `system.disk.usage > 85 %` **et** `system.disk.free < 5 GiB` sur ce chemin, avant d'atteindre 100 %.\\\\n5. **Rejouer** — après purge, vérifier que `app.errors{error.type=disk_full}` retombe à 0 et que les traces repartent sur `otel.traces`.\\\\n\\\\n*kafka-health non appelé : `disk_full` est un incident d'hôte (filesystem applicatif), pas un état de cluster Kafka — la trace a d'ailleurs bien été consommée depuis `otel.traces`, donc le broker n'est pas en cause.*\\\"}\", \"h\": \"e2825a22404793cd9e4f969cd7913c3adc25b697900b3e598bf9f19d6322660f\"}\n./migration-backup/agent-kafka-20261022/otel.logs.jsonl:5:{\"topic\": \"otel.logs\", \"partition\": 0, \"offset\": 4, \"key\": \"a03c79be3db4451b939eca343ee69502\", \"value\": \"{\\\"Timestamp\\\":\\\"2026-10-21 18:02:19.599\\\",\\\"TraceId\\\":\\\"a03c79be3db4451b939eca343ee69502\\\",\\\"SpanId\\\":\\\"47b29f757effd500\\\",\\\"ParentSpanId\\\":\\\"\\\",\\\"TraceFlags\\\":\\\"01\\\",\\\"SeverityText\\\":\\\"ERROR\\\",\\\"SeverityNumber\\\":17,\\\"Body\\\":\\\"No space left on device: write /var/lib/app/telemetry-buffer failed\\\",\\\"LogAttributes\\\":{\\\"agent.scenario\\\":\\\"platform_disk_full\\\",\\\"agent.profile\\\":\\\"infra\\\",\\\"error.type\\\":\\\"disk_full\\\",\\\"exception.message\\\":\\\"java.io.IOException: No space left on device: write /var/lib/app/telemetry-buffer failed\\\",\\\"file.path\\\":\\\"/var/lib/app/telemetry-buffer\\\",\\\"filesystem.type\\\":\\\"ext4\\\",\\\"system.disk.usage\\\":\\\"100\\\",\\\"system.disk.free\\\":\\\"0\\\",\\\"system.disk.size\\\":\\\"53687091200\\\"},\\\"SpanAttributes\\\":{\\\"agent.scenario\\\":\\\"platform_disk_full\\\",\\\"agent.profile\\\":\\\"infra\\\",\\\"error.type\\\":\\\"disk_full\\\",\\\"exception.message\\\":\\\"java.io.IOException: No space left on device: write /var/lib/app/telemetry-buffer failed\\\",\\\"file.path\\\":\\\"/var/lib/app/telemetry-buffer\\\",\\\"filesystem.type\\\":\\\"ext4\\\",\\\"system.disk.usage\\\":\\\"100\\\",\\\"system.disk.free\\\":\\\"0\\\",\\\"system.disk.size\\\":\\\"53687091200\\\"},\\\"ScopeName\\\":\\\"agent\\\",\\\"ScopeVersion\\\":\\\"1.0\\\",\\\"ResourceAttributes\\\":{\\\"service.name\\\":\\\"agent-demo\\\",\\\"deployment.environment\\\":\\\"demo\\\"},\\\"ServiceName\\\":\\\"agent-demo\\\"}\", \"h\": \"1919a2130b3e756697c2cd7a88f8b1161441f880e19546fc8ba56c2f54c9c79a\"}\n./migration-backup/agent-kafka-20261022/otel.logs.jsonl:26:{\"topic\": \"otel.logs\", \"partition\": 0, \"offset\": 25, \"key\": \"e5a9b1c3d7f06a4b1c2d3e4f5a6b7c8d\", \"value\": \"{\\\"Timestamp\\\":\\\"2026-10-22 07:44:50.196\\\",\\\"TraceId\\\":\\\"e5a9b1c3d7f06a4b1c2d3e4f5a6b7c8d\\\",\\\"SpanId\\\":\\\"a3948d26f4d71fe5\\\",\\\"ParentSpanId\\\":\\\"\\\",\\\"TraceFlags\\\":\\\"01\\\",\\\"SeverityText\\\":\\\"ERROR\\\",\\\"SeverityNumber\\\":17,\\\"Body\\\":\\\"java.io.IOException: No space left on device: write /var/li