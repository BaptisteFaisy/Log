"]:\n        if span[\"name\"] == \"agent.run\":\n            span[\"attributes\"][\"error.type\"] = \"silent_failure\"\n    msgs = build_messages(catalog, silent, trace_id=\"b\" * 32)\n    for key in broken:\n        broken[key].extend(msgs[key])\n\n    # (b) source perimee : version 5 utilisee alors que la version 7 existe\n    stale = json.loads(json.dumps(base))\n    stale[\"id\"] = \"broken_stale_source\"\n    stale[\"error_type\"] = \"stale_source\"\n    for span in stale[\"spans\"]:\n        if span[\"name\"] == \"tool.search_venues\":\n            span[\"attributes\"][\"source.version\"] = \"5\"\n    msgs = build_messages(catalog, stale, trace_id=\"c\" * 32)\n    for key in broken:\n        broken[key].extend(msgs[key])\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"=== catalog: silent ===\n=== erreurs_seed 60-95 ===\n 'java.io.IOException: No space left on device: write /var/lib/app/telemetry-buffer failed',\n 'file.write', NULL, NULL, 500, 'app-3.prod.internal',\n NULL, NULL, NULL, NULL, NULL, NULL, 42,\n '{\"file.path\":\"/var/lib/app/telemetry-buffer\",\"filesystem.type\":\"ext4\",\"system.disk.usage\":\"100\",\"system.disk.free\":\"0\",\"system.disk.size\":\"53687091200\"}'::jsonb,\n 'new'),\n\n-- 6. quota fournisseur depasse ------------------------------------------\n('f6b0c2d4e8a17b5c2d3e4f5a6b7c8d9e', now() - interval '23 minutes',\n 'agent-demo', 'prod', 'WARN', 13, 'rate_limit',\n 'HTTP 429 Too Many Requests from llm-provider (quota: 600 req/min, retry-after: 30s)',\n 'llm.chat', 'POST', '/api/chat', 429, 'app-1.prod.internal',\n NULL, NULL, NULL, NULL, NULL, NULL, 87,\n '{\"http.response.status_code\":\"429\",\"llm.provider\":\"llm-provider\",\"retry_after.s\":\"30\",\"http.retry.count\":\"3\"}'::jsonb,\n 'new'),\n\n-- 7. echec silencieux (promesse non tenue) ------------------------------\n('a7c1d3e5f9b28c6d3e4f5a6b7c8d9e0f', now() - interval '17 minutes',\n 'agent-de