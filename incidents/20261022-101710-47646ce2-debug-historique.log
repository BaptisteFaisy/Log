vk4pIpiQ7UHQXapI2711\",\"tool\":\"shell\",\"state\":{\"status\":\"completed\",\"input\":{\"command\":\"cd /home/baptistefaisy/aiven-kafka-demo && sed -n '154,240p' tools/kafkalib.py\"},\"output\":\"def _config_for(env: Dict[str, str], extra: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:\\n    \\\"\\\"\\\"Configuration librdkafka a partir d'un jeu de variables explicite.\\\"\\\"\\\"\\n    cfg: Dict[str, Any] = {\\n        \\\"bootstrap.servers\\\": env[\\\"KAFKA_BOOTSTRAP\\\"],\\n        \\\"security.protocol\\\": env.get(\\\"KAFKA_SECURITY_PROTOCOL\\\", \\\"SASL_SSL\\\"),\\n        \\\"sasl.mechanism\\\": env.get(\\\"KAFKA_SASL_MECHANISM\\\", \\\"SCRAM-SHA-256\\\"),\\n        \\\"sasl.username\\\": env[\\\"KAFKA_USERNAME\\\"],\\n        \\\"sasl.password\\\": env[\\\"KAFKA_PASSWORD\\\"],\\n        \\\"ssl.ca.location\\\": env[\\\"KAFKA_CA_FILE\\\"],\\n        # le certificat Aiven porte le nom du SERVICE, pas celui du broker\\n        \\\"ssl.endpoint.identification.algorithm\\\": \\\"none\\\",\\n        # le DNS Aiven resout d'abord en IPv6 NAT64 : on force IPv4\\n        \\\"broker.address.family\\\": os.environ.get(\\\"KAFKA_ADDRESS_FAMILY\\\", \\\"v4\\\"),\\n        \\\"socket.timeout.ms\\\": int(os.environ.get(\\\"KAFKA_SOCKET_TIMEOUT_MS\\\", \\\"10000\\\")),\\n        \\\"request.timeout.ms\\\": int(os.environ.get(\\\"KAFKA_REQUEST_TIMEOUT_MS\\\", \\\"15000\\\")),\\n    }\\n    if extra:\\n        cfg.update(extra)\\n    return cfg\\n\\n\\ndef _probe_profile(env: Dict[str, str]) -> bool:\\n    \\\"\\\"\\\"Le cluster du profil repond-il ? (metadata, timeout court)\\\"\\\"\\\"\\n    try:\\n        from confluent_kafka.admin import AdminClient  # type: ignore\\n\\n        admin = AdminClient(_config_for(env, {\\\"socket.timeout.ms\\\": 6000,\\n                                               \\\"request.timeout.ms\\\": 8000,\\n                                               \\\"log_level\\\": 3}))\\n        admin.list_topics(timeout=8)\\n        return True\\n    except Exception:  # noqa: BLE001\\n        return False\\n\\n\\ndef active_profile(force: bool = False) -> Tuple[str, Dict[str, str]]:\\n    \\\"\\\"\\\"Retourne (nom, variables) du cluster a utiliser.\\n\\n    - un seul cluster en service (kafka-1687d005) : le profil « primary » ;\\n    - KAFKA_PROFILE=primary|fallback force un profil (fallback n'existe que si\\n      KAFKA_FALLBACK_ENV_FILE est defini) ;\\n    - le choix reste partage via un fichier d'etat commun a tous les outils.\\n    \\\"\\\"\\\"\\n    available = profiles()\\n    if not available:\\n        raise ConfigError(\\n            \\\"configuration incomplete : aucun profil Kafka exploitable \\\"\\n            \\\"(variables KAFKA_* absentes : lance ./provision.sh)\\\"\\n        )\\n    forced = os.environ.get(\\\"KAFKA_PROFILE\\\")\\n    if forced:\\n        for name, env in available:\\n            if name == forced:\\n                return name, env\\n    state = _read_state()\\n    now = time.time()\\n    if not force and state.get(\\\"active\\\") and now - float(state.get(\\\"at\\\", 0)) < HEALTH_TTL_S:\\n        for name, env in available:\\n            if name == state[\\\"active\\\"]:\\n                return name, env\\n    for name, env in available:\\n        if _probe_profile(env):\\n            if state.get(\\\"active\\\") != name:\\n                eprint(f\\\"cluster Kafka actif : {name} ({env['KAFKA_BOOTSTRAP']})\\\")\\n            _write_state(name)\\n            return name, env\\n    # aucun cluster joignable : on garde le premier (l'erreur sera explicite)\\n    name, env = available[0]\\n    _write_state(name)\\n    return name, env\\n\\n\\ndef kafka_config(extra: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:\\n    \\\"\\\"\\\"Configuration librdkafka (§8 : sasl.mechanism au singulier, endpoint none).\\n\\n    Elle part du profil ACTIF : basculement automatique vers le repli.\\n    \\\"\\\"\\\"\\n    _name, env = active_profile()\\n    return _config_for(env, extra)\\n\\n\\ndef topic(name: str, prefix: Optional[str] = None) -> str:\\n    \\\"\\\"\\\"Nom du topic.\\n\\n    Le suffixe \\\"reports\\\" est special : les rapports d'agents vivent dans\\n    <prefix>-reports, HORS de l'espace otel.* qui ne contient que la\\n    telemetrie (criteres §9.2).\\n\",\"title\":\"shell\",\"metadata\":{\"metadata\":{\"status\":\"completed\",\"truncated\":false,\"exit\":0},\"content\":[{\"type\":\"text\",\"text\":\"def _config_for(env: Dict[str, str], extra: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:\\n    \\\"\\\"\\\"Configuration librdkafka a partir d'un jeu de variables explicite.\\\"\\\"\\\"\\n    cfg: Dict[str, Any] = {\\n        \\\"bootstrap.servers\\\": env[\\\"KAFKA_BOOTSTRAP\\\"],\\n        \\\"security.protocol\\\": env.get(\\\"KAFKA_SECURITY_PROTOCOL\\\", \\\"SASL_SSL\\\"),\\n        \\\"sasl.mechanism\\\": env.get(\\\"KAFKA_SASL_MECHANISM\\\", \\\"SCRAM-SHA-256\\\"),\\n        \\\"sasl.username\\\": env[\\\"KAFKA_USERNAME\\\"],\\n        \\\"sasl.password\\\": env[\\\"KAFKA_PASSWORD\\\"],\\n        \\\"ssl.ca.location\\\": env[\\\"KAFKA_CA_FILE\\\"],\\n        # le certificat Aiven porte le nom du SERVICE, pas celui du broker\\n        \\\"ssl.endpoint.identification.algorithm\\\": \\\"none\\\",\\n        # le DNS Aiven resout d'abord en IPv6 NAT64 : on force IPv4\\n        \\\"broker.address.family\\\": os.environ.get(\\\"KAFKA_ADDRESS_FAMILY\\\", \\\"v4\\\"),\\n        \\\"socket.timeout.ms\\\": int(os.environ.get(\\\"KAFKA_SOCKET_TIMEOUT_MS\\\", \\\"10000\\\")),\\n        \\\"request.timeout.ms\\\": int(os.environ.get(\\\"KAFKA_REQUEST_TIMEOUT_MS\\\", \\\"15000\\\")),\\n    }\\n    if extra:\\n        cfg.update(extra)\\n    return cfg\\n\\n\\ndef _probe_profile(env: Dict[str, str]) -> bool:\\n    \\\"\\\"\\\"Le cluster du profil repond-il ? (metadata, timeout court)\\\"\\\"\\\"\\n    try:\\n        from confluent_kafka.admin import AdminClient  # type: ignore\\n\\n        admin = AdminClient(_config_for(env, {\\\"socket.timeout.ms\\\": 6000,\\n                                               \\\"request.timeout.ms\\\": 8000,\\n                                               \\\"log_level\\\": 3}))\\n        admin.list_topics(timeout=8)\\n        return True\\n    except Exception:  # noqa: BLE001\\n        return False\\n\\n\\ndef active_profile(force: bool = False) -> Tuple[str, Dict[str, str]]:\\n    \\\"\\\"\\\"Retourne (nom, variables) du cluster a utiliser.\\n\\n    - un seul cluster en service (kafka-1687d005) : le profil « primary » ;\\n    - KAFKA_PROFILE=primary|fallback force un profil (fallback n'existe que si\\n      KAFKA_FALLBACK_ENV_FILE est defini) ;\\n    - le choix reste partage via un fichier d'etat commun a tous les outils.\\n    \\\"\\\"\\\"\\n    available = profiles()\\n    if not available:\\n        raise ConfigError(\\n            \\\"configuration incomplete : aucun profil Kafka exploitable \\\"\\n            \\\"(variables KAFKA_* absentes : lance ./provision.sh)\\\"\\n        )\\n    forced = os.environ.get(\\\"KAFKA_PROFILE\\\")\\n    if forced:\\n        for name, env in available:\\n            if name == forced:\\n                return name, env\\n    state = _read_state()\\n    now = time.time()\\n    if not force and state.get(\\\"active\\\") and now - float(state.get(\\\"at\\\", 0)) < HEALTH_TTL_S:\\n        for name, env in available:\\n            if name == state[\\\"active\\\"]:\\n                return name, env\\n    for name, env in available:\\n        if _probe_profile(env):\\n            if state.get(\\\"active\\\") != name:\\n                eprint(f\\\"cluster Kafka actif : {name} ({env['KAFKA_BOOTSTRAP']})\\\")\\n            _write_state(name)\\n            return name, env\\n    # aucun cluster joignable : on garde le premier (l'erreur sera explicite)\\n    name, env = available[0]\\n    _write_state(name)\\n    return name, env\\n\\n\\ndef kafka_config(extra: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:\\n    \\\"\\\"\\\"Configuration librdkafka (§8 : sasl.mechanism au singulier, endpoint none).\\n\\n    Elle part du profil ACTIF : basculement automatique vers le repli.\\n    \\\"\\\"\\\"\\n    _name, env = active_profile()\\n    return _config_for(env, extra)\\n\\n\\ndef topic(name: str, prefix: Optional[str] = None) -> str:\\n    \\\"\\\"\\\"Nom du topic.\\n\\n    Le suffixe \\\"reports\\\" est special : les rapports d'agents vivent dans\\n    <prefix>-reports, HORS de l'espace otel.* qui ne contient que la\\n    telemetrie (criteres §9.2).\\n\"}],\"providerCall\":{\"executed\":false},\"providerResult\":{\"executed\":false},\"rawInput\":\"{\\\"command\\\": \\\"cd /home/baptistefaisy/aiven-kafka-demo && sed -n '154,240p' tools/kafkalib.py\\\"}\"},\"time\":{\"start\":1792664519858,\"end\":1792664520131}}}}\n{\"type\":\"tool_use\",\"timestamp\":1792664520134,\"sessionID\":\"ses_e9ce2a39dffeu7KNBAgMFYRyF6\",\"part\":{\"partID\":\"prt_16321c52a00105MIO1HiLKXbbQ\",\"sessionID\":\"ses_e9ce2a39dffeu7KNBAgMFYRyF6\",\"messageID\":\"msg_16320ee40001WfOMk3jys6sBe5\",\"type\":\"tool\",\"id\":\"call_01_ET_ObyWE2qfENNiTQEHHJJU1396\",\"tool\":\"shell\",\"state\":{\"status\":\"completed\",\"input\":{\"command\":\"cd /home/baptistefaisy/aiven-kafka-demo && sed -n '392,470p' tools/kafkalib.py\"},\"output\":\"def _read_once(prefix: Optional[str] = None,\\n               suffixes: Optional[List[str]] = None,\\n               trace_id: Optional[str] = None,\\n               group_id: Optional[str] = None,\\n               idle_seconds: float = 6.0,\\n               timeout_seconds: float = 45.0,\\n               max_messages: int = 20000) -> Dict[str, List[dict]]:\\n    \\\"\\\"\\\"Une passe de lecture (voir read_messages pour la politique de retry).\\\"\\\"\\\"\\n    import time\\n    import uuid\\n\\n    ck = import_kafka()\\n    prefix = prefix or os.environ.get(\\\"KAFKA_TOPIC_PREFIX\\\", \\\"otel\\\")\\n    suffixes = suffixes or [\\\"traces\\\", \\\"logs\\\", \\\"metrics\\\"]\\n    out: Dict[str, List[dict]] = {s: [] for s in suffixes}\\n    topic_names = [topic(s, prefix) for s in suffixes]\\n\\n    consumer = None\\n    try:\\n        consumer = ck.Consumer(kafka_config({\\n            \\\"group.id\\\": group_id or f\\\"otel-watch-dump-{uuid.uuid4().hex[:8]}\\\",\\n            \\\"enable.auto.commit\\\": \\\"false\\\",\\n            \\\"session.timeout.ms\\\": 10000,\\n        }))\\n        # Lecture directe des partitions (pas de groupe de consommateurs) :\\n        # pas de negociation de groupe, pas d'attente de rebalance, et la\\n        # lecture demarre toujours au debut du topic. Un topic absent est\\n        # simplement ignore.\\n        from confluent_kafka import OFFSET_BEGINNING, TopicPartition  # type: ignore\\n\\n        try:\\n            meta = consumer.list_topics(timeout=20)\\n        except Exception as exc:  # noqa: BLE001\\n            # broker momentanement injoignable : on rend la main, read_messages\\n            # reessaie avec un nouveau consommateur.\\n            try:\\n                consumer.close()\\n            except Exception:  # noqa: BLE001\\n                pass\\n            eprint(f\\\"lecture Kafka : metadonnees indisponibles ({exc}) -> nouvel essai\\\")\\n            return out\\n        assignments = []\\n        for name in topic_names:\\n            tm = (getattr(meta, \\\"topics\\\", None) or {}).get(name)\\n            if not tm:\\n                continue\\n            for pid in (getattr(tm, \\\"partitions\\\", None) or {}):\\n                assignments.append(TopicPartition(name, pid, OFFSET_BEGINNING))\\n        consumer.assign(assignments)\\n    except Exception as exc:  # noqa: BLE001\\n        raise KafkaUnreachable(f\\\"connexion au broker impossible : {exc}\\\") from exc\\n\\n    import json as _json\\n\\n    deadline = time.time() + timeout_seconds\\n    started_at = time.time()\\n    last_message_at = None\\n    # La premiere reception peut tarder : il faut rejoindre le groupe de\\n    # consommateurs et obtenir l'affectation des partitions (quelques\\n    # secondes). On ne coupe pas la lecture avant le premier message.\\n    first_message_grace = max(float(idle_seconds), 8.0)\\n    try:\\n        while time.time() < deadline:\\n            total = sum(len(v) for v in out.values())\\n            if total >= max_messages:\\n                break\\n            msg = consumer.poll(0.5)\\n            if msg is None:\\n                if last_message_at is None:\\n                    if time.time() - started_at > first_message_grace:\\n                        break\\n                elif time.time() - last_message_at > idle_seconds:\\n                    break\\n                continue\\n            if msg.error():\\n                continue\\n            last_message_at = time.time()\\n            try:\\n                payload = _json.loads(msg.value().decode(\\\"utf-8\\\"))\\n\",\"title\":\"shell\",\"metadata\":{\"metadata\":{\"status\":\"completed\",\"truncated\":false,\"exit\":0},\"content\":[{\"type\":\"text\",\"text\":\"def _read_once(prefix: Optional[str] = None,\\n               suffixes: Optional[List[str]] = None,\\n               trace_id: Optional[str] = None,\\n               group_id: Optional[str] = None,\\n               idle_seconds: float = 6.0,\\n               timeout_seconds: float = 45.0,\\n               max_messages: int = 20000) -> Dict[str, List[dict]]:\\n    \\\"\\\"\\\"Une passe de lecture (voir read_messages pour la politique de retry).\\\"\\\"\\\"\\n    import time\\n    import uuid\\n\\n    ck = import_kafka()\\n    prefix = prefix or os.environ.get(\\\"KAFKA_TOPIC_PREFIX\\\", \\\"otel\\\")\\n    suffixes = suffixes or [\\\"traces\\\", \\\"logs\\\", \\\"metrics\\\"]\\n    out: Dict[str, List[dict]] = {s: [] for s in suffixes}\\n    topic_names = [topic(s, prefix) for s in suffixes]\\n\\n    consumer = None\\n    try:\\n        consumer = ck.Consumer(kafka_config({\\n            \\\"group.id\\\": group_id or f\\\"otel-watch-dump-{uuid.uuid4().hex[:8]}\\\",\\n            \\\"enable.auto.commit\\\": \\\"false\\\",\\n            \\\"session.timeout.ms\\\": 10000,\\n        }))\\n        # Lecture directe des partitions (pas de groupe de consommateurs) :\\n        # pas de negociation de groupe, pas d'attente de rebalance, et la\\n        # lecture demarre toujours au debut du topic. Un topic absent est\\n        # simplement ignore.\\n        from confluent_kafka import OFFSET_BEGINNING, TopicPartition  # type: ignore\\n\\n        try:\\n            meta = consumer.list_topics(timeout=20)\\n        except Exception as exc:  # noqa: BLE001\\n            # broker momentanement injoignable : on rend la main, read_messages\\n            # reessaie avec un nouveau consommateur.\\n            try:\\n                consumer.close()\\n            except Exception:  # noqa: BLE001\\n                pass\\n            eprint(f\\\"lecture Kafka : metadonnees indisponibles ({exc}) -> nouvel essai\\\")\\n            return out\\n        assignments = []\\n        for name in topic_names:\\n            tm = (getattr(meta, \\\"topics\\\", None) or {}).get(name)\\n            if not tm:\\n                continue\\n            for pid in (getattr(tm, \\\"partitions\\\", None) or {}):\\n                assignments.append(TopicPartition(name, pid, OFFSET_BEGINNING))\\n        consumer.assign(assignments)\\n    except Exception as exc:  # noqa: BLE001\\n        raise KafkaUnreachable(f\\\"connexion au broker impossible : {exc}\\\") from exc\\n\\n    import json as _json\\n\\n    deadline = time.time() + timeout_seconds\\n    started_at = time.time()\\n    last_message_at = None\\n    # La premiere reception peut tarder : il faut rejoindre le groupe de\\n    # consommateurs et obtenir l'affectation des partitions (quelques\\n    # secondes). On ne coupe pas la lecture avant le premier message.\\n    first_message_grace = max(float(idle_seconds), 8.0)\\n    try:\\n        while time.time() < deadline:\\n            total = sum(len(v) for v in out.values())\\n            if total >= max_messages:\\n                break\\n            msg = consumer.poll(0.5)\\n            if msg is None:\\n                if last_message_at is None:\\n                    if time.time() - started_at > first_message_grace:\\n                        break\\n                elif time.time() - last_message_at > idle_seconds:\\n                    break\\n                continue\\n            if msg.error():\\n                continue\\n            last_message_at = time.time()\\n            try:\\n                payload = _json.loads(msg.value().decode(\\\"utf-8\\\"))\\n\"}],\"providerCall\":{\"executed\":false},\"providerResult\":{\"executed\":false},\"rawInput\":\"{\\\"command\\\": \\\"cd /home/baptistefaisy/aiven-kafka-demo && sed -n '392,470p' tools/kafkalib.py\\\"}\"},\"time\":{\"start\":1792664519978,\"end\":1792664520134}}}}\n{\"type\":\"step_finish\",\"timestamp\":1792664520137,\"sessionID\":\"ses_e9ce2a39dffeu7KNBAgMFYRyF6\",\"part\":{\"id\":\"prt_16321c5c9001kUBvuHla7SXO4I\",\"sessionID\":\"ses_e9ce2a39dffeu7KNBAgMFYRyF6\",\"messageID\":\"msg_16320ee40001WfOMk3jys6sBe5\",\"type\":\"step-finish\",\"reason\":\"tool-calls\",\"cost\":0,\"tokens\":{\"input\":703,\"output\":122,\"reasoning\":0,\"cache\":{\"read\":24320,\"write\":0}}}}\n{\"type\":\"step_start\",\"timestamp\":1792664535414,\"sessionID\":\"ses_e9ce2a39dffeu7KNBAgMFYRyF6\",\"part\":{\"id\":\"prt_163220175001EgE1RIRoe7WqMM\",\"sessionID\":\"ses_e9ce2a39dffeu7KNBAgMFYRyF6\",\"messageID\":\"msg_16321c5d9001hl7bOQal7CiFks\",\"type\":\"step-start\"}}\n{\"type\":\"step_start\",\"timestamp\":1792664552463,\"sessionID\":\"ses_e9ce2a39dffeu7KNBAgMFYRyF6\",\"part\":{\"id\":\"prt_16322440f001QyMJdhAPzM3mbS\",\"sessionID\":\"ses_e9ce2a39dffeu7KNBAgMFYRyF6\",\"messageID\":\"msg_16321c5d9001hl7bOQal7CiFks\",\"type\":\"step-start\"}}\n{\"type\":\"step_start\",\"timestamp\":1792664588410,\"sessionID\":\"ses_e9ce2a39dffeu7KNBAgMFYRyF6\",\"part\":{\"i