{"type":"tool_use","timestamp":1792664449158,"sessionID":"ses_e9ce2a39dffeu7KNBAgMFYRyF6","part":{"partID":"prt_16320b032001HwoIFSc2MHagEN","sessionID":"ses_e9ce2a39dffeu7KNBAgMFYRyF6","messageID":"msg_1631fbe74001W0wGnExH5TRx3P","type":"tool","id":"call_00_jOJZHB02heU5PgbKkMUy7202","tool":"shell","state":{"status":"completed","input":{"command":"cd /home/baptistefaisy/aiven-kafka-demo && sed -n '1,140p' tools/kafkalib.py"},"output":"#!/usr/bin/env python3\n\"\"\"Boite a outils Kafka partagee (config, producteur, consommateur).\n\nRegles de securite :\n  - aucun secret n'est jamais affiche ni journalise ;\n  - chaque appel reseau a un timeout ;\n  - les erreurs sont transformees en messages lisibles\n    (\"quoi / pourquoi / quoi faire maintenant\"), jamais en traceback.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\nimport re\nimport sys\nimport time\nfrom pathlib import Path\nfrom typing import Any, Dict, List, Optional, Tuple\n\nHERE = Path(__file__).resolve().parent\nPROJECT_ROOT = HERE.parent\n\nEXIT_OK = 0\nEXIT_USAGE = 1\nEXIT_CONFIG = 2\nEXIT_KAFKA = 3\nEXIT_RUNNING = 4\n\nREQUIRED_ENV = [\n    \"KAFKA_BOOTSTRAP\",\n    \"KAFKA_USERNAME\",\n    \"KAFKA_PASSWORD\",\n    \"KAFKA_CA_FILE\",\n    \"KAFKA_TOPIC_PREFIX\",\n]\n\n\nclass ConfigError(Exception):\n    \"\"\"Configuration incomplete (variables manquantes, fichier illisible...).\"\"\"\n\n\nclass KafkaUnreachable(Exception):\n    \"\"\"Le broker ne repond pas (reseau, TLS, ACL, service en construction...).\"\"\"\n\n\ndef load_env_file(path: Optional[str] = None) -> Dict[str, str]:\n    \"\"\"Charge un env-<service>.sh sans l'executer (parsing KEY=VALUE).\"\"\"\n    p = Path(path or PROJECT_ROOT / \"env-kafka-1687d005.sh\")\n    values: Dict[str, str] = {}\n    if not p.exists():\n        return values\n    for raw in p.read_text(encoding=\"utf-8\").splitlines():\n        line = raw.strip()\n        if not line or line.startswith(\"#\") or \"=\" not in line:\n            continue\n        if line.startswith(\"export \"):\n            line = line[len(\"export \"):]\n        key, _, val = line.partition(\"=\")\n        key = key.strip()\n        val = val.strip().strip('\"').strip(\"'\")\n        if key and re.fullmatch(r\"[A-Za-z_][A-Za-z0-9_]*\", key):\n            values[key] = val\n    return values\n\n\ndef ensure_config() -> None:\n    \"\"\"Remplit les variables KAFKA_* manquantes depuis le fichier d'env.\n\n    Le fichier est au format systemd (KEY=\"valeur\", sans `export`) : il est\n    lisible par `EnvironmentFile=` ET par bash. En bash, on le charge avec\n    `set -a; . env-kafka-1687d005.sh; set +a` pour l'exporter.\n    \"\"\"\n    if all(os.environ.get(k) for k in REQUIRED_ENV):\n        return\n    env_file = os.environ.get(\"KAFKA_ENV_FILE\")\n    for key, val in load_env_file(env_file).items():\n        os.environ.setdefault(key, val)\n\n\ndef config() -> Dict[str, str]:\n    ensure_config()\n    missing = [k for k in REQUIRED_ENV if not os.environ.get(k)]\n    if missing:\n        raise ConfigError(\n            \"configuration incomplete : variable(s) manquante(s) \"\n            + \", \".join(missing)\n            + \" -> source env-kafka-1687d005.sh (mode 600) puis reessaye\"\n        )\n    return {k: os.environ[k] for k in REQUIRED_ENV}\n\n\n# --------------------------------------------------------------------------\n# selection du cluster\n# --------------------------------------------------------------------------\n# Un seul cluster desormais : kafka-1687d005 (l'ancien service de repli\n# agent-kafka a ete supprime apres migration des donnees). L'infrastructure de\n# profils est conservee pour ne pas casser les appelants : un profil de repli\n# n'est ajoute QUE si KAFKA_FALLBACK_ENV_FILE designe un fichier existant.\nFALLBACK_ENV_FILE = os.environ.get(\"KAFKA_FALLBACK_ENV_FILE\", \"\")\nPROFILE_STATE = Path(os.environ.get(\n    \"KAFKA_PROFILE_STATE\",\n    str(Path.home() / \".local\" / \"state\" / \"aiven-kafka-demo\" / \"active.json\")))\nHEALTH_TTL_S = float(os.environ.get(\"KAFKA_HEALTH_TTL_S\", \"20\"))\n\n\ndef _profile_env(values: Dict[str, str]) -> Dict[str, str]:\n    env = dict(values)\n    env.setdefault(\"KAFKA_SECURITY_PROTOCOL\", \"SASL_SSL\")\n    env.setdefault(\"KAFKA_SASL_MECHANISM\", \"SCRAM-SHA-256\")\n    return env\n\n\ndef profiles() -> List[Tuple[str, Dict[str, str]]]:\n    \"\"\"Les profils disponibles : (nom, variables KAFKA_*).\"\"\"\n    ensure_config()\n    out: List[Tuple[str, Dict[str, str]]] = []\n    primary = {k: os.environ.get(k) for k in REQUIRED_ENV}\n    if all(primary.get(k) for k in REQUIRED_ENV):\n        out.append((\"primary\", _profile_env(primary)))\n    fallback = load_env_file(FALLBACK_ENV_FILE) if FALLBACK_ENV_FILE else {}\n    if all(fallback.get(k) for k in REQUIRED_ENV):\n        if fallback.get(\"KAFKA_BOOTSTRAP\") != primary.get(\"KAFKA_BOOTSTRAP\"):\n            out.append((\"fallback\", _profile_env(fallback)))\n    return out\n\n\ndef _read_state() -> Dict[str, Any]:\n    try:\n        return json.loads(PROFILE_STATE.read_text(encoding=\"utf-8\"))\n    except (OSError, ValueError):\n        return {}\n\n\ndef _write_state(name: str) -> None:\n    try:\n        PROFILE_STATE.parent.mkdir(parents=True, exist_ok=True)\n        PROFILE_STATE.write_text(\n            json.dumps({\"active\": name, \"at\": time.time()}), encoding=\"utf-8\")\n    except OSError:\n        pass\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"#!/usr/bin/env python3\n\"\"\"Boite a outils Kafka partagee (config, producteur, consommateur).\n\nRegles de securite :\n  - aucun secret n'est jamais affiche ni journalise ;\n  - chaque appel reseau a un timeout ;\n  - les erreurs sont transformees en messages lisibles\n    (\"quoi / pourquoi / quoi faire maintenant\"), jamais en traceback.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\nimport re\nimport sys\nimport time\nfrom pathlib import Path\nfrom typing import Any, Dict, List, Optional, Tuple\n\nHERE = Path(__file__).resolve().parent\nPROJECT_ROOT = HERE.parent\n\nEXIT_OK = 0\nEXIT_USAGE = 1\nEXIT_CONFIG = 2\nEXIT_KAFKA = 3\nEXIT_RUNNING = 4\n\nREQUIRED_ENV = [\n    \"KAFKA_BOOTSTRAP\",\n    \"KAFKA_USERNAME\",\n    \"KAFKA_PASSWORD\",\n    \"KAFKA_CA_FILE\",\n    \"KAFKA_TOPIC_PREFIX\",\n]\n\n\nclass ConfigError(Exception):\n    \"\"\"Configuration incomplete (variables manquantes, fichier illisible...).\"\"\"\n\n\nclass KafkaUnreachable(Exception):\n    \"\"\"Le broker ne repond pas (reseau, TLS, ACL, service en construction...).\"\"\"\n\n\ndef load_env_file(path: Optional[str] = None) -> Dict[str, str]:\n    \"\"\"Charge un env-<service>.sh sans l'executer (parsing KEY=VALUE).\"\"\"\n    p = Path(path or PROJECT_ROOT / \"env-kafka-1687d005.sh\")\n    values: Dict[str, str] = {}\n    if not p.exists():\n        return values\n    for raw in p.read_text(encoding=\"utf-8\").splitlines():\n        line = raw.strip()\n        if not line or line.startswith(\"#\") or \"=\" not in line:\n            continue\n        if line.startswith(\"export \"):\n            line = line[len(\"export \"):]\n        key, _, val = line.partition(\"=\")\n        key = key.strip()\n        val = val.strip().strip('\"').strip(\"'\")\n        if key and re.fullmatch(r\"[A-Za-z_][A-Za-z0-9_]*\", key):\n            values[key] = val\n    return values\n\n\ndef ensure_config() -> None:\n    \"\"\"Remplit les variables KAFKA_* manquantes depuis le fichier d'env.\n\n    Le fichier est au format systemd (KEY=\"valeur\", sans `export`) : il est\n    lisible par `EnvironmentFile=` ET par bash. En bash, on le charge avec\n    `set -a; . env-kafka-1687d005.sh; set +a` pour l'exporter.\n    \"\"\"\n    if all(os.environ.get(k) for k in REQUIRED_ENV):\n        return\n    env_file = os.environ.get(\"KAFKA_ENV_FILE\")\n    for key, val in load_env_file(env_file).items():\n        os.environ.setdefault(key, val)\n\n\ndef config() -> Dict[str, str]:\n    ensure_config()\n    missing = [k for k in REQUIRED_ENV if not os.environ.get(k)]\n    if missing:\n        raise ConfigError(\n            \"configuration incomplete : variable(s) manquante(s) \"\n            + \", \".join(missing)\n            + \" -> source env-kafka-1687d005.sh (mode 600) puis reessaye\"\n        )\n    return {k: os.environ[k] for k in REQUIRED_ENV}\n\n\n# --------------------------------------------------------------------------\n# selection du cluster\n# --------------------------------------------------------------------------\n# Un seul cluster desormais : kafka-1687d005 (l'ancien service de repli\n# agent-kafka a ete supprime apres migration des donnees). L'infrastructure de\n# profils est conservee pour ne pas casser les appelants : un profil de repli\n# n'est ajoute QUE si KAFKA_FALLBACK_ENV_FILE designe un fichier existant.\nFALLBACK_ENV_FILE = os.environ.get(\"KAFKA_FALLBACK_ENV_FILE\", \"\")\nPROFILE_STATE = Path(os.environ.get(\n    \"KAFKA_PROFILE_STATE\",\n    str(Path.home() / \".local\" / \"state\" / \"aiven-kafka-demo\" / \"active.json\")))\nHEALTH_TTL_S = float(os.environ.get(\"KAFKA_HEALTH_TTL_S\", \"20\"))\n\n\ndef _profile_env(values: Dict[str, str]) -> Dict[str, str]:\n    env = dict(values)\n    env.setdefault(\"KAFKA_SECURITY_PROTOCOL\", \"SASL_SSL\")\n    env.setdefault(\"KAFKA_SASL_MECHANISM\", \"SCRAM-SHA-256\")\n    return env\n\n\ndef profiles() -> List[Tuple[str, Dict[str, str]]]:\n    \"\"\"Les profils disponibles : (nom, variables KAFKA_*).\"\"\"\n    ensure_config()\n    out: List[Tuple[str, Dict[str, str]]] = []\n    primary = {k: os.environ.get(k) for k in REQUIRED_ENV}\n    if all(primary.get(k) for k in REQUIRED_ENV):\n        out.append((\"primary\", _profile_env(primary)))\n    fallback = load_env_file(FALLBACK_ENV_FILE) if FALLBACK_ENV_FILE else {}\n    if all(fallback.get(k) for k in REQUIRED_ENV):\n        if fallback.get(\"KAFKA_BOOTSTRAP\") != primary.get(\"KAFKA_BOOTSTRAP\"):\n            out.append((\"fallback\", _profile_env(fallback)))\n    return out\n\n\ndef _read_state() -> Dict[str, Any]:\n    try:\n        return json.loads(PROFILE_STATE.read_text(encoding=\"utf-8\"))\n    except (OSError, ValueError):\n        return {}\n\n\ndef _write_state(name: str) -> None:\n    try:\n        PROFILE_STATE.parent.mkdir(parents=True, exist_ok=True)\n        PROFILE_STATE.write_text(\n            json.dumps({\"active\": name, \"at\": time.time()}), encoding=\"utf-8\")\n    except OSError:\n        pass\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /home/baptistefaisy/aiven-kafka-demo && sed -n '1,140p' tools/kafkalib.py\"}"},"time":{"start":1792664449074,"end":1792664449158}}}}
{"type":"tool_use","timestamp":1792664449166,"sessionID":"ses_e9ce2a39dffeu7KNBAgMFYRyF6","part":{"partID":"prt_16320b03f001Y3mDsh9Xq0Ykzr","sessionID":"ses_e9ce2a39dffeu7KNBAgMFYRyF6","messageID":"msg_1631fbe74001W0wGnExH5TRx3P","type":"tool","id":"call_01_wCwe7GwB9ELYsBy04SQp2998","tool":"shell","state":{"status":"completed","input":{"command":"cd /home/baptistefaisy/aiven-kafka-demo && sed -n '1,120p' trace-dump"},"output":"#!/usr/bin/env python3\n\"\"\"trace-dump — la preuve brute (§5.4).\n\nUsage :\n  trace-dump <trace_id>            spans + logs + metriques d'une trace\n  trace-dump <trace_id> --detectors  + le verdict des 3 detecteurs\n  trace-dump --list                liste les traces vues dans Kafka\n  trace-dump --list --json\n  trace-dump <trace_id> --json\n\nCodes de sortie : 0 ok / 1 trace absente ou usage / 2 configuration\nmanquante / 3 Kafka injoignable.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport sys\nfrom pathlib import Path\n\nPROJECT_ROOT = Path(__file__).resolve().parent\nsys.path.insert(0, str(PROJECT_ROOT / \"tools\"))\n\nimport contract  # noqa: E402\nimport detectors  # noqa: E402\nimport kafkalib  # noqa: E402\n\nEXIT_OK = kafkalib.EXIT_OK\nEXIT_USAGE = kafkalib.EXIT_USAGE\nEXIT_CONFIG = kafkalib.EXIT_CONFIG\nEXIT_KAFKA = kafkalib.EXIT_KAFKA\n\n\ndef read(prefix, suffixes=None, trace_id=None):\n    return kafkalib.read_messages(prefix=prefix, suffixes=suffixes, trace_id=trace_id)\n\n\ndef collect(data, trace_id=None):\n    \"\"\"Separe les traces/logs (par TraceId) des metriques (par scenario/profil).\n\n    §3 : la table otel.metrics n'a pas de colonne TraceId ; les metriques\n    sont donc rattachees par couple scenario/profil (§5.4).\n    \"\"\"\n    traces = [t for t in data.get(\"traces\", []) if trace_id is None or t.get(\"TraceId\") == trace_id]\n    logs = [l for l in data.get(\"logs\", []) if trace_id is None or l.get(\"TraceId\") == trace_id]\n    scenario = \"\"\n    profile = \"\"\n    error_type = \"\"\n    for span in traces:\n        attrs = span.get(\"SpanAttributes\") or {}\n        scenario = scenario or attrs.get(\"agent.scenario\", \"\")\n        profile = profile or attrs.get(\"agent.profile\", \"\")\n        error_type = error_type or attrs.get(\"error.type\", \"\")\n    for log in logs:\n        attrs = log.get(\"SpanAttributes\") or log.get(\"LogAttributes\") or {}\n        scenario = scenario or attrs.get(\"agent.scenario\", \"\")\n        profile = profile or attrs.get(\"agent.profile\", \"\")\n        error_type = error_type or attrs.get(\"error.type\", \"\")\n    metrics = []\n    for metric in data.get(\"metrics\", []):\n        attrs = metric.get(\"Attributes\") or {}\n        if scenario and attrs.get(\"agent.scenario\") != scenario:\n            continue\n        if profile and attrs.get(\"agent.profile\") not in (\"\", profile):\n            continue\n        metrics.append(metric)\n    return traces, logs, metrics, scenario, profile, error_type\n\n\ndef dump_trace(trace_id, prefix, as_json, with_detectors):\n    data = read(prefix)\n    traces, logs, metrics, scenario, profile, error_type = collect(data, trace_id)\n    if not traces and not logs:\n        msg = f\"trace absente : {trace_id}\"\n        if as_json:\n            print(json.dumps({\"ok\": False, \"error\": \"trace_absente\",\n                              \"trace_id\": trace_id, \"hint\": msg}, ensure_ascii=False))\n        else:\n            print(msg, file=sys.stderr)\n            print(\"  -> le trace_id n'existe pas dans les topics (ou le prefixe est faux)\",\n                  file=sys.stderr)\n        return EXIT_USAGE\n    findings = detectors.detect(traces, logs, metrics)\n    payload = {\n        \"ok\": True,\n        \"trace_id\": trace_id,\n        \"scenario\": scenario,\n        \"profile\": profile,\n        \"error_type\": error_type or None,\n        \"spans\": sorted(traces, key=lambda s: (s.get(\"Timestamp\", \"\"), s.get(\"SpanId\", \"\"))),\n        \"logs\": sorted(logs, key=lambda l: l.get(\"Timestamp\", \"\")),\n        \"metrics\": sorted(metrics, key=lambda m: m.get(\"TimeUnix\", 0)),\n        \"detectors\": {\n            \"counts\": detectors.findings_by_detector(findings),\n            \"findings\": findings,\n            \"verdict\": detectors.verdict_lines(findings),\n        },\n    }\n\n    if as_json:\n        print(json.dumps(payload, indent=2, ensure_ascii=False))\n        return EXIT_OK\n\n    print(f\"=== trace {trace_id} ===\")\n    print(f\"scenario={scenario or '?'} profile={profile or '?'} \"\n          f\"error.type={error_type or '(aucun)'}\")\n    print(f\"--- spans ({len(traces)}) ---\")\n    for span in payload[\"spans\"]:\n        attrs = span.get(\"SpanAttributes\") or {}\n        interesting = {k: v for k, v in attrs.items()\n                       if k not in (\"agent.scenario\", \"agent.profile\")}\n        print(f\"  {span.get('Timestamp')} {span.get('SpanName'):22s} \"\n              f\"{span.get('Duration', 0) / 1e6:>9.1f}ms {span.get('StatusCode'):6s} \"\n              f\"{json.dumps(interesting, ensure_ascii=False)}\")\n    print(f\"--- logs ({len(logs)}) ---\")\n    for log in payload[\"logs\"]:\n        print(f\"  {log.get('Timestamp')} {log.get('SeverityText', '?'):5s} \"\n              f\"(sev {log.get('SeverityNumber')}) {log.get('Body')}\")\n    print(f\"--- metriques ({len(metrics)}) ---\")\n    for metric in payload[\"metrics\"]:\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"#!/usr/bin/env python3\n\"\"\"trace-dump — la preuve brute (§5.4).\n\nUsage :\n  trace-dump <trace_id>            spans + logs + metriques d'une trace\n  trace-dump <trace_id> --detectors  + le verdict des 3 detecteurs\n  trace-dump --list                liste les traces vues dans Kafka\n  trace-dump --list --json\n  trace-dump <trace_id> --json\n\nCodes de sortie : 0 ok / 1 trace absente ou usage / 2 configuration\nmanquante / 3 Kafka injoignable.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport sys\nfrom pathlib import Path\n\nPROJECT_ROOT = Path(__file__).resolve().parent\nsys.path.insert(0, str(PROJECT_ROOT / \"tools\"))\n\nimport contract  # noqa: E402\nimport detectors  # noqa: E402\nimport kafkalib  # noqa: E402\n\nEXIT_OK = kafkalib.EXIT_OK\nEXIT_USAGE = kafkalib.EXIT_USAGE\nEXIT_CONFIG = kafkalib.EXIT_CONFIG\nEXIT_KAFKA = kafkalib.EXIT_KAFKA\n\n\ndef read(prefix, suffixes=None, trace_id=None):\n    return kafkalib.read_messages(prefix=prefix, suffixes=suffixes, trace_id=trace_id)\n\n\ndef collect(data, trace_id=None):\n    \"\"\"Separe les traces/logs (par TraceId) des metriques (par scenario/profil).\n\n    §3 : la table otel.metrics n'a pas de colonne TraceId ; les metriques\n    sont donc rattachees par couple scenario/profil (§5.4).\n    \"\"\"\n    traces = [t for t in data.get(\"traces\", []) if trace_id is None or t.get(\"TraceId\") == trace_id]\n    logs = [l for l in data.get(\"logs\", []) if trace_id is None or l.get(\"TraceId\") == trace_id]\n    scenario = \"\"\n    profile = \"\"\n    error_type = \"\"\n    for span in traces:\n        attrs = span.get(\"SpanAttributes\") or {}\n        scenario = scenario or attrs.get(\"agent.scenario\", \"\")\n        profile = profile or attrs.get(\"agent.profile\", \"\")\n        error_type = error_type or attrs.get(\"error.type\", \"\")\n    for log in logs:\n        attrs = log.get(\"SpanAttributes\") or log.get(\"LogAttributes\") or {}\n        scenario = scenario or attrs.get(\"agent.scenario\", \"\")\n        profile = profile or attrs.get(\"agent.profile\", \"\")\n        error_type = error_type or attrs.get(\"error.type\", \"\")\n    metrics = []\n    for metric in data.get(\"metrics\", []):\n        attrs = metric.get(\"Attributes\") or {}\n        if scenario and attrs.get(\"agent.scenario\") != scenario:\n            continue\n        if profile and attrs.get(\"agent.profile\") not in (\"\", profile):\n            continue\n        metrics.append(metric)\n    return traces, logs, metrics, scenario, profile, error_type\n\n\ndef dump_trace(trace_id, prefix, as_json, with_detectors):\n    data = read(prefix)\n    traces, logs, metrics, scenario, profile, error_type = collect(data, trace_id)\n    if not traces and not logs:\n        msg = f\"trace absente : {trace_id}\"\n        if as_json:\n            print(json.dumps({\"ok\": False, \"error\": \"trace_absente\",\n                              \"trace_id\": trace_id, \"hint\": msg}, ensure_ascii=False))\n        else:\n            print(msg, file=sys.stderr)\n            print(\"  -> le trace_id n'existe pas dans les topics (ou le prefixe est faux)\",\n                  file=sys.stderr)\n        return EXIT_USAGE\n    findings = detectors.detect(traces, logs, metrics)\n    payload = {\n        \"ok\": True,\n        \"trace_id\": trace_id,\n        \"scenario\": scenario,\n        \"profile\": profile,\n        \"error_type\": error_type or None,\n        \"spans\": sorted(traces, key=lambda s: (s.get(\"Timestamp\", \"\"), s.get(\"SpanId\", \"\"))),\n        \"logs\": sorted(logs, key=lambda l: l.get(\"Timestamp\", \"\")),\n        \"metrics\": sorted(metrics, key=lambda m: m.get(\"TimeUnix\", 0)),\n        \"detectors\": {\n            \"counts\": detectors.findings_by_detector(findings),\n            \"findings\": findings,\n            \"verdict\": detectors.verdict_lines(findings),\n        },\n    }\n\n    if as_json:\n        print(json.dumps(payload, indent=2, ensure_ascii=False))\n        return EXIT_OK\n\n    print(f\"=== trace {trace_id} ===\")\n    print(f\"scenario={scenario or '?'} profile={profile or '?'} \"\n          f\"error.type={error_type or '(aucun)'}\")\n    print(f\"--- spans ({len(traces)}) ---\")\n    for span in payload[\"spans\"]:\n        attrs = span.get(\"SpanAttributes\") or {}\n        interesting = {k: v for k, v in attrs.items()\n                       if k not in (\"agent.scenario\", \"agent.profile\")}\n        print(f\"  {span.get('Timestamp')} {span.get('SpanName'):22s} \"\n              f\"{span.get('Duration', 0) / 1e6:>9.1f}ms {span.get('StatusCode'):6s} \"\n              f\"{json.dumps(interesting, ensure_ascii=False)}\")\n    print(f\"--- logs ({len(logs)}) ---\")\n    for log in payload[\"logs\"]:\n        print(f\"  {log.get('Timestamp')} {log.get('SeverityText', '?'):5s} \"\n              f\"(sev {log.get('SeverityNumber')}) {log.get('Body')}\")\n    print(f\"--- metriques ({len(metrics)}) ---\")\n    for metric in payload[\"metrics\"]:\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /home/baptistefaisy/aiven-kafka-demo && sed -n '1,120p' trace-dump\"}"},"time":{"start":1792664449087,"end":1792664449166}}}}
