 22 12:10 .\ndrwxr-xr-x 1 baptistefaisy baptistefaisy   678 Oct 22 11:54 ..\ndrwxr-xr-x 1 baptistefaisy baptistefaisy   446 Oct 22 12:19 __pycache__\n-rwxr-xr-x 1 baptistefaisy baptistefaisy  5264 Oct 22 11:57 check.sh\n-rwxr-xr-x 1 baptistefaisy baptistefaisy  3958 Oct 22 09:08 contract-check\n-rw-r--r-- 1 baptistefaisy baptistefaisy 10729 Oct 22 09:18 contract.py\n-rwxr-xr-x 1 baptistefaisy baptistefaisy 22206 Oct 22 11:54 db_fault_probe.py\n-rw-r--r-- 1 baptistefaisy baptistefaisy 16398 Oct 22 11:16 dbprobe.py\n-rwxr-xr-x 1 baptistefaisy baptistefaisy 17546 Oct 22 11:33 debug-bundle\n-rwxr-xr-x 1 baptistefaisy baptistefaisy 10585 Oct 22 12:01 debug-selftest\n-rw-r--r-- 1 baptistefaisy baptistefaisy  9825 Oct 22 09:18 detectors.py\n-rwxr-xr-x 1 baptistefaisy baptistefaisy 22291 Oct 22 11:54 emit_db_errors.py\n-rwxr-xr-x 1 baptistefaisy baptistefaisy  4081 Oct 22 11:54 emit_incident.py\n-rwxr-xr-x 1 baptistefaisy baptistefaisy 22372 Oct 22 11:54 emit_sql_error.py\n-rwxr-xr-x 1 baptistefaisy baptistefaisy 10590 Oct 22 12:09 generator\n-rw-r--r-- 1 baptistefaisy baptistefaisy  5169 Oct 22 12:10 generator_switch.py\n-rwxr-xr-x 1 baptistefaisy baptistefaisy 79079 Oct 22 12:13 kafka-incident-watch\n-rw-r--r-- 1 baptistefaisy baptistefaisy  1361 Oct 22 11:49 kafka-incident-watch.service\n-rwxr-xr-x 1 baptistefaisy baptistefaisy  9255 Oct 22 11:04 kafka-migrate\n-rw-r--r-- 1 baptistefaisy baptistefaisy 18468 Oct 22 11:07 kafkalib.py\n-rwxr-xr-x 1 baptistefaisy baptistefaisy 16098 Oct 22 11:20 patch-new\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /home/baptistefaisy/aiven-kafka-demo && ls -la tools/ db/ debug/ patches/ agents/ 2>&1 | head -60\"}"},"time":{"start":1792664387052,"end":1792664387141}}}}
