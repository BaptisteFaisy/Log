c_suffix: str, key: str, payload: str) -> None:\n332:    def send_to(self, topic_name: str, key: str, payload: str) -> None:\n346:    def flush(self, timeout: float = 30.0) -> None:\n362:def read_messages(prefix: Optional[str] = None,\n365:                  group_id: Optional[str] = None,\n383:        result = _read_once(prefix, suffixes, trace_id, group_id, idle_seconds,\n392:def _read_once(prefix: Optional[str] = None,\n395:               group_id: Optional[str] = None,\n411:        consumer = ck.Consumer(kafka_config({\n412:            \"group.id\": group_id or f\"otel-watch-dump-{uuid.uuid4().hex[:8]}\",\n491:def eprint(*args: Any) -> None:\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"46:def load_env_file(path: Optional[str] = None) -> Dict[str, str]:\n66:def ensure_config() -> None:\n80:def config() -> Dict[str, str]:\n106:def _profile_env(values: Dict[str, str]) -> Dict[str, str]:\n113:def profiles() -> List[Tuple[str, Dict[str, str]]]:\n127:def _read_state() -> Dict[str, Any]:\n134:def _write_state(name: str) -> None:\n143:def invalidate_profile_cache() -> None:\n154:def _config_for(env: Dict[str, str], extra: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:\n158:        \"security.protocol\": env.get(\"KAFKA_SECURITY_PROTOCOL\", \"SASL_SSL\"),\n159:        \"sasl.mechanism\": env.get(\"KAFKA_SASL_MECHANISM\", \"SCRAM-SHA-256\"),\n160:        \"sasl.username\": env[\"KAFKA_USERNAME\"],\n161:        \"sasl.password\": env[\"KAFKA_PASSWORD\"],\n175:def _probe_profile(env: Dict[str, str]) -> bool:\n189:def active_profile(force: bool = False) -> Tuple[str, Dict[str, str]]:\n226:def kafka_config(extra: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:\n227:    \"\"\"Configuration librdkafka (§8 : sasl.mechanism au singulier, endpoint none).\n235:def topic(name: str, prefix: Optional[str] = None) -> str:\n248:def ensure_kafka_interpreter() -> None:\n268:def import_kafka():\n281:def suffix_for_topic(topic_name: str, prefix: Optional[str] = None) -> str:\n290:def admin_client(client_id: str = \"aiven-kafka-demo\"):\n308:    def __init__(self, prefix: Optional[str] = None) -> None:\n322:    def _on_delivery(self, err, _msg) -> None:\n329:    def send(self, topic_suffix: str, key: str, payload: str) -> None:\n332:    def send_to(self, topic_name: str, key: str, payload: str) -> None:\n346:    def flush(self, timeout: float = 30.0) -> None:\n362:def read_messages(prefix: Optional[str] = None,\n365:                  group_id: Optional[str] = None,\n383:        result = _read_once(prefix, suffixes, trace_id, group_id, idle_seconds,\n392:def _read_once(prefix: Optional[str] = None,\n395:               group_id: Optional[str] = None,\n411:        consumer = ck.Consumer(kafka_config({\n412:            \"group.id\": group_id or f\"otel-watch-dump-{uuid.uuid4().hex[:8]}\",\n491:def eprint(*args: Any) -> None:\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /home/baptistefaisy/aiven-kafka-demo && grep -n \\\"def \\\\|group.id\\\\|Consumer\\\\|sasl\\\\|security\\\" tools/kafkalib.py | sed -n '1,80p'\"}"},"time":{"start":1792664464910,"end":1792664464942}}}}
