{"type":"tool_use","timestamp":1792664688913,"sessionID":"ses_e9ce2a39dffeu7KNBAgMFYRyF6","part":{"partID":"prt_1632457360015P5cQxmdtLHBoR","sessionID":"ses_e9ce2a39dffeu7KNBAgMFYRyF6","messageID":"msg_1632405e20015txv6kpKd6abFR","type":"tool","id":"call_00_0AWs8sMf7VqHYdJUAHx56208","tool":"shell","state":{"status":"completed","input":{"command":"cd /home/baptistefaisy/aiven-kafka-demo && .venv/bin/python -c \"1\" 2>/dev/null || ls /home/baptistefaisy/.venv* 2>/dev/null; ls -d /home/baptistefaisy/aiven-kafka-demo/.venv 2>/dev/null; sed -n '248,280p' tools/kafkalib.py"},"output":"aiven-kafka\ndef ensure_kafka_interpreter() -> None:\n    \"\"\"Re-execute le script avec le python du venv dedie (§0.6).\n\n    Permet d'appeler ./seed, ./trace-dump ou ./tools/preflight directement,\n    sans avoir a passer par tools/venv.sh.\n    \"\"\"\n    try:\n        import confluent_kafka  # type: ignore  # noqa: F401\n        return\n    except ImportError:\n        pass\n    if os.environ.get(\"KAFKA_VENV_REEXEC\") == \"1\":\n        return\n    venv = os.environ.get(\"KAFKA_VENV\") or os.path.expanduser(\"~/.venvs/aiven-kafka\")\n    py = os.path.join(venv, \"bin\", \"python\")\n    if os.path.exists(py):\n        os.environ[\"KAFKA_VENV_REEXEC\"] = \"1\"\n        os.execv(py, [py, os.path.abspath(sys.argv[0])] + sys.argv[1:])\n\n\ndef import_kafka():\n    \"\"\"Importe confluent_kafka depuis le venv dedie (§0.6).\"\"\"\n    ensure_kafka_interpreter()\n    try:\n        import confluent_kafka  # type: ignore\n        return confluent_kafka\n    except ImportError as exc:\n        raise ConfigError(\n            \"confluent-kafka absent du Python systeme -> utilise le venv dedie : \"\n            \"./tools/venv.sh exec <commande>  (ou ./tools/venv.sh install)\"\n        ) from exc\n\n\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"aiven-kafka\ndef ensure_kafka_interpreter() -> None:\n    \"\"\"Re-execute le script avec le python du venv dedie (§0.6).\n\n    Permet d'appeler ./seed, ./trace-dump ou ./tools/preflight directement,\n    sans avoir a passer par tools/venv.sh.\n    \"\"\"\n    try:\n        import confluent_kafka  # type: ignore  # noqa: F401\n        return\n    except ImportError:\n        pass\n    if os.environ.get(\"KAFKA_VENV_REEXEC\") == \"1\":\n        return\n    venv = os.environ.get(\"KAFKA_VENV\") or os.path.expanduser(\"~/.venvs/aiven-kafka\")\n    py = os.path.join(venv, \"bin\", \"python\")\n    if os.path.exists(py):\n        os.environ[\"KAFKA_VENV_REEXEC\"] = \"1\"\n        os.execv(py, [py, os.path.abspath(sys.argv[0])] + sys.argv[1:])\n\n\ndef import_kafka():\n    \"\"\"Importe confluent_kafka depuis le venv dedie (§0.6).\"\"\"\n    ensure_kafka_interpreter()\n    try:\n        import confluent_kafka  # type: ignore\n        return confluent_kafka\n    except ImportError as exc:\n        raise ConfigError(\n            \"confluent-kafka absent du Python systeme -> utilise le venv dedie : \"\n            \"./tools/venv.sh exec <commande>  (ou ./tools/venv.sh install)\"\n        ) from exc\n\n\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /home/baptistefaisy/aiven-kafka-demo && .venv/bin/python -c \\\"1\\\" 2>/dev/null || ls /home/baptistefaisy/.venv* 2>/dev/null; ls -d /home/baptistefaisy/aiven-kafka-demo/.venv 2>/dev/null; sed -n '248,280p' tools/kafkalib.py\"}"},"time":{"start":1792664688438,"end":1792664688913}}}}
