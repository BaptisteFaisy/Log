{"type":"tool_use","timestamp":1792666720167,"sessionID":"ses_e9cc974dfffegz842AnbVwJnCF","part":{"partID":"prt_16343577d0012IpZzIGqFgvgP6","sessionID":"ses_e9cc974dfffegz842AnbVwJnCF","messageID":"msg_16341e483001DKVaHmONgCEUHi","type":"tool","id":"call_00_m1TU7FvHAQEFkFKRhiAy9031","tool":"read","state":{"status":"completed","input":{"path":"/home/baptistefaisy/log-site-vercel/api/logs.js"},"output":"Read file /home/baptistefaisy/log-site-vercel/api/logs.js, lines 1-273\n1: // Vercel Function : ingestion des logs de la console web « log() » vers Aiven Kafka.\n2: //\n3: //   POST /api/logs   {\"lines\":[{\"level\":\"err\",\"text\":\"...\",\"code\":\"ERR_KAFKA_UNREACHABLE\",\n4: //                               \"service\":\"event-worker\",\"ts\":\"2026-10-22T10:03:55.123Z\",\n5: //                               \"trace_id\":\"<32 hex>\"}]}\n6: //     -> 200 {\"ok\":true,\"topic\":\"otel.logs\",\"produced\":1,\"trace_id\":\"...\"}\n7: //     -> 400 {\"ok\":false,\"error\":\"bad_request\",\"hint\":\"...\"}\n8: //     -> 503 {\"ok\":false,\"error\":\"kafka_unreachable\",\"hint\":\"...\"}\n9: //     -> 429 {\"ok\":false,\"error\":\"rate_limited\",\"hint\":\"...\"}\n10: //\n11: //   GET /api/logs    -> 200 {\"ok\":true,\"kafka\":\"up\"|\"down\",\"topic\":\"otel.logs\",...}\n12: //\n13: // Le message produit suit le contrat des messages (§3) : une ligne JSON dont les\n14: // cles sont celles du schema OpenTelemetry standard, la cle Kafka etant le TraceId.\n15: // Les attributs agent.scenario / agent.profile sont presents sur chaque log, comme\n16: // l'exige le watcher d'incidents.\n17: //\n18: // Variables d'environnement : celles de api/_kafka.js, plus\n19: //   KAFKA_AGENT_ROUTING   \"0\" = logs seulement, sans error.type (aucun agent ne part)\n20: //                         \"1\" (defaut) = les lignes err/wrn portent error.type et\n21: //                         peuvent declencher un agent via routes.yaml\n22: //   LOGS_MAX_LINES        lignes max par requete (defaut : 40)\n23: //   LOGS_RATE_PER_MIN     requetes max par minute et par IP (defaut : 120)\n24: //\n25: // Le site est public : tout ce qui entre est borne, nettoye et masque.\n26: \n27: const crypto = require(\"crypto\");\n28: const { publish, health, KafkaConfigError, KafkaDownError, topicName, configured } = require(\"./_kafka\");\n29: const { redact } = require(\"./_redact\");\n30: \n31: const MAX_LINES = Number(process.env.LOGS_MAX_LINES) || 40;\n32: const MAX_LINE_CHARS = 4000;\n33: const MAX_BODY_CHARS = 96 * 1024;\n34: const RATE_PER_MIN = Number(process.env.LOGS_RATE_PER_MIN) || 120;\n35: const AGENT_ROUTING = String(process.env.KAFKA_AGENT_ROUTING || \"1\") !== \"0\";\n36: const SERVICE = \"log-site\";\n37: const SCOPE = { name: \"log-site\", version: \"1.0.0\" };\n38: \n39: // « err » cote navigateur -> severite OpenTelemetry.\n40: const SEVERITY = {\n41:   dbg: { text: \"DEBUG\", number: 5 },\n42:   inf: { text: \"INFO\", number: 9 },\n43:   ok: { text: \"INFO\", number: 9 },\n44:   wrn: { text: \"WARN\", number: 13 },\n45:   err: { text: \"ERROR\", number: 17 },\n46: };\n47: \n48: // Code affiche par la console -> error.type attendu par routes.yaml.\n49: // Un code inconnu est simplement derive (minuscules, prefixe ERR_ retire) : le\n50: // watcher retombe alors sur default_agent, il ne casse pas.\n51: const ERROR_TYPES = {\n52:   ERR_DB_POOL_EXHAUSTED: \"db_pool_exhausted\",\n53:   ERR_PG_TIMEOUT_5432: \"db_connection_timeout\",\n54:   ERR_KAFKA_UNREACHABLE: \"kafka_broker_unreachable\",\n55:   ERR_OOM_HEAP: \"oom\",\n56:   ERR_DISK_FULL: \"disk_full\",\n57:   ERR_SILENT_FAILURE: \"silent_failure\",\n58:   ERR_STALE_SOURCE: \"stale_source\",\n59:   ERR_CACHE_MISS_STORM: \"cache_miss_storm\",\n60: };\n61: \n62: function json(res, code, payload) {\n63:   res.statusCode = code;\n64:   res.setHeader(\"Content-Type\", \"application/json; charset=utf-8\");\n65:   res.setHeader(\"Cache-Control\", \"no-store\");\n66:   res.end(JSON.stringify(payload));\n67: }\n68: \n69: function errorTypeFor(code, level) {\n70:   if (!AGENT_ROUTING) return \"\";\n71:   if (level !== \"err\" && level !== \"wrn\") return \"\";\n72:   const key = String(code || \"\").toUpperCase();\n73:   if (ERROR_TYPES[key]) return ERROR_TYPES[key];\n74:   const derived = key.replace(/^ERR_/, \"\").toLowerCase().replace(/[^a-z0-9_]/g, \"_\");\n75:   return derived.slice(0, 60);\n76: }\n77: \n78: function timestamp(value) {\n79:   const date = value ? new Date(value) : new Date();\n80:   const safe = Number.isNaN(date.getTime()) ? new Date() : date;\n81:   return `${safe.toISOString().slice(0, 19).replace(\"T\", \" \")}.${String(safe.getUTCMilliseconds()).padStart(3, \"0\")}`;\n82: }\n83: \n84: function hex32(value) {\n85:   return crypto.createHash(\"sha256\").update(String(value)).digest(\"hex\");\n86: }\n87: \n88: function traceIdFor(raw) {\n89:   const candidate = String(raw || \"\").toLowerCase().replace(/[^0-9a-f]/g, \"\");\n90:   if (candidate.length === 32) return candidate;\n91:   return hex32(`${Date.now()}:${Math.random()}`).slice(0, 32);\n92: }\n93: \n94: function clean(text) {\n95:   return redact(String(text == null ? \"\" : text))\n96:     // eslint-disable-next-line no-control-regex\n97:     .replace(/[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]/g, \" \")\n98:     .slice(0, MAX_LINE_CHARS);\n99: }\n100: \n101: /** Transforme une ligne de console en log OpenTelemetry du contrat. */\n102: function toRecord(line, index, traceId) {\n103:   const level = String(line.level || \"inf\").toLowerCase();\n104:   const severity = SEVERITY[level] || SEVERITY.inf;\n105:   const code = clean(line.code || \"\").toUpperCase().slice(0, 64);\n106:   const service = clean(line.service || \"\").slice(0, 64) || SERVICE;\n107:   const errorType = errorTypeFor(code, level);\n108:   const attributes = {\n109:     \"agent.scenario\": code || \"site-console\",\n110:     \"agent.profile\": \"site\",\n111:     \"site.level\": level,\n112:     \"site.service\": service,\n113:     \"site.host\": clean(line.host || \"\").slice(0, 120) || \"unknown\",\n114:     \"site.page\": clean(line.page || \"/\").slice(0, 200),\n115:     \"site.session\": clean(line.session || \"\").slice(0, 64),\n116:     \"site.source\": \"vercel-function\",\n117:   };\n118:   if (errorType) attributes[\"error.type\"] = errorType;\n119:   return {\n120:     Timestamp: timestamp(line.ts),\n121:     TraceId: traceId,\n122:     SpanId: hex32(`${traceId}:${index}:${line.text || \"\"}`).slice(0, 16),\n123:     ParentSpanId: \"\",\n124:     TraceFlags: \"01\",\n125:     SeverityText: severity.text,\n126:     SeverityNumber: severity.number,\n127:     Body: clean(line.text || \"\"),\n128:     LogAttributes: attributes,\n129:     SpanAttributes: { ...attributes },\n130:     ScopeName: SCOPE.name,\n131:     ScopeVersion: SCOPE.version,\n132:     ResourceAttributes: {\n133:       \"service.name\": SERVICE,\n134:       \"deployment.environment\": \"vercel\",\n135:       \"site.region\": process.env.VERCEL_REGION || \"\",\n136:     },\n137:     ServiceName: SERVICE,\n138:   };\n139: }\n140: \n141: // Limiteur best effort : chaque instance de fonction a sa propre memoire, ce qui\n142: // suffit a empecher une boucle navigateur de saturer un petit plan Kafka.\n143: const hits = new Map();\n144: \n145: function rateLimited(ip) {\n146:   const now = Date.now();\n147:   const window = hits.get(ip);\n148:   if (!window || now - window.start > 60000) {\n149:     hits.set(ip, { start: now, count: 1 });\n150:     if (hits.size > 5000) hits.clear();\n151:     return false;\n152:   }\n153:   window.count += 1;\n154:   return window.count > RATE_PER_MIN;\n155: }\n156: \n157: function bodyOf(req) {\n158:   let body = req.body;\n159:   if (typeof body === \"string\") {\n160:     if (body.length > MAX_BODY_CHARS) return null;\n161:     try {\n162:       body = JSON.parse(body);\n163:     } catch (err) {\n164:       return null;\n165:     }\n166:   }\n167:   if (!body || typeof body !== \"object\") return null;\n168:   return body;\n169: }\n170: \n171: module.exports = async function handler(req, res) {\n172:   if (req.method === \"GET\") {\n173:     if (!configured()) {\n174:       return json(res, 200, {\n175:         ok: true,\n176:         kafka: \"down\",\n177:         error: \"config_error\",\n178:         hint: \"variables KAFKA_BOOTSTRAP / KAFKA_USERNAME / KAFKA_PASSWORD / KAFKA_CA_PEM absentes du projet Vercel\",\n179:         topic: topicName(\"logs\"),\n180:       });\n181:     }\n182:     try {\n183:       const state = await health();\n184:       return json(res, 200, {\n185:         ok: true,\n186:         kafka: \"up\",\n187:         topic: state.topic,\n188:         brokers: state.brokers,\n189:         routing: AGENT_ROUTING ? \"agents\" : \"logs_only\",\n190:       });\n191:     } catch (err) {\n192:       const config = err instanceof KafkaConfigError;\n193:       return json(res, 200, {\n194:         ok: true,\n195:         kafka: \"down\",\n196:         error: config ? \"config_error\" : \"kafka_unreachable\",\n197:         hint: config ? err.message : `Kafka injoignable (${err.message})`,\n198:         topic: topicName(\"logs\"),\n199:       });\n200:     }\n201:   }\n202: \n203:   if (req.method !== \"POST\") {\n204:     return json(res, 405, {\n205:       ok: false,\n206:       error: \"method_not_allowed\",\n207:       hint: 'utilise POST /api/logs avec {\"lines\":[...]} ou GET /api/logs pour l\\'etat',\n208:     });\n209:   }\n210: \n211:   const ip =\n212:     (req.headers[\"x-forwarded-for\"] || \"\").split(\",\")[0].trim() ||\n213:     (req.socket && req.socket.remoteAddress) ||\n214:     \"unknown\";\n215:   if (rateLimited(ip)) {\n216:     return json(res, 429, {\n217:       ok: false,\n218:       error: \"rate_limited\",\n219:       hint: `plus de ${RATE_PER_MIN} envois par minute depuis cette adresse`,\n220:     });\n221:   }\n222: \n223:   const body = bodyOf(req);\n224:   const lines = body && Array.isArray(body.lines) ? body.lines : body && body.line ? [body.line] : null;\n225:   if (!lines || !lines.length) {\n226:     return json(res, 400, {\n227:       ok: false,\n228:       error: \"bad_request\",\n229:       hint: 'corps attendu : {\"lines\":[{\"level\":\"err\",\"text\":\"...\"}]}',\n230:     });\n231:   }\n232:   if (lines.length > MAX_LINES) {\n233:     return json(res, 413, {\n234:       ok: false,\n235:       error: \"too_many_lines\",\n236:       hint: `maximum ${MAX_LINES} lignes par requete`,\n237:     });\n238:   }\n239: \n240:   const traceId = traceIdFor(body.trace_id || (lines[0] && lines[0].trace_id));\n241:   let records;\n242:   try {\n243:     records = lines\n244:       .filter((line) => line && (typeof line === \"object\" || typeof line === \"string\"))\n245:       .map((line, index) =>\n246:         typeof line === \"string\" ? toRecord({ text: line }, index, traceId) : toRecord(line, index, traceId)\n247:       );\n248:   } catch (err) {\n249:     return json(res, 400, { ok: false, error: \"bad_request\", hint: \"ligne illisible dans lines\" });\n250:   }\n251:   if (!records.length) {\n252:     return json(res, 400, { ok: false, error: \"bad_request\", hint: \"aucune ligne exploitable\" });\n253:   }\n254: \n255:   const messages = records.map((record) => ({ key: traceId, value: JSON.stringify(record) }));\n256:   try {\n257:     const produced = await publish(messages);\n258:     return json(res, 200, {\n259:       ok: true,\n260:       topic: topicName(\"logs\"),\n261:       produced,\n262:       trace_id: traceId,\n263:       routing: AGENT_ROUTING ? \"agents\" : \"logs_only\",\n264:     });\n265:   } catch (err) {\n266:     const config = err instanceof KafkaConfigError;\n267:     return json(res, 503, {\n268:       ok: false,\n269:       error: config ? \"config_error\" : \"kafka_unreachable\",\n270:       hint: config ? err.message : `Kafka injoignable (${err.message})`,\n271:     });\n272:   }\n273: };","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /home/baptistefaisy/log-site-vercel/api/logs.js, lines 1-273\n1: // Vercel Function : ingestion des logs de la console web « log() » vers Aiven Kafka.\n2: //\n3: //   POST /api/logs   {\"lines\":[{\"level\":\"err\",\"text\":\"...\",\"code\":\"ERR_KAFKA_UNREACHABLE\",\n4: //                               \"service\":\"event-worker\",\"ts\":\"2026-10-22T10:03:55.123Z\",\n5: //                               \"trace_id\":\"<32 hex>\"}]}\n6: //     -> 200 {\"ok\":true,\"topic\":\"otel.logs\",\"produced\":1,\"trace_id\":\"...\"}\n7: //     -> 400 {\"ok\":false,\"error\":\"bad_request\",\"hint\":\"...\"}\n8: //     -> 503 {\"ok\":false,\"error\":\"kafka_unreachable\",\"hint\":\"...\"}\n9: //     -> 429 {\"ok\":false,\"error\":\"rate_limited\",\"hint\":\"...\"}\n10: //\n11: //   GET /api/logs    -> 200 {\"ok\":true,\"kafka\":\"up\"|\"down\",\"topic\":\"otel.logs\",...}\n12: //\n13: // Le message produit suit le contrat des messages (§3) : une ligne JSON dont les\n14: // cles sont celles du schema OpenTelemetry standard, la cle Kafka etant le TraceId.\n15: // Les attributs agent.scenario / agent.profile sont presents sur chaque log, comme\n16: // l'exige le watcher d'incidents.\n17: //\n18: // Variables d'environnement : celles de api/_kafka.js, plus\n19: //   KAFKA_AGENT_ROUTING   \"0\" = logs seulement, sans error.type (aucun agent ne part)\n20: //                         \"1\" (defaut) = les lignes err/wrn portent error.type et\n21: //                         peuvent declencher un agent via routes.yaml\n22: //   LOGS_MAX_LINES        lignes max par requete (defaut : 40)\n23: //   LOGS_RATE_PER_MIN     requetes max par minute et par IP (defaut : 120)\n24: //\n25: // Le site est public : tout ce qui entre est borne, nettoye et masque.\n26: \n27: const crypto = require(\"crypto\");\n28: const { publish, health, KafkaConfigError, KafkaDownError, topicName, configured } = require(\"./_kafka\");\n29: const { redact } = require(\"./_redact\");\n30: \n31: const MAX_LINES = Number(process.env.LOGS_MAX_LINES) || 40;\n32: const MAX_LINE_CHARS = 4000;\n33: const MAX_BODY_CHARS = 96 * 1024;\n34: const RATE_PER_MIN = Number(process.env.LOGS_RATE_PER_MIN) || 120;\n35: const AGENT_ROUTING = String(process.env.KAFKA_AGENT_ROUTING || \"1\") !== \"0\";\n36: const SERVICE = \"log-site\";\n37: const SCOPE = { name: \"log-site\", version: \"1.0.0\" };\n38: \n39: // « err » cote navigateur -> severite OpenTelemetry.\n40: const SEVERITY = {\n41:   dbg: { text: \"DEBUG\", number: 5 },\n42:   inf: { text: \"INFO\", number: 9 },\n43:   ok: { text: \"INFO\", number: 9 },\n44:   wrn: { text: \"WARN\", number: 13 },\n45:   err: { text: \"ERROR\", number: 17 },\n46: };\n47: \n48: // Code affiche par la console -> error.type attendu par routes.yaml.\n49: // Un code inconnu est simplement derive (minuscules, prefixe ERR_ retire) : le\n50: // watcher retombe alors sur default_agent, il ne casse pas.\n51: const ERROR_TYPES = {\n52:   ERR_DB_POOL_EXHAUSTED: \"db_pool_exhausted\",\n53:   ERR_PG_TIMEOUT_5432: \"db_connection_timeout\",\n54:   ERR_KAFKA_UNREACHABLE: \"kafka_broker_unreachable\",\n55:   ERR_OOM_HEAP: \"oom\",\n56:   ERR_DISK_FULL: \"disk_full\",\n57:   ERR_SILENT_FAILURE: \"silent_failure\",\n58:   ERR_STALE_SOURCE: \"stale_source\",\n59:   ERR_CACHE_MISS_STORM: \"cache_miss_storm\",\n60: };\n61: \n62: function json(res, code, payload) {\n63:   res.statusCode = code;\n64:   res.setHeader(\"Content-Type\", \"application/json; charset=utf-8\");\n65:   res.setHeader(\"Cache-Control\", \"no-store\");\n66:   res.end(JSON.stringify(payload));\n67: }\n68: \n69: function errorTypeFor(code, level) {\n70:   if (!AGENT_ROUTING) return \"\";\n71:   if (level !== \"err\" && level !== \"wrn\") return \"\";\n72:   const key = String(code || \"\").toUpperCase();\n73:   if (ERROR_TYPES[key]) return ERROR_TYPES[key];\n74:   const derived = key.replace(/^ERR_/, \"\").toLowerCase().replace(/[^a-z0-9_]/g, \"_\");\n75:   return derived.slice(0, 60);\n76: }\n77: \n78: function timestamp(value) {\n79:   const date = value ? new Date(value) : new Date();\n80:   const safe = Number.isNaN(date.getTime()) ? new Date() : date;\n81:   return `${safe.toISOString().slice(0, 19).replace(\"T\", \" \")}.${String(safe.getUTCMilliseconds()).padStart(3, \"0\")}`;\n82: }\n83: \n84: function hex32(value) {\n85:   return crypto.createHash(\"sha256\").update(String(value)).digest(\"hex\");\n86: }\n87: \n88: function traceIdFor(raw) {\n89:   const candidate = String(raw || \"\").toLowerCase().replace(/[^0-9a-f]/g, \"\");\n90:   if (candidate.length === 32) return candidate;\n91:   return hex32(`${Date.now()}:${Math.random()}`).slice(0, 32);\n92: }\n93: \n94: function clean(text) {\n95:   return redact(String(text == null ? \"\" : text))\n96:     // eslint-disable-next-line no-control-regex\n97:     .replace(/[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]/g, \" \")\n98:     .slice(0, MAX_LINE_CHARS);\n99: }\n100: \n101: /** Transforme une ligne de console en log OpenTelemetry du contrat. */\n102: function toRecord(line, index, traceId) {\n103:   const level = String(line.level || \"inf\").toLowerCase();\n104:   const severity = SEVERITY[level] || SEVERITY.inf;\n105:   const code = clean(line.code || \"\").toUpperCase().slice(0, 64);\n106:   const service = clean(line.service || \"\").slice(0, 64) || SERVICE;\n107:   const errorType = errorTypeFor(code, level);\n108:   const attributes = {\n109:     \"agent.scenario\": code || \"site-console\",\n110:     \"agent.profile\": \"site\",\n111:     \"site.level\": level,\n112:     \"site.service\": service,\n113:     \"site.host\": clean(line.host || \"\").slice(0, 120) || \"unknown\",\n114:     \"site.page\": clean(line.page || \"/\").slice(0, 200),\n115:     \"site.session\": clean(line.session || \"\").slice(0, 64),\n116:     \"site.source\": \"vercel-function\",\n117:   };\n118:   if (errorType) attributes[\"error.type\"] = errorType;\n119:   return {\n120:     Timestamp: timestamp(line.ts),\n121:     TraceId: traceId,\n122:     SpanId: hex32(`${traceId}:${index}:${line.text || \"\"}`).slice(0, 16),\n123:     ParentSpanId: \"\",\n124:     TraceFlags: \"01\",\n125:     SeverityText: severity.text,\n126:     SeverityNumber: severity.number,\n127:     Body: clean(line.text || \"\"),\n128:     LogAttributes: attributes,\n129:     SpanAttributes: { ...attributes },\n130:     ScopeName: SCOPE.name,\n131:     ScopeVersion: SCOPE.version,\n132:     ResourceAttributes: {\n133:       \"service.name\": SERVICE,\n134:       \"deployment.environment\": \"vercel\",\n135:       \"site.region\": process.env.VERCEL_REGION || \"\",\n136:     },\n137:     ServiceName: SERVICE,\n138:   };\n139: }\n140: \n141: // Limiteur best effort : chaque instance de fonction a sa propre memoire, ce qui\n142: // suffit a empecher une boucle navigateur de saturer un petit plan Kafka.\n143: const hits = new Map();\n144: \n145: function rateLimited(ip) {\n146:   const now = Date.now();\n147:   const window = hits.get(ip);\n148:   if (!window || now - window.start > 60000) {\n149:     hits.set(ip, { start: now, count: 1 });\n150:     if (hits.size > 5000) hits.clear();\n151:     return false;\n152:   }\n153:   window.count += 1;\n154:   return window.count > RATE_PER_MIN;\n155: }\n156: \n157: function bodyOf(req) {\n158:   let body = req.body;\n159:   if (typeof body === \"string\") {\n160:     if (body.length > MAX_BODY_CHARS) return null;\n161:     try {\n162:       body = JSON.parse(body);\n163:     } catch (err) {\n164:       return null;\n165:     }\n166:   }\n167:   if (!body || typeof body !== \"object\") return null;\n168:   return body;\n169: }\n170: \n171: module.exports = async function handler(req, res) {\n172:   if (req.method === \"GET\") {\n173:     if (!configured()) {\n174:       return json(res, 200, {\n175:         ok: true,\n176:         kafka: \"down\",\n177:         error: \"config_error\",\n178:         hint: \"variables KAFKA_BOOTSTRAP / KAFKA_USERNAME / KAFKA_PASSWORD / KAFKA_CA_PEM absentes du projet Vercel\",\n179:         topic: topicName(\"logs\"),\n180:       });\n181:     }\n182:     try {\n183:       const state = await health();\n184:       return json(res, 200, {\n185:         ok: true,\n186:         kafka: \"up\",\n187:         topic: state.topic,\n188:         brokers: state.brokers,\n189:         routing: AGENT_ROUTING ? \"agents\" : \"logs_only\",\n190:       });\n191:     } catch (err) {\n192:       const config = err instanceof KafkaConfigError;\n193:       return json(res, 200, {\n194:         ok: true,\n195:         kafka: \"down\",\n196:         error: config ? \"config_error\" : \"kafka_unreachable\",\n197:         hint: config ? err.message : `Kafka injoignable (${err.message})`,\n198:         topic: topicName(\"logs\"),\n199:       });\n200:     }\n201:   }\n202: \n203:   if (req.method !== \"POST\") {\n204:     return json(res, 405, {\n205:       ok: false,\n206:       error: \"method_not_allowed\",\n207:       hint: 'utilise POST /api/logs avec {\"lines\":[...]} ou GET /api/logs pour l\\'etat',\n208:     });\n209:   }\n210: \n211:   const ip =\n212:     (req.headers[\"x-forwarded-for\"] || \"\").split(\",\")[0].trim() ||\n213:     (req.socket && req.socket.remoteAddress) ||\n214:     \"unknown\";\n215:   if (rateLimited(ip)) {\n216:     return json(res, 429, {\n217:       ok: false,\n218:       error: \"rate_limited\",\n219:       hint: `plus de ${RATE_PER_MIN} envois par minute depuis cette adresse`,\n220:     });\n221:   }\n222: \n223:   const body = bodyOf(req);\n224:   const lines = body && Array.isArray(body.lines) ? body.lines : body && body.line ? [body.line] : null;\n225:   if (!lines || !lines.length) {\n226:     return json(res, 400, {\n227:       ok: false,\n228:       error: \"bad_request\",\n229:       hint: 'corps attendu : {\"lines\":[{\"level\":\"err\",\"text\":\"...\"}]}',\n230:     });\n231:   }\n232:   if (lines.length > MAX_LINES) {\n233:     return json(res, 413, {\n234:       ok: false,\n235:       error: \"too_many_lines\",\n236:       hint: `maximum ${MAX_LINES} lignes par requete`,\n237:     });\n238:   }\n239: \n240:   const traceId = traceIdFor(body.trace_id || (lines[0] && lines[0].trace_id));\n241:   let records;\n242:   try {\n243:     records = lines\n244:       .filter((line) => line && (typeof line === \"object\" || typeof line === \"string\"))\n245:       .map((line, index) =>\n246:         typeof line === \"string\" ? toRecord({ text: line }, index, traceId) : toRecord(line, index, traceId)\n247:       );\n248:   } catch (err) {\n249:     return json(res, 400, { ok: false, error: \"bad_request\", hint: \"ligne illisible dans lines\" });\n250:   }\n251:   if (!records.length) {\n252:     return json(res, 400, { ok: false, error: \"bad_request\", hint: \"aucune ligne exploitable\" });\n253:   }\n254: \n255:   const messages = records.map((record) => ({ key: traceId, value: JSON.stringify(record) }));\n256:   try {\n257:     const produced = await publish(messages);\n258:     return json(res, 200, {\n259:       ok: true,\n260:       topic: topicName(\"logs\"),\n261:       produced,\n262:       trace_id: traceId,\n263:       routing: AGENT_ROUTING ? \"agents\" : \"logs_only\",\n264:     });\n265:   } catch (err) {\n266:     const config = err instanceof KafkaConfigError;\n267:     return json(res, 503, {\n268:       ok: false,\n269:       error: config ? \"config_error\" : \"kafka_unreachable\",\n270:       hint: config ? err.message : `Kafka injoignable (${err.message})`,\n271:     });\n272:   }\n273: };"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/home/baptistefaisy/log-site-vercel/api/logs.js\"}"},"time":{"start":1792666720125,"end":1792666720167}}}}
