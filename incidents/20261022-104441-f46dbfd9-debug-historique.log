{"type":"tool_use","timestamp":1792666812776,"sessionID":"ses_e9cc974dfffegz842AnbVwJnCF","part":{"partID":"prt_16344c147001qZ0R8TSs3yvE4M","sessionID":"ses_e9cc974dfffegz842AnbVwJnCF","messageID":"msg_163445104001UwfD2QseWHMYfp","type":"tool","id":"call_00_LrinvSPSv8lAQeS9aebv4120","tool":"read","state":{"status":"completed","input":{"path":"/home/baptistefaisy/log-site-vercel/logsink.js"},"output":"Read file /home/baptistefaisy/log-site-vercel/logsink.js, lines 1-156\n1: /* Envoi des lignes de la console vers Aiven Kafka (via /api/logs).\n2:  *\n3:  * Principe : la console reste instantanee. Chaque ligne part dans une file,\n4:  * la file est vidée par lots (<= 20 lignes, toutes les 900 ms) et l'echec\n5:  * reseau ne casse jamais l'affichage : au pire la ligne reste locale.\n6:  *\n7:  * Vide = 100 % local (aucun appel reseau), comme LOG_METRICS_API.\n8:  */\n9: window.LogSink = (function () {\n10:   const MAX_QUEUE = 200;\n11:   const BATCH = 20;\n12:   const DELAY = 900;\n13: \n14:   const base = String(window.LOG_KAFKA_API || \"\").trim().replace(/\\/$/, \"\");\n15:   const state = {\n16:     base,\n17:     online: Boolean(base) && window.location.protocol !== \"file:\",\n18:     sent: 0,\n19:     dropped: 0,\n20:     errors: 0,\n21:     lastError: \"\",\n22:     lastStatus: \"\",\n23:   };\n24: \n25:   let queue = [];\n26:   let timer = null;\n27:   let trace = \"\";\n28:   let flushing = false;\n29: \n30:   // Identifiant de session : permet de regrouper les lignes d'un meme onglet.\n31:   state.session = Math.random().toString(16).slice(2, 10);\n32: \n33:   function randomTrace() {\n34:     const bytes = new Uint8Array(16);\n35:     if (window.crypto && window.crypto.getRandomValues) window.crypto.getRandomValues(bytes);\n36:     else for (let i = 0; i < 16; i += 1) bytes[i] = Math.floor(Math.random() * 256);\n37:     return Array.from(bytes, (b) => b.toString(16).padStart(2, \"0\")).join(\"\");\n38:   }\n39: \n40:   function beginTrace() {\n41:     trace = randomTrace();\n42:     return trace;\n43:   }\n44: \n45:   function currentTrace() {\n46:     if (!trace) beginTrace();\n47:     return trace;\n48:   }\n49: \n50:   function payload(lines, id) {\n51:     return JSON.stringify({\n52:       trace_id: id,\n53:       page: window.location.pathname,\n54:       host: window.location.host,\n55:       session: state.session || \"\",\n56:       lines,\n57:     });\n58:   }\n59: \n60:   function flush(useBeacon) {\n61:     if (!state.online || flushing || !queue.length) return Promise.resolve(false);\n62:     const batch = queue.slice(0, BATCH);\n63:     queue = queue.slice(batch.length);\n64:     const body = payload(batch, currentTrace());\n65:     flushing = true;\n66: \n67:     const done = (ok, data) => {\n68:       flushing = false;\n69:       if (ok) {\n70:         state.sent += batch.length;\n71:         state.lastError = \"\";\n72:       } else {\n73:         state.errors += 1;\n74:         state.lastError = (data && data.hint) || \"envoi impossible\";\n75:       }\n76:       if (queue.length) schedule();\n77:       return ok;\n78:     };\n79: \n80:     if (useBeacon && navigator.sendBeacon) {\n81:       const blob = new Blob([body], { type: \"application/json\" });\n82:       const ok = navigator.sendBeacon(`${base}`, blob);\n83:       return Promise.resolve(done(ok, null));\n84:     }\n85: \n86:     const controller = new AbortController();\n87:     const guard = setTimeout(() => controller.abort(), 6000);\n88:     return fetch(base, {\n89:       method: \"POST\",\n90:       headers: { \"content-type\": \"application/json\" },\n91:       body,\n92:       signal: controller.signal,\n93:       keepalive: true,\n94:     })\n95:       .then((res) => res.json().catch(() => null).then((data) => done(res.ok, data)))\n96:       .catch(() => done(false, null))\n97:       .finally(() => clearTimeout(guard));\n98:   }\n99: \n100:   function schedule() {\n101:     if (timer) return;\n102:     timer = setTimeout(() => {\n103:       timer = null;\n104:       flush(false);\n105:     }, DELAY);\n106:   }\n107: \n108:   function push(entry) {\n109:     if (!state.online) return;\n110:     queue.push({\n111:       level: entry.level || \"inf\",\n112:       text: String(entry.text || \"\").slice(0, 4000),\n113:       code: entry.code || \"\",\n114:       service: entry.service || \"\",\n115:       ts: new Date().toISOString(),\n116:       trace_id: currentTrace(),\n117:     });\n118:     if (queue.length > MAX_QUEUE) {\n119:       state.dropped += queue.length - MAX_QUEUE;\n120:       queue = queue.slice(queue.length - MAX_QUEUE);\n121:     }\n122:     schedule();\n123:   }\n124: \n125:   function health() {\n126:     if (!state.online) return Promise.resolve({ ok: false, kafka: \"off\", error: \"not_configured\" });\n127:     const controller = new AbortController();\n128:     const guard = setTimeout(() => controller.abort(), 6000);\n129:     return fetch(base, { headers: { accept: \"application/json\" }, signal: controller.signal })\n130:       .then((res) => res.json().catch(() => null))\n131:       .then((data) => {\n132:         state.lastStatus = data && data.kafka ? data.kafka : \"down\";\n133:         return data || { ok: false, kafka: \"down\", error: \"bad_response\" };\n134:       })\n135:       .catch(() => ({ ok: false, kafka: \"down\", error: \"unreachable\" }))\n136:       .finally(() => clearTimeout(guard));\n137:   }\n138: \n139:   // Derniere chance : vider la file quand l'onglet se ferme.\n140:   window.addEventListener(\"pagehide\", () => flush(true));\n141:   document.addEventListener(\"visibilitychange\", () => {\n142:     if (document.visibilityState === \"hidden\") flush(true);\n143:   });\n144: \n145:   return {\n146:     state,\n147:     push,\n148:     flush,\n149:     health,\n150:     beginTrace,\n151:     currentTrace,\n152:     setSession: (id) => {\n153:       state.session = String(id || \"\").slice(0, 64);\n154:     },\n155:   };\n156: })();","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /home/baptistefaisy/log-site-vercel/logsink.js, lines 1-156\n1: /* Envoi des lignes de la console vers Aiven Kafka (via /api/logs).\n2:  *\n3:  * Principe : la console reste instantanee. Chaque ligne part dans une file,\n4:  * la file est vidée par lots (<= 20 lignes, toutes les 900 ms) et l'echec\n5:  * reseau ne casse jamais l'affichage : au pire la ligne reste locale.\n6:  *\n7:  * Vide = 100 % local (aucun appel reseau), comme LOG_METRICS_API.\n8:  */\n9: window.LogSink = (function () {\n10:   const MAX_QUEUE = 200;\n11:   const BATCH = 20;\n12:   const DELAY = 900;\n13: \n14:   const base = String(window.LOG_KAFKA_API || \"\").trim().replace(/\\/$/, \"\");\n15:   const state = {\n16:     base,\n17:     online: Boolean(base) && window.location.protocol !== \"file:\",\n18:     sent: 0,\n19:     dropped: 0,\n20:     errors: 0,\n21:     lastError: \"\",\n22:     lastStatus: \"\",\n23:   };\n24: \n25:   let queue = [];\n26:   let timer = null;\n27:   let trace = \"\";\n28:   let flushing = false;\n29: \n30:   // Identifiant de session : permet de regrouper les lignes d'un meme onglet.\n31:   state.session = Math.random().toString(16).slice(2, 10);\n32: \n33:   function randomTrace() {\n34:     const bytes = new Uint8Array(16);\n35:     if (window.crypto && window.crypto.getRandomValues) window.crypto.getRandomValues(bytes);\n36:     else for (let i = 0; i < 16; i += 1) bytes[i] = Math.floor(Math.random() * 256);\n37:     return Array.from(bytes, (b) => b.toString(16).padStart(2, \"0\")).join(\"\");\n38:   }\n39: \n40:   function beginTrace() {\n41:     trace = randomTrace();\n42:     return trace;\n43:   }\n44: \n45:   function currentTrace() {\n46:     if (!trace) beginTrace();\n47:     return trace;\n48:   }\n49: \n50:   function payload(lines, id) {\n51:     return JSON.stringify({\n52:       trace_id: id,\n53:       page: window.location.pathname,\n54:       host: window.location.host,\n55:       session: state.session || \"\",\n56:       lines,\n57:     });\n58:   }\n59: \n60:   function flush(useBeacon) {\n61:     if (!state.online || flushing || !queue.length) return Promise.resolve(false);\n62:     const batch = queue.slice(0, BATCH);\n63:     queue = queue.slice(batch.length);\n64:     const body = payload(batch, currentTrace());\n65:     flushing = true;\n66: \n67:     const done = (ok, data) => {\n68:       flushing = false;\n69:       if (ok) {\n70:         state.sent += batch.length;\n71:         state.lastError = \"\";\n72:       } else {\n73:         state.errors += 1;\n74:         state.lastError = (data && data.hint) || \"envoi impossible\";\n75:       }\n76:       if (queue.length) schedule();\n77:       return ok;\n78:     };\n79: \n80:     if (useBeacon && navigator.sendBeacon) {\n81:       const blob = new Blob([body], { type: \"application/json\" });\n82:       const ok = navigator.sendBeacon(`${base}`, blob);\n83:       return Promise.resolve(done(ok, null));\n84:     }\n85: \n86:     const controller = new AbortController();\n87:     const guard = setTimeout(() => controller.abort(), 6000);\n88:     return fetch(base, {\n89:       method: \"POST\",\n90:       headers: { \"content-type\": \"application/json\" },\n91:       body,\n92:       signal: controller.signal,\n93:       keepalive: true,\n94:     })\n95:       .then((res) => res.json().catch(() => null).then((data) => done(res.ok, data)))\n96:       .catch(() => done(false, null))\n97:       .finally(() => clearTimeout(guard));\n98:   }\n99: \n100:   function schedule() {\n101:     if (timer) return;\n102:     timer = setTimeout(() => {\n103:       timer = null;\n104:       flush(false);\n105:     }, DELAY);\n106:   }\n107: \n108:   function push(entry) {\n109:     if (!state.online) return;\n110:     queue.push({\n111:       level: entry.level || \"inf\",\n112:       text: String(entry.text || \"\").slice(0, 4000),\n113:       code: entry.code || \"\",\n114:       service: entry.service || \"\",\n115:       ts: new Date().toISOString(),\n116:       trace_id: currentTrace(),\n117:     });\n118:     if (queue.length > MAX_QUEUE) {\n119:       state.dropped += queue.length - MAX_QUEUE;\n120:       queue = queue.slice(queue.length - MAX_QUEUE);\n121:     }\n122:     schedule();\n123:   }\n124: \n125:   function health() {\n126:     if (!state.online) return Promise.resolve({ ok: false, kafka: \"off\", error: \"not_configured\" });\n127:     const controller = new AbortController();\n128:     const guard = setTimeout(() => controller.abort(), 6000);\n129:     return fetch(base, { headers: { accept: \"application/json\" }, signal: controller.signal })\n130:       .then((res) => res.json().catch(() => null))\n131:       .then((data) => {\n132:         state.lastStatus = data && data.kafka ? data.kafka : \"down\";\n133:         return data || { ok: false, kafka: \"down\", error: \"bad_response\" };\n134:       })\n135:       .catch(() => ({ ok: false, kafka: \"down\", error: \"unreachable\" }))\n136:       .finally(() => clearTimeout(guard));\n137:   }\n138: \n139:   // Derniere chance : vider la file quand l'onglet se ferme.\n140:   window.addEventListener(\"pagehide\", () => flush(true));\n141:   document.addEventListener(\"visibilitychange\", () => {\n142:     if (document.visibilityState === \"hidden\") flush(true);\n143:   });\n144: \n145:   return {\n146:     state,\n147:     push,\n148:     flush,\n149:     health,\n150:     beginTrace,\n151:     currentTrace,\n152:     setSession: (id) => {\n153:       state.session = String(id || \"\").slice(0, 64);\n154:     },\n155:   };\n156: })();"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/home/baptistefaisy/log-site-vercel/logsink.js\"}"},"time":{"start":1792666812743,"end":1792666812776}}}}
