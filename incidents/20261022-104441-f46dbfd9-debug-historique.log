err.write(`api/report : ${err.message}\\n`);\n38:     return send(config ? 500 : 503, {\n39:       ok: false,\n40:       error: config ? 'config_error' : 'kafka_unreachable',\n41:       hint: config\n42:         ? `configuration Kafka incomplete cote serveur : ${err.message}`\n43:         : `Kafka injoignable (${publicReason(err)}) — le rapport ne peut pas etre lu pour l'instant, reessaie dans un instant.`,\n44:     });\n45:   }\n46: \n47:   if (!report) {\n48:     return send(404, {\n49:       ok: false,\n50:       error: 'not_found',\n51:       hint: \"l'agent n'a pas encore publie de rapport pour cette trace\",\n52:     });\n53:   }\n54: \n55:   return send(200, {\n56:     ok: true,\n57:     status: 'done',\n58:     trace_id: report.TraceId || traceId,\n59:     agent: report.agent || '',\n60:     // identification du groupe : ajoutee par tools/kafka-incident-watch depuis\n61:     // agents/group.json. Vide pour un rapport publie avant le manifeste.\n62:     agent_group: report.agent_group || '',\n63:     agent_group_label: report.agent_group_label || '',\n64:     agent_use_case: report.agent_use_case || '',\n65:     agent_origin: report.agent_origin || '',\n66:     agent_origin_label: report.agent_origin_label || '',\n67:     agent_role: report.agent_role || '',\n68:     error_type: report.error_type || '',\n69:     scenario: report.scenario || '',\n70:     title: report.title || '',\n71:     report: report.report || '',\n72:   });\n73: };","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /home/baptistefaisy/aiven-kafka-demo/site/api/report.js, lines 1-73\n1: 'use strict';\n2: /**\n3:  * GET /api/report?trace_id=<id>\n4:  *   -> 200 {\"ok\":true,\"status\":\"pending\"|\"done\",\"agent\":\"...\",\"report\":\"...\"}\n5:  *   -> 404 {\"ok\":false,\"error\":\"not_found\",\"hint\":\"...\"}  (pas encore de rapport)\n6:  *   -> 503 {\"ok\":false,\"error\":\"kafka_unreachable\",\"hint\":\"...\"}\n7:  *\n8:  * Extension