l[str] = None,\\n363-                  suffixes: Optional[List[str]] = None,\\n364-                  trace_id: Optional[str] = None,\\n365-                  group_id: Optional[str] = None,\\n366-                  idle_seconds: float = 6.0,\\n367-                  timeout_seconds: float = 45.0,\\n368-                  max_messages: int = 20000,\\n369-                  attempts: int = 3) -> Dict[str, List[dict]]:\\n370-    \\\"\\\"\\\"Lit les topics depuis le debut et renvoie les messages par suffixe.\\n371-\\n372-    trace_id : ne garder que les messages de cette trace (None = tout).\\n373-    Ne leve jamais : un topic absent ou un broker injoignable donne une\\n374-    liste vide et un diagnostic dans stderr.\\n375-\\n376-    Le broker Aiven peut refuser la premiere negociation SASL (les identifiants\\n377-    SCRAM ne sont pas encore propages sur l'autre noeud du cluster) : on\\n378-    reessaie avec un nouveau consommateur plutot que de renvoyer une liste\\n379-    vide qui ferait croire a une trace absente.\\n380-    \\\"\\\"\\\"\\n381-    result: Dict[str, List[dict]] = {}\\n382-    for attempt in range(max(1, attempts)):\\n383-        result = _read_once(prefix, suffixes, trace_id, group_id, idle_seconds,\\n384-                             timeout_seconds, max_messages)\\n385-        if any(result.values()):\\n386-            return result\\n387-        if attempt < attempts - 1:\\n388-            time.sleep(2)\\n389-    return result\\n390-\\n391-\\n392-def _read_once(prefix: Optional[str] = None,\\n393-               suffixes: Optional[List[str]] = None,\\n394-               trace_id: Optional[str] = None,\\n395-               group_id: Optional[str] = None,\\n396-               idle_seconds: float = 6.0,\\n397-               timeout_seconds: float = 45.0,\\n398-               max_messages: int = 20000) -> Dict[str, List[dict]]:\\n399-    \\\"\\\"\\\"Une passe de lecture (voir read_messages pour la politique de retry).\\\"\\\"\\\"\\n400-    import time\\n401-