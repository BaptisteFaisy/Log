 pass\n431-            eprint(f\"lecture Kafka : metadonnees indisponibles ({exc}) -> nouvel essai\")\n432-            return out\n433-        assignments = []\n434-        for name in topic_names:\n435-            tm = (getattr(meta, \"topics\", None) or {}).get(name)\n436-            if not tm:\n437-                continue\n438-            for pid in (getattr(tm, \"partitions\", None) or {}):\n439-                assignments.append(TopicPartition(name, pid, OFFSET_BEGINNING))\n440-        consumer.assign(assignments)\n441-    except Exception as exc:  # noqa: BLE001\n442-        raise KafkaUnreachable(f\"connexion au broker impossible : {exc}\") from exc\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /home/baptistefaisy/aiven-kafka-demo && grep -n \\\"def read_messages\\\" -A 80 tools/kafkalib.py\", \"timeout\": 60000}"},"time":{"start":1792670752773,"end":1792670752821}}}}
