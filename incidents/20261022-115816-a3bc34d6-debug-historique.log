{"type":"tool_use","timestamp":1792670648798,"sessionID":"ses_e9c8615ebffej4TfSsdRs4c367","part":{"partID":"prt_1637f48870016d3MDU5GgA8b7M","sessionID":"ses_e9c8615ebffej4TfSsdRs4c367","messageID":"msg_1637ee9d2001OXWQ0d51v5GcYY","type":"tool","id":"call_01_qRms0Go2T1Zgi8rp8gvA1351","tool":"shell","state":{"status":"completed","input":{"command":"cd /home/baptistefaisy/aiven-kafka-demo && sed -n 1,120p tools/kafkalib.py","timeout":60000},"output":"#!/usr/bin/env python3\n\"\"\"Boite a outils Kafka partagee (config, producteur, consommateur).\n\nRegles de securite :\n  - aucun secret n'est jamais affiche ni journalise ;\n  - chaque appel reseau a un timeout ;\n  - les erreurs sont transformees en messages lisibles\n    (\"quoi / pourquoi / quoi faire maintenant\"), jamais en traceback.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\nimport re\nimport sys\nimport time\nfrom pathlib import Path\nfrom typing import Any, Dict, List, Optional, Tuple\n\nHERE = Path(__file__).resolve().parent\nPROJECT_ROOT = HERE.parent\n\nEXIT_OK = 0\nEXIT_USAGE = 1\nEXIT_CONFIG = 2\nEXIT_KAFKA = 3\nEXIT_RUNNING = 4\n\nREQUIRED_ENV = [\n    \"KAFKA_BOOTSTRAP\",\n    \"KAFKA_USERNAME\",\n    \"KAFKA_PASSWORD\",\n    \"KAFKA_CA_FILE\",\n    \"KAFKA_TOPIC_PREFIX\",\n]\n\n\nclass ConfigError(Exception):\n    \"\"\"Configuration incomplete (variables manquantes, fichier illisible...).\"\"\"\n\n\nclass KafkaUnreachable(Exception):\n    \"\"\"Le broker ne repond pas (reseau, TLS, ACL, service en construction...).\"\"\"\n\n\ndef load_env_file(path: Optional[str] = None) -> Dict[str, str]:\n    \"\"\"Charge un env-<service>.sh sans l'executer (parsing KEY=VALUE).\"\"\"\n    p = Path(path or PROJECT_ROOT / \"env-kafka-1687d005.sh\")\n    values: Dict[str, str] = {}\n    if not p.exists():\n        return values\n    for raw in p.read_text(encoding=\"utf-8\").splitlines():\n        line = raw.strip()\n        if not line or line.startswith(\"#\") or \"=\" not in line:\n            continue\n        if line.startswith(\"export \"):\n            line = line[len(\"export \"):]\n        key, _, val = line.partition(\"=\")\n        key = key.strip()\n        val = val.strip().strip('\"').strip(\"'\")\n        if key and re.fullmatch(r\"[A-Za-z_][A-Za-z0-9_]*\", key):\n            values[key] = val\n    return values\n\n\ndef ensure_config() -> None:\n    \"\"\"Remplit les variables KAFKA_* manquantes depuis le fichier d'env.\n\n    Le fichier est au format systemd (KEY=\"valeur\", sans `export`) : il est\n    lisible par `EnvironmentFile=` ET par bash. En bash, on le charge avec\n    `set -a; . env-kafka-1687d005.sh; set +a` pour l'exporter.\n    \"\"\"\n    if all(os.environ.get(k) for k in REQUIRED_ENV):\n        return\n    env_file = os.environ.get(\"KAFKA_ENV_FILE\")\n    for key, val in load_env_file(env_file).items():\n        os.environ.setdefault(key, val)\n\n\ndef config() -> Dict[str, str]:\n    ensure_config()\n    missing = [k for k in REQUIRED_ENV if not os.environ.get(k)]\n    if missing:\n        raise ConfigError(\n            \"configuration incomplete : variable(s) manquante(s) \"\n            + \", \".join(missing)\n            + \" -> source env-kafka-1687d005.sh (mode 600) puis reessaye\"\n        )\n    return {k: os.environ[k] for k in REQUIRED_ENV}\n\n\n# --------------------------------------------------------------------------\n# selection du cluster\n# --------------------------------------------------------------------------\n# Un seul cluster desormais : kafka-1687d005 (l'ancien service de repli\n# agent-kafka a ete supprime apres migration des donnees). L'infrastructure de\n# profils est conservee pour ne pas casser les appelants : un profil de repli\n# n'est ajoute QUE si KAFKA_FALLBACK_ENV_FILE designe un fichier existant.\nFALLBACK_ENV_FILE = os.environ.get(\"KAFKA_FALLBACK_ENV_FILE\", \"\")\nPROFILE_STATE = Path(os.environ.get(\n    \"KAFKA_PROFILE_STATE\",\n    str(Path.home() / \".local\" / \"state\" / \"aiven-kafka-demo\" / \"active.json\")))\nHEALTH_TTL_S = float(os.environ.get(\"KAFKA_HEALTH_TTL_S\", \"20\"))\n\n\ndef _profile_env(values: Dict[str, str]) -> Dict[str, str]:\n    env = dict(values)\n    env.setdefault(\"KAFKA_SECURITY_PROTOCOL\", \"SASL_SSL\")\n    env.setdefault(\"KAFKA_SASL_MECHANISM\", \"SCRAM-SHA-256\")\n    return env\n\n\ndef profiles() -> List[Tuple[str, Dict[str, str]]]:\n    \"\"\"Les profils disponibles : (nom, variables KAFKA_*).\"\"\"\n    ensure_config()\n    out: List[Tuple[str, Dict[str, str]]] = []\n    primary = {k: os.environ.get(k) for k in REQUIRED_ENV}\n    if all(primary.get(k) for k in REQUIRED_ENV):\n        out.append((\"primary\", _profile_env(primary)))\n    fallback = load_env_file(FALLBACK_ENV_FILE) if FALLBACK_ENV_FILE else {}\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"#!/usr/bin/env python3\n\"\"\"Boite a outils Kafka partagee (config, producteur, consommateur).\n\nRegles de securite :\n  - aucun secret n'est jamais affiche ni journalise ;\n  - chaque appel reseau a un timeout ;\n  - les erreurs sont transformees en messages lisibles\n    (\"quoi / pourquoi / quoi faire maintenant\"), jamais en traceback.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\nimport re\nimport sys\nimport time\nfrom pathlib import Path\nfrom typing import Any, Dict, List, Optional, Tuple\n\nHERE = Path(__file__).resolve().parent\nPROJECT_ROOT = HERE.parent\n\nEXIT_OK = 0\nEXIT_USAGE = 1\nEXIT_CONFIG = 2\nEXIT_KAFKA = 3\nEXIT_RUNNING = 4\n\nREQUIRED_ENV = [\n    \"KAFKA_BOOTSTRAP\",\n    \"KAFKA_USERNAME\",\n    \"KAFKA_PASSWORD\",\n    \"KAFKA_CA_FILE\",\n    \"KAFKA_TOPIC_PREFIX\",\n]\n\n\nclass ConfigError(Exception):\n    \"\"\"Configuration incomplete (variables manquantes, fichier illisible...).\"\"\"\n\n\nclass KafkaUnreachable(Exception):\n    \"\"\"Le broker ne repond pas (reseau, TLS, ACL, service en construction...).\"\"\"\n\n\ndef load_env_file(path: Optional[str] = None) -> Dict[str, str]:\n    \"\"\"Charge un env-<service>.sh sans l'executer (parsing KEY=VALUE).\"\"\"\n    p = Path(path or PROJECT_ROOT / \"env-kafka-1687d005.sh\")\n    values: Dict[str, str] = {}\n    if not p.exists():\n        return values\n    for raw in p.read_text(encoding=\"utf-8\").splitlines():\n        line = raw.strip()\n        if not line or line.startswith(\"#\") or \"=\" not in line:\n            continue\n        if line.startswith(\"export \"):\n            line = line[len(\"export \"):]\n        key, _, val = line.partition(\"=\")\n        key = key.strip()\n        val = val.strip().strip('\"').strip(\"'\")\n        if key and re.fullmatch(r\"[A-Za-z_][A-Za-z0-9_]*\", key):\n            values[key] = val\n    return values\n\n\ndef ensure_config() -> None:\n    \"\"\"Remplit les variables KAFKA_* manquantes depuis le fichier d'env.\n\n    Le fichier est au format systemd (KEY=\"valeur\", sans `export`) : il est\n    lisible par `EnvironmentFile=` ET par bash. En bash, on le charge avec\n    `set -a; . env-kafka-1687d005.sh; set +a` pour l'exporter.\n    \"\"\"\n    if all(os.environ.get(k) for k in REQUIRED_ENV):\n        return\n    env_file = os.environ.get(\"KAFKA_ENV_FILE\")\n    for key, val in load_env_file(env_file).items():\n        os.environ.setdefault(key, val)\n\n\ndef config() -> Dict[str, str]:\n    ensure_config()\n    missing = [k for k in REQUIRED_ENV if not os.environ.get(k)]\n    if missing:\n        raise ConfigError(\n            \"configuration incomplete : variable(s) manquante(s) \"\n            + \", \".join(missing)\n            + \" -> source env-kafka-1687d005.sh (mode 600) puis reessaye\"\n        )\n    return {k: os.environ[k] for k in REQUIRED_ENV}\n\n\n# --------------------------------------------------------------------------\n# selection du cluster\n# --------------------------------------------------------------------------\n# Un seul cluster desormais : kafka-1687d005 (l'ancien service de repli\n# agent-kafka a ete supprime apres migration des donnees). L'infrastructure de\n# profils est conservee pour ne pas casser les appelants : un profil de repli\n# n'est ajoute QUE si KAFKA_FALLBACK_ENV_FILE designe un fichier existant.\nFALLBACK_ENV_FILE = os.environ.get(\"KAFKA_FALLBACK_ENV_FILE\", \"\")\nPROFILE_STATE = Path(os.environ.get(\n    \"KAFKA_PROFILE_STATE\",\n    str(Path.home() / \".local\" / \"state\" / \"aiven-kafka-demo\" / \"active.json\")))\nHEALTH_TTL_S = float(os.environ.get(\"KAFKA_HEALTH_TTL_S\", \"20\"))\n\n\ndef _profile_env(values: Dict[str, str]) -> Dict[str, str]:\n    env = dict(values)\n    env.setdefault(\"KAFKA_SECURITY_PROTOCOL\", \"SASL_SSL\")\n    env.setdefault(\"KAFKA_SASL_MECHANISM\", \"SCRAM-SHA-256\")\n    return env\n\n\ndef profiles() -> List[Tuple[str, Dict[str, str]]]:\n    \"\"\"Les profils disponibles : (nom, variables KAFKA_*).\"\"\"\n    ensure_config()\n    out: List[Tuple[str, Dict[str, str]]] = []\n    primary = {k: os.environ.get(k) for k in REQUIRED_ENV}\n    if all(primary.get(k) for k in REQUIRED_ENV):\n        out.append((\"primary\", _profile_env(primary)))\n    fallback = load_env_file(FALLBACK_ENV_FILE) if FALLBACK_ENV_FILE else {}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /home/baptistefaisy/aiven-kafka-demo && sed -n 1,120p tools/kafkalib.py\", \"timeout\": 60000}"},"time":{"start":1792670648455,"end":1792670648798}}}}
