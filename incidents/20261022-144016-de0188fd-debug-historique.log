{"type":"tool_use","timestamp":1792680205901,"sessionID":"ses_e9bf1c43cffeIAXTTY71yEDIgZ","part":{"partID":"prt_164111715001e8u9MuL75gYdYf","sessionID":"ses_e9bf1c43cffeIAXTTY71yEDIgZ","messageID":"msg_16410f7bb001eZxSr3H6VQ3KqD","type":"tool","id":"call_00_c3XXDr6mt4NnEY9sJFOT9695","tool":"shell","state":{"status":"completed","input":{"command":"cd /home/baptistefaisy/aiven-kafka-demo && head -80 trace-dump 2>&1","timeout":30000},"output":"#!/usr/bin/env python3\n\"\"\"trace-dump — la preuve brute (§5.4).\n\nUsage :\n  trace-dump <trace_id>            spans + logs + metriques d'une trace\n  trace-dump <trace_id> --detectors  + le verdict des 3 detecteurs\n  trace-dump --list                liste les traces vues dans Kafka\n  trace-dump --list --json\n  trace-dump <trace_id> --json\n\nCodes de sortie : 0 ok / 1 trace absente ou usage / 2 configuration\nmanquante / 3 Kafka injoignable.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport sys\nfrom pathlib import Path\n\nPROJECT_ROOT = Path(__file__).resolve().parent\nsys.path.insert(0, str(PROJECT_ROOT / \"tools\"))\n\nimport contract  # noqa: E402\nimport detectors  # noqa: E402\nimport kafkalib  # noqa: E402\n\nEXIT_OK = kafkalib.EXIT_OK\nEXIT_USAGE = kafkalib.EXIT_USAGE\nEXIT_CONFIG = kafkalib.EXIT_CONFIG\nEXIT_KAFKA = kafkalib.EXIT_KAFKA\n\n\ndef read(prefix, suffixes=None, trace_id=None):\n    return kafkalib.read_messages(prefix=prefix, suffixes=suffixes, trace_id=trace_id)\n\n\ndef collect(data, trace_id=None):\n    \"\"\"Separe les traces/logs (par TraceId) des metriques (par scenario/profil).\n\n    §3 : la table otel.metrics n'a pas de colonne TraceId ; les metriques\n    sont donc rattachees par couple scenario/profil (§5.4).\n    \"\"\"\n    traces = [t for t in data.get(\"traces\", []) if trace_id is None or t.get(\"TraceId\") == trace_id]\n    logs = [l for l in data.get(\"logs\", []) if trace_id is None or l.get(\"TraceId\") == trace_id]\n    scenario = \"\"\n    profile = \"\"\n    error_type = \"\"\n    for span in traces:\n        attrs = span.get(\"SpanAttributes\") or {}\n        scenario = scenario or attrs.get(\"agent.scenario\", \"\")\n        profile = profile or attrs.get(\"agent.profile\", \"\")\n        error_type = error_type or attrs.get(\"error.type\", \"\")\n    for log in logs:\n        attrs = log.get(\"SpanAttributes\") or log.get(\"LogAttributes\") or {}\n        scenario = scenario or attrs.get(\"agent.scenario\", \"\")\n        profile = profile or attrs.get(\"agent.profile\", \"\")\n        error_type = error_type or attrs.get(\"error.type\", \"\")\n    metrics = []\n    for metric in data.get(\"metrics\", []):\n        attrs = metric.get(\"Attributes\") or {}\n        if scenario and attrs.get(\"agent.scenario\") != scenario:\n            continue\n        if profile and attrs.get(\"agent.profile\") not in (\"\", profile):\n            continue\n        metrics.append(metric)\n    return traces, logs, metrics, scenario, profile, error_type\n\n\ndef dump_trace(trace_id, prefix, as_json, with_detectors):\n    data = read(prefix)\n    traces, logs, metrics, scenario, profile, error_type = collect(data, trace_id)\n    if not traces and not logs:\n        msg = f\"trace absente : {trace_id}\"\n        if as_json:\n            print(json.dumps({\"ok\": False, \"error\": \"trace_absente\",\n                              \"trace_id\": trace_id, \"hint\": msg}, ensure_ascii=False))\n        else:\n            print(msg, file=sys.stderr)\n            print(\"  -> le trace_id n'existe pas dans les topics (ou le prefixe est faux)\",\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"#!/usr/bin/env python3\n\"\"\"trace-dump — la preuve brute (§5.4).\n\nUsage :\n  trace-dump <trace_id>            spans + logs + metriques d'une trace\n  trace-dump <trace_id> --detectors  + le verdict des 3 detecteurs\n  trace-dump --list                liste les traces vues dans Kafka\n  trace-dump --list --json\n  trace-dump <trace_id> --json\n\nCodes de sortie : 0 ok / 1 trace absente ou usage / 2 configuration\nmanquante / 3 Kafka injoignable.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport sys\nfrom pathlib import Path\n\nPROJECT_ROOT = Path(__file__).resolve().parent\nsys.path.insert(0, str(PROJECT_ROOT / \"tools\"))\n\nimport contract  # noqa: E402\nimport detectors  # noqa: E402\nimport kafkalib  # noqa: E402\n\nEXIT_OK = kafkalib.EXIT_OK\nEXIT_USAGE = kafkalib.EXIT_USAGE\nEXIT_CONFIG = kafkalib.EXIT_CONFIG\nEXIT_KAFKA = kafkalib.EXIT_KAFKA\n\n\ndef read(prefix, suffixes=None, trace_id=None):\n    return kafkalib.read_messages(prefix=prefix, suffixes=suffixes, trace_id=trace_id)\n\n\ndef collect(data, trace_id=None):\n    \"\"\"Separe les traces/logs (par TraceId) des metriques (par scenario/profil).\n\n    §3 : la table otel.metrics n'a pas de colonne TraceId ; les metriques\n    sont donc rattachees par couple scenario/profil (§5.4).\n    \"\"\"\n    traces = [t for t in data.get(\"traces\", []) if trace_id is None or t.get(\"TraceId\") == trace_id]\n    logs = [l for l in data.get(\"logs\", []) if trace_id is None or l.get(\"TraceId\") == trace_id]\n    scenario = \"\"\n    profile = \"\"\n    error_type = \"\"\n    for span in traces:\n        attrs = span.get(\"SpanAttributes\") or {}\n        scenario = scenario or attrs.get(\"agent.scenario\", \"\")\n        profile = profile or attrs.get(\"agent.profile\", \"\")\n        error_type = error_type or attrs.get(\"error.type\", \"\")\n    for log in logs:\n        attrs = log.get(\"SpanAttributes\") or log.get(\"LogAttributes\") or {}\n        scenario = scenario or attrs.get(\"agent.scenario\", \"\")\n        profile = profile or attrs.get(\"agent.profile\", \"\")\n        error_type = error_type or attrs.get(\"error.type\", \"\")\n    metrics = []\n    for metric in data.get(\"metrics\", []):\n        attrs = metric.get(\"Attributes\") or {}\n        if scenario and attrs.get(\"agent.scenario\") != scenario:\n            continue\n        if profile and attrs.get(\"agent.profile\") not in (\"\", profile):\n            continue\n        metrics.append(metric)\n    return traces, logs, metrics, scenario, profile, error_type\n\n\ndef dump_trace(trace_id, prefix, as_json, with_detectors):\n    data = read(prefix)\n    traces, logs, metrics, scenario, profile, error_type = collect(data, trace_id)\n    if not traces and not logs:\n        msg = f\"trace absente : {trace_id}\"\n        if as_json:\n            print(json.dumps({\"ok\": False, \"error\": \"trace_absente\",\n                              \"trace_id\": trace_id, \"hint\": msg}, ensure_ascii=False))\n        else:\n            print(msg, file=sys.stderr)\n            print(\"  -> le trace_id n'existe pas dans les topics (ou le prefixe est faux)\",\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /home/baptistefaisy/aiven-kafka-demo && head -80 trace-dump 2>&1\", \"timeout\": 30000}"},"time":{"start":1792680204053,"end":1792680205901}}}}
