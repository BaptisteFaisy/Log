{"type":"tool_use","timestamp":1792680640851,"sessionID":"ses_e9bf1c43cffeIAXTTY71yEDIgZ","part":{"partID":"prt_16417c123001cOKECDBzB86jcj","sessionID":"ses_e9bf1c43cffeIAXTTY71yEDIgZ","messageID":"msg_16417b2ee001EAD5PyTqGmG0Y9","type":"tool","id":"call_00_g2NzPX4UaoBhrZA12JdS1699","tool":"shell","state":{"status":"completed","input":{"command":"cd /home/baptistefaisy/aiven-kafka-demo && python3 - <<'PY'\nimport json\np=json.load(open(\"debug/playbook.json\"))\ne=p[\"entries\"]\nfor k in e:\n    if \"pool\" in k or \"connection\" in k or \"broker\" in k:\n        print(\"###\",k)\n        print(json.dumps(e[k],ensure_ascii=False,indent=2)[:1800]); print()\nprint(\"familles:\", list(p[\"families\"]))\nPY","timeout":60000},"output":"### db_pool_exhausted\n{\n  \"family\": \"config\",\n  \"signal\": \"Database connection pool exhausted (N/N in use, 0 available) / HikariPool ... Connection is not available\",\n  \"discriminate\": [\n    \"1. active == max ET idle == 0 ? Alors c'est une fuite de connexion (session non rendue), pas une simple charge.\",\n    \"2. Les sessions sont-elles 'idle in transaction' côté PostgreSQL ?\",\n    \"3. Le pool est-il plus petit que le nombre de threads qui l'appellent ?\"\n  ],\n  \"evidence\": [\n    \"./tools/debug-bundle <TRACE_ID>\",\n    \"./tools/pg-diag \\\"SELECT state, count(*) FROM pg_stat_activity GROUP BY 1\\\"\",\n    \"./tools/pg-diag \\\"SELECT count(*) FROM pg_stat_activity WHERE datname = current_database() AND wait_event_type IS NOT NULL\\\"\"\n  ],\n  \"patch\": \"Code d'abord : rendre chaque connexion (try-with-resources / finally). Config ensuite : dimensionner le pool, jamais au-delà de max_connections/2 par instance.\",\n  \"rollback\": \"Redescendre la taille du pool.\",\n  \"do_not\": \"Augmenter max_connections : PostgreSQL consomme ~10 Mo par connexion et le vrai défaut est la fuite.\"\n}\n\n### db_too_many_connections\n{\n  \"family\": \"config\",\n  \"sqlstates\": [\n    \"53300\"\n  ],\n  \"signal\": \"too many connections for role \\\"X\\\" / remaining connection slots are reserved\",\n  \"discriminate\": [\n    \"1. Combien de sessions par instance applicative, et combien d'instances ?\",\n    \"2. Y a-t-il un pooler (PgBouncer) ou chaque process ouvre-t-il sa connexion ?\",\n    \"3. Le quota du rôle est-il atteint (CONNECTION LIMIT) ou le max_connections global ?\"\n  ],\n  \"evidence\": [\n    \"./tools/debug-bundle <TRACE_ID>\",\n    \"./tools/pg-diag \\\"SHOW max_connections\\\"\",\n    \"./tools/pg-diag \\\"SELECT usename, count(*) FROM pg_stat_activity GROUP BY 1 ORDER BY 2 DESC\\\"\"\n  ],\n  \"patch\": \"Config : baisser la taille du pool par instance, ajouter un pooler, ou relever max_connections en connaissance de la RAM.\",\n  \"rollback\": \"Redescendre max_connections (redémarrage requis).\",\n  \"do_not\": \"Relever max_connections en boucle : à 500 connexions, le contexte de commutation coûte plus que le travail utile.\"\n}\n\n### db_connection_timeout\n{\n  \"family\": \"infra\",\n  \"signal\": \"Connection timeout on port 5432 after Nms / SQLTransientConnectionException\",\n  \"discriminate\": [\n    \"1. Le TCP aboutit-il ? (DNS cassé vs filtre réseau vs service arrêté)\",\n    \"2. Le timeout est-il à la CONNEXION (connectique) ou à la REQUÊTE (statement_timeout) ?\",\n    \"3. Le service Aiven est-il en cours de redémarrage ?\"\n  ],\n  \"evidence\": [\n    \"./tools/debug-bundle <TRACE_ID>\",\n    \"avn service get pg-memoire --json\",\n    \"timeout 5 bash -c '</dev/tcp/<host>/<port>' && echo tcp-ok || echo tcp-ko\"\n  ],\n  \"patch\": \"Infra : rétablir la route/le service. Aucune migration, aucun accès base n'aide.\",\n  \"rollback\": \"Sans objet.\",\n  \"do_not\": \"Augmenter le timeout de connexion : un TCP qui n'aboutit pas n'aboutira pas plus tard.\"\n}\n\n### db_connection_failure\n{\n  \"family\": \"infra\",\n  \"sqlstates\": [\n    \"08006\",\n    \"08003\"\n  ],\n  \"signal\": \"connection failure / connection does not exist — la session est tombée pendant la requête\",\n  \"discriminate\": [\n    \"1. La connexion a-t-elle été coupée EN COURS de requête (réseau, redémarrage, timeout côté serveur) ?\",\n    \"2. Le pool a-t-il servi une connexion déjà morte (pas de validation à l'emprunt) ?\",\n    \"3. Y a-t-il eu un redémarrage du service au même instant (avn service get) ?\"\n  ],\n  \"evidence\": [\n    \"./tools/debug-bundle <TRACE_ID>\",\n    \"avn service get pg-memoire --json\",\n    \"./tools/pg-diag \\\"SELECT state, count(*) FROM pg_stat_activity GROUP BY 1\\\"\"\n  ],\n  \"patch\": \"Config : activer la validation des connexions à l'emprunt (test-on-borrow) et un keepalive TCP ; infra : rétablir le service s'il a redémarré.\",\n  \"rollback\": \"Désactiver la validation si elle coûte trop cher (une requête par emprunt).\",\n  \"do_not\": \"Rejouer aveuglément : une 08006 peut survenir APRÈS un COMMIT — le rejeu duplique l'écriture.\"\n}\n\n### kafka_broker_unreachable\n{\n  \"family\": \"infra\",\n  \"signal\": \"BrokerNotAvailableException / ERR__TRANSPORT / _TIMED_OUT / broker not reachable\",\n  \"discriminate\": [\n    \"1. Le bootstrap répond-il (kafka-health) ?\",\n    \"2. Les topics sont-ils VISIBLES dans list_topics ? Sinon c'est une ACL Describe manquante, pas une panne.\",\n    \"3. TLS : le certificat porte le nom du SERVICE, pas du broker -> ssl.endpoint.identification.algorithm=none requis.\",\n    \"4. Le consumer group existe-t-il / a-t-il les droits ?\"\n  ],\n  \"evidence\": [\n    \"./tools/debug-bundle <TRACE_ID>\",\n    \"./kafka-health --deep\",\n    \"./tools/preflight\"\n  ],\n  \"patch\": \"Infra : ACL (Describe/Write), listener TLS, ou redémarrage du service. Aucun accès base.\",\n  \"rollback\": \"Retirer l'ACL ajoutée.\",\n  \"do_not\": \"Recréer les topics avant d'avoir vérifié l'ACL Describe : on croit créer ce qui existait déjà.\"\n}\n\nfamilles: ['schema', 'data', 'concurrency', 'config', 'applicatif', 'infra', 'policy']\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"### db_pool_exhausted\n{\n  \"family\": \"config\",\n  \"signal\": \"Database connection pool exhausted (N/N in use, 0 available) / HikariPool ... Connection is not available\",\n  \"discriminate\": [\n    \"1. active == max ET idle == 0 ? Alors c'est une fuite de connexion (session non rendue), pas une simple charge.\",\n    \"2. Les sessions sont-elles 'idle in transaction' côté PostgreSQL ?\",\n    \"3. Le pool est-il plus petit que le nombre de threads qui l'appellent ?\"\n  ],\n  \"evidence\": [\n    \"./tools/debug-bundle <TRACE_ID>\",\n    \"./tools/pg-diag \\\"SELECT state, count(*) FROM pg_stat_activity GROUP BY 1\\\"\",\n    \"./tools/pg-diag \\\"SELECT count(*) FROM pg_stat_activity WHERE datname = current_database() AND wait_event_type IS NOT NULL\\\"\"\n  ],\n  \"patch\": \"Code d'abord : rendre chaque connexion (try-with-resources / finally). Config ensuite : dimensionner le pool, jamais au-delà de max_connections/2 par instance.\",\n  \"rollback\": \"Redescendre la taille du pool.\",\n  \"do_not\": \"Augmenter max_connections : PostgreSQL consomme ~10 Mo par connexion et le vrai défaut est la fuite.\"\n}\n\n### db_too_many_connections\n{\n  \"family\": \"config\",\n  \"sqlstates\": [\n    \"53300\"\n  ],\n  \"signal\": \"too many connections for role \\\"X\\\" / remaining connection slots are reserved\",\n  \"discriminate\": [\n    \"1. Combien de sessions par instance applicative, et combien d'instances ?\",\n    \"2. Y a-t-il un pooler (PgBouncer) ou chaque process ouvre-t-il sa connexion ?\",\n    \"3. Le quota du rôle est-il atteint (CONNECTION LIMIT) ou le max_connections global ?\"\n  ],\n  \"evidence\": [\n    \"./tools/debug-bundle <TRACE_ID>\",\n    \"./tools/pg-diag \\\"SHOW max_connections\\\"\",\n    \"./tools/pg-diag \\\"SELECT usename, count(*) FROM pg_stat_activity GROUP BY 1 ORDER BY 2 DESC\\\"\"\n  ],\n  \"patch\": \"Config : baisser la taille du pool par instance, ajouter un pooler, ou relever max_connections en connaissance de la RAM.\",\n  \"rollback\": \"Redescendre max_connections (redémarrage requis).\",\n  \"do_not\": \"Relever max_connections en boucle : à 500 connexions, le contexte de commutation coûte plus que le travail utile.\"\n}\n\n### db_connection_timeout\n{\n  \"family\": \"infra\",\n  \"signal\": \"Connection timeout on port 5432 after Nms / SQLTransientConnectionException\",\n  \"discriminate\": [\n    \"1. Le TCP aboutit-il ? (DNS cassé vs filtre réseau vs service arrêté)\",\n    \"2. Le timeout est-il à la CONNEXION (connectique) ou à la REQUÊTE (statement_timeout) ?\",\n    \"3. Le service Aiven est-il en cours de redémarrage ?\"\n  ],\n  \"evidence\": [\n    \"./tools/debug-bundle <TRACE_ID>\",\n    \"avn service get pg-memoire --json\",\n    \"timeout 5 bash -c '</dev/tcp/<host>/<port>' && echo tcp-ok || echo tcp-ko\"\n  ],\n  \"patch\": \"Infra : rétablir la route/le service. Aucune migration, aucun accès base n'aide.\",\n  \"rollback\": \"Sans objet.\",\n  \"do_not\": \"Augmenter le timeout de connexion : un TCP qui n'aboutit pas n'aboutira pas plus tard.\"\n}\n\n### db_connection_failure\n{\n  \"family\": \"infra\",\n  \"sqlstates\": [\n    \"08006\",\n    \"08003\"\n  ],\n  \"signal\": \"connection failure / connection does not exist — la session est tombée pendant la requête\",\n  \"discriminate\": [\n    \"1. La connexion a-t-elle été coupée EN COURS de requête (réseau, redémarrage, timeout côté serveur) ?\",\n    \"2. Le pool a-t-il servi une connexion déjà morte (pas de validation à l'emprunt) ?\",\n    \"3. Y a-t-il eu un redémarrage du service au même instant (avn service get) ?\"\n  ],\n  \"evidence\": [\n    \"./tools/debug-bundle <TRACE_ID>\",\n    \"avn service get pg-memoire --json\",\n    \"./tools/pg-diag \\\"SELECT state, count(*) FROM pg_stat_activity GROUP BY 1\\\"\"\n  ],\n  \"patch\": \"Config : activer la validation des connexions à l'emprunt (test-on-borrow) et un keepalive TCP ; infra : rétablir le service s'il a redémarré.\",\n  \"rollback\": \"Désactiver la validation si elle coûte trop cher (une requête par emprunt).\",\n  \"do_not\": \"Rejouer aveuglément : une 08006 peut survenir APRÈS un COMMIT — le rejeu duplique l'écriture.\"\n}\n\n### kafka_broker_unreachable\n{\n  \"family\": \"infra\",\n  \"signal\": \"BrokerNotAvailableException / ERR__TRANSPORT / _TIMED_OUT / broker not reachable\",\n  \"discriminate\": [\n    \"1. Le bootstrap répond-il (kafka-health) ?\",\n    \"2. Les topics sont-ils VISIBLES dans list_topics ? Sinon c'est une ACL Describe manquante, pas une panne.\",\n    \"3. TLS : le certificat porte le nom du SERVICE, pas du broker -> ssl.endpoint.identification.algorithm=none requis.\",\n    \"4. Le consumer group existe-t-il / a-t-il les droits ?\"\n  ],\n  \"evidence\": [\n    \"./tools/debug-bundle <TRACE_ID>\",\n    \"./kafka-health --deep\",\n    \"./tools/preflight\"\n  ],\n  \"patch\": \"Infra : ACL (Describe/Write), listener TLS, ou redémarrage du service. Aucun accès base.\",\n  \"rollback\": \"Retirer l'ACL ajoutée.\",\n  \"do_not\": \"Recréer les topics avant d'avoir vérifié l'ACL Describe : on croit créer ce qui existait déjà.\"\n}\n\nfamilles: ['schema', 'data', 'concurrency', 'config', 'applicatif', 'infra', 'policy']\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /home/baptistefaisy/aiven-kafka-demo && python3 - <<'PY'\\nimport json\\np=json.load(open(\\\"debug/playbook.json\\\"))\\ne=p[\\\"entries\\\"]\\nfor k in e:\\n    if \\\"pool\\\" in k or \\\"connection\\\" in k or \\\"broker\\\" in k:\\n        print(\\\"###\\\",k)\\n        print(json.dumps(e[k],ensure_ascii=False,indent=2)[:1800]); print()\\nprint(\\\"familles:\\\", list(p[\\\"families\\\"]))\\nPY\", \"timeout\": 60000}"},"time":{"start":1792680640803,"end":1792680640851}}}}
