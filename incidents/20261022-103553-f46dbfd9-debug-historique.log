{"type":"tool_use","timestamp":1792665682902,"sessionID":"ses_e9cd17f69ffeURpERydLf268dF","part":{"partID":"prt_16333836a001nGFHMCKHvd6Row","sessionID":"ses_e9cd17f69ffeURpERydLf268dF","messageID":"msg_163334dcc001tOfJDBl45bX3TE","type":"tool","id":"call_01_jnheSpQGLYD4pdUs5Aus9619","tool":"shell","state":{"status":"completed","input":{"command":"cd /home/baptistefaisy/aiven-kafka-demo && sed -n 1,60p tools/emit_incident.py && echo \"=== grep FEED rows ===\" && grep -rn \"WS /socket\\|clients=\\|deploy ready\\|dpl_\" --include='*.js' --include='*.py' --include='*.json' . 2>/dev/null | grep -v node_modules | head -20"},"output":"#!/usr/bin/env python3\n\"\"\"tools/emit_incident.py — repli local de la console web (§6.1).\n\nSi le deploiement Vercel echoue, la demo continue : cet outil publie la meme\ntrace que le bouton du site (meme contrat §3, meme catalogue).\n\nUsage :\n  ./tools/emit_incident.py --scenario <id> [--prefix P] [--json]\n  ./tools/emit_incident.py --list\n\nCodes de sortie : 0 ok / 1 usage / 2 configuration manquante /\n3 Kafka injoignable / 7 generateurs d'erreurs coupes (./tools/generator on).\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport sys\nfrom pathlib import Path\n\nHERE = Path(__file__).resolve().parent\nPROJECT_ROOT = HERE.parent\nsys.path.insert(0, str(HERE))\n\nimport contract  # noqa: E402\nimport generator_switch  # noqa: E402\nimport kafkalib  # noqa: E402\n\nEXIT_OK = kafkalib.EXIT_OK\nEXIT_USAGE = kafkalib.EXIT_USAGE\nEXIT_CONFIG = kafkalib.EXIT_CONFIG\nEXIT_KAFKA = kafkalib.EXIT_KAFKA\n\n\ndef main(argv=None):\n    parser = argparse.ArgumentParser(\n        prog=\"emit_incident.py\",\n        description=\"publie une panne reelle dans Kafka (repli local du site)\")\n    parser.add_argument(\"--scenario\", help=\"identifiant du scenario (cf. scenarios/catalog.json)\")\n    parser.add_argument(\"--prefix\", help=\"prefixe de topics\")\n    parser.add_argument(\"--list\", action=\"store_true\", help=\"liste les scenarios disponibles\")\n    parser.add_argument(\"--json\", action=\"store_true\", help=\"sortie JSON\")\n    args = parser.parse_args(argv)\n\n    # Re-execution dans le venv dedie avant toute sortie (§0.6)\n    kafkalib.ensure_kafka_interpreter()\n\n    try:\n        catalog = contract.load_catalog()\n    except contract.ContractError as exc:\n        print(f\"ERREUR : {exc}\", file=sys.stderr)\n        return EXIT_CONFIG\n\n    if args.list:\n        rows = contract.all_scenarios(catalog)\n        if args.json:\n            print(json.dumps([{\"id\": r[\"id\"], \"label\": r.get(\"label\"),\n                               \"error_type\": r.get(\"error_type\")} for r in rows],\n                             indent=2, ensure_ascii=False))\n        else:\n=== grep FEED rows ===\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"#!/usr/bin/env python3\n\"\"\"tools/emit_incident.py — repli local de la console web (§6.1).\n\nSi le deploiement Vercel echoue, la demo continue : cet outil publie la meme\ntrace que le bouton du site (meme contrat §3, meme catalogue).\n\nUsage :\n  ./tools/emit_incident.py --scenario <id> [--prefix P] [--json]\n  ./tools/emit_incident.py --list\n\nCodes de sortie : 0 ok / 1 usage / 2 configuration manquante /\n3 Kafka injoignable / 7 generateurs d'erreurs coupes (./tools/generator on).\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport sys\nfrom pathlib import Path\n\nHERE = Path(__file__).resolve().parent\nPROJECT_ROOT = HERE.parent\nsys.path.insert(0, str(HERE))\n\nimport contract  # noqa: E402\nimport generator_switch  # noqa: E402\nimport kafkalib  # noqa: E402\n\nEXIT_OK = kafkalib.EXIT_OK\nEXIT_USAGE = kafkalib.EXIT_USAGE\nEXIT_CONFIG = kafkalib.EXIT_CONFIG\nEXIT_KAFKA = kafkalib.EXIT_KAFKA\n\n\ndef main(argv=None):\n    parser = argparse.ArgumentParser(\n        prog=\"emit_incident.py\",\n        description=\"publie une panne reelle dans Kafka (repli local du site)\")\n    parser.add_argument(\"--scenario\", help=\"identifiant du scenario (cf. scenarios/catalog.json)\")\n    parser.add_argument(\"--prefix\", help=\"prefixe de topics\")\n    parser.add_argument(\"--list\", action=\"store_true\", help=\"liste les scenarios disponibles\")\n    parser.add_argument(\"--json\", action=\"store_true\", help=\"sortie JSON\")\n    args = parser.parse_args(argv)\n\n    # Re-execution dans le venv dedie avant toute sortie (§0.6)\n    kafkalib.ensure_kafka_interpreter()\n\n    try:\n        catalog = contract.load_catalog()\n    except contract.ContractError as exc:\n        print(f\"ERREUR : {exc}\", file=sys.stderr)\n        return EXIT_CONFIG\n\n    if args.list:\n        rows = contract.all_scenarios(catalog)\n        if args.json:\n            print(json.dumps([{\"id\": r[\"id\"], \"label\": r.get(\"label\"),\n                               \"error_type\": r.get(\"error_type\")} for r in rows],\n                             indent=2, ensure_ascii=False))\n        else:\n=== grep FEED rows ===\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /home/baptistefaisy/aiven-kafka-demo && sed -n 1,60p tools/emit_incident.py && echo \\\"=== grep FEED rows ===\\\" && grep -rn \\\"WS /socket\\\\|clients=\\\\|deploy ready\\\\|dpl_\\\" --include='*.js' --include='*.py' --include='*.json' . 2>/dev/null | grep -v node_modules | head -20\"}"},"time":{"start":1792665682794,"end":1792665682902}}}}
