lTop = stream.scrollHeight;\r\n}\r\n\r\nfunction randomId(len = 6) {\r\n  const chars = \"abcdef0123456789\";\r\n  let out = \"\";\r\n  for (let i = 0; i < len; i += 1) out += chars[Math.floor(Math.random() * chars.length)];\r\n  return out;\r\n}\r\n\r\nfunction setStatus(text) {\r\n  statusEl.textContent = text;\r\n  clockEl.textContent = new Date().toLocaleTimeString(\"en-GB\", { hour12: false });\r\n}\r\n\r\nfunction refreshCount() {\r\n  const n = stream.childElementCount;\r\n  countEl.textContent = `${n} line${n > 1 ? \"s\" : \"\"}`;\r\n}\r\n\r\nconst LABELS = { dbg: \"dbg\", inf: \"inf\", wrn: \"wrn\", ok: \"ok\", err: \"err\" };\r\n\r\nfunction addRow(level, text) {\r\n  const row = document.createElement(\"div\");\r\n  row.className = \"row\";\r\n  row.dataset.level = level;\r\n\r\n  const time = document.createElement(\"time\");\r\n  time.textContent = stamp();\r\n\r\n  const lvl = document.createElement(\"span\");\r\n  lvl.className = \"lvl\";\r\n  lvl.textContent = LABELS[level] || level;\r\n\r\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"const stream = document.getElementById(\"stream\");\r\nconst countEl = document.getElementById(\"count\");\r\nconst statusEl = document.getElementById(\"status\");\r\nconst clockEl = document.getElementById(\"clock\");\r\nconst fireBtn = document.getElementById(\"fire\");\r\n\r\nconst agentList = document.getElementById(\"agentList\");\r\nconst agentsEmpty = document.getElementById(\"agentsEmpty\");\r\nconst agentCount = document.getElementById(\"agentCount\");\r\nconst agentFoot = document.getElementById(\"agentFoot\");\r\n\r\nconst MAX_ROWS = 160;\r\nconst MAX_AGENTS = 3;\r\nconst AGENT_STEPS = [\"analyze\", \"patch\", \"verify\", \"ready\"];\r\nconst STEP_NAMES = {\n  analyze: \"diagnose\",\n  patch: \"patch\",\n  verify: \"verify\",\n  ready: \"write_memo\",\n};\r\n\r\nconst params = new URLSearchParams(window.location.search);\r\nconst metrics = window.LogMetrics;\r\nconst DEMO_WARM = params.get(\"demo\") === \"warm\";\r\nconst SPEED = DEMO_WARM ? 0.35 : 1;\r\nconst PINNED = params.get(\"scenario\");\r\nconst FAIL = params.get(\"fail\") === \"1\";\r\n\r\nconst state = {\r\n  scenario: 0,\r\n  errors: 0,\r\n  agents: [],\r\n};\r\n\r\nconst pad = (n, size = 2) => String(n).padStart(size, \"0\");\r\n\r\nfunction stamp() {\r\n  const d = new Date();\r\n  return `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}.${pad(d.getMilliseconds(), 3)}`;\r\n}\r\n\r\nfunction nearBottom() {\r\n  return stream.scrollHeight - stream.scrollTop - stream.clientHeight < 80;\r\n}\r\n\r\nfunction scrollDown(force) {\r\n  if (force || nearBottom()) stream.scrollTop = stream.scrollHeight;\r\n}\r\n\r\nfunction randomId(len = 6) {\r\n  const chars = \"abcdef0123456789\";\r\n  let out = \"\";\r\n  for (let i = 0; i < len; i += 1) out += chars[Math.floor(Math.random() * chars.length)];\r\n  return out;\r\n}\r\n\r\nfunction setStatus(text) {\r\n  statusEl.textContent = text;\r\n  clockEl.textContent = new Date().toLocaleTimeString(\"en-GB\", { hour12: false });\r\n}\r\n\r\nfunction refreshCount() {\r\n  const n = stream.childElementCount;\r\n  countEl.textContent = `${n} line${n > 1 ? \"s\" : \"\"}`;\r\n}\r\n\r\nconst LABELS = { dbg: \"dbg\", inf: \"inf\", wrn: \"wrn\", ok: \"ok\", err: \"err\" };\r\n\r\nfunction addRow(level, text) {\r\n  const row = document.createElement(\"div\");\r\n  row.className = \"row\";\r\n  row.dataset.level = level;\r\n\r\n  const time = document.createElement(\"time\");\r\n  time.textContent = stamp();\r\n\r\n  const lvl = document.createElement(\"span\");\r\n  lvl.className = \"lvl\";\r\n  lvl.textContent = LABELS[level] || level;\r\n\r\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /home/baptistefaisy/Log/site && sed -n 1,80p app.js\"}"},"time":{"start":1792665669005,"end":1792665669050}}}}
