ne reelle dans Kafka (repli local du site)\")\n./tools/check.sh:5:# ouverture de la page du site sans erreur JavaScript.\n./tools/check.sh:45:say \"3. contract-check : le message du site == le message de seed (§6.1)\"\n./tools/check.sh:55:say \"4. le catalogue du site est a jour de la source unique\"\n./tools/check.sh:56:./tools/sync-site-catalog.sh > /dev/null 2>&1\n./tools/check.sh:65:./tools/sync-site-group.sh > /dev/null 2>&1\n./tools/check.sh:125:say \"6. la page du site s'ouvre sans erreur JavaScript (§0)\"\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /home/baptistefaisy/aiven-kafka-demo && ls scripts && grep -rn \\\"site\\\" --include='*.py' --include='*.sh' --include='*.js' --include='*.mjs' . 2>/dev/null | grep -v node_modules | grep -vi \\\"site-server\\\\|SITE_ROOT\\\\|'site'\\\\|/site\\\\|site/\\\" | head -30\"}"},"time":{"start":1792665682784,"end":1792665682905}}}}
