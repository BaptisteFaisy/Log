{"type":"tool_use","timestamp":1792665584140,"sessionID":"ses_e9cd17f69ffeURpERydLf268dF","part":{"partID":"prt_163320122001V7h44WwoBtbZTv","sessionID":"ses_e9cd17f69ffeURpERydLf268dF","messageID":"msg_16331d253001XWUrvJIWOg4K7r","type":"tool","id":"call_01_GSHisBU7pDBAzNrDz8kd4297","tool":"shell","state":{"status":"completed","input":{"command":"sed -n 1,80p /home/baptistefaisy/logs/incidents/20261022-103553-f46dbfd9-debug-historique.log"},"output":"4733fd40c907fe4\\\"}\\n\"}],\"providerCall\":{\"executed\":false},\"providerResult\":{\"executed\":false},\"rawInput\":\"{\\\"command\\\": \\\"cd /home/baptistefaisy/aiven-kafka-demo && grep -rn \\\\\\\"db_pool_exhausted\\\\\\\\|DB_POOL_EXHAUSTED\\\\\\\\|pool exhausted\\\\\\\" --include='*' -I . 2>/dev/null | grep -v node_modules | head -40\\\"}\"},\"time\":{\"start\":1792665491207,\"end\":1792665491337}}}}\n{\"type\":\"step_finish\",\"timestamp\":1792665491340,\"sessionID\":\"ses_e9cd17f69ffeURpERydLf268dF\",\"part\":{\"id\":\"prt_16330978b001Cl9jiWrHD5P9L8\",\"sessionID\":\"ses_e9cd17f69ffeURpERydLf268dF\",\"messageID\":\"msg_16330756d001nWYX6jIS9QQTjY\",\"type\":\"step-finish\",\"reason\":\"tool-calls\",\"cost\":0,\"tokens\":{\"input\":1788,\"output\":179,\"reasoning\":112,\"cache\":{\"read\":17408,\"write\":0}}}}\n{\"type\":\"step_start\",\"timestamp\":1792665506215,\"sessionID\":\"ses_e9cd17f69ffeURpERydLf268dF\",\"part\":{\"id\":\"prt_16330d1a7001bLChQDdIbvrtdN\",\"sessionID\":\"ses_e9cd17f69ffeURpERydLf268dF\",\"messageID\":\"msg_16330979b001D1FdmJyg8Aw4wW\",\"type\":\"step-start\"}}\n{\"type\":\"tool_use\",\"timestamp\":1792665506575,\"sessionID\":\"ses_e9cd17f69ffeURpERydLf268dF\",\"part\":{\"partID\":\"prt_16330d1c4001FMjWupCHY10Dcz\",\"sessionID\":\"ses_e9cd17f69ffeURpERydLf268dF\",\"messageID\":\"msg_16330979b001D1FdmJyg8Aw4wW\",\"type\":\"tool\",\"id\":\"call_01_m3z39F2thJsBtSl1St315662\",\"tool\":\"shell\",\"state\":{\"status\":\"completed\",\"input\":{\"command\":\"cd /home/baptistefaisy/aiven-kafka-demo && sed -n 1,80p site/api/incident.js && echo \\\"=== report.js ===\\\" && sed -n 1,90p site/api/report.js\"},\"output\":\"'use strict';\\n/**\\n * POST /api/incident  {\\\"scenario\\\":\\\"<id>\\\"}  ->  {\\\"ok\\\":true,\\\"trace_id\\\":\\\"<32 hex>\\\"}\\n *\\n *   scenario inconnu  -> 400 {\\\"ok\\\":false,\\\"error\\\":\\\"unknown_scenario\\\",\\\"hint\\\":\\\"...\\\"}\\n *   Kafka injoignable -> 503 {\\\"ok\\\":false,\\\"error\\\":\\\"kafka_unreachable\\\",\\\"hint\\\":\\\"...\\\"}\\n *\\n * Jamais de stack trace dans la reponse.\\n */\\nconst { loadCatalog, scenarioById, buildMessages, newTraceId } = require('../lib/contract.js');\\nconst { publish, publicReason, KafkaConfigError } = require('../lib/kafka.js');\\n\\nfunction json(res, code, payload) {\\n  res.statusCode = code;\\n  res.setHeader('Content-Type', 'application/json; charset=utf-8');\\n  res.setHeader('Cache-Control', 'no-store');\\n  res.end(JSON.stringify(payload));\\n}\\n\\nmodule.exports = async function handler(req, res) {\\n  if (req.method !== 'POST') {\\n    return json(res, 405, {\\n      ok: false,\\n      error: 'method_not_allowed',\\n      hint: \\\"utilise POST /api/incident avec {\\\\\\\"scenario\\\\\\\":\\\\\\\"<id>\\\\\\\"}\\\",\\n    });\\n  }\\n\\n  // Sur Vercel, `req.body` est evalue a la demande et LEVE une erreur si le JSON\\n  // est invalide (le runtime repondrait alors 400 avec un corps vide, hors JSON).\\n  let body = null;\\n  try {\\n    body = req.body;\\n  } catch (err) {\\n    body = null;\\n  }\\n  if (typeof body === 'string') {\\n    try {\\n      body = JSON.parse(body || '{}');\\n    } catch (err) {\\n      body = null;\\n    }\\n  }\\n  if (!body || typeof body !== 'object' || !body.scenario) {\\n    return json(res, 400, {\\n      ok: false,\\n      error: 'bad_request',\\n      hint: 'corps attendu : {\\\"scenario\\\":\\\"<identifiant du scenario>\\\"}',\\n    });\\n  }\\n\\n  let scenario;\\n  let messages;\\n  let traceId;\\n  try {\\n    const catalog = loadCatalog();\\n    scenario = scenarioById(catalog, body.scenario, false);\\n    traceId = newTraceId();\\n    messages = buildMessages(catalog, scenario, traceId);\\n  } catch (err) {\\n    const unknown = /scenario inconnu/.test(err.message || '');\\n    return json(res, unknown ? 400 : 500, {\\n      ok: false,\\n      error: unknown ? 'unknown_scenario' : 'catalog_error',\\n      hint: unknown\\n        ? `scenario inconnu : ${body.scenario} — consulte /scenarios/catalog.json pour la liste`\\n        : 'catalogue des scenarios illisible',\\n    });\\n  }\\n\\n  const bySuffix = {};\\n  let count = 0;\\n  for (const suffix of ['traces', 'logs', 'metrics']) {\\n    const list = [];\\n    for (const msg of messages[suffix] || []) {\\n      list.push({ key: msg.TraceId || traceId, value: JSON.stringify(msg) });\\n      count += 1;\\n    }\\n    if (list.length) bySuffix[suffix] = list;\\n  }\\n=== report.js ===\\n'use strict';\\n/**\\n * GET /api/report?trace_id=<id>\\n *   -> 200 {\\\"ok\\\":true,\\\"status\\\":\\\"pending\\\"|\\\"done\\\",\\\"agent\\\":\\\"...\\\",\\\"report\\\":\\\"...\\\"}\\n *   -> 404 {\\\"ok\\\":false,\\\"error\\\":\\\"not_found\\\",\\\"hint\\\":\\\"...\\\"}  (pas encore de rapport)\\n *   -> 503 {\\\"ok\\\":false,\\\"error\\\":\\\"kafka_unreachable\\\",\\\"hint\\\":\\\"...\\\"}\\n *\\n * Extension du contrat §6.2 : elle permet a la console d'afficher l'etat\\n * « agent » puis « rapport ». Le rapport est republie dans <prefix>-reports\\n * par le watcher, apres la fin de l'agent.\\n */\\nconst { findReport, publicReason, KafkaConfigError } = require('../lib/kafka.js');\\n\\nmodule.exports = async function handler(req, res) {\\n  const traceId = (req.query && req.query.trace_id) || '';\\n  const send = (code, payload) => {\\n    res.statusCode = code;\\n    res.setHeader('Content-Type', 'application/json; charset=utf-8');\\n    res.setHeader('Cache-Control', 'no-store');\\n    res.end(JSON.stringify(payload));\\n  };\\n\\n  if (!traceId) {\\n    return send(400, {\\n      ok: false,\\n      error: 'bad_request',\\n      hint: 'parametre trace_id manquant (?trace_id=<id>)',\\n    });\\n  }\\n\\n  let report = null;\\n  try {\\n    report = await findReport(traceId, 8000);\\n  } catch (err) {\\n    const config = err instanceof KafkaConfigError;\\n    // le detail brut (adresse du broker...) reste dans les journaux serveur\\n    process.stderr.write(`api/report : ${err.message}\\\\n`);\\n    return send(config ? 500 : 503, {\\n      ok: false,\\n      error: config ? 'config_error' : 'kafka_unreachable',\\n      hint: config\\n        ? `configuration Kafka incomplete cote serveur : ${err.message}`\\n        : `Kafka injoignable (${publicReason(err)}) — le rapport ne peut pas etre lu pour l'instant, reessaie dans un instant.`,\\n    });\\n  }\\n\\n  if (!report) {\\n    return send(404, {\\n      ok: false,\\n      error: 'not_found',\\n      hint: \\\"l'agent n'a pas encore publie de rapport pour cette trace\\\",\\n    });\\n  }\\n\\n  return send(200, {\\n    ok: true,\\n    status: 'done',\\n    trace_id: report.TraceId || traceId,\\n    agent: report.agent || '',\\n    // identification du groupe : ajoutee par tools/kafka-incident-watch depuis\\n    // agents/group.json. Vide pour un rapport publie avant le manifeste.\\n    agent_group: report.agent_group || '',\\n    agent_group_label: report.agent_group_label || '',\\n    agent_use_case: report.agent_use_case || '',\\n    agent_origin: report.agent_origin || '',\\n    agent_origin_label: report.agent_origin_label || '',\\n    agent_role: report.agent_role || '',\\n    error_type: report.error_type || '',\\n    scenario: report.scenario || '',\\n    title: report.title || '',\\n    report: report.report || '',\\n  });\\n};\\n\",\"title\":\"shell\",\"metadata\":{\"metadata\":{\"status\":\"completed\",\"truncated\":false,\"exit\":0},\"content\":[{\"type\":\"text\",\"text\":\"'use strict';\\n/**\\n * POST /api/incident  {\\\"scenario\\\":\\\"<id>\\\"}  ->  {\\\"ok\\\":true,\\\"trace_id\\\":\\\"<32 hex>\\\"}\\n *\\n *   scenario inconnu  -> 400 {\\\"ok\\\":false,\\\"error\\\":\\\"unknown_scenario\\\",\\\"hint\\\":\\\"...\\\"}\\n *   Kafka injoignable -> 503 {\\\"ok\\\":false,\\\"error\\\":\\\"kafka_unreachable\\\",\\\"hint\\\":\\\"...\\\"}\\n *\\n * Jamais de stack trace dans la reponse.\\n */\\nconst { loadCatalog, scenarioById, buildMessages, newTraceId } = require('../lib/contract.js');\\nconst { publish, publicReason, KafkaConfigError } = require('../lib/kafka.js');\\n\\nfunction json(res, code, payload) {\\n  res.statusCode = code;\\n  res.setHeader('Content-Type', 'application/json; charset=utf-8');\\n  res.setHeader('Cache-Control', 'no-store');\\n  res.end(JSON.stringify(payload));\\n}\\n\\nmodule.exports = async function handler(req, res) {\\n  if (req.method !== 'POST') {\\n    return json(res, 405, {\\n      ok: false,\\n      error: 'method_not_allowed',\\n      hint: \\\"utilise POST /api/incident avec {\\\\\\\"scenario\\\\\\\":\\\\\\\"<id>\\\\\\\"}\\\",\\n    });\\n  }\\n\\n  // Sur Vercel, `req.body` est evalue a la demande et LEVE une erreur si le JSON\\n  // est invalide (le runtime repondrait alors 400 avec un corps vide, hors JSON).\\n  let body = null;\\n  try {\\n    body = req.body;\\n  } catch (err) {\\n    body = null;\\n  }\\n  if (typeof body === 'string') {\\n    try {\\n      body = JSON.parse(body || '{}');\\n    } catch (err) {\\n      body = null;\\n    }\\n  }\\n  if (!body || typeof body !== 'object' || !body.scenario) {\\n    return json(res, 400, {\\n      ok: false,\\n      error: 'bad_request',\\n      hint: 'corps attendu : {\\\"scenario\\\":\\\"<identifiant du scenario>\\\"}',\\n    });\\n  }\\n\\n  let scenario;\\n  let messages;\\n  let traceId;\\n  try {\\n    const catalog = loadCatalog();\\n    scenario = scenarioById(catalog, body.scenario, false);\\n    traceId = newTraceId();\\n    messages = buildMessages(catalog, scenario, traceId);\\n  } catch (err) {\\n    const unknown = /scenario inconnu/.test(err.message || '');\\n    return json(res, unknown ? 400 : 500, {\\n      ok: false,\\n      error: unknown ? 'unknown_scenario' : 'catalog_error',\\n      hint: unknown\\n        ? `scenario inconnu : ${body.scenario} — consulte /scenarios/catalog.json pour la liste`\\n        : 'catalogue des scenarios illisible',\\n    });\\n  }\\n\\n  const bySuffix = {};\\n  let count = 0;\\n  for (const suffix of ['traces', 'logs', 'metrics']) {\\n    const list = [];\\n    for (const msg of messages[suffix] || []) {\\n      list.push({ key: msg.TraceId || traceId, value: JSON.stringify(msg) });\\n      count += 1;\\n    }\\n    if (list.length) bySuffix[suffix] = list;\\n  }\\n=== report.js ===\\n'use strict';\\n/**\\n * GET /api/report?trace_id=<id>\\n *   -> 200 {\\\"ok\\\":true,\\\"status\\\":\\\"pending\\\"|\\\"done\\\",\\\"agent\\\":\\\"...\\\",\\\"report\\\":\\\"...\\\"}\\n *   -> 404 {\\\"ok\\\":false,\\\"error\\\":\\\"not_found\\\",\\\"hint\\\":\\\"...\\\"}  (pas encore de rapport)\\n *   -> 503 {\\\"ok\\\":false,\\\"error\\\":\\\"kafka_unreachable\\\",\\\"hint\\\":\\\"...\\\"}\\n *\\n * Extension du contrat §6.2 : elle permet a la console d'afficher l'etat\\n * « agent » puis « rapport ». Le rapport est republie dans <prefix>-reports\\n * par le watcher, apres la fin de l'agent.\\n */\\nconst { findReport, publicReason, KafkaConfigError } = require('../lib/kafka.js');\\n\\nmodule.exports = async function handler(req, res) {\\n  const traceId = (req.query && req.query.trace_id) || '';\\n  const send = (code, payload) => {\\n    res.statusCode = code;\\n    res.setHeader('Content-Type', 'application/json; charset=utf-8');\\n    res.setHeader('Cache-Control', 'no-store');\\n    res.end(JSON.stringify(payload));\\n  };\\n\\n  if (!traceId) {\\n    return send(400, {\\n      ok: false,\\n      error: 'bad_request',\\n      hint: 'parametre trace_id manquant (?trace_id=<id>)',\\n    });\\n  }\\n\\n  let report = null;\\n  try {\\n    report = await findReport(traceId, 8000);\\n  } catch (err) {\\n    const config = err instanceof KafkaConfigError;\\n    // le detail brut (adresse du broker...) reste dans les journaux serveur\\n    process.stderr.write(`api/report : ${err.message}\\\\n`);\\n    return send(config ? 500 : 503, {\\n      ok: false,\\n      error: config ? 'config_error' : 'kafka_unreachable',\\n      hint: config\\n        ? `configuration Kafka incomplete cote serveur : ${err.message}`\\n        : `Kafka injoignable (${publicReason(err)}) — le rapport ne peut pas etre lu pour l'instant, reessaie dans un instant.`,\\n    });\\n  }\\n\\n  if (!report) {\\n    return send(404, {\\n      ok: false,\\n      error: 'not_found',\\n      hint: \\\"l'agent n'a pas encore publie de rapport pour cette trace\\\",\\n    });\\n  }\\n\\n  return send(200, {\\n    ok: true,\\n    status: 'done',\\n    trace_id: report.TraceId || traceId,\\n    agent: report.agent || '',\\n    // identification du groupe : ajoutee par tools/kafka-incident-watch depuis\\n    // agents/group.json. Vide pour un rapport publie avant le manifeste.\\n    agent_group: report.agent_group || '',\\n    agent_group_label: report.agent_group_label || '',\\n    agent_use_case: report.agent_use_case || '',\\n    agent_origin: report.agent_origin || '',\\n    agent_origin_label: report.agent_origin_label || '',\\n    agent_role: report.agent_role || '',\\n    error_type: report.error_type || '',\\n    scenario: report.scenario || '',\\n    title: report.title || '',\\n    report: report.report || '',\\n  });\\n};\\n\"}],\"providerCall\":{\"executed\":false},\"providerResult\":{\"executed\":false},\"rawInput\":\"{\\\"command\\\": \\\"cd /home/baptistefaisy/aiven-kafka-demo && sed -n 1,80p site/api/incident.js && echo \\\\\\\"=== report.js ===\\\\\\\" && sed -n 1,90p site/api/report.js\\\"}\"},\"time\":{\"start\":1792665506244,\"end\":1792665506575}}}}\n{\"type\":\"tool_use\",\"timestamp\":1792665506594,\"sessionID\":\"ses_e9cd17f69ffeURpERydLf268dF\",\"part\":{\"partID\":\"prt_16330d1ae001Bbxw01Jshw2HgA\",\"sessionID\":\"ses_e9cd17f69ffeURpERydLf268dF\",\"messageID\":\"msg_16330979b001D1FdmJyg8Aw4wW\",\"type\":\"tool\",\"id\":\"call_00_vglUOwOdqKvTSqSuomDn9613\",\"tool\":\"shell\",\"state\":{\"status\":\"completed\",\"input\":{\"command\":\"cd /home/baptistefaisy/aiven-kafka-demo && python3 - <<'PY'\\nimport json\\nc=json.load(open('site/scenarios/catalog.json'))\\ndef walk(o,p=''):\\n    if isinstance(o,dict):\\n        for k,v in o.items(): walk(v,p+'/'+k)\\n    elif isinstance(o,list):\\n        for i,v in enumerate(o): walk(v,p+f'[{i}]')\\n    else:\\n        s=str(o)\\n        if any(t in s for t in ('checkout-api','pool','ERR_DB_POOL','site-console')):\\n            print(p,'=',s[:300])\\nwalk(c)\\nPY\"},\"output\":\"/scenarios[0]/id = platform_db_pool_exhausted\\n/scenarios[0]/error_type = db_pool_exhausted\\n/scenarios[0]/log_body = Database connection pool exhausted (20/20 in use, 0 available)\\n/scenarios[0]/exception_message = com.zaxxer.hikari.pool.HikariPool$PoolInitializationException: Database connection pool exhausted (20/20 in use, 0 available)\\n/scenarios[0]/spans[0]/attributes/error.type = db_pool_exhausted\\n/scenarios[0]/spans[0]/attributes/exception.message = com.zaxxer.hikari.pool.HikariPool$PoolInitializationException: Database connection pool exhausted (20/20 in use, 0 available)\\n/scenarios[0]/logs[0]/body = Database connection pool exhausted (20/20 in use, 0 available)\\n/scenarios[0]/logs[0]/attributes/error.type = db_pool_exhausted\\n/scenarios[0]/logs[0]/attributes/exception.message = com.zaxxer.hikari.pool.HikariPool$PoolInitializationException: Database connection pool exhausted (20/20 in use, 0 available)\\n/scenarios[0]/metrics[0]/name = db.client.connection.pool.active\\n/scenarios[0]/metrics[1]/name = db.client.connection.pool.idle\\n/scenarios[0]/metrics[2]/name = db.client.connection.pool.max\\n\",\"title\":\"shell\",\"metadata\":{\"metadata\":{\"status\":\"completed\",\"truncated\":false,\"exit\":0},\"content\":[{\"type\":\"text\",\"text\":\"/scenarios[0]/id = platform_db_pool_exhausted\\n/scenarios[0]/error_type = db_pool_exhausted\\n/scenarios[0]/log_body = Database connection pool exhausted (20/20 in use, 0 available)\\n/scenarios[0]/exception_message = com.zaxxer.hikari.pool.HikariPool$PoolInitializationException: Database connection pool exhausted (20/20 in use, 0 available)\\n/scenarios[0]/spans[0]/attributes/error.type = db_pool_exhausted\\n/scenarios[0]/spans[0]/attributes/exception.message = com.zaxxer.hikari.pool.HikariPool$PoolInitializationException: Database connection pool exhausted (20/20 in use, 0 available)\\n/scenarios[0]/logs[0]/body = Database connection pool exhausted (20/20 in use, 0 available)\\n/scenarios[0]/logs[0]/attributes/error.type = db_pool_exhausted\\n/scenarios[0]/logs[0]/attributes/exception.message = com.zaxxer.hikari.pool.HikariPool$PoolInitializationException: Database connection pool exhausted (20/20 in use, 0 available)\\n/scenarios[0]/metrics[0]/name = db.client.connection.pool.active\\n/scenarios[0]/metrics[1]/name = db.client.connection.pool.idle\\n/scenarios[0]/metrics[2]/name = db.client.connection.pool.max\\n\"}],\"providerCall\":{\"executed\":false},\"providerResult\":{\"executed\":false},\"rawInput\":\"{\\\"command\\\": \\\"cd /home/baptistefaisy/aiven-kafka-demo && python3 - <<'PY'\\\\nimport json\\\\nc=json.load(open('site/scenarios/catalog.json'))\\\\ndef walk(o,p=''):\\\\n    if isinstance(o,dict):\\\\n        for k,v in o.items(): walk(v,p+'/'+k)\\\\n    elif isinstance(o,list):\\\\n        for i,v in enumerate(o): walk(v,p+f'[{i}]')\\\\n    else:\\\\n        s=str(o)\\\\n        if any(t in s for t in ('checkout-api','pool','ERR_DB_POOL','site-console')):\\\\n            print(p,'=',s[:300])\\\\nwalk(c)\\\\nPY\\\"}\"},\"time\":{\"start\":1792665506222,\"end\":1792665506594}}}}\n{\"type\":\"step_finish\",\"timestamp\":1792665506597,\"sessionID\":\"ses_e9cd17f69ffeURpERydLf268dF\",\"part\":{\"id\":\"prt_16330d325001JDMG6l6blYD6oz\",\"sessionID\":\"ses_e9cd17f69ffeURpERydLf268dF\",\"messageID\":\"msg_16330979b001D1FdmJyg8Aw4wW\",\"type\":\"step-finish\",\"reason\":\"tool-calls\",\"cost\":0,\"tokens\":{\"input\":11102,\"output\":253,\"reasoning\":379,\"cache\":{\"read\":19456,\"write\":0}}}}\n{\"type\":\"step_start\",\"timestamp\":1792665516302,\"sessionID\":\"ses_e9cd17f69ffeURpERydLf268dF\",\"part\":{\"id\":\"prt_16330f90e001HiahVW1OUjcOeV\",\"sessionID\":\"ses_e9cd17f69ffeURpERydLf268dF\",\"messageID\":\"msg_16330d336001k2i90KVu0I4706\",\"type\":\"step-start\"}}\n{\"type\":\"tool_use\",\"timestamp\":1792665516580,\"sessionID\":\"ses_e9cd17f69ffeURpERydLf268dF\",\"part\":{\"partID\":\"prt_16330f9200014gGVUpq61rI6E2\",\"sessionID\":\"ses_e9cd17f69ffeURpERydLf268dF\",\"messageID\":\"msg_16330d336001k2i90KVu0I4706\",\"type\":\"tool\",\"id\":\"call_01_XSoxNevVZsrrL4ErTGww6160\",\"tool\":\"shell\",\"state\":{\"status\":\"completed\",\"input\":{\"command\":\"cd /home/baptistefaisy/aiven-kafka-demo && sed -n 1,120p tools/kafka-incident-watch | head -120 && echo \\\"=== grep watch for historique/site ===\\\" && grep -n \\\"site\\\\.\\\\|historique\\\\|scenario=site\\\\|ERR_DB_POOL\\\" tools/kafka-incident-watch | head -40\"},\"output\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"kafka-incident-watch — le declencheur d'agent « zero code » (§5.3).\\n\\nIl tourne sur le POSTE DE TRAVAIL (jamais dans un conteneur Aiven) et :\\n\\n  - consomme <prefix>.logs et <prefix>.traces ;\\n  - est un incident : un log ERROR/WARN AVEC un error.type non vide, ou un\\n    span StatusCode=\\\"Error\\\" ;\\n  - resout l'agent dans routes.yaml (aucun type d'erreur code en dur) ; le\\n    fichier est relu a chaud quand il change ;\\n  - lance `opencode run --agent <agent> --auto --title \\\"<titre>\\\"` (prompt sur\\n    l'entree standard) avec un environnement SANS secret ; le prompt vient de\\n    routes.yaml (agents.<nom>.prompt_file, relu a chaque lancement) ou du\\n    modele generique ;\\n  - coupe les generateurs d'erreurs a chaque incident mis en file si\\n    routes.yaml le demande (disable_generators_on_incident: true) ;\\n  - 1 agent par trace, file d'attente PERSISTEE dans l'etat, plafonds et\\n    cooldowns ;\\n  - instance unique (flock), etat par cluster (empreinte du bootstrap) ;\\n  - detecte l'incarnation d'un topic (topic_id : topic recree -> offsets\\n    invalides) ; une erreur de metadonnees n'est JAMAIS un changement ;\\n  - republie le rapport de l'agent dans <prefix>-reports pour la console web.\\n\\nUsage :\\n  kafka-incident-watch [--from earliest|latest] [--prefix P] [--group G] [--dry-run]\\n  kafka-incident-watch --check-routes [ERROR_TYPE]   verifie routes.yaml (sans Kafka)\\n  kafka-incident-watch --purge-backlog               service ARRETE : offsets du groupe\\n                                                     a la fin, file/cooldowns/plafonds a zero\\n\\nCodes de sortie : 0 arret propre / 1 usage / 2 configuration manquante /\\n3 Kafka injoignable / 4 deja lance (verrou).\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport argparse\\nimport errno\\nimport fcntl\\nimport hashlib\\nimport hmac\\nimport json\\nimport os\\nimport re\\nimport shutil\\nimport signal\\nimport subprocess\\nimport sys\\nimport tempfile\\nimport threading\\nimport time\\nfrom datetime import datetime, timezone\\nfrom pathlib import Path\\nfrom typing import Any, Dict, List, Optional, Tuple\\n\\nHERE = Path(__file__).resolve().parent\\nPROJECT_ROOT = HERE.parent\\nsys.path.insert(0, str(HERE))\\n\\nimport kafkalib  # noqa: E402\\n\\n# L'interrupteur commun des generateurs d'erreurs (tools/generator_switch.py).\\n# Absent ou casse : le watcher tourne quand meme et le dit au demarrage.\\ntry:\\n    import generator_switch  # noqa: E402\\n    GENERATOR_SWITCH_ERROR = \\\"\\\"\\nexcept Exception as _exc:  # noqa: BLE001 - un module tiers ne doit pas empecher le demarrage\\n    generator_switch = None\\n    GENERATOR_SWITCH_ERROR = f\\\"{type(_exc).__name__}: {_exc}\\\"\\n\\nEXIT_OK = kafkalib.EXIT_OK\\nEXIT_USAGE = kafkalib.EXIT_USAGE\\nEXIT_CONFIG = kafkalib.EXIT_CONFIG\\nEXIT_KAFKA = kafkalib.EXIT_KAFKA\\nEXIT_RUNNING = kafkalib.EXIT_RUNNING\\n\\n# --- plafonds (§5.3) --------------------------------------------------------\\nCOOLDOWN_TRACE_S = int(os.environ.get(\\\"WATCHER_COOLDOWN_TRACE_S\\\", \\\"300\\\"))     # 5 min\\nCOOLDOWN_ERROR_S = int(os.environ.get(\\\"WATCHER_COOLDOWN_ERROR_S\\\", \\\"1800\\\"))   # 30 min\\nMAX_CONCURRENT = int(os.environ.get(\\\"WATCHER_MAX_CONCURRENT\\\", \\\"2\\\"))\\nMAX_PER_HOUR = int(os.environ.get(\\\"WATCHER_MAX_PER_HOUR\\\", \\\"6\\\"))\\n# delai par defaut d'un agent ; routes.yaml le fixe par agent (agents.<nom>.timeout_s)\\nAGENT_TIMEOUT_S = int(os.environ.get(\\\"WATCHER_AGENT_TIMEOUT_S\\\", \\\"900\\\"))\\n# file bloquee : une ligne au changement d'etat, puis au plus un rappel / 5 min\\nWAIT_REMINDER_S = int(os.environ.get(\\\"WATCHER_WAIT_REMINDER_S\\\", \\\"300\\\"))\\n# echec de lancement d'un agent (opencode absent...) : pause avant le nouvel essai\\nLAUNCH_RETRY_S = int(os.environ.get(\\\"WATCHER_LAUNCH_RETRY_S\\\", \\\"60\\\"))\\n# garde-fou : au-dela, prompt generique (un prompt geant coute cher et noie l'agent)\\nMAX_PROMPT_BYTES = 100_000\\n# un champ venu de Kafka (message, attributs) est tronque dans le prompt\\nMAX_FIELD_CHARS = 4000\\n# on cherche l'id de session opencode dans la sortie de l'agent pendant 2 min\\nSESSION_SEARCH_S = 120\\n\\nSTATE_DIR = Path(os.environ.get(\\n    \\\"WATCHER_STATE_DIR\\\", str(Path.home() / \\\".local\\\" / \\\"state\\\" / \\\"kafka-incident-watch\\\")))\\nINCIDENT_DIR = Path(os.environ.get(\\n    \\\"WATCHER_INCIDENT_DIR\\\", str(Path.home() / \\\"logs\\\" / \\\"incidents\\\")))\\n\\nROUTES_FILE = Path(os.environ.get(\\\"WATCHER_ROUTES\\\", str(PROJECT_ROOT / \\\"routes.yaml\\\")))\\n# Appartenance agent -> groupe -> cas d'usage -> machine d'origine. Manifeste\\n# declaratif : il n'est lu QUE pour estampiller les rapports publies (le\\n# routage, lui, reste dans routes.yaml).\\nGROUPS_FILE = Path(os.environ.get(\\\"WATCHER_GROUPS\\\", str(PROJECT_ROOT / \\\"agents\\\" / \\\"group.json\\\")))\\nOPENCODE_BIN = os.environ.get(\\\"OPENCODE_BIN\\\", \\\"opencode\\\")\\n\\n# un TraceId finit dans une commande (trace-dump <id>) et un nom de fichier :\\n# on n'accepte que des identifiants simples (OTel : 32 caracteres hexa)\\nTRACE_ID_RE = re.compile(r\\\"[0-9A-Za-z_-]{1,64}\\\")\\nLOG_BLOCK_RE = re.compile(r\\\"<log>.*?</log>\\\", re.S)\\nSESSION_ID_RE = re.compile(r'\\\"sessionID\\\"\\\\s*:\\\\s*\\\"(ses_[0-9A-Za-z]+)\\\"')\\n\\n# --- environnement des agents (defense en profondeur) ------------------------\\n# `opencode run` transmet SON environnement au shell de la session : on n'y\\n# laisse aucun secret. trace-dump & co rechargent les KAFKA_* manquants depuis\\n# env-kafka-1687d005.sh (kafkalib.ensure_config), sans que l'agent les voie.\\n# SSH_AUTH_SOCK : l'agent ssh de Baptiste ; un agent d'incident n'a rien a pousser.\\nSENSITIVE_ENV_NAMES = {\\\"KAFKA_PASSWORD\\\", \\\"KAFKA_USERNAME\\\", \\\"KAFKA_CA_PEM\\\", \\\"SSH_AUTH_SOCK\\\"}\\nSENSITIVE_ENV_MARKERS = (\\\"PASSWORD\\\", \\\"SECRET\\\", \\\"TOKEN\\\", \\\"KEY\\\", \\\"CREDENTIAL\\\")\\n# Liste blanche (nom exact) : LOG_PATCH_KEY est la cle de PUBLICATION des\\n# propositions de patch (console locale) ; l'unite systemd la charge depuis\\n# ~/.secrets/log-patch.env. La cle de DECISION humaine ne passe jamais : si\\n=== grep watch for historique/site ===\\n551:        routes.yaml pointe sur debug-historique) ;\\n1490:        de cluster, `--from earliest` rejouerait sinon tout l'historique.\\n\",\"title\":\"shell\",\"metadata\":{\"metadata\":{\"status\":\"completed\",\"truncated\":false,\"exit\":0},\"content\":[{\"type\":\"text\",\"text\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"kafka-incident-watch — le declencheur d'agent « zero code » (§5.3).\\n\\nIl tourne sur le POSTE DE TRAVAIL (jamais dans un conteneur Aiven) et :\\n\\n  - consomme <prefix>.logs et <prefix>.traces ;\\n  - est un incident : un log ERROR/WARN AVEC un error.type non vide, ou un\\n    span StatusCode=\\\"Error\\\" ;\\n  - resout l'agent dans routes.yaml (aucun type d'erreur code en dur) ; le\\n    fichier est relu a chaud quand il change ;\\n  - lance `opencode run --agent <agent> --auto --title \\\"<titre>\\\"` (prompt sur\\n    l'entree standard) avec un environnement SANS secret ; le prompt vient de\\n    routes.yaml (agents.<nom>.prompt_file, relu a chaque lancement) ou du\\n    modele generique ;\\n  - coupe les generateurs d'erreurs a chaque incident mis en file si\\n    routes.yaml le demande (disable_generators_on_incident: true) ;\\n  - 1 agent par trace, file d'attente PERSISTEE dans l'etat, plafonds et\\n    cooldowns ;\\n  - instance unique (flock), etat par cluster (empreinte du bootstrap) ;\\n  - detecte l'incarnation d'un topic (topic_id : topic recree -> offsets\\n    invalides) ; une erreur de metadonnees n'est JAMAIS un changement ;\\n  - republie le rapport de l'agent dans <prefix>-reports pour la console web.\\n\\nUsage :\\n  kafka-incident-watch [--from earliest|latest] [--prefix P] [--group G] [--dry-run]\\n  kafka-incident-watch --check-routes [ERROR_TYPE]   verifie routes.yaml (sans Kafka)\\n  kafka-incident-watch --purge-backlog               service ARRETE : offsets du groupe\\n                                                     a la fin, file/cooldowns/plafonds a zero\\n\\nCodes de sortie : 0 arret propre / 1 usage / 2 configuration manquante /\\n3 Kafka injoignable / 4 deja lance (verrou).\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport argparse\\nimport errno\\nimport fcntl\\nimport hashlib\\nimport hmac\\nimport json\\nimport os\\nimport re\\nimport shutil\\nimport signal\\nimport subprocess\\nimport sys\\nimport tempfile\\nimport threading\\nimport time\\nfrom datetime import datetime, timezone\\nfrom pathlib import Path\\nfrom typing import Any, Dict, List, Optional, Tuple\\n\\nHERE = Path(__file__).resolve().parent\\nPROJECT_ROOT = HERE.parent\\nsys.path.insert(0, str(HERE))\\n\\nimport kafkalib  # noqa: E402\\n\\n# L'interrupteur commun des generateurs d'erreurs (tools/generator_switch.py).\\n# Absent ou casse : le watcher tourne quand meme et le dit au demarrage.\\ntry:\\n    import generator_switch  # noqa: E402\\n    GENERATOR_SWITCH_ERROR = \\\"\\\"\\nexcept Exception as _exc:  # noqa: BLE001 - un module tiers ne doit pas empecher le demarrage\\n    generator_switch = None\\n    GENERATOR_SWITCH_ERROR = f\\\"{type(_exc).__name__}: {_exc}\\\"\\n\\nEXIT_OK = kafkalib.EXIT_OK\\nEXIT_USAGE = kafkalib.EXIT_USAGE\\nEXIT_CONFIG = kafkalib.EXIT_CONFIG\\nEXIT_KAFKA = kafkalib.EXIT_KAFKA\\nEXIT_RUNNING = kafkalib.EXIT_RUNNING\\n\\n# --- plafonds (§5.3) --------------------------------------------------------\\nCOOLDOWN_TRACE_S = int(os.environ.get(\\\"WATCHER_COOLDOWN_TRACE_S\\\", \\\"300\\\"))     # 5 min\\nCOOLDOWN_ERROR_S = int(os.environ.get(\\\"WATCHER_COOLDOWN_ERROR_S\\\", \\\"1800\\\"))   # 30 min\\nMAX_CONCURRENT = int(os.environ.get(\\\"WATCHER_MAX_CONCURRENT\\\", \\\"2\\\"))\\nMAX_PER_HOUR = int(os.environ.get(\\\"WATCHER_MAX_PER_HOUR\\\", \\\"6\\\"))\\n# delai par defaut d'un agent ; routes.yaml le fixe par agent (agents.<nom>.timeout_s)\\nAGENT_TIMEOUT_S = int(os.environ.get(\\\"WATCHER_AGENT_TIMEOUT_S\\\", \\\"900\\\"))\\n# file bloquee : une ligne au changement d'etat, puis au plus un rappel / 5 min\\nWAIT_REMINDER_S = int(os.environ.get(\\\"WATCHER_WAIT_REMINDER_S\\\", \\\"300\\\"))\\n# echec de lancement d'un agent (opencode absent...) : pause avant le nouvel essai\\nLAUNCH_RETRY_S = int(os.environ.get(\\\"WATCHER_LAUNCH_RETRY_S\\\", \\\"60\\\"))\\n# garde-fou : au-dela, prompt generique (un prompt geant coute cher et noie l'agent)\\nMAX_PROMPT_BYTES = 100_000\\n# un champ venu de Kafka (message, attributs) est tronque dans le prompt\\nMAX_FIELD_CHARS = 4000\\n# on cherche l'id de session opencode dans la sortie de l'agent pendant 2 min\\nSESSION_SEARCH_S = 120\\n\\nSTATE_DIR = Path(os.environ.get(\\n    \\\"WATCHER_STATE_DIR\\\", str(Path.home() / \\\".local\\\" / \\\"state\\\" / \\\"kafka-incident-watch\\\")))\\nINCIDENT_DIR = Path(os.environ.get(\\n    \\\"WATCHER_INCIDENT_DIR\\\", str(Path.home() / \\\"logs\\\" / \\\"incidents\\\")))\\n\\nROUTES_FILE = Path(os.environ.get(\\\"WATCHER_ROUTES\\\", str(PROJECT_ROOT / \\\"routes.yaml\\\")))\\n# Appartenance agent -> groupe -> cas d'usage -> machine d'origine. Manifeste\\n# declaratif : il n'est lu QUE pour estampiller les rapports publies (le\\n# routage, lui, reste dans routes.yaml).\\nGROUPS_FILE = Path(os.environ.get(\\\"WATCHER_GROUPS\\\", str(PROJECT_ROOT / \\\"agents\\\" / \\\"group.json\\\")))\\nOPENCODE_BIN = os.environ.get(\\\"OPENCODE_BIN\\\", \\\"opencode\\\")\\n\\n# un TraceId finit dans une commande (trace-dump <id>) et un nom de fichier :\\n# on n'accepte que des identifiants simples (OTel : 32 caracteres hexa)\\nTRACE_ID_RE = re.compile(r\\\"[0-9A-Za-z_-]{1,64}\\\")\\nLOG_BLOCK_RE = re.compile(r\\\"<log>.*?</log>\\\", re.S)\\nSESSION_ID_RE = re.compile(r'\\\"sessionID\\\"\\\\s*:\\\\s*\\\"(ses_[0-9A-Za-z]+)\\\"')\\n\\n# --- environnement des agents (defense en profondeur) ------------------------\\n# `opencode run` transmet SON environnement au shell de la session : on n'y\\n# laisse aucun secret. trace-dump & co rechargent les KAFKA_* manquants depuis\\n# env-kafka-1687d005.sh (kafkalib.ensure_config), sans que l'agent les voie.\\n# SSH_AUTH_SOCK : l'agent ssh de Baptiste ; un agent d'incident n'a rien a pousser.\\nSENSITIVE_ENV_NAMES = {\\\"KAFKA_PASSWORD\\\", \\\"KAFKA_USERNAME\\\", \\\"KAFKA_CA_PEM\\\", \\\"SSH_AUTH_SOCK\\\"}\\nSENSITIVE_ENV_MARKERS = (\\\"PASSWORD\\\", \\\"SECRET\\\", \\\"TOKEN\\\", \\\"KEY\\\", \\\"CREDENTIAL\\\")\\n# Liste blanche (nom exact) : LOG_PATCH_KEY est la cle de PUBLICATION des\\n# propositions de patch (console locale) ; l'unite systemd la charge depuis\\n# ~/.secrets/log-patch.env. La cle de DECISION humaine ne passe jamais : si\\n=== grep watch for historique/site ===\\n551:        routes.yaml pointe sur debug-historique) ;\\n1490:        de cluster, `--from earliest` rejouerait sinon tout l'historique.\\n\"}],\"providerCall\":{\"executed\":false},\"providerResult\":{\"executed\":false},\"rawInput\":\"{\\\"command\\\": \\\"cd /home/baptistefaisy/aiven-kafka-demo && sed -n 1,120p tools/kafka-incident-watch | head -120 && echo \\\\\\\"=== grep watch for historique/site ===\\\\\\\" && grep -n \\\\\\\"site\\\\\\\\.\\\\\\\\|historique\\\\\\\\|scenario=site\\\\\\\\|ERR_DB_POOL\\\\\\\" tools/kafka-incident-watch | head -40\\\"}\"},\"time\":{\"start\":1792665516320,\"end\":1792665516580}}}}\n{\"type\":\"tool_use\",\"timestamp\":1792665516584,\"sessionID\":\"ses_e9cd17f69ffeURpERydLf268dF\",\"part\":{\"partID\":\"prt_16330f915002D3mj2jRbTUCzE3\",\"sessionID\":\"ses_e9cd17f69ffeURpERydLf268dF\",\"messageID\":\"msg_16330d336001k2i90KVu0I4706\",\"type\":\"tool\",\"id\":\"call_00_tIybAP9mz3rrn4oJ3oeO7441\",\"tool\":\"shell\",\"state\":{\"status\":\"completed\",\"input\":{\"command\":\"cd /home/baptistefaisy/aiven-kafka-demo && grep -rn \\\"site.source\\\\|vercel-function\\\\|checkout-api\\\\|ERR_DB_POOL_EXHAUSTED\\\\|fix-db-pool-exhausted\\\\|clients=82\\\\|deploy ready\\\" -I . 2>/dev/null | grep -v node_modules | grep -v migration-backup | head -40\"},\"output\":\"(no output)\",\"title\":\"shell\",\"metadata\":{\"metadata\":{\"status\":\"completed\",\"truncated\":false,\"exit\":0},\"content\":[{\"type\":\"text\",\"text\":\"(no output)\"}],\"providerCall\":{\"executed\":false},\"providerResult\":{\"executed\":false},\"rawInput\":\"{\\\"command\\\": \\\"cd /home/baptistefaisy/aiven-kafka-demo && grep -rn \\\\\\\"site.source\\\\\\\\|vercel-function\\\\\\\\|checkout-api\\\\\\\\|ERR_DB_POOL_EXHAUSTED\\\\\\\\|fix-db-pool-exhausted\\\\\\\\|clients=82\\\\\\\\|deploy ready\\\\\\\" -I . 2>/dev/null | grep -v node_modules | grep -v migration-backup | head -40\\\"}\"},\"time\":{\"start\":1792665516310,\"end\":1792665516584}}}}\n{\"type\":\"step_finish\",\"timestamp\":1792665516587,\"sessionID\":\"ses_e9cd17f69ffeURpERydLf268dF\",\"part\":{\"id\":\"prt_16330fa2b001miaDUZ9tTyEZIO\",\"sessionID\":\"ses_e9cd17f69ffeURpERydLf268dF\",\"messageID\":\"msg_16330d336001k2i90KVu0I4706\",\"type\":\"step-finish\",\"reason\":\"tool-calls\",\"cost\":0,\"tokens\":{\"input\":1732,\"output\":224,\"reasoning\":228,\"cache\":{\"read\":31232,\"write\":0}}}}\n{\"type\":\"step_start\",\"timestamp\":1792665531111,\"sessionID\":\"ses_e9cd17f69ffeURpERydLf268dF\",\"part\":{\"id\":\"prt_1633132e7001xao8dULam4ufUU\",\"sessionID\":\"ses_e9cd17f69ffeURpERydLf268dF\",\"messageID\":\"msg_16330fa400013V6aQoQaZmZf9v\",\"type\":\"step-start\"}}\n{\"type\":\"tool_use\",\"timestamp\":1792665531197,\"sessionID\":\"ses_e9cd17f69ffeURpERydLf268dF\",\"part\":{\"partID\":\"prt_16331330d001e1iMc7XKdapiOc\",\"sessionID\":\"ses_e9cd17f69ffeURpERydLf268dF\",\"messageID\":\"msg_16330fa400013V6aQoQaZmZf9v\",\"type\":\"tool\",\"id\":\"call_01_KH8GWsElVI2BenXjJqRG5106\",\"tool\":\"shell\",\"state\":{\"status\":\"completed\",\"input\":{\"command\":\"cd /home/baptistefaisy/aiven-kafka-demo && sed -n 1,120p routes.yaml && echo \\\"=== specialists ===\\\" && sed -n 1,80p routes.specialistes.yaml\"},\"output\":\"# Table de routage des incidents — mode « debug-historique » (2026-10-22).\\n#\\n# Le watcher (tools/kafka-incident-watch) la LIT, il ne code aucun type\\n# d'erreur : c'est le « zero code ». Changer d'agent, de prompt ou de\\n# comportement = modifier CE fichier, jamais une ligne de code. Le watcher le\\n# relit a chaud au prochain incident (pas de redemarrage).\\n#\\n# Ici, TOUTES les erreurs partent vers l'agent debug-historique\\n# (agents/debug-historique.md). Son prompt est PROMPT-AGENT-DEBUG-HISTORIQUE.md :\\n# le watcher le relit a chaque lancement (sans jamais le modifier) et met\\n# l'incident dans son bloc <log> (§5 « JOURNAL DU BUG »). A chaque incident mis\\n# en file, les generateurs d'erreurs sont coupes (sans etre supprimes) ; pour\\n# les relancer : ./tools/generator on\\n#\\n# Revenir aux specialistes (incident-watch + db/kafka/runtime/policy/cache) :\\n#   cp routes.specialistes.yaml routes.yaml\\n#\\n# Format :\\n#   default_agent                  : agent des error.type absents de routes\\n#   disable_generators_on_incident : true = coupe les generateurs a chaque\\n#                                    incident mis en file (absent = false)\\n#   agents.<nom>.prompt_file       : prompt complet envoye a cet agent\\n#   agents.<nom>.timeout_s         : delai maximal de cet agent, en secondes\\n#   routes.<error.type>            : agent a lancer pour ce type\\n# Verification sans Kafka : ./tools/kafka-incident-watch --check-routes [error.type]\\n\\ndefault_agent: debug-historique\\n\\ndisable_generators_on_incident: true\\n\\nagents:\\n  debug-historique:\\n    prompt_file: /home/baptistefaisy/PROMPT-AGENT-DEBUG-HISTORIQUE.md\\n    # le prompt attend jusqu'a 20 min une decision humaine sur la console\\n    timeout_s: 2700\\n\\n# Aucune route specifique : chaque error.type tombe sur default_agent.\\nroutes:\\n=== specialists ===\\n# Table de routage des incidents.\\n#\\n# Le watcher la LIT, il ne code aucun type d'erreur.\\n# Le orchestrateur (agents/incident-watch.md) la lit aussi pour choisir le\\n# specialiste a deleguer.\\n#\\n# Ajouter un agent = ajouter un .md dans agents/ + UNE ligne ici.\\n# Aucune ligne de code a toucher. C'est la preuve du \\\"zero code\\\".\\n#\\n# format : <error.type> : <agent a lancer>\\n\\ndefault_agent: incident-watch\\n\\nroutes:\\n  # --- pannes de plateforme (les 5 du catalogue §2) -------------------------\\n  db_pool_exhausted: db-diagnose\\n  db_connection_timeout: db-diagnose\\n  kafka_broker_unreachable: kafka-diagnose\\n  oom: runtime-diagnose\\n  disk_full: runtime-diagnose\\n\\n  # --- variantes de nommage acceptees -------------------------------------\\n  broker_unreachable: kafka-diagnose\\n  connection_timeout: db-diagnose\\n  timeout: kafka-diagnose\\n\\n  # --- pannes de politique de l'agent ---------------------------------------\\n  rate_limit: policy-review\\n  silent_failure: policy-review\\n  stale_source: policy-review\\n\\n  # --- preuve du \\\"zero code\\\" (§9.6) ---------------------------------------\\n  # Ajoute le 2026-10-22 : un nouvel agent (agents/cache-diagnose.md) + UNE\\n  # ligne ici. Aucune ligne du watcher n'a ete modifiee.\\n  cache_miss_storm: cache-diagnose\\n\\n  # --- erreurs SQL reelles (producteur tools/emit_sql_error.py) ------------\\n  # Ajoute le 2026-10-22 : ces error.type ne sont PAS des scenarios du\\n  # catalogue. Ils sont produits par une VRAIE erreur PostgreSQL (sqlstate\\n  # capture par le serveur), publiee par tools/emit_sql_error.py.\\n  # Meme regle : aucune ligne de tools/kafka-incident-watch n'a ete touchee.\\n  db_undefined_table: db-diagnose\\n  db_undefined_function: db-diagnose\\n  db_undefined_column: db-diagnose\\n  db_syntax_error: db-diagnose\\n  db_data_exception: db-diagnose\\n  db_in_failed_transaction: db-diagnose\\n  db_application_exception: db-diagnose\\n  db_lock_timeout: db-diagnose\\n  db_deadlock: db-diagnose\\n  db_permission_denied: db-diagnose\\n\\n  # --- erreurs REELLEMENT provoquees par la base (tools/db_fault_probe.py) ---\\n  # Ajoutees le 2026-10-22 : la base d'erreurs ne contient pas que des\\n  # scenarios illustratifs, elle fait echouer de vraies requetes et remonte\\n  # le message + le SQLSTATE du serveur.\\n  db_division_by_zero: db-diagnose\\n  db_unique_violation: db-diagnose\\n  db_not_null_violation: db-diagnose\\n  db_check_violation: db-diagnose\\n  db_foreign_key_violation: db-diagnose\\n  db_serialization_failure: db-diagnose\\n  db_statement_timeout: db-diagnose\\n  db_too_many_connections: db-diagnose\\n\\n  # --- sqlstates mappes par tools/emit_sql_error.py (SQLSTATE_TO_ERROR_TYPE) --\\n  # Ajoutes le 2026-10-22 : ces deux types etaient produits mais non routes,\\n  # donc ils tombaient sur default_agent (incident-watch) au lieu de\\n  # db-diagnose. Trouve par ./tools/debug-selftest.\\n  db_query_canceled: db-diagnose\\n  db_connection_failure: db-diagnose\\n\",\"title\":\"shell\",\"metadata\":{\"metadata\":{\"status\":\"completed\",\"truncated\":false,\"exit\":0},\"content\":[{\"type\":\"text\",\"text\":\"# Table de routage des incidents — mode « debug-historique » (2026-10-22).\\n#\\n# Le watcher (tools/kafka-incident-watch) la LIT, il ne code aucun type\\n# d'erreur : c'est le « zero code ». Changer d'agent, de prompt ou de\\n# comportement = modifier CE fichier, jamais une ligne de code. Le watcher le\\n# relit a chaud au prochain incident (pas de redemarrage).\\n#\\n# Ici, TOUTES les erreurs partent vers l'agent debug-historique\\n# (agents/debug-historique.md). Son prompt est PROMPT-AGENT-DEBUG-HISTORIQUE.md :\\n# le watcher le relit a chaque lancement (sans jamais le modifier) et met\\n# l'incident dans son bloc <log> (§5 « JOURNAL DU BUG »). A chaque incident mis\\n# en file, les generateurs d'erreurs sont coupes (sans etre supprimes) ; pour\\n# les relancer : ./tools/generator on\\n#\\n# Revenir aux specialistes (incident-watch + db/kafka/runtime/policy/cache) :\\n#   cp routes.specialistes.yaml routes.yaml\\n#\\n# Format :\\n#   default_agent                  : agent des error.type absents de routes\\n#   disable_generators_on_incident : true = coupe les generateurs a chaque\\n#                                    incident mis en file (absent = false)\\n#   agents.<nom>.prompt_file       : prompt complet envoye a cet agent\\n#   agents.<nom>.timeout_s         : delai maximal de cet agent, en secondes\\n#   routes.<error.type>            : agent a lancer pour ce type\\n# Verification sans Kafka : ./tools/kafka-incident-watch --check-routes [error.type]\\n\\ndefault_agent: debug-historique\\n\\ndisable_generators_on_incident: true\\n\\nagents:\\n  debug-historique:\\n    prompt_file: /home/baptistefaisy/PROMPT-AGENT-DEBUG-HISTORIQUE.md\\n    # le prompt attend jusqu'a 20 min une decision humaine sur la console\\n    timeout_s: 2700\\n\\n# Aucune route specifique : chaque error.type tombe sur default_agent.\\nroutes:\\n=== specialists ===\\n# Table de routage des incidents.\\n#\\n# Le watcher la LIT, il ne code aucun type d'erreur.\\n# Le orchestrateur (agents/incident-watch.md) la lit aussi pour choisir le\\n# specialiste a deleguer.\\n#\\n# Ajouter un agent = ajouter un .md dans agents/ + UNE ligne ici.\\n# Aucune ligne de code a toucher. C'est la preuve du \\\"zero code\\\".\\n#\\n# format : <error.type> : <agent a lancer>\\n\\ndefault_agent: incident-watch\\n\\nroutes:\\n  # --- pannes de plateforme (les 5 du catalogue §2) -------------------------\\n  db_pool_exhausted: db-diagnose\\n  db_connection_timeout: db-diagnose\\n  kafka_broker_unreachable: kafka-diagnose\\n  oom: runtime-diagnose\\n  disk_full: runtime-diagnose\\n\\n  # --- variantes de nommage acceptees -------------------------------------\\n  broker_unreachable: kafka-diagnose\\n  connection_timeout: db-diagnose\\n  timeout: kafka-diagnose\\n\\n  # --- pannes de politique de l'agent ---------------------------------------\\n  rate_limit: policy-review\\n  silent_failure: policy-review\\n  stale_source: policy-review\\n\\n  # --- preuve du \\\"zero code\\\" (§9.6) ---------------------------------------\\n  # Ajoute le 2026-10-22 : un nouvel agent (agents/cache-diagnose.md) + UNE\\n  # ligne ici. Aucune ligne du watcher n'a ete modifiee.\\n  cache_miss_storm: cache-diagnose\\n\\n  # --- erreurs SQL reelles (producteur tools/emit_sql_error.py) ------------\\n  # Ajoute le 2026-10-22 : ces error.type ne sont PAS des scenarios du\\n  # catalogue. Ils sont produits par une VRAIE erreur PostgreSQL (sqlstate\\n  # capture par le serveur), publiee par tools/emit_sql_error.py.\\n  # Meme regle : aucune ligne de tools/kafka-incident-watch n'a ete touchee.\\n  db_undefined_table: db-diagnose\\n  db_undefined_function: db-diagnose\\n  db_undefined_column: db-diagnose\\n  db_syntax_error: db-diagnose\\n  db_data_exception: db-diagnose\\n  db_in_failed_transaction: db-diagnose\\n  db_application_exception: db-diagnose\\n  db_lock_timeout: db-diagnose\\n  db_deadlock: db-diagnose\\n  db_permission_denied: db-diagnose\\n\\n  # --- erreurs REELLEMENT provoquees par la base (tools/db_fault_probe.py) ---\\n  # Ajoutees le 2026-10-22 : la base d'erreurs ne contient pas que des\\n  # scenarios illustratifs, elle fait echouer de vraies requetes et remonte\\n  # le message + le SQLSTATE du serveur.\\n  db_division_by_zero: db-diagnose\\n  db_unique_violation: db-diagnose\\n  db_not_null_violation: db-diagnose\\n  db_check_violation: db-diagnose\\n  db_foreign_key_violation: db-diagnose\\n  db_serialization_failure: db-diagnose\\n  db_statement_timeout: db-diagnose\\n  db_too_many_connections: db-diagnose\\n\\n  # --- sqlstates mappes par tools/emit_sql_error.py (SQLSTATE_TO_ERROR_TYPE) --\\n  # Ajoutes le 2026-10-22 : ces deux types etaient produits mais non routes,\\n  # donc ils tombaient sur default_agent (incident-watch) au lieu de\\n  # db-diagnose. Trouve par ./tools/debug-selftest.\\n  db_query_canceled: db-diagnose\\n  db_connection_failure: db-diagnose\\n\"}],\"providerCall\":{\"executed\":false},\"providerResult\":{\"executed\":false},\"rawInput\":\"{\\\"command\\\": \\\"cd /home/baptistefaisy/aiven-kafka-demo && sed -n 1,120p routes.yaml && echo \\\\\\\"=== specialists ===\\\\\\\" && sed -n 1,80p routes.specialistes.yaml\\\"}\"},\"time\":{\"start\":1792665531149,\"end\":1792665531197}}}}\n{\"type\":\"tool_use\",\"timestamp\":1792665531254,\"sessionID\":\"ses_e9cd17f69ffeURpERydLf268dF\",\"part\":{\"partID\":\"prt_1633132f7001ntWnEULVnPjCg5\",\"sessionID\":\"ses_e9cd17f69ffeURpERydLf268dF\",\"messageID\":\"msg_16330fa400013V6aQoQaZmZf9v\",\"type\":\"tool\",\"id\":\"call_00_JyVIzVsPrSvo0E1Iq3E22099\",\"tool\":\"shell\",\"state\":{\"status\":\"completed\",\"input\":{\"command\":\"cd /home/baptistefaisy/aiven-kafka-demo && grep -rn \\\"vercel-function\\\\|socket connected\\\\|deploy ready\\\\|site\\\\.level\\\\|'site'\\\\|\\\\\\\"site\\\\\\\"\\\" -I . 2>/dev/null | grep -v node_modules | head -40\"},\"output\":\"./tools/contract-check:30:BUILD_CLI = PROJECT_ROOT / \\\"site\\\" / \\\"lib\\\" / \\\"build-cli.js\\\"\\n./tools/site-server.py:31:SITE_ROOT = PROJECT_ROOT / \\\"site\\\"\\n./site/lib/groups.js:22:  path.join(process.cwd(), 'site', 'agents', 'group.json'),\\n./site/.vercel/project.json:1:{\\\"projectId\\\":\\\"prj_Mbk16vkDIucpoKIYArOeHL0SVLkk\\\",\\\"orgId\\\":\\\"team_69W3p97P7EKfPQaumMuNX85m\\\",\\\"projectName\\\":\\\"site\\\"}\\n\",\"title\":\"shell\",\"metadata\":{\"metadata\":{\"status\":\"completed\",\"truncated\":false,\"exit\":0},\"content\":[{\"type\":\"text\",\"text\":\"./tools/contract-check:30:BUILD_CLI = PROJECT_ROOT / \\\"site\\\" / \\\"lib\\\" / \\\"build-cli.js\\\"\\n./tools/site-server.py:31:SITE_ROOT = PROJECT_ROOT / \\\"site\\\"\\n./site/lib/groups.js:22:  path.join(process.cwd(), 'site', 'agents', 'group.json'),\\n./site/.vercel/project.json:1:{\\\"projectId\\\":\\\"prj_Mbk16vkDIucpoKIYArOeHL0SVLkk\\\",\\\"orgId\\\":\\\"team_69W3p97P7EKfPQaumMuNX85m\\\",\\\"projectName\\\":\\\"site\\\"}\\n\"}],\"providerCall\":{\"executed\":false},\"providerResult\":{\"executed\":false},\"rawInput\":\"{\\\"command\\\": \\\"cd /home/baptistefaisy/aiven-kafka-demo && grep -rn \\\\\\\"vercel-function\\\\\\\\|socket connected\\\\\\\\|deploy ready\\\\\\\\|site\\\\\\\\.level\\\\\\\\|'site'\\\\\\\\|\\\\\\\\\\\\\\\"site\\\\\\\\\\\\\\\"\\\\\\\" -I . 2>/dev/null | grep -v node_modules | head -40\\\"}\"},\"time\":{\"start\":1792665531128,\"end\":1792665531254}}}}\n{\"type\":\"step_finish\",\"timestamp\":1792665531256,\"sessionID\":\"ses_e9cd17f69ffeURpERydLf268dF\",\"part\":{\"id\":\"prt_163313378001an053A2mnOH6kd\",\"sessionID\":\"ses_e9cd17f69ffeURpERydLf268dF\",\"messageID\"