"agent.scenario\\\":\\\"platform_db_pool_exhausted\\\",\\\"agent.profile\\\":\\\"infra\\\",\\\"error.type\\\":\\\"db_pool_exhausted\\\",\\\"http.response.status_code\\\":\\\"500\\\",\\\"db.system\\\":\\\"postgresql\\\",\\\"db.connection_pool.name\\\":\\\"HikariPool-1\\\",\\\"db.connection_pool.active\\\":\\\"20\\\",\\\"db.connection_pool.idle\\\":\\\"0\\\",\\\"db.connection_pool.max\\\":\\\"20\\\"},\\\"Duration\\\":380000000,\\\"StatusCode\\\":\\\"Error\\\",\\\"StatusMessage\\\":\\\"\\\"}\", \"h\": \"29880e444349612f34cdff0407f87417b9676d832cce3efc14733fd40c907fe4\"}\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"./scenarios/catalog.json:25:      \"id\": \"platform_db_pool_exhausted\",\n./scenarios/catalog.json:28:      \"error_type\": \"db_pool_exhausted\",\n./scenarios/catalog.json:32:      \"log_body\": \"Database connection pool exhausted (20/20 in use, 0 available)\",\n./scenarios/catalog.json:33:      \"exception_message\": \"com.zaxxer.hikari.pool.HikariPool$PoolInitializationException: Database connection pool exhausted (20/20 in use, 0 available)\",\n./scenarios/catalog.json:44:            \"error.type\": \"db_pool_exhausted\",\n./scenarios/catalog.json:45:            \"exception.message\": \"com.zaxxer.hikari.pool.HikariPool$PoolInitializationException: Database connection pool exhausted (20/20 in use, 0 available)\",\n./scenarios/catalog.json:125:          \"body\": \"Database connection pool exhausted (20/20 in use, 0 available)\",\n./scenarios/catalog.json:127:            \"error.type\": \"db_pool_exhausted\",\n./scenarios/catalog.json:128:            \"exception.message\": \"com.zaxxer.hikari.pool.HikariPool$PoolInitializationException: Database connection pool exhausted (20/20 in use, 0 available)\",\n./tools/detectors.py:216:    pool = next((s for s in scenarios if s.get(\"error_type\") == \"db_pool_exhausted\"), None)\n./tools/patch-new:23:  ./tools/patch-new --error-type db_pool_exhausted --cause config --sqlstate 53300\n./tools/emit_db_errors.py:28:  ./tools/emit_db_errors.py --emit db_pool_exhausted \"pool 20/20\"  # insere\n./tools/generator_switch.py:9:     \"reason\": \"incident 03ee1959 error.type=db_pool_exhausted\"}\n./site/scenarios/catalog.json:25:      \"id\": \"platform_db_pool_exhausted\",\n./site/scenarios/catalog.json:28:      \"error_type\": \"db_pool_exhausted\",\n./site/scenarios/catalog.json:32:      \"log_body\": \"Database connection pool exhausted (20/20 in use, 0 available)\",\n./site/scenarios/catalog.json:33:      \"exception_message\": \"com.zaxxer.hikari.pool.HikariPool$PoolInitializationException: Database connection pool exhausted (20/20 in use, 0 available)\",\n./site/scenarios/catalog.json:44:            \"error.type\": \"db_pool_exhausted\",\n./site/scenarios/catalog.json:45:            \"exception.message\": \"com.zaxxer.hikari.pool.HikariPool$PoolInitializationException: Database connection pool exhausted (20/20 in use, 0 available)\",\n./site/scenarios/catalog.json:125:          \"body\": \"Database connection pool exhausted (20/20 in use, 0 available)\",\n./site/scenarios/catalog.json:127:            \"error.type\": \"db_pool_exhausted\",\n./site/scenarios/catalog.json:128:            \"exception.message\": \"com.zaxxer.hikari.pool.HikariPool$PoolInitializationException: Database connection pool exhausted (20/20 in use, 0 available)\",\n./db/erreurs_schema.sql:144:    'Insere une erreur publiable (status=new). Usage : SELECT erreurs.emit(''db_pool_exhausted'', ''pool 20/20'');';\n./db/erreurs_seed.sql:23: 'agent-demo', 'prod', 'ERROR', 17, 'db_pool_exhausted',\n./db/erreurs_seed.sql:24: 'com.zaxxer.hikari.pool.HikariPool$PoolInitializationException: Database connection pool exhausted (20/20 in use, 0 available)',\n./HANDOFF-CLAUDE-PG-ERREURS.md:129:« plateforme » illustratives : `db_pool_exhausted`, `db_connection_timeout`,\n./migration-backup/agent-kafka-20261022/otel-reports.jsonl:2:{\"topic\": \"otel-reports\", \"partition\": 0, \"offset\": 1, \"key\": \"d7cce6a56ec4464985edac9f1890015f\", \"value\": \"{\\\"Timestamp\\\": \\\"2026-10-22 07:57:54.343\\\", \\\"TraceId\\\": \\\"d7cce6a56ec4464985edac9f1890015f\\\", \\\"agent\\\": \\\"db-diagnose\\\", \\\"error_type\\\": \\\"db_pool_exhausted\\\", \\\"scenario\\\": \\\"platform_db_pool_exhausted\\\", \\\"title\\\": \\\"[db_pool_exhausted] d7cce6a5\\\", \\\"exit_code\\\": 0, \\\"report\\\": \\\"```\\\\nPANNIE : base joignable en TCP ? — indéterminé. Le pool HikariPool-1 est en\\\\n         saturation franche : 20/20 connexions actives, 0 idle. Aucun signe de\\\\n         panne réseau (pas de \\\\\\\"connection refused\\\\\\\", pas d'erreur DNS), mais\\\\n         aucune sonde TCP n'est présente dans la trace. Côté applicatif :\\\\n         indisponible (HTTP 500 sur les 4 appels tool.check_reservation).\\\\n         Note : \\\\\\\"PoolInitializationException\\\\\\\" évoque une init de pool ratée,\\\\n         pas une simple attente — voir « non concluable ».\\\\n\\\\nCAUSE  : CAUSE RACINE = pool saturé (épuisement de connexions), pas la\\\\n         connectique ni les credentials.\\\\n         - Pas un problème de credentials : aucune 401/403, aucun\\\\n           \\\\\\\"password authentication failed\\\\\\\" — on échoue AVANT d'atteindre\\\\n           l'authentification (pas de slot disponible).\\\\n         - Pas un timeout de requête : les 4 échecs sont des timeouts\\\\n           d'ACQUISITION de connexion (db.client.connection.timeouts = 4),\\\\n           la requête SQL n'a jamais été émise.\\\\n         - Signature fuite de connexion : active = max = 20 ET idle = 0, avec\\\\n           4 tentatives qui ne libèrent rien. Une simple charge laisserait\\\\n           transiter des connexions (idle > 0 par intermittence).\\\\n         SYMPTÔME = retry spiral : le détecteur relève 4 appels\\\\n         tool.check_reservation à 380 ms d'intervalle, tous en 500. L'agent\\\\n         répète l'appel ; ce n'est pas la cause, c'est la conséquence.\\\\n\\\\nPREUVES: - db.client.connection.pool.active = 20  (max = 20 → 100 %)\\\\n         - db.client.connection.pool.idle   = 0\\\\n         - db.client.connection.pool.max    = 20\\\\n         - db.client.connection.timeouts    = 4  (1 par tentative)\\\\n         - 5 spans : 1 agent.run (1600 ms, success=false, booking_confirmed\\\\n           =false, tool_calls=4) + 4 × tool.check_reservation à 380 ms, tous\\\\n           en 500, db.system=postgresql, pool=HikariPool-1\\\\n         - retry_spiral [PROBLEME] : 4 appels (seuil > 2), statuts\\\\n           500/500/500/500 ; silent_failure [ok] ; stale_source [ok]\\\\n         - 4 échecs × 380 ms ≈ 1520 ms ≈ durée du span racine (1600 ms) :\\\\n           l'agent a passé 95 % de son temps à attendre une connexion.\\\\n\\\\nACTION : 1) Relevé de pool côté app (le plus rapide) :\\\\n            curl -s localhost:<mgmt-port>/actuator/metrics/hikaricp.connections.active\\\\n            curl -s localhost:<mgmt-port>/actuator/metrics/hikaricp.connections.pending\\\\n         2) Sessions Postgres — chercher les \\\\\\\"idle in transaction\\\\\\\" (fuite) :\\\\n            psql \\\\\\\"$DATABASE_URL\\\\\\\" -c \\\\\\\"SELECT state, count(*), max(now()-state_change)\\\\n              AS age_max FROM pg_stat_activity WHERE datname=current_database()\\\\n              GROUP BY state ORDER BY 2 DESC;\\\\\\\"\\\\n            psql \\\\\\\"$DATABASE_URL\\\\\\\" -c \\\\\\\"SELECT pid, state, wait_event_type, wait_event,\\\\n              now()-state_change AS age, left(query,80) FROM pg_stat_activity\\\\n              WHERE datname=current_database() ORDER BY age DESC LIMIT 20;\\\\\\\"\\\\n         3) Si age_max élevé sur 'idle in transaction' → fuite confirmée :\\\\n            correctif = try-with-resources / @Transactional manquant, puis\\\\n            relâcher les sessions bloquées (pg_terminate_backend).\\\\n            Si age faible et turnover élevé → charge réelle : augmenter\\\\n            maximumPoolSize + connectionTimeout, pas de correctif de fuite.\\\\n\\\\nNON CONCLUABLE avec ces données :\\\\n  - Aucun accès base n'est configuré dans cet environnement (ni DATABASE_URL,\\\\n    ni PGHOST/PGUSER ; psql présent mais sans cible) : je n'ai PAS pu\\\\n    interroger pg_stat_activity. Tout ce qui précède vient des métriques de\\\\n    la trace.\\\\n  - Fuite vs charge : active=20/idle=0 est compatible avec les deux. Il\\\\n    manque la distribution des temps de détention et le compteur\\\\n    hikaricp.connections.pending (file d'attente) pour trancher.\\\\n  - Durée anormale : Hikari connectionTimeout vaut 30 s par défaut, or les\\\\n    échecs tombent à 380 ms. Soit connectionTimeout est configuré très bas\\\\n    (< 400 ms), soit l'échec vient de l'initialisation du pool et non d'une\\\\n    attente. La trace ne donne pas la valeur configurée.\\\\n  - Contradiction de message : la classe citée est\\\\n    HikariPool$PoolInitializationException (échec de création des connexions\\\\n    initiales → piste connectique/credentials) alors que le texte et les\\\\n    métriques décrivent une saturation (20/20, 0 idle). Les deux ne peuvent\\\\n    pas être vrais simultanément ; à lever en priorité via le log applicatif\\\\n    complet de HikariPool-1 (chercher \\\\\\\"Exception during pool initialization\\\\\\\"\\\\n    vs \\\\\\\"Connection is not available, request timed out\\\\\\\").\\\\n  - Connectivité réseau réelle (DNS, filtre, service up) : non testée.\\\\n```\\\"}\", \"h\": \"b33a6f515e57d42b0aa19cb57198734bf984907c7279532f80f73aa6969ec669\"}\n./migration-backup/agent-kafka-20261022/otel-reports.jsonl:15:{\"topic\": \"otel-reports\", \"partition\": 0, \"offset\": 14, \"key\": \"1e8926a2360c493b839c310d07e4c512\", \"value\": \"{\\\"Timestamp\\\": \\\"2026-10-22 08:29:46.300\\\", \\\"TraceId\\\": \\\"1e8926a2360c493b839c310d07e4c512\\\", \\\"agent\\\": \\\"db-diagnose\\\", \\\"error_type\\\": \\\"db_pool_exhausted\\\", \\\"scenario\\\": \\\"db/db_pool_exhausted\\\", \\\"title\\\": \\\"[db_pool_exhausted] 1e8926a2\\\", \\\"exit_code\\\": 0, \\\"report\\\": \\\"## PANNE\\\\nLa base n'est **pas** injoignable : elle répond, mais l'application ne peut plus en obtenir de session. `HikariPool-1` est à **20/20 connexions actives, 0 disponible** — le pool est saturé au plafond. Le span `agent.run` meurt à **0.0 ms**, donc l'échec se produit **avant** toute requête SQL : ce n'est pas la base qui est lente, c'est l'emprunt de connexion qui est refusé. Aucun `net.peer.*`, aucun `db.*` span, aucune erreur TCP/DNS dans la trace.\\\\n\\\\n## CAUSE\\\\n**Cause racine : épuisement du pool par non-restitution des sessions (fuite de connexion applicative), pas une connectique cassée ni un pic de charge prouvé.**\\\\n- **Symptôme** : `db_pool_exhausted` / `app.errors=1` sur `agent-demo`, remonté dans Kafka `otel.traces`.\\\\n- **Distinction** : pas de timeout TCP (aucune erreur de connexion, de DNS ou de refus), pas de timeout de requête (durée 0.0 ms, aucun span enfant DB), pas de credentials (aucun 401/403, aucun SQLSTATE 28P01/42501 — `db.error.origin=application`), et **pas de spirale de retry** (détecteur `retry_spiral` = `ok`). Donc aucun mécanisme d'amplification : l'agent ne répète pas, il constate.\\\\n- Le seuil `active = max = 20` avec `0 disponible` est la signature d'un **pool qui ne récupère pas ses connexions** (session jamais rendue : `close()`/try-with-resources manquant, transaction laissée ouverte) bien plus que d'une simple charge — une charge pure laisserait des connexions tourner et se libérer.\\\\n\\\\n## PREUVES\\\\n- `HikariPool-1: 20/20 connexions actives, 0 disponible` — **active=20, max=20, available=0**.\\\\n- `db.error.origin=application`, `db.error.id=13`, `error.source=postgresql://pg-erreurs/erreurs.app_errors`, table `erreurs.app_errors`.\\\\n- Span unique `agent.run` durée **0.0 ms**, statut `Error` → rejet immédiat à l'acquisition, pas d'I/O.\\\\n- Détecteurs : `retry_spiral` **ok**, `silent_failure` **ok**, `stale_source` **ok**.\\\\n- Métriques présentes : `app.errors = 1` (×2 séries). **Absentes** : `db.client.connection.pool.*` (active/idle/pending/acquire), `db.*`, `net.peer.*`.\\\\n\\\\n**Ce que les données NE permettent PAS de conclure :**\\\\n1. **Fuite vs requêtes lentes** : la trace ne donne pas `idle`, `pending` ni `acquire` dans le temps, ni la durée des requêtes en cours. Un pool plein peut aussi venir de requêtes bloquées (lock, `idle in transaction`) — non départageable ici.\\\\n2. **Identité du coupable** : impossible de savoir quel code/endpoint emprunte les 20 connexions (pas de span DB, pas de stack, un seul span `agent.run`).\\\\n3. **Ancienneté** : on ne sait pas depuis quand le pool est saturé (pas de série temporelle, un seul point à 08:16:46.837).\\\\n4. **Côté serveur** : `max_connections`, `idle_in_transaction_session_timeout` et l'état réel de `pg_stat_activity` sont inconnus — **aucun accès base n'est configuré dans cet environnement** (aucune variable PG/DSN), donc pas de requête de diagnostic possible ; conclusion établie sur les seules métriques de la trace.\\\\n5. `kafka-health` **non appelé** : le type d'erreur est `db_pool_exhausted`, Kafka n'est que le transport de la télémétrie — aucun symptôme broker.\\\\n\\\\n## ACTION\\\\nRelevé de pool + état serveur, dans cet ordre :\\\\n\\\\n```sh\\\\n# 1) Qui tient les 20 connexions ? (le point décisif : idle in transaction = fuite)\\\\npsql \\\\\\\"postgresql://pg-erreurs/erreurs\\\\\\\" -c \\\\\\\"\\\\nselect state, wait_event_type, wait_event, count(*) as n,\\\\n       max(now()-state_change) as age_max\\\\nfrom pg_stat_activity where datname='erreurs'\\\\ngroup by 1,2,3 order by n desc;\\\\\\\"\\\\n\\\\n# 2) Détail des sessions les plus anciennes\\\\npsql \\\\\\\"postgresql://pg-erreurs/erreurs\\\\\\\" -c \\\\\\\"\\\\nselect pid, usename, application_name, state, now()-state_change as age,\\\\n       left(query,100) as q\\\\nfrom pg_stat_activity where datname='erreurs'\\\\norder by state_change asc limit 20;\\\\\\\"\\\\n\\\\n# 3) Plafonds serveur\\\\npsql \\\\\\\"postgresql://pg-erreurs/erreurs\\\\\\\" -c \\\\\\\"show max_connections; show idle_in_transaction_session_timeout;\\\\\\\"\\\\n```\\\\n\\\\nRelevé côté application : exposer `hikaricp_connections_active/idle/pending/acquire` (Micrometer/JMX) et activer `leakDetectionThreshold=20000` pour faire nommer la fuite par Hikari lui-même. Correctif attendu si `idle in transaction` domine : fermeture des sessions en `try-with-resources`, `idle_in_transaction_session_timeout` côté serveur, et plafond de pool dimensionné sur `max_connections` du serveur.\\\"}\", \"h\": \"8fecfd909b66c1c423c2ad6d146a8aad1c582420ff82bfbda39ce664d3dd98aa\"}\n./migration-backup/agent-kafka-20261022/otel-reports.jsonl:16:{\"topic\": \"otel-reports\", \"partition\": 0, \"offset\": 15, \"key\": \"d7cce6a56ec4464985edac9f1890015f\", \"value\": \"{\\\"Timestamp\\\": \\\"2026-10-22 08:43:09.040\\\", \\\"TraceId\\\": \\\"d7cce6a56ec4464985edac9f1890015f\\\", \\\"agent\\\": \\\"db-diagnose\\\", \\\"error_type\\\": \\\"db_pool_exhausted\\\", \\\"scenario\\\": \\\"platform_db_pool_exhausted\\\", \\\"title\\\": \\\"[db_pool_exhausted] d7cce6a5\\\", \\\"exit_code\\\": 0, \\\"report\\\": \\\"## PANNIE\\\\nLa base **n'est pas démontrée injoignable** : aucun timeout TCP, aucune erreur DNS, aucun 401/403. Ce qui est certain, c'est que le **pool Hikari est plein** et que le service applicatif renvoie 500. L'échec se situe au niveau de la **couche de connexion applicative (HikariPool-1)**, pas au niveau du réseau vers PostgreSQL.\\\\n\\\\n## CAUSE\\\\n**Cause racine : pool saturé avec fuite de connexion probable** (pas une simple charge, pas la connectique, pas les credentials).\\\\n- `active = 20`, `max = 20`, `idle = 0` → le pool est à 100 % et il ne reste **aucune** connexion libre. Une charge légitime laisserait au moins quelques connexions revenir en `idle` entre deux requêtes ; ici `idle = 0` en continu sur les 4 tentatives, ce qui oriente vers des **sessions non rendues** (connexion empruntée jamais `close()` dans un `finally`).\\\\n- **Symptôme, pas cause** : le détecteur `retry_spiral` (4 appels `tool.check_reservation`, tous en 500). L'agent répète l'appel ; la répétition **aggrave** la saturation (chaque essai tente un nouvel emprunt) mais ne la crée pas. Traiter le retry ne libérera aucune connexion.\\\\n- **Credentials exclus** : aucun statut 401/403, aucune erreur d'authentification dans les spans.\\\\n- **Requête lente exclue comme cause première** : les 4 spans échouent en **380 ms**, très en dessous d'un `connectionTimeout` Hikari classique (30 s) → échec rapide, cohérent avec un pool déjà vide et une initialisation/acquisition qui abandonne immédiatement.\\\\n\\\\n## PREUVES\\\\n```\\\\ndb.client.connection.pool.active = 20   (max = 20)   -> saturation\\\\ndb.client.connection.pool.idle   = 0                 -> aucune connexion rendue\\\\ndb.client.connection.pool.max    = 20\\\\ndb.client.connection.timeouts    = 4                 -> 4 échecs d'obtention\\\\ndb.system = postgresql | db.connection_pool.name = HikariPool-1\\\\nexception: HikariPool$PoolInitializationException: \\\\\\\"Database connection pool exhausted (20/20 in use, 0 available)\\\\\\\"\\\\nspans : 4 x tool.check_reservation, 380 ms, statut 500, du 18:02:18.919 au 18:02:20.119\\\\nagent.run 1600 ms -> http 500 | agent.result: success=false, booking_confirmed=false, tool_calls=4\\\\ndétecteur: [PROBLEME] retry_spiral 4 appels (seuil > 2), statuts 500/500/500/500\\\\n```\\\\n\\\\n## ACTION\\\\nAucun accès base n'est configuré dans cet environnement (`PG*`/`DATABASE_*` absents) : je n'ai pas pu interroger le serveur, seulement lire les métriques de la trace. À lancer côté ops :\\\\n\\\\n```sql\\\\n-- 1. Qui tient les 20 connexions ? (état + ancienneté + requête en cours)\\\\nSELECT application_name, state, count(*),\\\\n       max(now() - state_change) AS duree_etat,\\\\n       max(now() - query_start)  AS duree_requete\\\\nFROM pg_stat_activity\\\\nWHERE datname = current_database()\\\\nGROUP BY 1,2 ORDER BY 3 DESC;\\\\n\\\\n-- 2. Fuite caractéristique : sessions \\\\\\\"idle in transaction\\\\\\\" qui ne rendent jamais\\\\nSELECT pid, application_name, state, now() - state_change AS idle_depuis, left(query,120)\\\\nFROM pg_stat_activity\\\\nWHERE state IN ('idle in transaction','idle in transaction (aborted)')\\\\nORDER BY state_change LIMIT 20;\\\\n\\\\n-- 3. Marge serveur\\\\nSELECT count(*) AS total, current_setting('max_connections') AS max_conn FROM pg_stat_activity;\\\\n```\\\\nEt côté application : activer `leakDetectionThreshold=20000` sur HikariPool-1 (le log nommera le code qui emprunte sans rendre), exposer `hikaricp_connections_active/idle/pending` en métrique continue, et vérifier le `try-with-resources` autour de `check_reservation`.\\\\n\\\\n**Ce que les données NE permettent PAS de conclure :**\\\\n- impossible de distinguer **fuite** de **pool sous-dimensionné + pic de charge** : la trace ne dit pas depuis combien de temps `active=20`, ni si les 20 connexions tournent ou dorment (`pg_stat_activity` requis) ;\\\\n- aucun attribut `net.peer.*`/`server.address` → **joignabilité TCP non prouvée** (on ne peut pas totalement exclure un serveur qui accepte le TCP mais ne répond plus, ce qui produirait aussi `active=20`) ;\\\\n- aucune vue sur les autres instances/services partageant la même base ni sur `max_connections` serveur ;\\\\n- le libellé `PoolInitializationException` (échec d'**initialisation** du pool) est incohérent avec un épuisement en cours d'exécution (qui donnerait `SQLTransientConnectionException: Connection is not available, request timed out`) → il faut vérifier si le pool a été **recréé à chaud** (redémarrage/`HikariPool` reconstruit pendant l'incident) ;\\\\n- les `_TIMED_OUT` rdkafka visibles dans `trace-dump` viennent du **consommateur de l'outil de dump**, pas de l'incident — à ne pas imputer à Kafka.\\\"}\", \"h\": \"047bc622