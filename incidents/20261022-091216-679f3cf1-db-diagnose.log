--- metriques (4) ---\n  db.client.connections.timeouts = 1 [1] {\"agent.scenario\": \"platform_db_connection_timeout\", \"agent.profile\": \"infra\", \"error.type\": \"db_connection_timeout\", \"db.system\": \"postgresql\"}\n  db.client.operation.duration = 30 [s] {\"agent.scenario\": \"platform_db_connection_timeout\", \"agent.profile\": \"infra\", \"error.type\": \"db_connection_timeout\", \"db.system\": \"postgresql\", \"db.operation.name\": \"SELECT reservations\"}\n  db.client.connections.timeouts = 1 [1] {\"agent.scenario\": \"platform_db_connection_timeout\", \"agent.profile\": \"infra\", \"error.type\": \"db_connection_timeout\", \"db.system\": \"postgresql\"}\n  db.client.operation.duration = 30 [s] {\"agent.scenario\": \"platform_db_connection_timeout\", \"agent.profile\": \"infra\", \"error.type\": \"db_connection_timeout\", \"db.system\": \"postgresql\", \"db.operation.name\": \"SELECT reservations\"}\n--- detecteurs ---\n  [ok      ] retry_spiral     aucune spirale de retry (> 2 appels)\n  [ok      ] silent_failure   aucune promesse non tenue par l'outil\n  [ok      ] stale_source     aucune version perimee\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"/home/baptistefaisy/aiven-kafka-demo/trace-dump 679f3cf125ec4bf7a61552afcc3b16a1 --detectors\"}"},"time":{"start":1792660341355,"end":1792660350417}}}}
