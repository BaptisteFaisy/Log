cPartition  # type: ignore\n            ck = kafkalib.import_kafka()\n            admin = kafkalib.admin_client(\"kafka-incident-watch-purge\")\n            names = [kafkalib.topic(suffix, self.prefix) for suffix in (\"logs\", \"traces\")]\n            meta = admin.list_topics(timeout=15)\n            partitions = [TopicPartition(name, pid) for name in names\n                          for pid in sorted(((meta.topics or {}).get(name).partitions or {})\n                                            if (meta.topics or {}).get(name) else [])]\n            if not partitions:\n                log(f\"aucun topic {', '.join(names)} visible -> rien a purger (ACL Describe ?)\")\n                return EXIT_KAFKA\n            probe = ck.Consumer(kafkalib.kafka_config({\n                \"group.id\": f\"{self.group_id}-purge-probe\", \"enable.auto.commit\": False}))\n            try:\n                ends = {(tp.topic, tp.partition): probe.get_watermark_offsets(tp, timeout=15)[1]\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /home/baptistefaisy/aiven-kafka-demo && sed -n 1540,1600p tools/kafka-incident-watch\"}"},"time":{"start":1792673321275,"end":1792673321320}}}}
