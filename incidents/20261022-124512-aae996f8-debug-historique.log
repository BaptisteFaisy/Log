{"type":"tool_use","timestamp":1792673387934,"sessionID":"ses_e9c5b1e0cffe0hZ6Q4WZhgMv3f","part":{"partID":"prt_163a90e18001LxbWu2ERwQMwFz","sessionID":"ses_e9c5b1e0cffe0hZ6Q4WZhgMv3f","messageID":"msg_163a8d9b70016oxg65FqtvQCVZ","type":"tool","id":"call_00_kDe7hyv7xpEXG5VmXoVU9985","tool":"write","state":{"status":"completed","input":{"path":"/tmp/opencode/ts_probe.py","content":"#!/usr/bin/env python3\n\"\"\"Sonde LECTURE SEULE : horodatage des enregistrements Kafka (record timestamp)\npour un TraceId donne. N'ecrit rien, ne committe aucun offset (groupe jetable).\"\"\"\nimport json\nimport sys\nimport uuid\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\nPROJECT = Path(\"/home/baptistefaisy/aiven-kafka-demo\")\nsys.path.insert(0, str(PROJECT / \"tools\"))\nimport kafkalib  # noqa: E402\n\ntrace_id = sys.argv[1]\nck = kafkalib.import_kafka()\nfrom confluent_kafka import OFFSET_BEGINNING, TopicPartition, KafkaError  # noqa: E402\n\nconsumer = ck.Consumer(kafkalib.kafka_config({\n    \"group.id\": f\"ts-probe-{uuid.uuid4().hex[:8]}\",\n    \"enable.auto.commit\": False,\n}))\ntopics = [kafkalib.topic(s) for s in (\"traces\", \"logs\", \"metrics\")]\nmeta = consumer.list_topics(timeout=20)\nparts = []\nfor name in topics:\n    t = (meta.topics or {}).get(name)\n    if not t:\n        print(f\"topic absent : {name}\")\n        continue\n    for pid in t.partitions:\n        parts.append(TopicPartition(name, pid))\nconsumer.assign([TopicPartition(p.topic, p.partition, OFFSET_BEGINNING) for p in parts])\n\nfound = 0\nidle = 0\nwhile idle < 3:\n    msg = consumer.poll(1.0)\n    if msg is None:\n        idle += 1\n        continue\n    idle = 0\n    if msg.error():\n        print(\"erreur:\", msg.error())\n        continue\n    try:\n        payload = json.loads(msg.value().decode(\"utf-8\", \"replace\"))\n    except Exception:\n        continue\n    if payload.get(\"TraceId\") != trace_id:\n        continue\n    found += 1\n    ts_type, ts_ms = msg.timestamp()\n    when = datetime.fromtimestamp(ts_ms / 1000, timezone.utc).isoformat() if ts_ms and ts_ms > 0 else \"n/a\"\n    print(f\"{msg.topic()} p{msg.partition()} off={msg.offset()} \"\n          f\"record_ts={when} (type={ts_type}) \"\n          f\"payload_ts={payload.get('Timestamp')} key={payload.get('SpanName') or payload.get('Body','')[:40]}\")\nprint(f\"messages trouves pour la trace : {found}\")\nconsumer.close()\n"},"output":"Created file successfully: /tmp/opencode/ts_probe.py","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: /tmp/opencode/ts_probe.py"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/tmp/opencode/ts_probe.py\", \"content\": \"#!/usr/bin/env python3\\n\\\"\\\"\\\"Sonde LECTURE SEULE : horodatage des enregistrements Kafka (record timestamp)\\npour un TraceId donne. N'ecrit rien, ne committe aucun offset (groupe jetable).\\\"\\\"\\\"\\nimport json\\nimport sys\\nimport uuid\\nfrom datetime import datetime, timezone\\nfrom pathlib import Path\\n\\nPROJECT = Path(\\\"/home/baptistefaisy/aiven-kafka-demo\\\")\\nsys.path.insert(0, str(PROJECT / \\\"tools\\\"))\\nimport kafkalib  # noqa: E402\\n\\ntrace_id = sys.argv[1]\\nck = kafkalib.import_kafka()\\nfrom confluent_kafka import OFFSET_BEGINNING, TopicPartition, KafkaError  # noqa: E402\\n\\nconsumer = ck.Consumer(kafkalib.kafka_config({\\n    \\\"group.id\\\": f\\\"ts-probe-{uuid.uuid4().hex[:8]}\\\",\\n    \\\"enable.auto.commit\\\": False,\\n}))\\ntopics = [kafkalib.topic(s) for s in (\\\"traces\\\", \\\"logs\\\", \\\"metrics\\\")]\\nmeta = consumer.list_topics(timeout=20)\\nparts = []\\nfor name in topics:\\n    t = (meta.topics or {}).get(name)\\n    if not t:\\n        print(f\\\"topic absent : {name}\\\")\\n        continue\\n    for pid in t.partitions:\\n        parts.append(TopicPartition(name, pid))\\nconsumer.assign([TopicPartition(p.topic, p.partition, OFFSET_BEGINNING) for p in parts])\\n\\nfound = 0\\nidle = 0\\nwhile idle < 3:\\n    msg = consumer.poll(1.0)\\n    if msg is None:\\n        idle += 1\\n        continue\\n    idle = 0\\n    if msg.error():\\n        print(\\\"erreur:\\\", msg.error())\\n        continue\\n    try:\\n        payload = json.loads(msg.value().decode(\\\"utf-8\\\", \\\"replace\\\"))\\n    except Exception:\\n        continue\\n    if payload.get(\\\"TraceId\\\") != trace_id:\\n        continue\\n    found += 1\\n    ts_type, ts_ms = msg.timestamp()\\n    when = datetime.fromtimestamp(ts_ms / 1000, timezone.utc).isoformat() if ts_ms and ts_ms > 0 else \\\"n/a\\\"\\n    print(f\\\"{msg.topic()} p{msg.partition()} off={msg.offset()} \\\"\\n          f\\\"record_ts={when} (type={ts_type}) \\\"\\n          f\\\"payload_ts={payload.get('Timestamp')} key={payload.get('SpanName') or payload.get('Body','')[:40]}\\\")\\nprint(f\\\"messages trouves pour la trace : {found}\\\")\\nconsumer.close()\\n\"}"},"time":{"start":1792673386008,"end":1792673387934}}}}
