{"type":"tool_use","timestamp":1792673555414,"sessionID":"ses_e9c5b1e0cffe0hZ6Q4WZhgMv3f","part":{"partID":"prt_163aba3b5001o3LG2TloL5LivZ","sessionID":"ses_e9c5b1e0cffe0hZ6Q4WZhgMv3f","messageID":"msg_163ab7ff5001oG2co8xlJqfB37","type":"tool","id":"call_00_K5V9nLK5lENT5KOAIze75576","tool":"shell","state":{"status":"completed","input":{"command":"cd /home/baptistefaisy/aiven-kafka-demo && sed -n 1,60p site/lib/generators.js"},"output":"'use strict';\n/**\n * L'interrupteur des generateurs d'erreurs, vu du site (miroir de\n * tools/generator_switch.py).\n *\n * Le bouton « Declencher l'incident » du site publie une erreur dans les topics\n * `otel.*` : c'est un generateur d'erreurs comme les autres, il doit donc\n * respecter le MEME interrupteur. Deux sources, dans cet ordre :\n *\n *   1. la variable d'environnement GENERATORS_ENABLED (0/1)\n *      -> indispensable sur Vercel : le fichier d'etat est sur le poste, il\n *         n'existe pas dans la fonction deployee ;\n *   2. le fichier d'etat de tools/generator_switch.py\n *      -> ~/.local/state/aiven-kafka-demo/generators.json\n *         {\"enabled\": true, \"at\": 1792660000.0, \"by\": \"manuel\", \"reason\": \"...\"}\n *         (GENERATORS_STATE_FILE deplace ce chemin, pour les tests) ;\n *   3. sinon COUPES : meme semantique que le Python, « fichier absent ou\n *      illisible = generateurs coupes », il faut `./tools/generator on`.\n *\n * La variable GENERATORS_ENABLED est prioritaire : c'est le moyen explicite de\n * couper le bouton d'un site deploye sans toucher au poste.\n */\nconst fs = require('fs');\nconst os = require('os');\nconst path = require('path');\n\n// au-dela, le fichier d'etat n'est plus un etat : on le considere illisible\nconst MAX_STATE_BYTES = 64 * 1024;\n\nconst RELAUNCH = './tools/generator on';\n\nfunction stateFile() {\n  if (process.env.GENERATORS_STATE_FILE) return process.env.GENERATORS_STATE_FILE;\n  return path.join(os.homedir(), '.local', 'state', 'aiven-kafka-demo', 'generators.json');\n}\n\n/** true / false, ou null si la valeur n'est pas reconnue (on ignore alors). */\nfunction parseFlag(raw) {\n  if (raw === undefined || raw === null) return null;\n  const text = String(raw).trim().toLowerCase();\n  if (['1', 'true', 'on', 'yes', 'oui', 'actifs', 'active'].includes(text)) return true;\n  if (['0', 'false', 'off', 'no', 'non', 'coupes', 'disabled'].includes(text)) return false;\n  return null;\n}\n\n/** L'etat du fichier, ou null s'il est absent / illisible / hors format. */\nfunction readStateFile() {\n  const file = stateFile();\n  try {\n    const info = fs.statSync(file);\n    if (!info.isFile() || info.size > MAX_STATE_BYTES) return null;\n    const data = JSON.parse(fs.readFileSync(file, 'utf8'));\n    if (!data || typeof data !== 'object' || Array.isArray(data)) return null;\n    return {\n      enabled: Boolean(data.enabled),\n      by: typeof data.by === 'string' ? data.by : '',\n      reason: typeof data.reason === 'string' ? data.reason : '',\n      at: Number(data.at) || 0,\n    };\n  } catch (err) {\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"'use strict';\n/**\n * L'interrupteur des generateurs d'erreurs, vu du site (miroir de\n * tools/generator_switch.py).\n *\n * Le bouton « Declencher l'incident » du site publie une erreur dans les topics\n * `otel.*` : c'est un generateur d'erreurs comme les autres, il doit donc\n * respecter le MEME interrupteur. Deux sources, dans cet ordre :\n *\n *   1. la variable d'environnement GENERATORS_ENABLED (0/1)\n *      -> indispensable sur Vercel : le fichier d'etat est sur le poste, il\n *         n'existe pas dans la fonction deployee ;\n *   2. le fichier d'etat de tools/generator_switch.py\n *      -> ~/.local/state/aiven-kafka-demo/generators.json\n *         {\"enabled\": true, \"at\": 1792660000.0, \"by\": \"manuel\", \"reason\": \"...\"}\n *         (GENERATORS_STATE_FILE deplace ce chemin, pour les tests) ;\n *   3. sinon COUPES : meme semantique que le Python, « fichier absent ou\n *      illisible = generateurs coupes », il faut `./tools/generator on`.\n *\n * La variable GENERATORS_ENABLED est prioritaire : c'est le moyen explicite de\n * couper le bouton d'un site deploye sans toucher au poste.\n */\nconst fs = require('fs');\nconst os = require('os');\nconst path = require('path');\n\n// au-dela, le fichier d'etat n'est plus un etat : on le considere illisible\nconst MAX_STATE_BYTES = 64 * 1024;\n\nconst RELAUNCH = './tools/generator on';\n\nfunction stateFile() {\n  if (process.env.GENERATORS_STATE_FILE) return process.env.GENERATORS_STATE_FILE;\n  return path.join(os.homedir(), '.local', 'state', 'aiven-kafka-demo', 'generators.json');\n}\n\n/** true / false, ou null si la valeur n'est pas reconnue (on ignore alors). */\nfunction parseFlag(raw) {\n  if (raw === undefined || raw === null) return null;\n  const text = String(raw).trim().toLowerCase();\n  if (['1', 'true', 'on', 'yes', 'oui', 'actifs', 'active'].includes(text)) return true;\n  if (['0', 'false', 'off', 'no', 'non', 'coupes', 'disabled'].includes(text)) return false;\n  return null;\n}\n\n/** L'etat du fichier, ou null s'il est absent / illisible / hors format. */\nfunction readStateFile() {\n  const file = stateFile();\n  try {\n    const info = fs.statSync(file);\n    if (!info.isFile() || info.size > MAX_STATE_BYTES) return null;\n    const data = JSON.parse(fs.readFileSync(file, 'utf8'));\n    if (!data || typeof data !== 'object' || Array.isArray(data)) return null;\n    return {\n      enabled: Boolean(data.enabled),\n      by: typeof data.by === 'string' ? data.by : '',\n      reason: typeof data.reason === 'string' ? data.reason : '',\n      at: Number(data.at) || 0,\n    };\n  } catch (err) {\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /home/baptistefaisy/aiven-kafka-demo && sed -n 1,60p site/lib/generators.js\"}"},"time":{"start":1792673555381,"end":1792673555414}}}}
