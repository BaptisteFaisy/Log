erator on pour les relancer\")\n\n    # -- prompt -------------------------------------------------------------\n    def build_prompt(self, incident: Dict[str, Any]) -> str:\n        return build_prompt(incident)\n\n    def make_prompt(self, incident: Dict[str, Any], settings: Dict[str, Any],\n=== site 145-185 ===\n    def api_incident(self, scenario_id: str) -> None:\n        try:\n            catalog = contract.load_catalog()\n            scenario = contract.scenario_by_id(catalog, scenario_id)\n        except contract.ContractError as exc:\n            unknown = \"inconnu\" in str(exc)\n            return self.send_json(400 if unknown else 500, {\n                \"ok\": False,\n                \"error\": \"unknown_scenario\" if unknown else \"catalog_error\",\n                \"hint\": (f\"scenario inconnu : {scenario_id} — la liste est dans \"\n                         \"scenarios/catalog.json\") if unknown else str(exc),\n            })\n        trace_id = contract.new_trace_id()\n        try:\n            messages = build_with_js(scenario[\"id\"], trace_id)\n        except Exception as exc:  # noqa: BLE001\n            return self.send_json(500, {\"ok\": False, \"error\": \"build_error\",\n                                        \"hint\": f\"construction du message impossible : {exc}\"})\n        # L'interrupteur : apres la validation du scenario (un scenario inconnu\n        # reste un 400) et JUSTE AVANT de publier dans Kafka.\n        state = generator_switch.status()\n        if not state[\"enabled\"]:\n            return self.send_json(503, {\n                \"ok\": False,\n                \"error\": \"generators_disabled\",\n                \"hint\": generator_switch.disabled_hint(\"POST /api/incident\", state),\n            })\n        try:\n            publisher = kafkalib.Publisher()\n            count = 0\n            for suffix in (\"traces\", \"logs\", \"metrics\"):\n                for msg in messages.get(suffix, []):\n                    publis