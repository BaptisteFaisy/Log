{"type":"tool_use","timestamp":1792673429656,"sessionID":"ses_e9c5b1e0cffe0hZ6Q4WZhgMv3f","part":{"partID":"prt_163a9b8000015xMOgJq5M4gcL2","sessionID":"ses_e9c5b1e0cffe0hZ6Q4WZhgMv3f","messageID":"msg_163a997ff001soQX2vixSt0UOU","type":"tool","id":"call_00_5X6vhXRjH6ZyUAM1bRCl7994","tool":"shell","state":{"status":"completed","input":{"command":"cd /home/baptistefaisy/aiven-kafka-demo && grep -n \"generator_switch\" seed tools/site-server.py | head; echo \"=== switch.py ===\"; sed -n 1,60p tools/generator_switch.py"},"output":"seed:29:import generator_switch  # noqa: E402\nseed:309:    generator_switch.require_enabled(\"seed\", json_mode=args.json)\ntools/site-server.py:19:l'interrupteur commun (tools/generator_switch.py) JUSTE AVANT de publier.\ntools/site-server.py:42:import generator_switch  # noqa: E402\ntools/site-server.py:165:        state = generator_switch.status()\ntools/site-server.py:170:                \"hint\": generator_switch.disabled_hint(\"POST /api/incident\", state),\n=== switch.py ===\n\"\"\"tools/generator_switch.py — l'interrupteur commun des generateurs d'erreurs.\n\nUn seul etat, partage par TOUS les producteurs d'erreurs (seed,\nemit_incident.py, emit_sql_error.py, emit_db_errors.py, db_fault_probe.py) et\npar le watcher :\n\n    ~/.local/state/aiven-kafka-demo/generators.json\n    {\"enabled\": false, \"at\": 1792660000.0, \"by\": \"kafka-incident-watch\",\n     \"reason\": \"incident 03ee1959 error.type=db_pool_exhausted\"}\n\n- le watcher le COUPE des qu'une erreur arrive dans Kafka ;\n- `./tools/generator on` le RALLUME (aucun generateur n'est supprime) ;\n- fichier absent ou illisible = generateurs COUPES : ils sont coupes par\n  defaut, il faut `./tools/generator on` (ou `run`) pour publier.\n\nUn generateur appelle `require_enabled(\"<nom>\")` AVANT de publier : s'ils sont\ncoupes, il explique pourquoi et comment les relancer, puis sort en code 7\n(EXIT_DISABLED). Les modes hors publication (--list, --dry-run, --self-check...)\nn'ont pas a l'appeler.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\nimport sys\nimport time\nfrom datetime import datetime\nfrom pathlib import Path\nfrom typing import Any, Dict\n\nSTATE_FILE = Path(os.environ.get(\n    \"GENERATORS_STATE_FILE\",\n    str(Path.home() / \".local\" / \"state\" / \"aiven-kafka-demo\" / \"generators.json\")))\n\n# 0 ok / 1 usage / 2 config / 3 Kafka / 4 deja lance : 7 = generateurs coupes\nEXIT_DISABLED = 7\n\n# etat sans fichier (ou fichier illisible) : COUPES par defaut, a la demande\n# de Baptiste. On ne publie une erreur qu'apres un `./tools/generator on`.\nDEFAULT_STATE: Dict[str, Any] = {\"enabled\": False, \"by\": \"defaut\",\n                                 \"reason\": \"aucun etat enregistre\"}\n\n\ndef status() -> Dict[str, Any]:\n    \"\"\"Etat courant : {\"enabled\": bool, \"at\": float, \"by\": str, \"reason\": str}.\"\"\"\n    try:\n        data = json.loads(STATE_FILE.read_text(encoding=\"utf-8\"))\n    except (OSError, ValueError):\n        return dict(DEFAULT_STATE)\n    if not isinstance(data, dict):\n        return dict(DEFAULT_STATE)\n    data[\"enabled\"] = bool(data.get(\"enabled\", False))\n    return data\n\n\ndef is_enabled() -> bool:\n    return status()[\"enabled\"]\n\n\ndef set_enabled(enabled: bool, by: str, reason: str = \"\") -> Dict[str, Any]:\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"seed:29:import generator_switch  # noqa: E402\nseed:309:    generator_switch.require_enabled(\"seed\", json_mode=args.json)\ntools/site-server.py:19:l'interrupteur commun (tools/generator_switch.py) JUSTE AVANT de publier.\ntools/site-server.py:42:import generator_switch  # noqa: E402\ntools/site-server.py:165:        state = generator_switch.status()\ntools/site-server.py:170:                \"hint\": generator_switch.disabled_hint(\"POST /api/incident\", state),\n=== switch.py ===\n\"\"\"tools/generator_switch.py — l'interrupteur commun des generateurs d'erreurs.\n\nUn seul etat, partage par TOUS les producteurs d'erreurs (seed,\nemit_incident.py, emit_sql_error.py, emit_db_errors.py, db_fault_probe.py) et\npar le watcher :\n\n    ~/.local/state/aiven-kafka-demo/generators.json\n    {\"enabled\": false, \"at\": 1792660000.0, \"by\": \"kafka-incident-watch\",\n     \"reason\": \"incident 03ee1959 error.type=db_pool_exhausted\"}\n\n- le watcher le COUPE des qu'une erreur arrive dans Kafka ;\n- `./tools/generator on` le RALLUME (aucun generateur n'est supprime) ;\n- fichier absent ou illisible = generateurs COUPES : ils sont coupes par\n  defaut, il faut `./tools/generator on` (ou `run`) pour publier.\n\nUn generateur appelle `require_enabled(\"<nom>\")` AVANT de publier : s'ils sont\ncoupes, il explique pourquoi et comment les relancer, puis sort en code 7\n(EXIT_DISABLED). Les modes hors publication (--list, --dry-run, --self-check...)\nn'ont pas a l'appeler.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\nimport sys\nimport time\nfrom datetime import datetime\nfrom pathlib import Path\nfrom typing import Any, Dict\n\nSTATE_FILE = Path(os.environ.get(\n    \"GENERATORS_STATE_FILE\",\n    str(Path.home() / \".local\" / \"state\" / \"aiven-kafka-demo\" / \"generators.json\")))\n\n# 0 ok / 1 usage / 2 config / 3 Kafka / 4 deja lance : 7 = generateurs coupes\nEXIT_DISABLED = 7\n\n# etat sans fichier (ou fichier illisible) : COUPES par defaut, a la demande\n# de Baptiste. On ne publie une erreur qu'apres un `./tools/generator on`.\nDEFAULT_STATE: Dict[str, Any] = {\"enabled\": False, \"by\": \"defaut\",\n                                 \"reason\": \"aucun etat enregistre\"}\n\n\ndef status() -> Dict[str, Any]:\n    \"\"\"Etat courant : {\"enabled\": bool, \"at\": float, \"by\": str, \"reason\": str}.\"\"\"\n    try:\n        data = json.loads(STATE_FILE.read_text(encoding=\"utf-8\"))\n    except (OSError, ValueError):\n        return dict(DEFAULT_STATE)\n    if not isinstance(data, dict):\n        return dict(DEFAULT_STATE)\n    data[\"enabled\"] = bool(data.get(\"enabled\", False))\n    return data\n\n\ndef is_enabled() -> bool:\n    return status()[\"enabled\"]\n\n\ndef set_enabled(enabled: bool, by: str, reason: str = \"\") -> Dict[str, Any]:\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /home/baptistefaisy/aiven-kafka-demo && grep -n \\\"generator_switch\\\" seed tools/site-server.py | head; echo \\\"=== switch.py ===\\\"; sed -n 1,60p tools/generator_switch.py\"}"},"time":{"start":1792673429504,"end":1792673429656}}}}
