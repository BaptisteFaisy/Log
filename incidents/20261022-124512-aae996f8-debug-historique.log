\\nfrom pathlib import Path\\n\\nPROJECT_ROOT = Path(__file__).resolve().parent\\nsys.path.insert(0, str(PROJECT_ROOT / \\\"tools\\\"))\\n\\nimport contract  # noqa: E402\\nimport detectors  # noqa: E402\\nimport kafkalib  # noqa: E402\\n\\nEXIT_OK = kafkalib.EXIT_OK\\nEXIT_USAGE = kafkalib.EXIT_USAGE\\nEXIT_CONFIG = kafkalib.EXIT_CONFIG\\nEXIT_KAFKA = kafkalib.EXIT_KAFKA\\n\\n\\ndef read(prefix, suffixes=None, trace_id=None):\\n    return kafkalib.read_messages(prefix=prefix, suffixes=suffixes, trace_id=trace_id)\\n\\n\\ndef collect(data, trace_id=None):\\n    \\\"\\\"\\\"Separe les traces/logs (par TraceId) des metriques (par scenario/profil).\\n\\n    §3 : la table otel.metrics n'a pas de colonne TraceId ; les metriques\\n    sont donc rattachees par couple scenario/profil (§5.4).\\n    \\\"\\\"\\\"\\n    traces = [t for t in data.get(\\\"traces\\\", []) if trace_id is None or t.get(\\\"TraceId\\\") == trace_id]\\n    logs = [l for l in data.get(\\\"logs\\\", []) if trace_id is None or l.get(\\\"TraceId\\\") == trace_id]\\n    scenario = \\\"\\\"\\n    profile = \\\"\\\"\\n    error_type = \\\"\\\"\\n    for span in traces:\\n        attrs = span.get(\\\"SpanAttributes\\\") or {}\\n        scenario = scenario or attrs.get(\\\"agent.scenario\\\", \\\"\\\")\\n        profile = profile or attrs.get(\\\"agent.profile\\\", \\\"\\\")\\n        error_type = error_type or attrs.get(\\\"error.type\\\", \\\"\\\")\\n    for log in logs:\\n        attrs = log.get(\\\"SpanAttributes\\\") or log.get(\\\"LogAttributes\\\") or {}\\n        scenario = scenario or attrs.get(\\\"agent.scenario\\\", \\\"\\\")\\n        profile = profile or attrs.get(\\\"agent.profile\\\", \\\"\\\")\\n        error_type = error_type or attrs.get(\\\"error.type\\\", \\\"\\\")\\n    metrics = []\\n    for metric in data.get(\\\"metrics\\\", []):\\n        attrs = metric.get(\\\"Attributes\\\") or {}\\n        if scenario and attrs.get(\\\"agent.scenario\\\") != scenario:\\n            continue\\n        if profile and attrs.get(\\\"agent.profile\\\") not in (\\\"\\\", profile):\\n            continue\\n        metrics.append(metric)\\n    return traces, logs, metrics, scenario, profile, error_type\\n\\n\\ndef dump_trace(trace_id, prefix, as_json, with_detectors):\\n    data = read(prefix)\\n    traces, logs, metrics, scenario, profile, error_type = collect(data, trace_id)\\n    if not traces and not logs:\\n        msg = f\\\"trace absente : {trace_id}\\\"\\n        if as_json:\\n            print(json.dumps({\\\"ok\\\": False, \\\"error\\\": \\\"trace_absente\\\",\\n                              \\\"trace_id\\\": trace_id, \\\"hint\\\": msg}, ensure_ascii=False))\\n        else:\\n            print(msg, file=sys.stderr)\\n            print(\\\"  -> le trace_id n'existe pas dans les topics (ou le prefixe est faux)\\\",\\n\",\"title\":\"shell\",\"metadata\":{\"metadata\":{\"status\":\"completed\",\"truncated\":false,\"exit\":0},\"content\":[{\"type\":\"text\",\"text\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"trace-dump — la preuve brute (§5.4).\\n\\nUsage :\\n  trace-dump <trace_id>            spans + logs + metriques d'une trace\\n  trace-dump <trace_id> --detectors  + le verdict des 3 detecteurs\\n  trace-dump --list                liste les traces vues dans Kafka\\n  trace-dump --list --json\\n  trace-dump <trace_id> --json\\n\\nCodes de sortie : 0 ok / 1 trace absente ou usage / 2 configuration\\nmanquante / 3 Kafka injoignable.\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport argparse\\nimport json\\nimport sys\\nfrom pathlib import Path\\n\\nPROJECT_ROOT = Path(__file__).resolve().parent\\nsys.path.insert(0, str(PROJECT_ROOT / \\\"tools\\\"))\\n\\nimport contract  # noqa: E402\\nimport detectors  # noqa: E402\\nimport kafkalib  # noqa: E402\\n\\nEXIT_OK = kafkalib.EXIT_OK\\nEXIT_USAGE = kafkalib.EXIT_USAGE\\nEXIT_CONFIG = kafkalib.EXIT_CONFIG\\nEXIT_KAFKA = kafkalib.EXIT_KAFKA\\n\\n\\ndef read(prefix, suffixes=None, trace_id=None):\\n    return kafkalib.read_messages(prefix=prefix, suffixes=suffixes, trace_id=trace_id)\\n\\n\\ndef collect(data, trace_id=None):\\n    \\\"\\\"\\\"Separe les traces/logs (par TraceId) des metriques (par scenario/profil).\\n\\n    §3 : la table otel.metrics n'a pas de colonne TraceId ; les metriques\\n    sont donc rattachees par couple scenario/profil (§5.4).\\n    \\\"\\\"\\\"\\n    traces = [t for t in data.get(\\\"traces\\\", []) if trace_id is None or t.get(\\\"TraceId\\\") == trace_id]\\n    logs = [l for l in data.get(\\\"logs\\\", []) if trace_id is None or l.get(\\\"TraceId\\\") == trace_id]\\n    scenario = \\\"\\\"\\n    profile = \\\"\\\"\\n    error_type = \\\"\\\"\\n    for span in traces:\\n        attrs = span.get(\\\"SpanAttributes\\\") or {}\\n        scenario = scenario or attrs.get(\\\"agent.scenario\\\", \\\"\\\")\\n        profile = profile or attrs.get(\\\"agent.profile\\\", \\\"\\\")\\n        error_type = error_type or attrs.get(\\\"error.type\\\", \\\"\\\")\\n    for log in logs:\\n        attrs = log.get(\\\"SpanAttributes\\\") or log.get(\\\"LogAttributes\\\") or {}\\n        scenario = scenario or attrs.get(\\\"agent.scenario\\\", \\\"\\\")\\n        profile = profile or attrs.get(\\\"agent.profile\\\", \\\"\\\")\\n        error_type = error_type or attrs.get(\\\"error.type\\\", \\\"\\\")\\n    metrics = []\\n    for metric in data.get(\\\"metrics\\\", []):\\n        attrs = metric.get(\\\"Attributes\\\") or {}\\n        if scenario and attrs.get(\\\"agent.scenario\\\") != scenario:\\n            continue\\n        if profile and attrs.get(\\\"agent.profile\\\") not in (\\\"\\\", profile):\\n            continue\\n        metrics.append(metric)\\n    return traces, logs, metrics, scenario, profile, error_type\\n\\n\\ndef dump_trace(trace_id, prefix, as_json, with_detectors):\\n    data = read(prefix)\\n    traces, logs, metrics, scenario, profile, error_type = collect(data, trace_id)\\n    if not traces and not logs:\\n        msg = f\\\"trace absente : {trace_id}\\\"\\n        if as_json:\\n            print(json.dumps({\\\"ok\\\": False, \\\"error\\\": \\\"trace_absente\\\",\\n                              \\\"trace_id\\\": trace_id, \\\"hint\\\": msg}, ensure_ascii=False))\\n        else:\\n            print(msg, file=sys.stderr)\\n            print(\\\"  -> le trace_id n'existe pas dans les topics (ou le prefixe est faux)\\\",\\n\"}],\"providerCall\":{\"executed\":false},\"providerResult\":{\"executed\":false},\"rawInput\":\"{\\\"command\\\": \\\"cd /home/baptistefaisy/aiven-kafka-demo && sed -n 1,80p trace-dump\\\"}\"},\"time\":{\"start\":1792673225723,\"end\":1792673225795}}}}\n{\"type\":\"tool_use\",\"timestamp\":1792673225805,\"sessionID\":\"ses_e9c5b1e0cffe0hZ6Q4WZhgMv3f\",\"part\":{\"partID\":\"prt_163a69c010012TOZ5CgNpertRT\",\"sessionID\":\"ses_e9c5b1e0cffe0hZ6Q4WZhgMv3f\",\"messageID\":\"msg_163a67a96001WbHSmtd4txbEtN\",\"type\":\"tool\",\"id\":\"call_01_Jn2Zp3nFWFjkdPtbeMDa4474\",\"tool\":\"shell\",\"state\":{\"status\":\"completed\",\"input\":{\"command\":\"cd /home/baptistefaisy/aiven-kafka-demo && sed -n 1,80p tools/emit_incident.py\"},\"output\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"tools/emit_incident.py — repli local de la console web (§6.1).\\n\\nSi le deploiement Vercel echoue, la demo continue : cet outil publie la meme\\ntrace que le bouton du site (meme contrat §3, meme catalogue).\\n\\nUsage :\\n  ./tools/emit_incident.py --scenario <id> [--prefix P] [--json]\\n  ./tools/emit_incident.py --list\\n\\nCodes de sortie : 0 ok / 1 usage / 2 configuration manquante /\\n3 Kafka injoignable / 7 generateurs d'erreurs coupes (./tools/generator on).\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport argparse\\nimport json\\nimport sys\\nfrom pathlib import Path\\n\\nHERE = Path(__file__).resolve().parent\\nPROJECT_ROOT = HERE.parent\\nsys.path.insert(0, str(HERE))\\n\\nimport contract  # noqa: E402\\nimport generator_switch  # noqa: E402\\nimport kafkalib  # noqa: E402\\n\\nEXIT_OK = kafkalib.EXIT_OK\\nEXIT_USAGE = kafkalib.EXIT_USAGE\\nEXIT_CONFIG = kafkalib.EXIT_CONFIG\\nEXIT_KAFKA = kafkalib.EXIT_KAFKA\\n\\n\\ndef main(argv=None):\\n    parser = argparse.ArgumentParser(\\n        prog=\\\"emit_incident.py\\\",\\n        description=\\\"publie une panne reelle dans Kafka (repli local du site)\\\")\\n    parser.add_argument(\\\"--scenario\\\", help=\\\"identifiant du scenario (cf. scenarios/catalog.json)\\\")\\n    parser.add_argument(\\\"--prefix\\\", help=\\\"prefixe de topics\\\")\\n    parser.add_argument(\\\"--list\\\", action=\\\"store_true\\\", help=\\\"liste les scenarios disponibles\\\")\\n    parser.add_argument(\\\"--json\\\", action=\\\"store_true\\\", help=\\\"sortie JSON\\\")\\n    args = parser.parse_args(argv)\\n\\n    # Re-execution dans le venv dedie avant toute sortie (§0.6)\\n    kafkalib.ensure_kafka_interpreter()\\n\\n    try:\\n        catalog = contract.load_catalog()\\n    except contract.ContractError as exc:\\n        print(f\\\"ERREUR : {exc}\\\", file=sys.stderr)\\n        return EXIT_CONFIG\\n\\n    if args.list:\\n        rows = contract.all_scenarios(catalog)\\n        if args.json:\\n            print(json.dumps([{\\\"id\\\": r[\\\"id\\\"], \\\"label\\\": r.get(\\\"label\\\"),\\n                               \\\"error_type\\\": r.get(\\\"error_type\\\")} for r in rows],\\n                             indent=2, ensure_ascii=False))\\n        else:\\n            for r in rows:\\n                print(f\\\"{r['id']:32s} {r.get('label', '')}\\\")\\n        return EXIT_OK\\n\\n    if not args.scenario:\\n        parser.print_usage(sys.stderr)\\n        print(\\\"ERREUR : --scenario <id> est obligatoire (voir --list)\\\", file=sys.stderr)\\n        return EXIT_USAGE\\n\\n    try:\\n        scenario = contract.scenario_by_id(catalog, args.scenario)\\n    except contract.ContractError as exc:\\n        print(f\\\"ERREUR : {exc}\\\", file=sys.stderr)\\n        return EXIT_USAGE\\n\\n    trace_id = contract.new_trace_id()\\n    messages = contract.build_messages(catalog, scenario, trace_id=trace_id)\\n\\n    # Interrupteur commun des generateurs : --list reste libre.\\n    generator_switch.require_enabled(\\\"emit_incident.py\\\", json_mode=args.json)\\n\",\"title\":\"shell\",\"metadata\":{\"metadata\":{\"status\":\"completed\",\"truncated\":false,\"exit\":0},\"content\":[{\"type\":\"text\",\"text\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"tools/emit_incident.py — repli local de la console web (§6.1).\\n\\nSi le deploiement Vercel echoue, la demo continue : cet outil publie la meme\\ntrace que le bouton du site (meme contrat §3, meme catalogue).\\n\\nUsage :\\n  ./tools/emit_incident.py --scenario <id> [--prefix P] [--json]\\n  ./tools/emit_incident.py --list\\n\\nCodes de sortie : 0 ok / 1 usage / 2 configuration manquante /\\n3 Kafka injoignable / 7 generateurs d'erreurs coupes (./tools/generator on).\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport argparse\\nimport json\\nimport sys\\nfrom pathlib import Path\\n\\nHERE = Path(__file__).resolve().parent\\nPROJECT_ROOT = HERE.parent\\nsys.path.insert(0, str(HERE))\\n\\nimport contract  # noqa: E402\\nimport generator_switch  # noqa: E402\\nimport kafkalib  # noqa: E402\\n\\nEXIT_OK = kafkalib.EXIT_OK\\nEXIT_USAGE = kafkalib.EXIT_USAGE\\nEXIT_CONFIG = kafkalib.EXIT_CONFIG\\nEXIT_KAFKA = kafkalib.EXIT_KAFKA\\n\\n\\ndef main(argv=None):\\n    parser = argparse.ArgumentParser(\\n        prog=\\\"emit_incident.py\\\",\\n        description=\\\"publie une panne reelle dans Kafka (repli local du site)\\\")\\n    parser.add_argument(\\\"--scenario\\\", help=\\\"identifiant du scenario (cf. scenarios/catalog.json)\\\")\\n    parser.add_argument(\\\"--prefix\\\", help=\\\"prefixe de topics\\\")\\n    parser.add_argument(\\\"--list\\\", action=\\\"store_true\\\", help=\\\"liste les scenarios disponibles\\\")\\n    parser.add_argument(\\\"--json\\\", action=\\\"store_true\\\", help=\\\"sortie JSON\\\")\\n    args = parser.parse_args(argv)\\n\\n    # Re-execution dans le venv dedie avant toute sortie (§0.6)\\n    kafkalib.ensure_kafka_interpreter()\\n\\n    try:\\n        catalog = contract.load_catalog()\\n    except contract.ContractError as exc:\\n        print(f\\\"ERREUR : {exc}\\\", file=sys.stderr)\\n        return EXIT_CONFIG\\n\\n    if args.list:\\n        rows = contract.all_scenarios(catalog)\\n        if args.json:\\n            print(json.dumps([{\\\"id\\\": r[\\\"id\\\"], \\\"label\\\": r.get(\\\"label\\\"),\\n                               \\\"error_type\\\": r.get(\\\"error_type\\\")} for r in rows],\\n                             indent=2, ensure_ascii=False))\\n        else:\\n            for r in rows:\\n                print(f\\\"{r['id']:32s} {r.get('label', '')}\\\")\\n        return EXIT_OK\\n\\n    if not args.scenario:\\n        parser.print_usage(sys.stderr)\\n        print(\\\"ERREUR : --scenario <id> est obligatoire (voir --list)\\\", file=sys.stderr)\\n        return EXIT_USAGE\\n\\n    try:\\n        scenario = contract.scenario_by_id(catalog, args.scenario)\\n    except contract.ContractError as exc:\\n        print(f\\\"ERREUR : {exc}\\\", file=sys.stderr)\\n        return EXIT_USAGE\\n\\n    trace_id = contract.new_trace_id()\\n    messages = contract.build_messages(catalog, scenario, trace_id=trace_id)\\n\\n    # Interrupteur commun des generateurs : --list reste libre.\\n    generator_switch.require_enabled(\\\"emit_incident.py\\\", json_mode=args.json)\\n\"}],\"providerCall\":{\"executed\":false},\"providerResult\":{\"executed\":false},\"rawInput\":\"{\\\"command\\\": \\\"cd /home/baptistefaisy/aiven-kafka-demo && sed -n 1,80p tools/emit_incident.py\\\"}\"},\"time\":{\"start\":1792673225729,\"end\":1792673225805}}}}\n{\"type\":\"step_finish\",\"timestamp\":1792673225810,\"sessionID\":\"ses_e9c5b1e0cffe0hZ6Q4WZhgMv3f\",\"part\":{\"id\":\"prt_163a69c520019SlbRzR11czsec\",\"sessionID\":\"ses_e9c5b1e0cffe0hZ6Q4WZhgMv3f\",\"messageID\":\"msg_163a67a96001Wb