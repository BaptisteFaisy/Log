{"type":"tool_use","timestamp":1792673338934,"sessionID":"ses_e9c5b1e0cffe0hZ6Q4WZhgMv3f","part":{"partID":"prt_163a85607001CmP4PYFcYBPFjn","sessionID":"ses_e9c5b1e0cffe0hZ6Q4WZhgMv3f","messageID":"msg_163a831930011oAgGb3AwbH609","type":"tool","id":"call_00_fmEzrJbYTPmGM7c7y8GL5971","tool":"shell","state":{"status":"completed","input":{"command":"cd /home/baptistefaisy/aiven-kafka-demo && sed -n 697,760p tools/kafka-incident-watch"},"output":"class State:\n    DEFAULTS: Dict[str, Any] = {\n        \"incarnations\": {},\n        \"handled_traces\": {},\n        \"error_cooldowns\": {},\n        \"hour_buckets\": {},\n        \"queue\": [],\n    }\n\n    def __init__(self, path: Path):\n        self.path = path\n        # RLock : save() est appele aussi depuis des sections deja verrouillees\n        self.lock = threading.RLock()\n        self.data: Dict[str, Any] = {k: type(v)() for k, v in self.DEFAULTS.items()}\n        self.load()\n\n    def load(self) -> None:\n        if not self.path.exists():\n            return\n        try:\n            loaded = json.loads(self.path.read_text(encoding=\"utf-8\"))\n        except (OSError, ValueError) as exc:\n            log(f\"etat illisible ({self.path} : {exc}) : on repart d'un etat vide\")\n            return\n        if not isinstance(loaded, dict):\n            log(f\"etat inattendu ({self.path} n'est pas un objet JSON) : on repart d'un etat vide\")\n            return\n        for key, default in self.DEFAULTS.items():\n            if key in loaded and not isinstance(loaded[key], type(default)):\n                log(f\"etat : champ '{key}' de type inattendu, remis a zero\")\n                loaded[key] = type(default)()\n        self.data.update(loaded)\n\n    def save(self) -> None:\n        with self.lock:\n            try:\n                self.path.parent.mkdir(parents=True, exist_ok=True)\n                tmp = self.path.with_suffix(\".tmp\")\n                tmp.write_text(json.dumps(self.data, indent=2, ensure_ascii=False),\n                               encoding=\"utf-8\")\n                tmp.replace(self.path)\n            except (OSError, TypeError, ValueError) as exc:\n                log(f\"impossible d'ecrire l'etat ({self.path} : {exc}) -> verifie l'espace disque \"\n                    \"et les droits ; le watcher continue en memoire\")\n\n\n# --------------------------------------------------------------------------\n# le watcher\n# --------------------------------------------------------------------------\ndef build_report_payload(incident: Dict[str, Any], report: str, code: Optional[int],\n                         session_id: str, identity: Dict[str, Any]) -> Dict[str, Any]:\n    \"\"\"Charge utile publiee dans <prefix>-reports (fonction pure : testable).\n\n    Les champs d'identification sont TOUJOURS presents, meme vides : un\n    consommateur ne doit pas avoir a distinguer « cle absente » (vieux rapport)\n    de « valeur inconnue » (agent hors manifeste). Le rapport reste publiable\n    dans les deux cas : l'identification ne doit jamais bloquer un incident.\n    \"\"\"\n    payload: Dict[str, Any] = {\n        \"Timestamp\": datetime.now(timezone.utc).strftime(\"%Y-%m-%d %H:%M:%S.%f\")[:-3],\n        \"TraceId\": incident[\"trace_id\"],\n        \"agent\": incident[\"agent\"],\n        \"error_type\": incident[\"error_type\"],\n        \"scenario\": (incident.get(\"attributes\") or {}).get(\"agent.scenario\", \"\"),\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"class State:\n    DEFAULTS: Dict[str, Any] = {\n        \"incarnations\": {},\n        \"handled_traces\": {},\n        \"error_cooldowns\": {},\n        \"hour_buckets\": {},\n        \"queue\": [],\n    }\n\n    def __init__(self, path: Path):\n        self.path = path\n        # RLock : save() est appele aussi depuis des sections deja verrouillees\n        self.lock = threading.RLock()\n        self.data: Dict[str, Any] = {k: type(v)() for k, v in self.DEFAULTS.items()}\n        self.load()\n\n    def load(self) -> None:\n        if not self.path.exists():\n            return\n        try:\n            loaded = json.loads(self.path.read_text(encoding=\"utf-8\"))\n        except (OSError, ValueError) as exc:\n            log(f\"etat illisible ({self.path} : {exc}) : on repart d'un etat vide\")\n            return\n        if not isinstance(loaded, dict):\n            log(f\"etat inattendu ({self.path} n'est pas un objet JSON) : on repart d'un etat vide\")\n            return\n        for key, default in self.DEFAULTS.items():\n            if key in loaded and not isinstance(loaded[key], type(default)):\n                log(f\"etat : champ '{key}' de type inattendu, remis a zero\")\n                loaded[key] = type(default)()\n        self.data.update(loaded)\n\n    def save(self) -> None:\n        with self.lock:\n            try:\n                self.path.parent.mkdir(parents=True, exist_ok=True)\n                tmp = self.path.with_suffix(\".tmp\")\n                tmp.write_text(json.dumps(self.data, indent=2, ensure_ascii=False),\n                               encoding=\"utf-8\")\n                tmp.replace(self.path)\n            except (OSError, TypeError, ValueError) as exc:\n                log(f\"impossible d'ecrire l'etat ({self.path} : {exc}) -> verifie l'espace disque \"\n                    \"et les droits ; le watcher continue en memoire\")\n\n\n# --------------------------------------------------------------------------\n# le watcher\n# --------------------------------------------------------------------------\ndef build_report_payload(incident: Dict[str, Any], report: str, code: Optional[int],\n                         session_id: str, identity: Dict[str, Any]) -> Dict[str, Any]:\n    \"\"\"Charge utile publiee dans <prefix>-reports (fonction pure : testable).\n\n    Les champs d'identification sont TOUJOURS presents, meme vides : un\n    consommateur ne doit pas avoir a distinguer « cle absente » (vieux rapport)\n    de « valeur inconnue » (agent hors manifeste). Le rapport reste publiable\n    dans les deux cas : l'identification ne doit jamais bloquer un incident.\n    \"\"\"\n    payload: Dict[str, Any] = {\n        \"Timestamp\": datetime.now(timezone.utc).strftime(\"%Y-%m-%d %H:%M:%S.%f\")[:-3],\n        \"TraceId\": incident[\"trace_id\"],\n        \"agent\": incident[\"agent\"],\n        \"error_type\": incident[\"error_type\"],\n        \"scenario\": (incident.get(\"attributes\") or {}).get(\"agent.scenario\", \"\"),\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /home/baptistefaisy/aiven-kafka-demo && sed -n 697,760p tools/kafka-incident-watch\"}"},"time":{"start":1792673338887,"end":1792673338934}}}}
