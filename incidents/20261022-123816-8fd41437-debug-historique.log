s\nfrom pathlib import Path\n\nHERE = Path(__file__).resolve().parent\nsys.path.insert(0, str(HERE))\n\nimport kafkalib  # noqa: E402\nfrom emit_sql_error import build_pg_env  # noqa: E402\n\nEXIT_OK = kafkalib.EXIT_OK\nEXIT_USAGE = kafkalib.EXIT_USAGE\nEXIT_CONFIG = kafkalib.EXIT_CONFIG\nEXIT_REFUSED = 3\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"__pycache__\ncheck.sh\ncontract-check\ncontract.py\ndb_fault_probe.py\ndbprobe.py\ndebug-bundle\ndebug-selftest\ndedup-selftest\ndetectors.py\nemit_db_errors.py\nemit_incident.py\nemit_sql_error.py\ngenerator\ngenerator_switch.py\nkafka-incident-watch\nkafka-incident-watch.service\nkafka-migrate\nkafkalib.py\npatch-new\npatch-validate\npg-diag\npreflight\nprobe_bootstrap.py\nschema-check\nsite-server.py\nsync-log-site-group.sh\nsync-site-catalog.sh\nsync-site-group.sh\nvenv.sh\n=== pg-diag ===\n#!/usr/bin/env python3\n\"\"\"tools/pg-diag — diagnostic PostgreSQL en LECTURE SEULE, sans secret.\n\nSert aux agents (db-diagnose) quand ils doivent aller voir la base reelle\npour conclure, sans qu'un mot de passe apparaisse ni dans la commande ni\ndans le rapport (le rapport est republie dans Kafka, puis dans un depot\npublic).\n\nUsage :\n  ./tools/pg-diag \"SELECT state, count(*) FROM pg_stat_activity GROUP BY 1\"\n  ./tools/pg-diag --db-url <url> \"<requete>\"\n\nSecurite :\n  - la session est ouverte en `default_transaction_read_only = on` :\n    PostgreSQL refuse toute ecriture, meme si la requete est malveillante ;\n  - seules les requetes de lecture sont acceptees (SELECT / SHOW / EXPLAIN /\n    WITH / VALUES / TABLE) ;\n  - le mot de passe vient de `.secrets/creds.env` et n'est jamais affiche.\n\nCodes de sortie : 0 ok / 1 usage / 2 configuration manquante / 3 requete refusee.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport os\nimport re\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nHERE = Path(__file__)