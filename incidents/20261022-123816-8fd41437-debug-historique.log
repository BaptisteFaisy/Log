blished\n\n\ndef export_all(built, out_dir: Path):\n    out_dir.mkdir(parents=True, exist_ok=True)\n    files = {}\n    for suffix in (\"traces\", \"logs\", \"metrics\"):\n        path = out_dir / f\"{suffix}.jsonl\"\n        with path.open(\"w\", encoding=\"utf-8\") as fh:\n            for sc, _trace_id, messages in built:\n                for msg in messages.get(suffix, []):\n                    fh.write(contract.dumps(msg) + \"\\n\")\n        files[suffix] = str(path)\n    return files\n\n\n# --------------------------------------------------------------------------\n# self-check\n# --------------------------------------------------------------------------\ndef live_check(catalog):\n    \"\"\"Verifie les runs du catalogue presents dans Kafka (§9.2).\n\n    Le topics peuvent contenir des traces d'autres producteurs (la mission\n    PostgreSQL, §12bis du README) : on verifie donc que les runs du\n    CATALOGUE sont exactement les 5 error.type de plateforme + le run nominal,\n    et on signale les autres sans les compter comme une erreur.\n    \"\"\"\n    expected = {s[\"id\"]: s.get(\"error_type\") for s in catalog.get(\"scenarios\", [])}\n    data = kafkalib.read_messages(suffixes=[\"traces\"])\n    mine, others = {}, {}\n    for span in data.get(\"traces\", []):\n        attrs = span.get(\"SpanAttributes\") or {}\n        scenario = attrs.get(\"agent.scenario\", \"\")\n        error_type = attrs.get(\"error.type\")\n        if scenario in expected:\n            mine.setdefault(scenario, set()).add(error_type)\n        else:\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"#!/usr/bin/env python3\n\"\"\"seed — generateur de logs (5 pannes de plateforme + 1 run nominal).\n\nUsage :\n  seed                      publie les 6 scenarios du catalogue\n  seed --emit <id>          publie un seul scenario (= un bouton du site)\n  seed --list               liste les scenarios du catalogue\n  seed --