-c 3000 scenarios/catalog.json; echo; echo '=== api/incident.js ==='; cat api/incident.js\",\"timeout\":60000},\"output\":\"=== scenarios/catalog.json (extrait) ===\\n{\\n  \\\"version\\\": 1,\\n  \\\"description\\\": \\\"Source unique des scenarios. Lue par seed, par trace-dump, par la console web (index.html + assets/app.js) et par l'API (api/incident.js). Aucun scenario n'est reecrit a la main ailleurs.\\\",\\n  \\\"service\\\": {\\n    \\\"name\\\": \\\"agent-demo\\\",\\n    \\\"scope_name\\\": \\\"agent\\\",\\n    \\\"scope_version\\\": \\\"1.0\\\",\\n    \\\"resource_attributes\\\": {\\n      \\\"service.name\\\": \\\"agent-demo\\\",\\n      \\\"deployment.environment\\\": \\\"demo\\\"\\n    }\\n  },\\n  \\\"base_timestamp\\\": \\\"2026-10-21 18:02:18.799\\\",\\n  \\\"contract\\\": {\\n    \\\"trace_key\\\": \\\"TraceId\\\",\\n    \\\"trace_topic_suffix\\\": \\\"traces\\\",\\n    \\\"log_topic_suffix\\\": \\\"logs\\\",\\n    \\\"metric_topic_suffix\\\": \\\"metrics\\\",\\n    \\\"timestamp_format\\\": \\\"YYYY-MM-DD HH:MM:SS.mmm\\\",\\n    \\\"duration_unit\\\": \\\"nanoseconds\\\",\\n    \\\"placeholders\\\": [\\\"{{trace_id}}\\\", \\\"{{span_id:<span_name>}}\\\"]\\n  },\\n  \\\"scenarios\\\": [\\n    {\\n      \\\"id\\\": \\\"platform_db_pool_exhausted\\\",\\n      \\\"label\\\": \\\"Pool de connexions PostgreSQL sature\\\",\\n      \\\"kind\\\": \\\"panne\\\",\\n      \\\"error_type\\\": \\\"db_pool_exhausted\\\",\\n      \\\"profile\\\": \\\"infra\\\",\\n      \\\"severity\\\": \\\"ERROR\\\",\\n      \\\"severity_number\\\": 17,\\n      \\\"log_body\\\": \\\"Database connection pool exhausted (20/20 in use, 0 available)\\\",\\n      \\\"exception_message\\\": \\\"com.zaxxer.hikari.pool.HikariPool$PoolInitializationException: Database connection pool exhausted (20/20 in use, 0 available)\\\",\\n      \\\"agent_result\\\": \\\"{\\\\\\\"success\\\\\\\":false,\\\\\\\"booking_confirmed\\\\\\\":false,\\\\\\\"tool_confirmed\\\\\\\":false,\\\\\\\"tool_calls\\\\\\\":4}\\\",\\n      \\\"spans\\\": [\\n        {\\n          \\\"name\\\": \\\"agent.run\\\",\\n          \\\"parent\\\": null,\\n          \\\"kind\\\": \\\"SPAN_KIND_INTERNAL\\\",\\n          \\\"offset_ms\\\": 0,\\n          \\\"duration_ms\\\": 1600,\\n          \\\"status\\\": \\\"Error\\\",\\n          \\\"attributes\\\": {\\n            \\\"error.type\\\": \\\"db_pool_exhausted\\\",\\n            \\\"exception.message\\\": \\\"com.zaxxer.hikari.pool.HikariPool$PoolInitializationException: Database connection pool exhausted (20/20 in use, 0 available)\\\",\\n            \\\"http.response.status_code\\\": \\\"500\\\",\\n            \\\"db.system\\\": \\\"postgresql\\\",\\n            \\\"db.connection_pool.name\\\": \\\"HikariPool-1\\\",\\n            \\\"db.connection_pool.active\\\": \\\"20\\\",\\n            \\\"db.connection_pool.idle\\\": \\\"0\\\",\\n            \\\"db.connection_pool.max\\\": \\\"20\\\"\\n          }\\n        },\\n        {\\n          \\\"name\\\": \\\"tool.check_reservation\\\",\\n          \\\"parent\\\": \\\"agent.run\\\",\\n          \\\"kind\\\": \\\"SPAN_KIND_INTERNAL\\\",\\n          \\\"offset_ms\\\": 120,\\n          \\\"duration_ms\\\": 380,\\n          \\\"status\\\": \\\"Error\\\",\\n          \\\"attributes\\\": {\\n            \\\"http.response.status_code\\\": \\\"500\\\",\\n            \\\"db.system\\\": \\\"postgresql\\\",\\n            \\\"db.connection_pool.name\\\": \\\"HikariPool-1\\\",\\n            \\\"db.connection_pool.active\\\": \\\"20\\\",\\n            \\\"db.connection_pool.idle\\\": \\\"0\\\",\\n            \\\"db.connection_pool.max\\\": \\\"20\\\"\\n          }\\n        },\\n        {\\n          \\\"name\\\": \\\"tool.check_reservation\\\",\\n          \\\"parent\\\": \\\"agent.run\\\",\\n          \\\"kind\\\": \\\"SPAN_KIND_INTERNAL\\\",\\n          \\\"offset_ms\\\": 520,\\n          \\\"duration_ms\\\": 380,\\n          \\\"status\\\": \\\"Error\\\",\\n          \\\"attributes\\\": {\\n            \\\"http.response.status_code\\\": \\\"500\\\",\\n            \\\"db.sy\\n=== api/incident.js ===\\n'use strict';\\n/**\\n * POST /api/incident  {\\\"scenario\\\":\\\"<id>\\\"}  ->  {\\\"ok\\\":true,\\\"trace_id\\\":\\\"<32 hex>\\\"}\\n *\\n *   scenario inconnu  -> 400 {\\\"ok\\\":false,\\\"error\\\":\\\"unknown_scenario\\\",\\\"hint\\\":\\\"...\\\"}\\n *   Kafka injoignable -> 503 {\\\"ok\\\":false,\\\"error\\\":\\\"kafka_unreachable\\\",\\\"hint\\\":\\\"...\\\"}\\n *   generateurs coupes -> 503 {\\\"ok\\\":false,\\\"error\\\":\\\"generators_disabled\\\",\\\"hint\\\":\\\"...\\\"}\\n *\\n * Ce point d'entree publie dans `otel.*` : c'est un generateur d'erreurs, il\\n * respecte donc l'interrupteur commun (site/lib/generators.js) JUSTE AVANT de\\n * publier. Coupe, il ne publie rien et ne renvoie ni error_type ni messages.\\n *\\n * Jamais de stack trace dans la reponse.\\n */\\nconst { loadCatalog, scenarioById, buildMessages, newTraceId } = require('../lib/contract.js');\\nconst { publish, publicReason, KafkaConfigError } = require('../lib/kafka.js');\\nconst generators = require('../lib/generators.js');\\n\\nfunction json(res, code, payload) {\\n  res.statusCode = code;\\n  res.setHeader('Content-Type', 'application/json; charset=utf-8');\\n  res.setHeader('Cache-Control', 'no-store');\\n  res.end(JSON.stringify(payload));\\n}\\n\\nmodule.exports = async function handler(req, res) {\\n  if (req.method !== 'POST') {\\n    return json(res, 405, {\\n      ok: false,\\n      error: 'method_not_allowed',\\n      hint: \\\"utilise POST /api/incident avec {\\\\\\\"scenario\\\\\\\":\\\\\\\"<id>\\\\\\\"}\\\",\\n    });\\n  }\\n\\n  // Sur Vercel, `req.body` est evalue a la demande et LEVE une erreur si le JSON\\n  // est invalide (le runtime repondrait alors 400 avec un corps vide, hors JSON).\\n  let body = null;\\n  try {\\n    body = req.body;\\n  } catch (err) {\\n    body = null;\\n  }\\n  if (typeof body === 'string') {\\n    try {\\n      body = JSON.parse(body || '{}');\\n    } catch (err) {\\n      body = null;\\n    }\\n  }\\n  if (!body || typeof body !== 'object' || !body.scenario) {\\n    return json(res, 400, {\\n      ok: false,\\n      error: 'bad_request',\\n      hint: 'corps attendu : {\\\"scenario\\\":\\\"<identifiant du scenario>\\\"}',\\n    });\\n  }\\n\\n  let scenario;\\n  let messages;\\n  let traceId;\\n  try {\\n    const catalog = loadCatalog();\\n    scenario = scenarioById(catalog, body.scenario, false);\\n    traceId = newTraceId();\\n    messages = buildMessages(catalog, scenario, traceId);\\n  } catch (err) {\\n    const unknown = /scenario inconnu/.test(err.message || '');\\n    return json(res, unknown ? 400 : 500, {\\n      ok: false,\\n      error: unknown ? 'unknown_scenario' : 'catalog_error',\\n      hint: unknown\\n        ? `scenario inconnu : ${body.scenario} — consulte /scenarios/catalog.json pour la liste`\\n        : 'catalogue des scenarios illisible',\\n    });\\n  }\\n\\n  // L'interrupteur : on le consulte APRES la validation du scenario (un\\n  // scenario inconnu doit rester un 400) et AVANT toute publication.\\n  const generatorState = generators.status();\\n  if (!generatorState.enabled) {\\n    return json(res, 503, {\\n      ok: false,\\n      error: 'generators_disabled',\\n      hint: generators.disabledHint('POST /api/incident', generatorState),\\n    });\\n  }\\n\\n  const bySuffix = {};\\n  let count = 0;\\n  for (const suffix of ['traces', 'logs', 'metrics']) {\\n    const list = [];\\n    for (const msg of messages[suffix] || []) {\\n      list.push({ key: msg.TraceId || traceId, value: JSON.stringify(msg) });\\n      count += 1;\\n    }\\n    if (list.length) bySuffix[suffix] = list;\\n  }\\n\\n  try {\\n    await publish(bySuffix, 15000);\\n  } catch (err) {\\n    const config = err instanceof KafkaConfigError;\\n    // le detail brut (adresse du broker...) reste dans les journaux serveur\\n    process.stderr.write(`api/incident : ${err.message}\\\\n`);\\n    return json(res, config ? 500 : 503, {\\n      ok: false,\\n      error: config ? 'config_error' : 'kafka_unreachable',\\n      hint: config\\n        ? `configuration Kafka incomplete cote serveur : ${err.message}`\\n        : `Kafka injoignable (${publicReason(err)}) — le cluster est-il demarre ? Reessaye dans un instant.`,\\n    });\\n  }\\n\\n  return json(res, 200, {\\n    ok: true,\\n    trace_id: traceId,\\n    scenario: scenario.id,\\n    error_type: scenario.error_type || null,\\n    messages: count,\\n  });\\n};\\n\",\"title\":\"shell\",\"metadata\":{\"metadata\":{\"status\":\"completed\",\"truncated\":false,\"exit\":0},\"content\":[{\"type\":\"text\",\"text\":\"=== scenarios/catalog.json (extrait) ===\\n{\\n  \\\"version\\\": 1,\\n  \\\"description\\\": \\\"Source unique des scenarios. Lue par seed, par trace-dump, par la console web (index.html + assets/app.js) et par l'API (api/incident.js). Aucun scenario n'est reecrit a la main ailleurs.\\\",\\n  \\\"service\\\": {\\n    \\\"name\\\": \\\"agent-demo\\\",\\n    \\\"scope_name\\\": \\\"agent\\\",\\n    \\\"scope_version\\\": \\\"1.0\\\",\\n    \\\"resource_attributes\\\": {\\n      \\\"service.name\\\": \\\"agent-demo\\\",\\n      \\\"deployment.environment\\\": \\\"demo\\\"\\n    }\\n  },\\n  \\\"base_timestamp\\\": \\\"2026-10-21 18:02:18.799\\\",\\n  \\\"contract\\\": {\\n    \\\"trace_key\\\": \\\"TraceId\\\",\\n    \\\"trace_topic_suffix\\\": \\\"traces\\\",\\n    \\\"log_topic_suffix\\\": \\\"logs\\\",\\n    \\\"metric_topic_suffix\\\": \\\"metrics\\\",\\n    \\\"timestamp_format\\\": \\\"YYYY-MM-DD HH:MM:SS.mmm\\\",\\n    \\\"duration_unit\\\": \\\"nanoseconds\\\",\\n    \\\"placeholders\\\": [\\\"{{trace_id}}\\\", \\\"{{span_id:<span_name>}}\\\"]\\n  },\\n  \\\"scenarios\\\": [\\n    {\\n      \\\"id\\\": \\\"platform_db_pool_exhausted\\\",\\n      \\\"label\\\": \\\"Pool de connexions PostgreSQL sature\\\",\\n      \\\"kind\\\": \\\"panne\\\",\\n      \\\"error_type\\\": \\\"db_pool_exhausted\\\",\\n   