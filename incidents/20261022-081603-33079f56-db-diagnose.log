{"type":"tool_use","timestamp":1792657035722,"sessionID":"ses_e9d51892effexO289ry4SGSziy","part":{"partID":"prt_162af78fe001IX8OYrbGlMhQD1","sessionID":"ses_e9d51892effexO289ry4SGSziy","messageID":"msg_162af6c39001zN6GFYckQGMZo9","type":"tool","id":"call_00_FuQgPB7q52kvbtjaI2j98761","tool":"shell","state":{"status":"completed","input":{"command":"cd /home/baptistefaisy/aiven-kafka-demo; set -a; . ./.secrets/pg-erreurs.env 2>/dev/null; set +a; psql \"${PGURL:-$DATABASE_URL}\" -At -c \"select state, count(*) from pg_stat_activity where datname=current_database() group by 1 order by 2 desc;\" -c \"select count(*) filter (where wait_event_type='Lock') as en_attente_lock, count(*) as total from pg_stat_activity where datname=current_database();\" -c \"show lock_timeout;\" -c \"show max_connections;\" 2>&1 | tail -20","workdir":"/home/baptistefaisy/aiven-kafka-demo","timeout":30000},"output":"active|1\n|1\n0|2\n0\n20\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"active|1\n|1\n0|2\n0\n20\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /home/baptistefaisy/aiven-kafka-demo; set -a; . ./.secrets/pg-erreurs.env 2>/dev/null; set +a; psql \\\"${PGURL:-$DATABASE_URL}\\\" -At -c \\\"select state, count(*) from pg_stat_activity where datname=current_database() group by 1 order by 2 desc;\\\" -c \\\"select count(*) filter (where wait_event_type='Lock') as en_attente_lock, count(*) as total from pg_stat_activity where datname=current_database();\\\" -c \\\"show lock_timeout;\\\" -c \\\"show max_connections;\\\" 2>&1 | tail -20\", \"workdir\": \"/home/baptistefaisy/aiven-kafka-demo\", \"timeout\": 30000}"},"time":{"start":1792657029374,"end":1792657035722}}}}
