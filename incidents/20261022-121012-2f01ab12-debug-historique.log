STATE_TO_ERROR_TYPE) --\n  # Ajoutes le 2026-10-22 : ces deux types etaient produits mais non routes,\n  # donc ils tombaient sur default_agent (incident-watch) au lieu de\n  # db-diagnose. Trouve par ./tools/debug-selftest.\n  db_query_canceled: db-diagnose\n  db_connection_failure: db-diagnose\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /home/baptistefaisy/aiven-kafka-demo && echo \\\"===routes.yaml===\\\" && cat routes.yaml && echo \\\"===routes.specialistes.yaml===\\\" && cat routes.specialistes.yaml\", \"timeout\": 60000}"},"time":{"start":1792671193345,"end":1792671193556}}}}
