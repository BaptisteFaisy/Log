{"type":"tool_use","timestamp":1792672284213,"sessionID":"ses_e9c7b26e4ffeqSUDmuHPylcNLD","part":{"partID":"prt_163983912001h6alz3ssa62um5","sessionID":"ses_e9c7b26e4ffeqSUDmuHPylcNLD","messageID":"msg_16397e98a001G2GMzgUovX2l3Q","type":"tool","id":"call_00_hfzZlX9QbDKteU0CTMZX3042","tool":"write","state":{"status":"completed","input":{"path":"/tmp/opencode/tsprobe.py","content":"#!/usr/bin/env python3\n\"\"\"Lecture seule : horodatage Kafka des messages d'une trace (preuve de provenance).\"\"\"\nimport json\nimport sys\nimport time\nimport uuid\n\nsys.path.insert(0, \"/home/baptistefaisy/aiven-kafka-demo/tools\")\nimport kafkalib  # noqa: E402\n\nTRACE = sys.argv[1]\nck = kafkalib.import_kafka()\nfrom confluent_kafka import OFFSET_BEGINNING, TopicPartition  # noqa: E402\n\nprefix = \"otel\"\nnames = [kafkalib.topic(s, prefix) for s in (\"traces\", \"logs\", \"metrics\")]\nconsumer = ck.Consumer(kafkalib.kafka_config({\n    \"group.id\": f\"tsprobe-{uuid.uuid4().hex[:8]}\",\n    \"enable.auto.commit\": \"false\",\n}))\nmeta = consumer.list_topics(timeout=20)\nassign = []\nfor name in names:\n    tm = (meta.topics or {}).get(name)\n    if not tm:\n        continue\n    for pid in tm.partitions or {}:\n        assign.append(TopicPartition(name, pid, OFFSET_BEGINNING))\nconsumer.assign(assign)\n\nfound = 0\ndeadline = time.time() + 40\nidle = None\nwhile time.time() < deadline:\n    msg = consumer.poll(0.5)\n    if msg is None:\n        if idle and time.time() - idle > 6:\n            break\n        continue\n    if msg.error():\n        continue\n    idle = time.time()\n    try:\n        payload = json.loads(msg.value().decode())\n    except Exception:\n        continue\n    if payload.get(\"TraceId\") != TRACE:\n        continue\n    found += 1\n    ts_type, ts_ms = msg.timestamp()\n    print(f\"{msg.topic()} offset={msg.offset()} \"\n          f\"record_ts={time.strftime('%Y-%m-%d %H:%M:%S', time.localtime(ts_ms/1000))} \"\n          f\"(type={ts_type}) payload_Timestamp={payload.get('Timestamp')}\")\nconsumer.close()\nprint(f\"messages trouves pour {TRACE} : {found}\")\n"},"output":"Created file successfully: /tmp/opencode/tsprobe.py","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: /tmp/opencode/tsprobe.py"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/tmp/opencode/tsprobe.py\", \"content\": \"#!/usr/bin/env python3\\n\\\"\\\"\\\"Lecture seule : horodatage Kafka des messages d'une trace (preuve de provenance).\\\"\\\"\\\"\\nimport json\\nimport sys\\nimport time\\nimport uuid\\n\\nsys.path.insert(0, \\\"/home/baptistefaisy/aiven-kafka-demo/tools\\\")\\nimport kafkalib  # noqa: E402\\n\\nTRACE = sys.argv[1]\\nck = kafkalib.import_kafka()\\nfrom confluent_kafka import OFFSET_BEGINNING, TopicPartition  # noqa: E402\\n\\nprefix = \\\"otel\\\"\\nnames = [kafkalib.topic(s, prefix) for s in (\\\"traces\\\", \\\"logs\\\", \\\"metrics\\\")]\\nconsumer = ck.Consumer(kafkalib.kafka_config({\\n    \\\"group.id\\\": f\\\"tsprobe-{uuid.uuid4().hex[:8]}\\\",\\n    \\\"enable.auto.commit\\\": \\\"false\\\",\\n}))\\nmeta = consumer.list_topics(timeout=20)\\nassign = []\\nfor name in names:\\n    tm = (meta.topics or {}).get(name)\\n    if not tm:\\n        continue\\n    for pid in tm.partitions or {}:\\n        assign.append(TopicPartition(name, pid, OFFSET_BEGINNING))\\nconsumer.assign(assign)\\n\\nfound = 0\\ndeadline = time.time() + 40\\nidle = None\\nwhile time.time() < deadline:\\n    msg = consumer.poll(0.5)\\n    if msg is None:\\n        if idle and time.time() - idle > 6:\\n            break\\n        continue\\n    if msg.error():\\n        continue\\n    idle = time.time()\\n    try:\\n        payload = json.loads(msg.value().decode())\\n    except Exception:\\n        continue\\n    if payload.get(\\\"TraceId\\\") != TRACE:\\n        continue\\n    found += 1\\n    ts_type, ts_ms = msg.timestamp()\\n    print(f\\\"{msg.topic()} offset={msg.offset()} \\\"\\n          f\\\"record_ts={time.strftime('%Y-%m-%d %H:%M:%S', time.localtime(ts_ms/1000))} \\\"\\n          f\\\"(type={ts_type}) payload_Timestamp={payload.get('Timestamp')}\\\")\\nconsumer.close()\\nprint(f\\\"messages trouves pour {TRACE} : {found}\\\")\\n\"}"},"time":{"start":1792672282898,"end":1792672284213}}}}
