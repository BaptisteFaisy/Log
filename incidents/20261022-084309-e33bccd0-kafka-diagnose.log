{"type":"tool_use","timestamp":1792659010938,"sessionID":"ses_e9d38b957ffeAPfToaPpTEOM2r","part":{"partID":"prt_162cdb5370011Vw3EjAmWjdkQO","sessionID":"ses_e9d38b957ffeAPfToaPpTEOM2r","messageID":"msg_162cd6bbb001AS3jhUr053tMm3","type":"tool","id":"call_00_bpYpYmmgBiuTeTWcZCf50774","tool":"shell","state":{"status":"completed","input":{"command":"cd /home/baptistefaisy/aiven-kafka-demo\nfind . -name 'kafkalib*' -not -path './logs/*' | head\necho \"=== kafkalib ===\"\nsed -n '1,90p' $(find . -name 'kafkalib.py' | head -1)","timeout":30000},"output":"./tools/kafkalib.py\n./tools/__pycache__/kafkalib.cpython-313.pyc\n=== kafkalib ===\n#!/usr/bin/env python3\n\"\"\"Boite a outils Kafka partagee (config, producteur, consommateur).\n\nRegles de securite :\n  - aucun secret n'est jamais affiche ni journalise ;\n  - chaque appel reseau a un timeout ;\n  - les erreurs sont transformees en messages lisibles\n    (\"quoi / pourquoi / quoi faire maintenant\"), jamais en traceback.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\nimport re\nimport sys\nimport time\nfrom pathlib import Path\nfrom typing import Any, Dict, List, Optional, Tuple\n\nHERE = Path(__file__).resolve().parent\nPROJECT_ROOT = HERE.parent\n\nEXIT_OK = 0\nEXIT_USAGE = 1\nEXIT_CONFIG = 2\nEXIT_KAFKA = 3\nEXIT_RUNNING = 4\n\nREQUIRED_ENV = [\n    \"KAFKA_BOOTSTRAP\",\n    \"KAFKA_USERNAME\",\n    \"KAFKA_PASSWORD\",\n    \"KAFKA_CA_FILE\",\n    \"KAFKA_TOPIC_PREFIX\",\n]\n\n\nclass ConfigError(Exception):\n    \"\"\"Configuration incomplete (variables manquantes, fichier illisible...).\"\"\"\n\n\nclass KafkaUnreachable(Exception):\n    \"\"\"Le broker ne repond pas (reseau, TLS, ACL, service en construction...).\"\"\"\n\n\ndef load_env_file(path: Optional[str] = None) -> Dict[str, str]:\n    \"\"\"Charge un env-<service>.sh sans l'executer (parsing KEY=VALUE).\"\"\"\n    p = Path(path or PROJECT_ROOT / \"env-agent-kafka.sh\")\n    values: Dict[str, str] = {}\n    if not p.exists():\n        return values\n    for raw in p.read_text(encoding=\"utf-8\").splitlines():\n        line = raw.strip()\n        if not line or line.startswith(\"#\") or \"=\" not in line:\n            continue\n        if line.startswith(\"export \"):\n            line = line[len(\"export \"):]\n        key, _, val = line.partition(\"=\")\n        key = key.strip()\n        val = val.strip().strip('\"').strip(\"'\")\n        if key and re.fullmatch(r\"[A-Za-z_][A-Za-z0-9_]*\", key):\n            values[key] = val\n    return values\n\n\ndef ensure_config() -> None:\n    \"\"\"Remplit les variables KAFKA_* manquantes depuis le fichier d'env.\n\n    Le fichier est au format systemd (KEY=\"valeur\", sans `export`) : il est\n    lisible par `EnvironmentFile=` ET par bash. En bash, on le charge avec\n    `set -a; . env-agent-kafka.sh; set +a` pour l'exporter.\n    \"\"\"\n    if all(os.environ.get(k) for k in REQUIRED_ENV):\n        return\n    env_file = os.environ.get(\"KAFKA_ENV_FILE\")\n    for key, val in load_env_file(env_file).items():\n        os.environ.setdefault(key, val)\n\n\ndef config() -> Dict[str, str]:\n    ensure_config()\n    missing = [k for k in REQUIRED_ENV if not os.environ.get(k)]\n    if missing:\n        raise ConfigError(\n            \"configuration incomplete : variable(s) manquante(s) \"\n            + \", \".join(missing)\n            + \" -> source env-agent-kafka.sh (mode 600) puis reessaye\"\n        )\n    return {k: os.environ[k] for k in REQUIRED_ENV}\n\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"./tools/kafkalib.py\n./tools/__pycache__/kafkalib.cpython-313.pyc\n=== kafkalib ===\n#!/usr/bin/env python3\n\"\"\"Boite a outils Kafka partagee (config, producteur, consommateur).\n\nRegles de securite :\n  - aucun secret n'est jamais affiche ni journalise ;\n  - chaque appel reseau a un timeout ;\n  - les erreurs sont transformees en messages lisibles\n    (\"quoi / pourquoi / quoi faire maintenant\"), jamais en traceback.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\nimport re\nimport sys\nimport time\nfrom pathlib import Path\nfrom typing import Any, Dict, List, Optional, Tuple\n\nHERE = Path(__file__).resolve().parent\nPROJECT_ROOT = HERE.parent\n\nEXIT_OK = 0\nEXIT_USAGE = 1\nEXIT_CONFIG = 2\nEXIT_KAFKA = 3\nEXIT_RUNNING = 4\n\nREQUIRED_ENV = [\n    \"KAFKA_BOOTSTRAP\",\n    \"KAFKA_USERNAME\",\n    \"KAFKA_PASSWORD\",\n    \"KAFKA_CA_FILE\",\n    \"KAFKA_TOPIC_PREFIX\",\n]\n\n\nclass ConfigError(Exception):\n    \"\"\"Configuration incomplete (variables manquantes, fichier illisible...).\"\"\"\n\n\nclass KafkaUnreachable(Exception):\n    \"\"\"Le broker ne repond pas (reseau, TLS, ACL, service en construction...).\"\"\"\n\n\ndef load_env_file(path: Optional[str] = None) -> Dict[str, str]:\n    \"\"\"Charge un env-<service>.sh sans l'executer (parsing KEY=VALUE).\"\"\"\n    p = Path(path or PROJECT_ROOT / \"env-agent-kafka.sh\")\n    values: Dict[str, str] = {}\n    if not p.exists():\n        return values\n    for raw in p.read_text(encoding=\"utf-8\").splitlines():\n        line = raw.strip()\n        if not line or line.startswith(\"#\") or \"=\" not in line:\n            continue\n        if line.startswith(\"export \"):\n            line = line[len(\"export \"):]\n        key, _, val = line.partition(\"=\")\n        key = key.strip()\n        val = val.strip().strip('\"').strip(\"'\")\n        if key and re.fullmatch(r\"[A-Za-z_][A-Za-z0-9_]*\", key):\n            values[key] = val\n    return values\n\n\ndef ensure_config() -> None:\n    \"\"\"Remplit les variables KAFKA_* manquantes depuis le fichier d'env.\n\n    Le fichier est au format systemd (KEY=\"valeur\", sans `export`) : il est\n    lisible par `EnvironmentFile=` ET par bash. En bash, on le charge avec\n    `set -a; . env-agent-kafka.sh; set +a` pour l'exporter.\n    \"\"\"\n    if all(os.environ.get(k) for k in REQUIRED_ENV):\n        return\n    env_file = os.environ.get(\"KAFKA_ENV_FILE\")\n    for key, val in load_env_file(env_file).items():\n        os.environ.setdefault(key, val)\n\n\ndef config() -> Dict[str, str]:\n    ensure_config()\n    missing = [k for k in REQUIRED_ENV if not os.environ.get(k)]\n    if missing:\n        raise ConfigError(\n            \"configuration incomplete : variable(s) manquante(s) \"\n            + \", \".join(missing)\n            + \" -> source env-agent-kafka.sh (mode 600) puis reessaye\"\n        )\n    return {k: os.environ[k] for k in REQUIRED_ENV}\n\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /home/baptistefaisy/aiven-kafka-demo\\nfind . -name 'kafkalib*' -not -path './logs/*' | head\\necho \\\"=== kafkalib ===\\\"\\nsed -n '1,90p' $(find . -name 'kafkalib.py' | head -1)\", \"timeout\": 30000}"},"time":{"start":1792659010871,"end":1792659010938}}}}
