{"type":"tool_use","timestamp":1792658992041,"sessionID":"ses_e9d38b957ffeAPfToaPpTEOM2r","part":{"partID":"prt_162cd68e20010pAlSULq63y7PT","sessionID":"ses_e9d38b957ffeAPfToaPpTEOM2r","messageID":"msg_162ccaef6001iuCNZLUw5RwhR0","type":"tool","id":"call_00_kLFL4Jhqq1vyiu1dIRe81279","tool":"shell","state":{"status":"completed","input":{"command":"cd /home/baptistefaisy/aiven-kafka-demo\necho \"=== kafka-health (script) ===\"\nsed -n '20,70p' kafka-health\necho\necho \"=== fichiers cert presents ===\"\nls -la cert/ 2>&1; echo \"---\"; ls -la cert/agent-kafka/ 2>&1; echo \"--- cert-agent-kafka ? ---\"; ls -la cert-agent-kafka/ 2>&1 | head -5\necho\necho \"=== outils dispo ===\"\nfor t in kcat kafkacat python3; do command -v $t >/dev/null && echo \"  $t: $(command -v $t)\"; done\npython3 -c \"import kafka; print('  kafka-python:', kafka.__version__)\" 2>&1 | head -2\npython3 -c \"import confluent_kafka; print('  confluent_kafka:', confluent_kafka.version())\" 2>&1 | head -2","timeout":60000},"output":"=== kafka-health (script) ===\nimport kafkalib  # noqa: E402\n\nEXIT_OK = kafkalib.EXIT_OK\nEXIT_USAGE = kafkalib.EXIT_USAGE\nEXIT_CONFIG = kafkalib.EXIT_CONFIG\nEXIT_KAFKA = kafkalib.EXIT_KAFKA\n\n\ndef probe(bootstrap, prefix, deep):\n    admin = kafkalib.admin_client(\"kafka-health\")\n    meta = admin.list_topics(timeout=15)\n    brokers = []\n    for broker_id, broker in (meta.brokers or {}).items():\n        brokers.append({\"id\": broker_id, \"host\": broker.host, \"port\": broker.port})\n    topics = {}\n    for name, tm in (meta.topics or {}).items():\n        partitions = []\n        for pid, part in (tm.partitions or {}).items():\n            partitions.append({\"id\": pid, \"leader\": part.leader,\n                               \"replicas\": list(part.replicas or []),\n                               \"isrs\": list(part.isrs or [])})\n        topics[name] = {\n            \"partitions\": len(partitions),\n            \"topic_id\": str(getattr(tm, \"topic_id\", \"\") or \"\"),\n            \"detail\": partitions,\n        }\n    groups = []\n    if deep:\n        try:\n            fut = admin.list_consumer_groups(request_timeout=15)\n            res = fut.result(timeout=20)\n            valid = getattr(res, \"valid\", None)\n            for g in (valid or []):\n                groups.append({\"group_id\": g.group_id, \"state\": str(g.state)})\n        except Exception as exc:  # noqa: BLE001\n            groups = [{\"error\": f\"list_consumer_groups indisponible : {exc}\"}]\n    expected = [f\"{prefix}.{s}\" for s in (\"traces\", \"logs\", \"metrics\")]\n    missing = [t for t in expected if t not in topics]\n    warnings = []\n    if missing:\n        warnings.append(\n            \"topic(s) invisible(s) : \" + \", \".join(missing)\n            + \" -> soit ils n'existent pas (./tools/preflight --fix), soit l'ACL Describe \"\n              \"manque (§8 piege 4 : sans Describe le topic n'apparait meme pas dans list_topics)\"\n        )\n    return {\n        \"ok\": True,\n        \"bootstrap\": bootstrap,\n        \"topics\": topics,\n        \"brokers\": brokers,\n        \"consumer_groups\": groups,\n\n=== fichiers cert presents ===\ntotal 0\ndrwxr-xr-x 1 baptistefaisy baptistefaisy  50 Oct 22 10:05 .\ndrwxr-xr-x 1 baptistefaisy baptistefaisy 652 Oct 22 10:42 ..\ndrwxr-xr-x 1 baptistefaisy baptistefaisy  12 Oct 22 10:02 agent-kafka\ndrwxr-xr-x 1 baptistefaisy baptistefaisy  12 Oct 22 10:07 kafka-1687d005\n---\ntotal 4\ndrwxr-xr-x 1 baptistefaisy baptistefaisy   12 Oct 22 10:02 .\ndrwxr-xr-x 1 baptistefaisy baptistefaisy   50 Oct 22 10:05 ..\n-rw-r--r-- 1 baptistefaisy baptistefaisy 1541 Oct 22 10:02 ca.pem\n--- cert-agent-kafka ? ---\nls: cannot access 'cert-agent-kafka/': No such file or directory\n\n=== outils dispo ===\n  python3: /home/baptistefaisy/.venvs/aiven-kafka/bin/python3\nTraceback (most recent call last):\n  File \"<string>\", line 1, in <module>\n  confluent_kafka: 2.16.0\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"=== kafka-health (script) ===\nimport kafkalib  # noqa: E402\n\nEXIT_OK = kafkalib.EXIT_OK\nEXIT_USAGE = kafkalib.EXIT_USAGE\nEXIT_CONFIG = kafkalib.EXIT_CONFIG\nEXIT_KAFKA = kafkalib.EXIT_KAFKA\n\n\ndef probe(bootstrap, prefix, deep):\n    admin = kafkalib.admin_client(\"kafka-health\")\n    meta = admin.list_topics(timeout=15)\n    brokers = []\n    for broker_id, broker in (meta.brokers or {}).items():\n        brokers.append({\"id\": broker_id, \"host\": broker.host, \"port\": broker.port})\n    topics = {}\n    for name, tm in (meta.topics or {}).items():\n        partitions = []\n        for pid, part in (tm.partitions or {}).items():\n            partitions.append({\"id\": pid, \"leader\": part.leader,\n                               \"replicas\": list(part.replicas or []),\n                               \"isrs\": list(part.isrs or [])})\n        topics[name] = {\n            \"partitions\": len(partitions),\n            \"topic_id\": str(getattr(tm, \"topic_id\", \"\") or \"\"),\n            \"detail\": partitions,\n        }\n    groups = []\n    if deep:\n        try:\n            fut = admin.list_consumer_groups(request_timeout=15)\n            res = fut.result(timeout=20)\n            valid = getattr(res, \"valid\", None)\n            for g in (valid or []):\n                groups.append({\"group_id\": g.group_id, \"state\": str(g.state)})\n        except Exception as exc:  # noqa: BLE001\n            groups = [{\"error\": f\"list_consumer_groups indisponible : {exc}\"}]\n    expected = [f\"{prefix}.{s}\" for s in (\"traces\", \"logs\", \"metrics\")]\n    missing = [t for t in expected if t not in topics]\n    warnings = []\n    if missing:\n        warnings.append(\n            \"topic(s) invisible(s) : \" + \", \".join(missing)\n            + \" -> soit ils n'existent pas (./tools/preflight --fix), soit l'ACL Describe \"\n              \"manque (§8 piege 4 : sans Describe le topic n'apparait meme pas dans list_topics)\"\n        )\n    return {\n        \"ok\": True,\n        \"bootstrap\": bootstrap,\n        \"topics\": topics,\n        \"brokers\": brokers,\n        \"consumer_groups\": groups,\n\n=== fichiers cert presents ===\ntotal 0\ndrwxr-xr-x 1 baptistefaisy baptistefaisy  50 Oct 22 10:05 .\ndrwxr-xr-x 1 baptistefaisy baptistefaisy 652 Oct 22 10:42 ..\ndrwxr-xr-x 1 baptistefaisy baptistefaisy  12 Oct 22 10:02 agent-kafka\ndrwxr-xr-x 1 baptistefaisy baptistefaisy  12 Oct 22 10:07 kafka-1687d005\n---\ntotal 4\ndrwxr-xr-x 1 baptistefaisy baptistefaisy   12 Oct 22 10:02 .\ndrwxr-xr-x 1 baptistefaisy baptistefaisy   50 Oct 22 10:05 ..\n-rw-r--r-- 1 baptistefaisy baptistefaisy 1541 Oct 22 10:02 ca.pem\n--- cert-agent-kafka ? ---\nls: cannot access 'cert-agent-kafka/': No such file or directory\n\n=== outils dispo ===\n  python3: /home/baptistefaisy/.venvs/aiven-kafka/bin/python3\nTraceback (most recent call last):\n  File \"<string>\", line 1, in <module>\n  confluent_kafka: 2.16.0\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /home/baptistefaisy/aiven-kafka-demo\\necho \\\"=== kafka-health (script) ===\\\"\\nsed -n '20,70p' kafka-health\\necho\\necho \\\"=== fichiers cert presents ===\\\"\\nls -la cert/ 2>&1; echo \\\"---\\\"; ls -la cert/agent-kafka/ 2>&1; echo \\\"--- cert-agent-kafka ? ---\\\"; ls -la cert-agent-kafka/ 2>&1 | head -5\\necho\\necho \\\"=== outils dispo ===\\\"\\nfor t in kcat kafkacat python3; do command -v $t >/dev/null && echo \\\"  $t: $(command -v $t)\\\"; done\\npython3 -c \\\"import kafka; print('  kafka-python:', kafka.__version__)\\\" 2>&1 | head -2\\npython3 -c \\\"import confluent_kafka; print('  confluent_kafka:', confluent_kafka.version())\\\" 2>&1 | head -2\", \"timeout\": 60000}"},"time":{"start":1792658991330,"end":1792658992041}}}}
