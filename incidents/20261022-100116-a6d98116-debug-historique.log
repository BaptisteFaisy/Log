{"type":"tool_use","timestamp":1792663382929,"sessionID":"ses_e9cf132deffe15nAQiy0AW84Er","part":{"partID":"prt_163106b77001EwfVGSKmuvMz62","sessionID":"ses_e9cf132deffe15nAQiy0AW84Er","messageID":"msg_163105075001ese1Oka16peWvf","type":"tool","id":"call_00_PPq4mOvyydVDuef1kcv84505","tool":"read","state":{"status":"completed","input":{"path":"/home/baptistefaisy/aiven-kafka-demo/tools/pg-diag"},"output":"Read file /home/baptistefaisy/aiven-kafka-demo/tools/pg-diag, lines 1-99\n1: #!/usr/bin/env python3\n2: \"\"\"tools/pg-diag — diagnostic PostgreSQL en LECTURE SEULE, sans secret.\n3: \n4: Sert aux agents (db-diagnose) quand ils doivent aller voir la base reelle\n5: pour conclure, sans qu'un mot de passe apparaisse ni dans la commande ni\n6: dans le rapport (le rapport est republie dans Kafka, puis dans un depot\n7: public).\n8: \n9: Usage :\n10:   ./tools/pg-diag \"SELECT state, count(*) FROM pg_stat_activity GROUP BY 1\"\n11:   ./tools/pg-diag --db-url <url> \"<requete>\"\n12: \n13: Securite :\n14:   - la session est ouverte en `default_transaction_read_only = on` :\n15:     PostgreSQL refuse toute ecriture, meme si la requete est malveillante ;\n16:   - seules les requetes de lecture sont acceptees (SELECT / SHOW / EXPLAIN /\n17:     WITH / VALUES / TABLE) ;\n18:   - le mot de passe vient de `.secrets/creds.env` et n'est jamais affiche.\n19: \n20: Codes de sortie : 0 ok / 1 usage / 2 configuration manquante / 3 requete refusee.\n21: \"\"\"\n22: from __future__ import annotations\n23: \n24: import argparse\n25: import os\n26: import re\n27: import subprocess\n28: import sys\n29: from pathlib import Path\n30: \n31: HERE = Path(__file__).resolve().parent\n32: sys.path.insert(0, str(HERE))\n33: \n34: import kafkalib  # noqa: E402\n35: from emit_sql_error import build_pg_env  # noqa: E402\n36: \n37: EXIT_OK = kafkalib.EXIT_OK\n38: EXIT_USAGE = kafkalib.EXIT_USAGE\n39: EXIT_CONFIG = kafkalib.EXIT_CONFIG\n40: EXIT_REFUSED = 3\n41: \n42: READ_ONLY_RE = re.compile(\n43:     r\"^\\s*(SELECT|SHOW|EXPLAIN|WITH|VALUES|TABLE)\\b\", re.IGNORECASE)\n44: \n45: FORBIDDEN = re.compile(\n46:     r\"\\b(INSERT|UPDATE|DELETE|DROP|CREATE|ALTER|TRUNCATE|GRANT|REVOKE|\"\n47:     r\"COPY|CALL|DO|SET|VACUUM|REINDEX|CLUSTER|LOCK|REFRESH)\\b\",\n48:     re.IGNORECASE)\n49: \n50: \n51: def main(argv=None):\n52:     parser = argparse.ArgumentParser(\n53:         prog=\"pg-diag\",\n54:         description=\"execute une requete SQL en lecture seule (aucun secret expose)\")\n55:     parser.add_argument(\"sql\", help=\"requete SQL de lecture\")\n56:     parser.add_argument(\"--db-url\", help=\"URL PostgreSQL (defaut : service Aiven 'historique')\")\n57:     parser.add_argument(\"--timeout\", type=int, default=30, help=\"timeout en secondes\")\n58:     args = parser.parse_args(argv)\n59: \n60:     if not args.sql.strip():\n61:         parser.print_usage(sys.stderr)\n62:         print(\"ERREUR : une requete SQL est obligatoire\", file=sys.stderr)\n63:         return EXIT_USAGE\n64:     if not READ_ONLY_RE.match(args.sql) or FORBIDDEN.search(args.sql):\n65:         print(\"ERREUR : seules les requetes de lecture sont acceptees \"\n66:               \"(SELECT / SHOW / EXPLAIN / WITH / VALUES)\", file=sys.stderr)\n67:         return EXIT_REFUSED\n68: \n69:     try:\n70:         pg_env = build_pg_env(args.db_url)\n71:     except kafkalib.ConfigError as exc:\n72:         print(f\"ERREUR : {exc}\", file=sys.stderr)\n73:         return EXIT_CONFIG\n74: \n75:     env = os.environ.copy()\n76:     env.update(pg_env)\n77:     script = \"SET default_transaction_read_only = on;\\n\" + args.sql.strip() + \"\\n\"\n78:     try:\n79:         proc = subprocess.run(\n80:             [\"psql\", \"-X\", \"-q\", \"-v\", \"VERBOSITY=verbose\", \"-f\", \"-\"],\n81:             input=script, env=env, capture_output=True, text=True,\n82:             timeout=args.timeout)\n83:     except subprocess.TimeoutExpired:\n84:         print(f\"ERREUR : la requete depasse {args.timeout}s\", file=sys.stderr)\n85:         return EXIT_REFUSED\n86: \n87:     if proc.stdout:\n88:         sys.stdout.write(proc.stdout)\n89:     if proc.stderr:\n90:         sys.stderr.write(proc.stderr)\n91:     return EXIT_OK if proc.returncode in (0, 1, 3) else EXIT_REFUSED\n92: \n93: \n94: if __name__ == \"__main__\":\n95:     try:\n96:         sys.exit(main())\n97:     except KeyboardInterrupt:\n98:         print(\"interrompu\", file=sys.stderr)\n99:         sys.exit(1)","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /home/baptistefaisy/aiven-kafka-demo/tools/pg-diag, lines 1-99\n1: #!/usr/bin/env python3\n2: \"\"\"tools/pg-diag — diagnostic PostgreSQL en LECTURE SEULE, sans secret.\n3: \n4: Sert aux agents (db-diagnose) quand ils doivent aller voir la base reelle\n5: pour conclure, sans qu'un mot de passe apparaisse ni dans la commande ni\n6: dans le rapport (le rapport est republie dans Kafka, puis dans un depot\n7: public).\n8: \n9: Usage :\n10:   ./tools/pg-diag \"SELECT state, count(*) FROM pg_stat_activity GROUP BY 1\"\n11:   ./tools/pg-diag --db-url <url> \"<requete>\"\n12: \n13: Securite :\n14:   - la session est ouverte en `default_transaction_read_only = on` :\n15:     PostgreSQL refuse toute ecriture, meme si la requete est malveillante ;\n16:   - seules les requetes de lecture sont acceptees (SELECT / SHOW / EXPLAIN /\n17:     WITH / VALUES / TABLE) ;\n18:   - le mot de passe vient de `.secrets/creds.env` et n'est jamais affiche.\n19: \n20: Codes de sortie : 0 ok / 1 usage / 2 configuration manquante / 3 requete refusee.\n21: \"\"\"\n22: from __future__ import annotations\n23: \n24: import argparse\n25: import os\n26: import re\n27: import subprocess\n28: import sys\n29: from pathlib import Path\n30: \n31: HERE = Path(__file__).resolve().parent\n32: sys.path.insert(0, str(HERE))\n33: \n34: import kafkalib  # noqa: E402\n35: from emit_sql_error import build_pg_env  # noqa: E402\n36: \n37: EXIT_OK = kafkalib.EXIT_OK\n38: EXIT_USAGE = kafkalib.EXIT_USAGE\n39: EXIT_CONFIG = kafkalib.EXIT_CONFIG\n40: EXIT_REFUSED = 3\n41: \n42: READ_ONLY_RE = re.compile(\n43:     r\"^\\s*(SELECT|SHOW|EXPLAIN|WITH|VALUES|TABLE)\\b\", re.IGNORECASE)\n44: \n45: FORBIDDEN = re.compile(\n46:     r\"\\b(INSERT|UPDATE|DELETE|DROP|CREATE|ALTER|TRUNCATE|GRANT|REVOKE|\"\n47:     r\"COPY|CALL|DO|SET|VACUUM|REINDEX|CLUSTER|LOCK|REFRESH)\\b\",\n48:     re.IGNORECASE)\n49: \n50: \n51: def main(argv=None):\n52:     parser = argparse.ArgumentParser(\n53:         prog=\"pg-diag\",\n54:         description=\"execute une requete SQL en lecture seule (aucun secret expose)\")\n55:     parser.add_argument(\"sql\", help=\"requete SQL de lecture\")\n56:     parser.add_argument(\"--db-url\", help=\"URL PostgreSQL (defaut : service Aiven 'historique')\")\n57:     parser.add_argument(\"--timeout\", type=int, default=30, help=\"timeout en secondes\")\n58:     args = parser.parse_args(argv)\n59: \n60:     if not args.sql.strip():\n61:         parser.print_usage(sys.stderr)\n62:         print(\"ERREUR : une requete SQL est obligatoire\", file=sys.stderr)\n63:         return EXIT_USAGE\n64:     if not READ_ONLY_RE.match(args.sql) or FORBIDDEN.search(args.sql):\n65:         print(\"ERREUR : seules les requetes de lecture sont acceptees \"\n66:               \"(SELECT / SHOW / EXPLAIN / WITH / VALUES)\", file=sys.stderr)\n67:         return EXIT_REFUSED\n68: \n69:     try:\n70:         pg_env = build_pg_env(args.db_url)\n71:     except kafkalib.ConfigError as exc:\n72:         print(f\"ERREUR : {exc}\", file=sys.stderr)\n73:         return EXIT_CONFIG\n74: \n75:     env = os.environ.copy()\n76:     env.update(pg_env)\n77:     script = \"SET default_transaction_read_only = on;\\n\" + args.sql.strip() + \"\\n\"\n78:     try:\n79:         proc = subprocess.run(\n80:             [\"psql\", \"-X\", \"-q\", \"-v\", \"VERBOSITY=verbose\", \"-f\", \"-\"],\n81:             input=script, env=env, capture_output=True, text=True,\n82:             timeout=args.timeout)\n83:     except subprocess.TimeoutExpired:\n84:         print(f\"ERREUR : la requete depasse {args.timeout}s\", file=sys.stderr)\n85:         return EXIT_REFUSED\n86: \n87:     if proc.stdout:\n88:         sys.stdout.write(proc.stdout)\n89:     if proc.stderr:\n90:         sys.stderr.write(proc.stderr)\n91:     return EXIT_OK if proc.returncode in (0, 1, 3) else EXIT_REFUSED\n92: \n93: \n94: if __name__ == \"__main__\":\n95:     try:\n96:         sys.exit(main())\n97:     except KeyboardInterrupt:\n98:         print(\"interrompu\", file=sys.stderr)\n99:         sys.exit(1)"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/home/baptistefaisy/aiven-kafka-demo/tools/pg-diag\"}"},"time":{"start":1792663382903,"end":1792663382929}}}}
