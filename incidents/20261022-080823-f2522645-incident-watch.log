{"type":"tool_use","timestamp":1792656524000,"sessionID":"ses_e9d588b99ffeeNyrcbWx0FOLx5","part":{"partID":"prt_162a7c2b5001OKdeyf8jVktTeo","sessionID":"ses_e9d588b99ffeeNyrcbWx0FOLx5","messageID":"msg_162a7af0d00132szPUmvepgJjV","type":"tool","id":"call_00_hBhgM8oFGPBVUM5PrxSb7364","tool":"read","state":{"status":"completed","input":{"path":"/home/baptistefaisy/aiven-kafka-demo/tools/kafkalib.py","limit":160},"output":"Read file /home/baptistefaisy/aiven-kafka-demo/tools/kafkalib.py, lines 1-160\n1: #!/usr/bin/env python3\n2: \"\"\"Boite a outils Kafka partagee (config, producteur, consommateur).\n3: \n4: Regles de securite :\n5:   - aucun secret n'est jamais affiche ni journalise ;\n6:   - chaque appel reseau a un timeout ;\n7:   - les erreurs sont transformees en messages lisibles\n8:     (\"quoi / pourquoi / quoi faire maintenant\"), jamais en traceback.\n9: \"\"\"\n10: from __future__ import annotations\n11: \n12: import os\n13: import re\n14: import sys\n15: import time\n16: from pathlib import Path\n17: from typing import Any, Dict, List, Optional, Tuple\n18: \n19: HERE = Path(__file__).resolve().parent\n20: PROJECT_ROOT = HERE.parent\n21: \n22: EXIT_OK = 0\n23: EXIT_USAGE = 1\n24: EXIT_CONFIG = 2\n25: EXIT_KAFKA = 3\n26: EXIT_RUNNING = 4\n27: \n28: REQUIRED_ENV = [\n29:     \"KAFKA_BOOTSTRAP\",\n30:     \"KAFKA_USERNAME\",\n31:     \"KAFKA_PASSWORD\",\n32:     \"KAFKA_CA_FILE\",\n33:     \"KAFKA_TOPIC_PREFIX\",\n34: ]\n35: \n36: \n37: class ConfigError(Exception):\n38:     \"\"\"Configuration incomplete (variables manquantes, fichier illisible...).\"\"\"\n39: \n40: \n41: class KafkaUnreachable(Exception):\n42:     \"\"\"Le broker ne repond pas (reseau, TLS, ACL, service en construction...).\"\"\"\n43: \n44: \n45: def load_env_file(path: Optional[str] = None) -> Dict[str, str]:\n46:     \"\"\"Charge un env-<service>.sh sans l'executer (parsing KEY=VALUE).\"\"\"\n47:     p = Path(path or PROJECT_ROOT / \"env-agent-kafka.sh\")\n48:     values: Dict[str, str] = {}\n49:     if not p.exists():\n50:         return values\n51:     for raw in p.read_text(encoding=\"utf-8\").splitlines():\n52:         line = raw.strip()\n53:         if not line or line.startswith(\"#\") or \"=\" not in line:\n54:             continue\n55:         if line.startswith(\"export \"):\n56:             line = line[len(\"export \"):]\n57:         key, _, val = line.partition(\"=\")\n58:         key = key.strip()\n59:         val = val.strip().strip('\"').strip(\"'\")\n60:         if key and re.fullmatch(r\"[A-Za-z_][A-Za-z0-9_]*\", key):\n61:             values[key] = val\n62:     return values\n63: \n64: \n65: def ensure_config() -> None:\n66:     \"\"\"Remplit les variables KAFKA_* manquantes depuis env-agent-kafka.sh.\"\"\"\n67:     if all(os.environ.get(k) for k in REQUIRED_ENV):\n68:         return\n69:     for key, val in load_env_file().items():\n70:         os.environ.setdefault(key, val)\n71: \n72: \n73: def config() -> Dict[str, str]:\n74:     ensure_config()\n75:     missing = [k for k in REQUIRED_ENV if not os.environ.get(k)]\n76:     if missing:\n77:         raise ConfigError(\n78:             \"configuration incomplete : variable(s) manquante(s) \"\n79:             + \", \".join(missing)\n80:             + \" -> source env-agent-kafka.sh (mode 600) puis reessaye\"\n81:         )\n82:     return {k: os.environ[k] for k in REQUIRED_ENV}\n83: \n84: \n85: # --------------------------------------------------------------------------\n86: # basculement de cluster (repli)\n87: # --------------------------------------------------------------------------\n88: # Le service principal (agent-kafka) peut tomber : le systeme bascule alors sur\n89: # le service de repli (kafka-1687d005) sans intervention. Le choix est partage\n90: # par tous les outils (fichier d'etat commun) pour que le generateur, le\n91: # watcher, l'agent et le site parlent au MEME cluster.\n92: FALLBACK_ENV_FILE = os.environ.get(\n93:     \"KAFKA_FALLBACK_ENV_FILE\", str(PROJECT_ROOT / \"env-kafka-1687d005.sh\"))\n94: PROFILE_STATE = Path(os.environ.get(\n95:     \"KAFKA_PROFILE_STATE\",\n96:     str(Path.home() / \".local\" / \"state\" / \"aiven-kafka-demo\" / \"active.json\")))\n97: HEALTH_TTL_S = float(os.environ.get(\"KAFKA_HEALTH_TTL_S\", \"20\"))\n98: \n99: \n100: def _profile_env(values: Dict[str, str]) -> Dict[str, str]:\n101:     env = dict(values)\n102:     env.setdefault(\"KAFKA_SECURITY_PROTOCOL\", \"SASL_SSL\")\n103:     env.setdefault(\"KAFKA_SASL_MECHANISM\", \"SCRAM-SHA-256\")\n104:     return env\n105: \n106: \n107: def profiles() -> List[Tuple[str, Dict[str, str]]]:\n108:     \"\"\"Les profils disponibles : (nom, variables KAFKA_*).\"\"\"\n109:     out: List[Tuple[str, Dict[str, str]]] = []\n110:     primary = {k: os.environ.get(k) for k in REQUIRED_ENV}\n111:     if all(primary.get(k) for k in REQUIRED_ENV):\n112:         out.append((\"primary\", _profile_env(primary)))\n113:     fallback = load_env_file(FALLBACK_ENV_FILE)\n114:     if all(fallback.get(k) for k in REQUIRED_ENV):\n115:         if fallback.get(\"KAFKA_BOOTSTRAP\") != primary.get(\"KAFKA_BOOTSTRAP\"):\n116:             out.append((\"fallback\", _profile_env(fallback)))\n117:     return out\n118: \n119: \n120: def _read_state() -> Dict[str, Any]:\n121:     try:\n122:         return json.loads(PROFILE_STATE.read_text(encoding=\"utf-8\"))\n123:     except (OSError, ValueError):\n124:         return {}\n125: \n126: \n127: def _write_state(name: str) -> None:\n128:     try:\n129:         PROFILE_STATE.parent.mkdir(parents=True, exist_ok=True)\n130:         PROFILE_STATE.write_text(\n131:             json.dumps({\"active\": name, \"at\": time.time()}), encoding=\"utf-8\")\n132:     except OSError:\n133:         pass\n134: \n135: \n136: def invalidate_profile_cache() -> None:\n137:     \"\"\"Force un nouveau sondage (le watcher l'appelle apres une erreur).\"\"\"\n138:     state = _read_state()\n139:     state[\"at\"] = 0\n140:     try:\n141:         PROFILE_STATE.parent.mkdir(parents=True, exist_ok=True)\n142:         PROFILE_STATE.write_text(json.dumps(state), encoding=\"utf-8\")\n143:     except OSError:\n144:         pass\n145: \n146: \n147: def _config_for(env: Dict[str, str], extra: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:\n148:     \"\"\"Configuration librdkafka a partir d'un jeu de variables explicite.\"\"\"\n149:     cfg: Dict[str, Any] = {\n150:         \"bootstrap.servers\": env[\"KAFKA_BOOTSTRAP\"],\n151:         \"security.protocol\": env.get(\"KAFKA_SECURITY_PROTOCOL\", \"SASL_SSL\"),\n152:         \"sasl.mechanism\": env.get(\"KAFKA_SASL_MECHANISM\", \"SCRAM-SHA-256\"),\n153:         \"sasl.username\": env[\"KAFKA_USERNAME\"],\n154:         \"sasl.password\": env[\"KAFKA_PASSWORD\"],\n155:         \"ssl.ca.location\": env[\"KAFKA_CA_FILE\"],\n156:         # le certificat Aiven porte le nom du SERVICE, pas celui du broker\n157:         \"ssl.endpoint.identification.algorithm\": \"none\",\n158:         # le DNS Aiven resout d'abord en IPv6 NAT64 : on force IPv4\n159:         \"broker.address.family\": os.environ.get(\"KAFKA_ADDRESS_FAMILY\", \"v4\"),\n160:         \"socket.timeout.ms\": int(os.environ.get(\"KAFKA_SOCKET_TIMEOUT_MS\", \"10000\")),\n[Output truncated. Continue reading with offset: 161]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /home/baptistefaisy/aiven-kafka-demo/tools/kafkalib.py, lines 1-160\n1: #!/usr/bin/env python3\n2: \"\"\"Boite a outils Kafka partagee (config, producteur, consommateur).\n3: \n4: Regles de securite :\n5:   - aucun secret n'est jamais affiche ni journalise ;\n6:   - chaque appel reseau a un timeout ;\n7:   - les erreurs sont transformees en messages lisibles\n8:     (\"quoi / pourquoi / quoi faire maintenant\"), jamais en traceback.\n9: \"\"\"\n10: from __future__ import annotations\n11: \n12: import os\n13: import re\n14: import sys\n15: import time\n16: from pathlib import Path\n17: from typing import Any, Dict, List, Optional, Tuple\n18: \n19: HERE = Path(__file__).resolve().parent\n20: PROJECT_ROOT = HERE.parent\n21: \n22: EXIT_OK = 0\n23: EXIT_USAGE = 1\n24: EXIT_CONFIG = 2\n25: EXIT_KAFKA = 3\n26: EXIT_RUNNING = 4\n27: \n28: REQUIRED_ENV = [\n29:     \"KAFKA_BOOTSTRAP\",\n30:     \"KAFKA_USERNAME\",\n31:     \"KAFKA_PASSWORD\",\n32:     \"KAFKA_CA_FILE\",\n33:     \"KAFKA_TOPIC_PREFIX\",\n34: ]\n35: \n36: \n37: class ConfigError(Exception):\n38:     \"\"\"Configuration incomplete (variables manquantes, fichier illisible...).\"\"\"\n39: \n40: \n41: class KafkaUnreachable(Exception):\n42:     \"\"\"Le broker ne repond pas (reseau, TLS, ACL, service en construction...).\"\"\"\n43: \n44: \n45: def load_env_file(path: Optional[str] = None) -> Dict[str, str]:\n46:     \"\"\"Charge un env-<service>.sh sans l'executer (parsing KEY=VALUE).\"\"\"\n47:     p = Path(path or PROJECT_ROOT / \"env-agent-kafka.sh\")\n48:     values: Dict[str, str] = {}\n49:     if not p.exists():\n50:         return values\n51:     for raw in p.read_text(encoding=\"utf-8\").splitlines():\n52:         line = raw.strip()\n53:         if not line or line.startswith(\"#\") or \"=\" not in line:\n54:             continue\n55:         if line.startswith(\"export \"):\n56:             line = line[len(\"export \"):]\n57:         key, _, val = line.partition(\"=\")\n58:         key = key.strip()\n59:         val = val.strip().strip('\"').strip(\"'\")\n60:         if key and re.fullmatch(r\"[A-Za-z_][A-Za-z0-9_]*\", key):\n61:             values[key] = val\n62:     return values\n63: \n64: \n65: def ensure_config() -> None:\n66:     \"\"\"Remplit les variables KAFKA_* manquantes depuis env-agent-kafka.sh.\"\"\"\n67:     if all(os.environ.get(k) for k in REQUIRED_ENV):\n68:         return\n69:     for key, val in load_env_file().items():\n70:         os.environ.setdefault(key, val)\n71: \n72: \n73: def config() -> Dict[str, str]:\n74:     ensure_config()\n75:     missing = [k for k in REQUIRED_ENV if not os.environ.get(k)]\n76:     if missing:\n77:         raise ConfigError(\n78:             \"configuration incomplete : variable(s) manquante(s) \"\n79:             + \", \".join(missing)\n80:             + \" -> source env-agent-kafka.sh (mode 600) puis reessaye\"\n81:         )\n82:     return {k: os.environ[k] for k in REQUIRED_ENV}\n83: \n84: \n85: # --------------------------------------------------------------------------\n86: # basculement de cluster (repli)\n87: # --------------------------------------------------------------------------\n88: # Le service principal (agent-kafka) peut tomber : le systeme bascule alors sur\n89: # le service de repli (kafka-1687d005) sans intervention. Le choix est partage\n90: # par tous les outils (fichier d'etat commun) pour que le generateur, le\n91: # watcher, l'agent et le site parlent au MEME cluster.\n92: FALLBACK_ENV_FILE = os.environ.get(\n93:     \"KAFKA_FALLBACK_ENV_FILE\", str(PROJECT_ROOT / \"env-kafka-1687d005.sh\"))\n94: PROFILE_STATE = Path(os.environ.get(\n95:     \"KAFKA_PROFILE_STATE\",\n96:     str(Path.home() / \".local\" / \"state\" / \"aiven-kafka-demo\" / \"active.json\")))\n97: HEALTH_TTL_S = float(os.environ.get(\"KAFKA_HEALTH_TTL_S\", \"20\"))\n98: \n99: \n100: def _profile_env(values: Dict[str, str]) -> Dict[str, str]:\n101:     env = dict(values)\n102:     env.setdefault(\"KAFKA_SECURITY_PROTOCOL\", \"SASL_SSL\")\n103:     env.setdefault(\"KAFKA_SASL_MECHANISM\", \"SCRAM-SHA-256\")\n104:     return env\n105: \n106: \n107: def profiles() -> List[Tuple[str, Dict[str, str]]]:\n108:     \"\"\"Les profils disponibles : (nom, variables KAFKA_*).\"\"\"\n109:     out: List[Tuple[str, Dict[str, str]]] = []\n110:     primary = {k: os.environ.get(k) for k in REQUIRED_ENV}\n111:     if all(primary.get(k) for k in REQUIRED_ENV):\n112:         out.append((\"primary\", _profile_env(primary)))\n113:     fallback = load_env_file(FALLBACK_ENV_FILE)\n114:     if all(fallback.get(k) for k in REQUIRED_ENV):\n115:         if 