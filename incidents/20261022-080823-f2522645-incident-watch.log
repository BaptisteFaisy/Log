\n32:   # --- preuve du \"zero code\" (§9.6) ---------------------------------------\n33:   # Ajoute le 2026-10-22 : un nouvel agent (agents/cache-diagnose.md) + UNE\n34:   # ligne ici. Aucune ligne du watcher n'a ete modifiee.\n35:   cache_miss_storm: cache-diagnose\n36: \n37:   # --- erreurs SQL reelles (producteur tools/emit_sql_error.py) ------------\n38:   # Ajoute le 2026-10-22 : ces error.type ne sont PAS des scenarios du\n39:   # catalogue. Ils sont produits par une VRAIE erreur PostgreSQL (sqlstate\n40:   # capture par le serveur), publiee par tools/emit_sql_error.py.\n41:   # Meme regle : aucune ligne de tools/kafka-incident-watch n'a ete touchee.\n42:   db_undefined_table: db-diagnose\n43:   db_undefined_function: db-diagnose\n44:   db_undefined_column: db-diagnose\n45:   db_syntax_error: db-diagnose\n46:   db_data_exception: db-diagnose\n47:   db_in_failed_transaction: db-diagnose\n48:   db_application_exception: db-diagnose\n49:   db_lock_timeout: db-diagnose\n50:   db_deadlock: db-diagnose\n51:   db_permission_denied: db-diagnose"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/home/baptistefaisy/aiven-kafka-demo/routes.yaml\"}"},"time":{"start":1792656505988,"end":1792656506474}}}}
